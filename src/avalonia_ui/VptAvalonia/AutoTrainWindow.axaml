<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="VptAvalonia.AutoTrainWindow"
        Title="Tự động Train"
        Width="680" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI, Tahoma, Arial" FontSize="12.5" Background="#2b2d30">

  <Window.Resources>
    <SolidColorBrush x:Key="Bg" Color="#2b2d30"/>
    <SolidColorBrush x:Key="Field" Color="#1a1b1d"/>
    <SolidColorBrush x:Key="Border" Color="#4a4d52"/>
    <SolidColorBrush x:Key="Text" Color="#e0e0e0"/>
    <SolidColorBrush x:Key="Dim" Color="#9aa0a6"/>
    <SolidColorBrush x:Key="Green" Color="#4e9e3a"/>
    <SolidColorBrush x:Key="Red" Color="#9c3232"/>
    <SolidColorBrush x:Key="Gray" Color="#55575b"/>
    <SolidColorBrush x:Key="Accent" Color="#6da13f"/>
    <SolidColorBrush x:Key="Combo" Color="#3c3f41"/>
  </Window.Resources>

  <Window.Styles>
    <Style Selector="TextBlock"><Setter Property="Foreground" Value="{StaticResource Text}"/></Style>
    <Style Selector="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="RadioButton"><Setter Property="Foreground" Value="{StaticResource Text}"/></Style>
    <Style Selector="TextBox">
      <Setter Property="Background" Value="{StaticResource Field}"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
      <Setter Property="CornerRadius" Value="2"/>
      <Setter Property="MinHeight" Value="27"/>
      <Setter Property="Padding" Value="6,3"/>
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="Background" Value="{StaticResource Combo}"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="MinHeight" Value="26"/>
      <Setter Property="CornerRadius" Value="2"/>
      <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="ComboBox /template/ Border#Background">
      <Setter Property="Background" Value="{StaticResource Combo}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
    </Style>
    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="3"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.tool">
      <Setter Property="Background" Value="{StaticResource Gray}"/>
      <Setter Property="Height" Value="26"/>
      <Setter Property="Padding" Value="10,2"/>
      <Setter Property="FontSize" Value="11.5"/>
    </Style>
    <Style Selector="Button.act">
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Height" Value="29"/>
      <Setter Property="Padding" Value="11,0"/>
      <Setter Property="FontSize" Value="11.5"/>
    </Style>
  </Window.Styles>

  <Grid Margin="12" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">

    <!-- group + key. The key account is the one that walks the patrol and drags
         the party, so it can only be a member of the selected group. -->
    <TextBlock Grid.Row="0" Grid.Column="0" Text="Nhóm" VerticalAlignment="Center" Margin="0,0,10,6"/>
    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="10" Margin="0,0,0,6">
      <TextBlock x:Name="TrainGroupName" Text="—" FontWeight="Bold"
                 Foreground="{StaticResource Accent}" VerticalAlignment="Center" MinWidth="70"/>
      <RadioButton x:Name="RbParty" GroupName="TeamMode" Content="Đội"
                   ToolTip.Tip="Một key kéo cả nhóm; chỉ key đi tuần"
                   IsChecked="True" VerticalAlignment="Center" IsCheckedChanged="OnTeamModeChanged"/>
      <RadioButton x:Name="RbSolo" GroupName="TeamMode" Content="Riêng lẻ"
                   VerticalAlignment="Center" IsCheckedChanged="OnTeamModeChanged"/>
      <TextBlock Text="Key" VerticalAlignment="Center"/>
      <ComboBox x:Name="CbKeyAccount" Width="120" SelectionChanged="OnKeyPicked">
        <ComboBox.ItemTemplate>
          <DataTemplate><TextBlock Text="{Binding Name}"/></DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <CheckBox x:Name="CbShared" Content="Chung"
                ToolTip.Tip="Dùng cấu hình chung thay vì cấu hình riêng của nhóm"/>
      <Button Content="Lưu nhóm" Classes="tool" Click="OnSaveGroup"/>
    </StackPanel>

    <TextBlock Grid.Row="1" Grid.Column="0" Text="Map" VerticalAlignment="Center" Margin="0,0,10,6"/>
    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,6">
      <ComboBox x:Name="CbTrainMap" Width="180" SelectionChanged="OnTrainMapPicked"/>
      <TextBlock Text="Thời gian chạy" VerticalAlignment="Center" Margin="14,0,0,0"/>
      <TextBox x:Name="TEndMinutes" Text="0" Width="56"/>
      <ComboBox x:Name="CbEndUnit" Width="80">
        <ComboBoxItem Content="Phút"/>
        <ComboBoxItem Content="Giờ"/>
      </ComboBox>
      <TextBlock Text="0 = tới khi bấm Stop" Foreground="{StaticResource Dim}"
                 FontSize="11" VerticalAlignment="Center"/>
    </StackPanel>

    <TextBlock Grid.Row="2" Grid.Column="0" Text="Vị trí" VerticalAlignment="Center" Margin="0,0,8,5"/>
    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="0,0,0,5">
      <Border BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="2" Padding="5,1">
        <StackPanel Orientation="Horizontal" Spacing="3">
          <TextBlock Text="1" Foreground="{StaticResource Dim}" VerticalAlignment="Center"/>
          <TextBlock x:Name="TPos1" Text="—" VerticalAlignment="Center" MinWidth="60"/>
          <Button Content="◎" Classes="tool" Height="20" Padding="4,0" FontSize="12" Tag="1"
                  Click="OnCapturePos" ToolTip.Tip="Ghi vị trí key đang đứng"/>
          <Button Content="✕" Classes="tool" Height="20" Padding="4,0" FontSize="10" Tag="1"
                  Click="OnClearPos" ToolTip.Tip="Xóa vị trí"/>
        </StackPanel>
      </Border>
      <Border BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="2" Padding="5,1">
        <StackPanel Orientation="Horizontal" Spacing="3">
          <TextBlock Text="2" Foreground="{StaticResource Dim}" VerticalAlignment="Center"/>
          <TextBlock x:Name="TPos2" Text="—" VerticalAlignment="Center" MinWidth="60"/>
          <Button Content="◎" Classes="tool" Height="20" Padding="4,0" FontSize="12" Tag="2"
                  Click="OnCapturePos" ToolTip.Tip="Ghi vị trí key đang đứng"/>
          <Button Content="✕" Classes="tool" Height="20" Padding="4,0" FontSize="10" Tag="2"
                  Click="OnClearPos" ToolTip.Tip="Xóa vị trí"/>
        </StackPanel>
      </Border>
      <Border BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="2" Padding="5,1">
        <StackPanel Orientation="Horizontal" Spacing="3">
          <TextBlock Text="3" Foreground="{StaticResource Dim}" VerticalAlignment="Center"/>
          <TextBlock x:Name="TPos3" Text="—" VerticalAlignment="Center" MinWidth="60"/>
          <Button Content="◎" Classes="tool" Height="20" Padding="4,0" FontSize="12" Tag="3"
                  Click="OnCapturePos" ToolTip.Tip="Ghi vị trí key đang đứng"/>
          <Button Content="✕" Classes="tool" Height="20" Padding="4,0" FontSize="10" Tag="3"
                  Click="OnClearPos" ToolTip.Tip="Xóa vị trí"/>
        </StackPanel>
      </Border>
      <TextBlock Text="ô trống thì bỏ qua" Foreground="{StaticResource Dim}"
                 FontSize="11" VerticalAlignment="Center" Margin="4,0,0,0"/>
    </StackPanel>

    <TextBlock Grid.Row="3" Grid.Column="0" Text="Tùy chọn" VerticalAlignment="Center" Margin="0,0,10,6"/>
    <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="14" Margin="0,0,0,6">
      <CheckBox x:Name="CbEnsureAuto" Content="Bật Auto" IsChecked="True"/>
      <CheckBox x:Name="CbGround" Content="Hạ cánh" IsChecked="True"/>
      <CheckBox x:Name="CbHide" Content="Ẩn cửa sổ"/>
      <!-- No entry-mode picker: this window IS the unattended path, so the tool
           always logs in itself. Driving an already-open client is the outer
           AUTO ALL button's job. -->
      <TextBlock Text="Tool tự đăng nhập" Foreground="{StaticResource Dim}"
                 FontSize="11" VerticalAlignment="Center"/>
    </StackPanel>

    <Grid Grid.Row="4" Grid.Column="1" ColumnDefinitions="*,Auto,Auto" Margin="0,6,0,0">
      <TextBlock Grid.Column="0" x:Name="Hint" Text="" Foreground="{StaticResource Dim}"
                 FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap"/>
      <Button Grid.Column="1" Classes="act" Content="Start" Width="92" Margin="0,0,8,0"
              Background="{StaticResource Green}" Click="OnStart"/>
      <Button Grid.Column="2" Classes="act" Content="Stop" Width="92"
              Background="{StaticResource Red}" Click="OnStop"/>
    </Grid>
  </Grid>
</Window>
