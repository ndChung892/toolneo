<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="VptAvalonia.MainWindow"
        Title="QUẢN LÝ TÀI KHOẢN GAME VUA PHÁP THUẬT"
        Width="800" Height="540" MinWidth="780" MinHeight="520"
        FontFamily="Segoe UI, Tahoma, Arial" FontSize="12.5" Background="#2b2d30">

  <Window.Resources>
    <SolidColorBrush x:Key="Bg" Color="#2b2d30"/>
    <SolidColorBrush x:Key="Field" Color="#1a1b1d"/>
    <SolidColorBrush x:Key="Border" Color="#4a4d52"/>
    <SolidColorBrush x:Key="Text" Color="#e0e0e0"/>
    <SolidColorBrush x:Key="Dim" Color="#9aa0a6"/>
    <SolidColorBrush x:Key="Title" Color="#c8ccd0"/>
    <SolidColorBrush x:Key="Green" Color="#4e9e3a"/>
    <SolidColorBrush x:Key="Orange" Color="#d2622a"/>
    <SolidColorBrush x:Key="Red" Color="#9c3232"/>
    <SolidColorBrush x:Key="Blue" Color="#2f7fd6"/>
    <SolidColorBrush x:Key="Sel" Color="#3a5f8a"/>
    <SolidColorBrush x:Key="Gray" Color="#55575b"/>
    <SolidColorBrush x:Key="Accent" Color="#6da13f"/>
    <SolidColorBrush x:Key="Combo" Color="#3c3f41"/>
    <SolidColorBrush x:Key="ComboHot" Color="#484c4f"/>
  </Window.Resources>

  <Window.Styles>
    <!-- classic group box: caption sits ON the top border line -->
    <Style Selector="HeaderedContentControl.group">
      <Setter Property="Margin" Value="0,0,0,8"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="VerticalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Grid>
            <Border Margin="0,9,0,0" BorderBrush="{StaticResource Border}"
                    BorderThickness="1" CornerRadius="4"/>
            <ContentPresenter Margin="10,20,10,10"
                              Content="{TemplateBinding Content}"
                              HorizontalContentAlignment="Stretch"
                              VerticalContentAlignment="Stretch"/>
            <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                    Margin="10,0,0,0" Padding="5,0" Background="{StaticResource Bg}">
              <TextBlock Text="{TemplateBinding Header}" FontSize="12.5"
                         Foreground="{StaticResource Title}" FontWeight="SemiBold"/>
            </Border>
          </Grid>
        </ControlTemplate>
      </Setter>
    </Style>

    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
    </Style>
    <Style Selector="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="Padding" Value="8,0,0,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBox">
      <Setter Property="Background" Value="{StaticResource Field}"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
      <Setter Property="CornerRadius" Value="2"/>
      <Setter Property="MinHeight" Value="27"/>
      <Setter Property="Padding" Value="6,3"/>
    </Style>
    <!-- mọi ComboBox dùng chung màu với ComboBox "Kênh" trong bảng tài khoản -->
    <Style Selector="ComboBox">
      <Setter Property="Background" Value="{StaticResource Combo}"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="MinHeight" Value="24"/>
      <Setter Property="CornerRadius" Value="2"/>
      <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="ComboBox /template/ Border#Background">
      <Setter Property="Background" Value="{StaticResource Combo}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
    </Style>
    <Style Selector="ComboBox:pointerover /template/ Border#Background">
      <Setter Property="Background" Value="{StaticResource ComboHot}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
    </Style>
    <Style Selector="ComboBox:pressed /template/ Border#Background">
      <Setter Property="Background" Value="{StaticResource ComboHot}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
    </Style>
    <Style Selector="ComboBox:focus /template/ Border#Background">
      <Setter Property="Background" Value="{StaticResource Combo}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
    </Style>
    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="3"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.act">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="Padding" Value="11,0"/>
      <Setter Property="Height" Value="28"/>
    </Style>
    <Style Selector="Button.daily">
      <Setter Property="Background" Value="#5a5c60"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="Margin" Value="1.5"/>
      <Setter Property="Height" Value="25"/>
      <Setter Property="Padding" Value="6,0"/>
      <Setter Property="FontSize" Value="10.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.grp">
      <Setter Property="Background" Value="{StaticResource Gray}"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="Padding" Value="9,3"/>
      <Setter Property="Margin" Value="0,0,4,0"/>
      <Setter Property="FontSize" Value="11.5"/>
    </Style>
    <Style Selector="Button.tool">
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="Background" Value="{StaticResource Gray}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Height" Value="21"/>
      <Setter Property="Padding" Value="5,1"/>
    </Style>

    <!-- Selection is a WHOLE ROW, and it stays lit when focus moves elsewhere.
         Avalonia's default dims the selected row once the grid loses focus and
         paints the clicked CELL separately - so after opening the Hái/Câu
         window there was no longer any sign of which account it belonged to. -->
    <Style Selector="DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
      <Setter Property="Fill" Value="{StaticResource Sel}"/>
      <Setter Property="Opacity" Value="1"/>
    </Style>
    <Style Selector="DataGridRow:selected:pointerover /template/ Rectangle#BackgroundRectangle">
      <Setter Property="Fill" Value="{StaticResource Sel}"/>
      <Setter Property="Opacity" Value="1"/>
    </Style>
    <!-- no per-cell tint: the row carries the selection, the cell never does -->
    <Style Selector="DataGridCell:selected">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="DataGridCell:current">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="DataGridColumnHeader">
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="Background" Value="#2b2d30"/>
      <Setter Property="Height" Value="23"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="DataGridColumnHeader /template/ ContentPresenter">
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="DataGridRow"><Setter Property="MinHeight" Value="28"/></Style>
    <Style Selector="DataGrid CheckBox:checked /template/ Border#NormalRectangle">
      <Setter Property="Background" Value="{StaticResource Green}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Green}"/>
    </Style>
    <Style Selector="DataGridCell">
      <Setter Property="FocusAdorner" Value="{x:Null}"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="DataGridCell:focus">
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="DataGridRow">
      <Setter Property="FocusAdorner" Value="{x:Null}"/>
    </Style>
    <Style Selector="DataGrid">
      <Setter Property="FocusAdorner" Value="{x:Null}"/>
    </Style>
    <Style Selector="DataGridCell:current /template/ Rectangle#CurrencyVisual">
      <Setter Property="IsVisible" Value="False"/>
    </Style>
    <Style Selector="DataGridCell:focus /template/ Rectangle#FocusVisual">
      <Setter Property="IsVisible" Value="False"/>
    </Style>

    <Style Selector="TabControl">
      <Setter Property="Padding" Value="0"/>
    </Style>
    <!-- Own template: the Fluent one anchors its selection pipe right under the
         glyphs (it clips descenders) and paints it with the system accent. -->
    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="Padding" Value="10,3"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="Opacity" Value="0.62"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}">
            <DockPanel LastChildFill="True">
              <Border DockPanel.Dock="Bottom" Name="Pipe" Height="2" CornerRadius="1"
                      Margin="4,1,4,0" Background="Transparent"/>
              <ContentPresenter Name="PART_ContentPresenter"
                                Content="{TemplateBinding Header}"
                                ContentTemplate="{TemplateBinding HeaderTemplate}"
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </DockPanel>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="TabItem:selected">
      <Setter Property="Opacity" Value="1"/>
    </Style>
    <Style Selector="TabItem:selected /template/ Border#Pipe">
      <Setter Property="Background" Value="{StaticResource Green}"/>
    </Style>
  </Window.Styles>

  <Grid ColumnDefinitions="244,*" Margin="6">
    <!-- ===================== LEFT ===================== -->
    <Grid Grid.Column="0" RowDefinitions="Auto,*" Margin="0,0,6,0">
      <!-- Thông tin -->
      <HeaderedContentControl Grid.Row="0" Classes="group" Header="Thông tin">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*,10,72">
          <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Spacing="3">
            <TextBlock Text="Tên"/>
            <TextBox x:Name="TName"/>
          </StackPanel>
          <StackPanel Grid.Row="1" Grid.Column="0" Spacing="3" Margin="0,7,0,0">
            <TextBlock Text="Link"/>
            <TextBox x:Name="TLink"/>
          </StackPanel>
          <StackPanel Grid.Row="1" Grid.Column="2" Spacing="3" Margin="0,7,0,0">
            <TextBlock Text="FPS"/>
            <TextBox x:Name="TFps"/>
          </StackPanel>
          <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal"
                      Spacing="10" Margin="0,9,0,0" VerticalAlignment="Center">
            <CheckBox x:Name="CMulti" Content="Mở trùng tab" VerticalAlignment="Center"/>
            <Button Content="FPS" Background="{StaticResource Blue}" Foreground="White"
                    FontSize="11" Height="24" Padding="9,1" Click="OnFps"/>
          </StackPanel>
          <Grid Grid.Row="3" Grid.ColumnSpan="3" ColumnDefinitions="*,6,*,6,*" Margin="0,9,0,0">
            <Button Grid.Column="0" Classes="act" Height="26" FontSize="10.5" Padding="4,0" Content="THÊM"
                    Background="{StaticResource Green}" Click="OnAdd"/>
            <Button Grid.Column="2" Classes="act" Height="26" FontSize="10.5" Padding="4,0" Content="CẬP NHẬT"
                    Background="{StaticResource Orange}" Click="OnUpdate"/>
            <Button Grid.Column="4" Classes="act" Height="26" FontSize="10.5" Padding="4,0" Content="XÓA"
                    Background="{StaticResource Red}" Click="OnDelete"/>
          </Grid>
        </Grid>
      </HeaderedContentControl>

      <!-- Nhật ký -->
      <HeaderedContentControl Grid.Row="1" Classes="group" Header="Nhật ký">
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
            <CheckBox Grid.Column="0" Content="Hiện log tài khoản" IsChecked="True" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="Xóa Log" Classes="tool" Height="26" Padding="10,2" Click="OnClearLog"/>
          </Grid>
          <TextBox x:Name="LogBox" AcceptsReturn="True" IsReadOnly="True"
                   FontFamily="Consolas, Courier New" FontSize="11.5" TextWrapping="Wrap"
                   Background="{StaticResource Field}"/>
        </DockPanel>
      </HeaderedContentControl>
    </Grid>

    <!-- ===================== RIGHT ===================== -->
    <Grid Grid.Column="1" RowDefinitions="245,*">

      <!-- Danh sách tài khoản đã lưu -->
      <HeaderedContentControl Grid.Row="0" Classes="group" Header="Danh sách tài khoản đã lưu">
        <DockPanel>
          <!-- Inside this frame, under the list: every one of these verbs acts
               on the account(s) in the list above them, so they belong to that
               box rather than floating between it and the feature tabs. Two
               rows, one kind of verb each - game actions, then window actions. -->
          <UniformGrid DockPanel.Dock="Bottom" Columns="6" Rows="2" Margin="0,5,0,0">
            <UniformGrid.Styles>
              <Style Selector="Button">
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="VerticalAlignment" Value="Stretch"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
              </Style>
            </UniformGrid.Styles>
            <Button Classes="act" Height="24" FontSize="10" Padding="4,0" Margin="1" Content="VÀO GAME" Background="{StaticResource Blue}" Click="OnLogin"/>
            <Button Classes="act" Height="24" FontSize="10" Padding="4,0" Margin="1" Content="VÀO ALL" Background="{StaticResource Green}" Click="OnLoginAll"/>
            <Button Classes="act" Height="24" FontSize="10" Padding="4,0" Margin="1" Content="AUTO ALL" Background="{StaticResource Red}" Click="OnAutoAll"/>
            <Button Classes="act" Height="24" FontSize="10" Padding="4,0" Margin="1" Content="NGỪNG AUTO" Background="{StaticResource Orange}" Click="OnStopAuto"/>
            <Button Classes="act" Height="24" FontSize="10" Padding="4,0" Margin="1" Content="DỪNG ALL" Background="{StaticResource Red}" Click="OnStopAll"/>
            <Button Classes="tool" Height="24" FontSize="14" Margin="1" Content="⚙" Click="OnSettings" ToolTip.Tip="Cài đặt chung"/>
            <Button Classes="tool" Height="24" Margin="1" Content="Hiển thị lên đầu" Click="OnBringFront"/>
            <Button Classes="tool" Height="24" Margin="1" Content="Sắp xếp CS" Click="OnArrange"/>
            <Button Classes="tool" Height="24" Margin="1" Content="Ẩn (đỡ GPU)" Click="OnHide"/>
            <Button Classes="tool" Height="24" Margin="1" Content="Ẩn taskbar" Click="OnMinimize"/>
            <Button Classes="tool" Height="24" Margin="1" Content="Hiện" Click="OnRestore"/>
            <Button Classes="tool" Height="24" Margin="1" Content="Đóng CS" Click="OnClose"/>
          </UniformGrid>

          <Border BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="2">
            <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="False" CanUserResizeColumns="True"
                      GridLinesVisibility="Horizontal" HeadersVisibility="Column" RowHeight="24" FontSize="12"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      Background="#2b2d30" RowBackground="#2b2d30" SelectionChanged="OnRowSelected"
                      SelectionMode="Single">
              <DataGrid.Columns>
                <DataGridTemplateColumn Header="CHỌN" Width="58" CanUserSort="False">
                  <DataGridTemplateColumn.Header>
                    <CheckBox x:Name="ChkAll" Content="Tất cả" IsThreeState="True"
                              HorizontalAlignment="Center" ToolTip.Tip="Chọn/bỏ chọn toàn bộ account"
                              IsCheckedChanged="OnSelectAll"/>
                  </DataGridTemplateColumn.Header>
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <CheckBox IsChecked="{Binding Sel, Mode=TwoWay}" HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch" HorizontalContentAlignment="Center"
                                ToolTip.Tip="Chọn account này để chạy Auto"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="STT" Binding="{Binding Stt}" Width="54" IsReadOnly="True" CanUserSort="False"/>
                <DataGridTemplateColumn Header="TÊN" Width="130" CanUserSort="False">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Name}" FontSize="10.5" Margin="6,0"
                                 VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="KÊNH" Width="88" CanUserSort="False">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <ComboBox SelectedItem="{Binding Channel, Mode=TwoWay}" ItemsSource="{Binding Channels}"
                                HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="3,0"
                                MinHeight="24" Padding="4,1" FontSize="11"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="FPS" Binding="{Binding Fps}" Width="54" IsReadOnly="True" CanUserSort="False"/>
                <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="64" IsReadOnly="True" CanUserSort="False"/>
                <DataGridTemplateColumn Header="●" Width="46" CanUserSort="False">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <Ellipse Width="11" Height="11" Fill="{Binding ActiveBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               ToolTip.Tip="Xanh = client đang chạy"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
          </Border>
        </DockPanel>
      </HeaderedContentControl>

      <!-- Thao tác -->
      <HeaderedContentControl Grid.Row="1" Classes="group" Header="Thao tác" Margin="0,0,0,8">
        <DockPanel>
          <TabControl x:Name="FeatureTabs">
            <!-- Daily -->
            <TabItem Header="Daily">
              <Grid Margin="2,4,2,2" RowDefinitions="Auto,Auto" VerticalAlignment="Top">
                <ItemsControl Grid.Row="1" x:Name="DailyButtons" Margin="0,9,0,0">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Rows="2" Columns="7"/></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                </ItemsControl>
                <!-- The two "Trạng thái / Xong" columns are gone. They were
                     never wired to anything - a second checkbox the user had to
                     tick by hand to record what they had already done - and they
                     ate half the width, which is why every label was cramped.
                     Same ten tasks now sit in three roomy columns. -->
                <Grid Grid.Row="0" ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                      VerticalAlignment="Top">
                  <Grid.Styles>
                    <Style Selector="CheckBox">
                      <Setter Property="FontSize" Value="11"/>
                      <Setter Property="Padding" Value="4,0,0,0"/>
                      <Setter Property="MinHeight" Value="17"/>
                      <Setter Property="Margin" Value="0,1"/>
                    </Style>
                  </Grid.Styles>
                  <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" ColumnDefinitions="Auto,Auto,*" Margin="0,0,0,5">
                    <Button Grid.Column="0" Content="CHẠY AUTO" Classes="act" Background="{StaticResource Green}"
                            Click="OnRunDailyAuto" ToolTip.Tip="Chạy cấu hình riêng của từng account đang được chọn ở bảng"/>
                    <Button Grid.Column="1" Content="DỪNG DAILY" Classes="act" Background="{StaticResource Red}"
                            Margin="4,0,0,0" Click="OnStopDaily"
                            ToolTip.Tip="Dừng Daily của account đang tick; không tick thì dừng mọi Daily"/>
                    <TextBlock Grid.Column="2" x:Name="DailySelectedNames" Text="Chưa chọn account"
                               Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Dim}"/>
                  </Grid>
                  <CheckBox x:Name="DlyVip" Grid.Row="1" Grid.Column="0" Content="VIP + thời trang" IsCheckedChanged="OnDailySettingChanged"/>
                  <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Spacing="3">
                    <CheckBox x:Name="DlyMatBao" Content="Chế mật bảo" IsCheckedChanged="OnDailySettingChanged"/>
                    <Grid Width="39" Height="18" ColumnDefinitions="27,12" RowDefinitions="9,9"
                          ToolTip.Tip="Số lần chế mật bảo của account đang chọn">
                      <TextBox x:Name="DlyMatBaoCount" Grid.Column="0" Grid.RowSpan="2" Text="20"
                               MinWidth="0" MinHeight="0" FontSize="10" Padding="3,0"
                               VerticalContentAlignment="Center" TextChanged="OnMatBaoCountChanged"/>
                      <Button Grid.Column="1" Grid.Row="0" Content="▲" MinWidth="0" MinHeight="0"
                              FontSize="5" Padding="0" CornerRadius="0" BorderThickness="1,1,1,0.5"
                              BorderBrush="{StaticResource Border}" Background="{StaticResource Combo}"
                              Click="OnMatBaoPlus" ToolTip.Tip="Tăng 1"/>
                      <Button Grid.Column="1" Grid.Row="1" Content="▼" MinWidth="0" MinHeight="0"
                              FontSize="5" Padding="0" CornerRadius="0" BorderThickness="1,0.5,1,1"
                              BorderBrush="{StaticResource Border}" Background="{StaticResource Combo}"
                              Click="OnMatBaoMinus" ToolTip.Tip="Giảm 1"/>
                    </Grid>
                  </StackPanel>
                  <CheckBox x:Name="DlyDieuKhac" Grid.Row="3" Grid.Column="0" Content="Nhận điêu khắc" IsCheckedChanged="OnDailySettingChanged"/>

                  <!-- Thứ tự lưới = thứ tự chạy Daily: đọc từ trên xuống trong
                       một cột, rồi sang cột kế. Cột 0: VIP/Mật bảo/Điêu khắc;
                       cột 1: Lật thẻ bài/Phụ bản/Hành lang; cột 2: Thần tu/Tu hành. -->
                  <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="3">
                    <CheckBox x:Name="DlyLatTheBai" Content="Lật thẻ bài" IsCheckedChanged="OnDailySettingChanged"/>
                    <Grid Width="39" Height="18" ColumnDefinitions="27,12" RowDefinitions="9,9"
                          ToolTip.Tip="Số lượt phát bài của account đang chọn (tối đa 10/ngày)">
                      <TextBox x:Name="DlyLatTheBaiCount" Grid.Column="0" Grid.RowSpan="2" Text="10"
                               MinWidth="0" MinHeight="0" FontSize="10" Padding="3,0"
                               VerticalContentAlignment="Center" TextChanged="OnLatTheBaiCountChanged"/>
                      <Button Grid.Column="1" Grid.Row="0" Content="▲" MinWidth="0" MinHeight="0"
                              FontSize="5" Padding="0" CornerRadius="0" BorderThickness="1,1,1,0.5"
                              BorderBrush="{StaticResource Border}" Background="{StaticResource Combo}"
                              Click="OnLatTheBaiPlus" ToolTip.Tip="Tăng 1"/>
                      <Button Grid.Column="1" Grid.Row="1" Content="▼" MinWidth="0" MinHeight="0"
                              FontSize="5" Padding="0" CornerRadius="0" BorderThickness="1,0.5,1,1"
                              BorderBrush="{StaticResource Border}" Background="{StaticResource Combo}"
                              Click="OnLatTheBaiMinus" ToolTip.Tip="Giảm 1"/>
                    </Grid>
                  </StackPanel>
                  <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="3">
                    <CheckBox x:Name="DlyPhuBan" Content="Auto phụ bản" IsCheckedChanged="OnDailySettingChanged"/>
                    <Button Content="..." Classes="tool" Width="18" Height="15" MinWidth="0" MinHeight="0"
                            FontSize="8" Padding="0" Click="OnDungeonSettings"
                            ToolTip.Tip="Mở cài đặt phụ bản"/>
                  </StackPanel>
                  <CheckBox x:Name="DlyHanhLang" Grid.Row="3" Grid.Column="1" Content="Nhận hành lang" IsCheckedChanged="OnDailySettingChanged"/>

                  <CheckBox x:Name="DlyThanTu" Grid.Row="1" Grid.Column="2" Content="Thần tu (15 phút)" IsCheckedChanged="OnDailySettingChanged"/>
                  <CheckBox x:Name="DlyTuHanh" Grid.Row="2" Grid.Column="2" Content="Tu hành" IsCheckedChanged="OnDailySettingChanged"/>
                  <CheckBox x:Name="DlyTruMa" Grid.Row="3" Grid.Column="2" Content="Trừ ma" IsCheckedChanged="OnDailySettingChanged"/>
                  <CheckBox x:Name="DlyTriAn" Grid.Row="4" Grid.Column="2" Content="Trị an / Phi tặc" IsCheckedChanged="OnDailySettingChanged"/>
                </Grid>
              </Grid>
            </TabItem>

            <!-- Cài đặt -->
            <TabItem Header="Cài đặt">
              <Grid ColumnDefinitions="*,260" Margin="2,10,2,2">
                <Grid Grid.Column="0" ColumnDefinitions="132,*,70" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
                  <Grid.Styles>
                    <Style Selector="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="0,3"/></Style>
                    <Style Selector="ComboBox"><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="Margin" Value="0,3,6,3"/></Style>
                    <Style Selector="Button"><Setter Property="Background" Value="{StaticResource Gray}"/><Setter Property="Foreground" Value="White"/><Setter Property="Margin" Value="0,3"/><Setter Property="Height" Value="27"/></Style>
                  </Grid.Styles>
                  <TextBlock Grid.Row="0" Grid.Column="0" Text="Lựa chọn Mật bảo"/>
                  <ComboBox  Grid.Row="0" Grid.Column="1"/>
                  <ComboBox  Grid.Row="0" Grid.Column="2" Margin="0,3"/>
                  <TextBlock Grid.Row="1" Grid.Column="0" Text="Trồng trang viên với"/>
                  <ComboBox  Grid.Row="1" Grid.Column="1"/>
                  <Button    Grid.Row="1" Grid.Column="2" Content="Trồng"/>
                  <TextBlock Grid.Row="2" Grid.Column="0" Text="Đổi năng nổ với"/>
                  <ComboBox  Grid.Row="2" Grid.Column="1"/>
                  <Button    Grid.Row="2" Grid.Column="2" Content="Đổi"/>
                  <!-- Câu/Hái is not here: it is per-account, so it lives behind
                       the HÁI/CÂU button in Daily, which opens that account's
                       own settings window. A row here would have been a second,
                       account-less place to configure the same runner. -->
                  <TextBlock Grid.Row="3" Grid.Column="0" Text="Nông trường"/>
                  <ComboBox  Grid.Row="3" Grid.Column="1"/>
                  <Button    Grid.Row="3" Grid.Column="2" Content="Trồng"/>
                </Grid>
                <HeaderedContentControl Grid.Column="1" Classes="group" Header="Cài đặt phụ bản" Margin="10,0,0,0">
                  <ScrollViewer><ItemsControl x:Name="DungeonList"/></ScrollViewer>
                </HeaderedContentControl>
              </Grid>
            </TabItem>

            <!-- Sổ Tay -->
            <TabItem Header="Sổ Tay">
              <DockPanel Margin="2,10,2,2">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                  <TextBlock Text="Loại Boss" VerticalAlignment="Center"/>
                  <ComboBox Width="110"/>
                  <TextBlock Text="Trạng thái" VerticalAlignment="Center"/>
                  <ComboBox Width="110"/>
                  <TextBlock Text="Tổng: 0 lượt" VerticalAlignment="Center"/>
                  <Button Content="CHẠY SỔ TAY" Classes="tool"/>
                </StackPanel>
                <Border BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="2">
                  <DataGrid x:Name="BossGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                            GridLinesVisibility="Horizontal" Background="#2b2d30" RowBackground="#2b2d30" RowHeight="28">
                    <DataGrid.Columns>
                      <DataGridCheckBoxColumn Header="Chọn" Binding="{Binding Sel}" Width="76"/>
                      <DataGridTextColumn Header="Boss" Binding="{Binding Name}" Width="*"/>
                      <DataGridTextColumn Header="Loại" Binding="{Binding Kind}" Width="120"/>
                      <DataGridTextColumn Header="Lượt" Binding="{Binding Turns}" Width="80"/>
                    </DataGrid.Columns>
                  </DataGrid>
                </Border>
              </DockPanel>
            </TabItem>

            <!-- Tự động hoàn toàn — a HOME for automation functions, not one
                 function itself. Each entry opens its own window that starts
                 the work immediately; more will be added beside Câu/Hái. -->
            <TabItem Header="Tự động hoàn toàn">
              <StackPanel Margin="4,10,4,2" Spacing="8">
                <TextBlock Text="Chọn chức năng để cấu hình và chạy tự động nhiều tài khoản:"
                           Foreground="{StaticResource Dim}" FontSize="11"/>
                <!-- Same small flat button as the Daily strip. These are menu
                     entries, not calls to action - making them big and green
                     implied one of them was the thing to press. -->
                <UniformGrid Columns="4">
                  <Button Classes="daily" Content="CÂU / HÁI" Click="OnOpenAutoGather"
                          ToolTip.Tip="Dàn acc, mỗi acc một loại nông sản"/>
                  <Button Classes="daily" Content="TRAIN" Click="OnOpenAutoTrain"
                          ToolTip.Tip="Chọn nhóm, key và map rồi chạy"/>
                  <!-- Two parallel Auto Boss paths (FEAT-031, chốt 2026-08-29).
                       CŨ keeps the shipped implementation/command untouched;
                       MỚI is the safe-runtime rewrite and must stay clearly
                       labelled as unverified until it passes live acceptance. -->
                  <Button Classes="daily" Content="AUTO BOSS (CŨ)" Click="OnOpenAutoBoss"
                          ToolTip.Tip="Bản đang dùng: vào map, lập nhóm rồi tự đánh những boss đã chọn"/>
                  <Button Classes="daily" Content="AUTO BOSS (MỚI)" Click="OnOpenAutoBossV2"
                          ToolTip.Tip="THỬ NGHIỆM / CHƯA NGHIỆM THU — runtime mới, chưa test live, không thay bản cũ"/>
                  <Button Classes="daily" Content="DAILY" IsEnabled="False"/>
                  <Button Classes="daily" Content="LOGIN CLONE" IsEnabled="False"/>
                  <Button Classes="daily" Content="BẮT PET" IsEnabled="False"/>
                  <Button Classes="daily" Content="PHỤ BẢN" IsEnabled="False"/>
                  <Button Classes="daily" Content="ĐẤU TRƯỜNG" IsEnabled="False"/>
                  <Button Classes="daily" Content="BANG HỘI" IsEnabled="False"/>
                </UniformGrid>
                <TextBlock Text="Nút mờ là chức năng chưa làm — dựng sẵn chỗ để thêm sau."
                           Foreground="{StaticResource Dim}" FontSize="11"/>
              </StackPanel>
            </TabItem>

            <!-- Bắt Pet -->
            <TabItem Header="Bắt Pet">
              <StackPanel Margin="4,12,4,2" Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="Map" VerticalAlignment="Center" Width="60"/>
                  <ComboBox x:Name="CbPetMap" Width="180"/>
                  <TextBlock Text="Pet cần bắt" VerticalAlignment="Center" Margin="12,0,0,0"/>
                  <ComboBox x:Name="CbPetTarget" Width="200"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="Lượt bắt" VerticalAlignment="Center" Width="60"/>
                  <TextBox x:Name="TPetTurns" Text="3" Width="56"/>
                  <CheckBox x:Name="CbPetFlee" Content="Bỏ chạy nếu không gặp pet cần bắt"
                            VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Classes="act" Content="BẮT ĐẦU BẮT PET" Width="180"
                          Background="{StaticResource Green}" IsEnabled="False"/>
                  <Button Classes="act" Content="DỪNG" Width="110"
                          Background="{StaticResource Red}" IsEnabled="False"/>
                </StackPanel>
                <TextBlock Text="Chưa nối backend — giao diện dựng trước để chốt bố cục."
                           Foreground="{StaticResource Dim}" FontSize="11"/>
              </StackPanel>
            </TabItem>

            <TabItem Header="AutoClick">
              <DockPanel Margin="2,10,2,2">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                  <TextBlock Text="Chế độ:" VerticalAlignment="Center"/>
                  <ComboBox Width="140"/>
                  <CheckBox Content="Lặp vô hạn" IsChecked="True" VerticalAlignment="Center"/>
                  <Button Content="CHẠY AUTOCLICK" Classes="tool"/>
                  <Button Content="DỪNG" Classes="tool"/>
                </StackPanel>
                <Grid ColumnDefinitions="*,12,260">
                  <HeaderedContentControl Grid.Column="0" Classes="group" Header="Kịch bản hiện tại" Margin="0">
                    <DockPanel>
                      <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="6"
                                  HorizontalAlignment="Center" Margin="0,6,0,0">
                        <Button Content="↑ Lên" Classes="tool"/>
                        <Button Content="↓ Xuống" Classes="tool"/>
                        <Button Content="✕ Xóa" Classes="tool"/>
                      </StackPanel>
                      <ListBox Background="{StaticResource Field}" BorderBrush="{StaticResource Border}" BorderThickness="1"/>
                    </DockPanel>
                  </HeaderedContentControl>
                  <HeaderedContentControl Grid.Column="2" Classes="group" Header="Thêm / Sửa" Margin="0">
                    <StackPanel Spacing="7">
                      <TextBlock Text="Loại"/><ComboBox HorizontalAlignment="Stretch"/>
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="X" VerticalAlignment="Center"/><TextBox Width="68"/>
                        <TextBlock Text="Y" VerticalAlignment="Center"/><TextBox Width="68"/>
                      </StackPanel>
                      <Button Content="Bắt tọa độ (F8)" Classes="tool" HorizontalAlignment="Stretch"/>
                      <TextBlock Text="*Trỏ chuột vào game và ấn F8" Foreground="{StaticResource Dim}" FontSize="11"/>
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="THÊM MỚI" Classes="tool"/>
                        <Button Content="CẬP NHẬT" Classes="tool"/>
                      </StackPanel>
                    </StackPanel>
                  </HeaderedContentControl>
                </Grid>
              </DockPanel>
            </TabItem>

          </TabControl>
        </DockPanel>
      </HeaderedContentControl>
    </Grid>


  </Grid>
</Window>
