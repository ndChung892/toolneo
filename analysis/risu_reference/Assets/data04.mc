    "T19.872.name": "Huyền Mục Khố",
    "T19.872.reqClass": "|2|",
    "T19.872.description": "Trang bị không những đẹp mà còn có sức phòng ngự\ntốt, đây là trang bị hiếm có\n",
    "T19.873.name": "Trục Nhật Khố",
    "T19.873.reqClass": "|2|",
    "T19.873.description": "Được làm từ da thần thú Trục Nhật, khó bị tổn hại\nbởi công kích thông thường\n",
    "T19.874.name": "Hạo Nguyệt Khố",
    "T19.874.reqClass": "|4|",
    "T19.874.description": "Tinh hoa lấy từ ánh trăng và huyền thiết đã làm\nnên trang bị này, giúp nâng khả năng phòng ngự vốn\ncó lên đẳng cấp mới\n",
    "T19.875.name": "Tụ Năng Khố",
    "T19.875.reqClass": "|4|",
    "T19.875.description": "Có khả năng hấp thu nguyên khí của trời đất, tuy\nchậm nhưng vẫn có ích cho người mặc\n",
    "T19.876.name": "Hậu Nghệ Khố",
    "T19.876.reqClass": "|4|",
    "T19.876.description": "Trang bị của đông phương tiên giới xạ thủ trong\ntruyền thuyết, thần lực vô song, với một mũi tên\ncó thể bắn hạ nhật nguyệt\n",
    "T19.877.name": "Hủy Diệt Khố",
    "T19.877.reqClass": "|4|",
    "T19.877.description": "Có thể huỷ diệt trời đất đồng thời khả năng phòng\nngự cao\n",
    "T19.878.name": "Trí Tuệ Khố",
    "T19.878.reqClass": "|3|",
    "T19.878.description": "Trang bị mà thánh hiền dùng để bảo vệ bản thân\n",
    "T19.879.name": "Cứu Thục Khố",
    "T19.879.reqClass": "|3|",
    "T19.879.description": "Trang bị phòng ngự tốt đối với pháp thuật ánh\nsáng, mạnh hơn cả trang bị của Long tộc\n",
    "T19.880.name": "Thánh Đồ Khố",
    "T19.880.reqClass": "|3|",
    "T19.880.description": "Người mặc trang bị này sẽ trở thành hoá thân của\nthiên sứ và sở hữu sức mạnh của thiên sứ\n",
    "T19.881.name": "Thiên Sứ Khố",
    "T19.881.reqClass": "|3|",
    "T19.881.description": "Trang bị của thiên sứ, hấp thu năng lượng có hại,\nsức phòng ngự kinh người\n",
    "T19.882.name": "Lỗ Mãng Khố",
    "T19.882.reqClass": "|6|",
    "T19.882.description": "Trang bị có sức phòng hộ cao làm từ vàng và tơ tằm\ncao cấp phù hợp cho người có địa vị cao và tài\ngiỏi\n",
    "T19.883.name": "Cuồng Bạo Khố",
    "T19.883.reqClass": "|6|",
    "T19.883.description": "Trang bị giúp người mặc đạt trạng thái cuồng bạo\nkhi chiến đấu, phòng ngự, sức mạnh và tốc độ đều\ntăng lên đáng kể\n",
    "T19.884.name": "Huyết Ẩm Khố",
    "T19.884.reqClass": "|6|",
    "T19.884.description": "Tương truyền là trang bị của một tướng quân đời\nxưa mặc tại chiến trường, mang lại hào lực và khả\nnăng chiến đấu vô hạn\n",
    "T19.885.name": "Mạt Nhật Khố",
    "T19.885.reqClass": "|6|",
    "T19.885.description": "Trang bị cổ xưa làm từ ô kim, ẩn chứa sức mạnh\nthần bí\n",
    "T19.886.name": "Chu Tước Khố",
    "T19.886.reqClass": "|5|",
    "T19.886.description": "Chu Tước còn được gọi là \"Huyền Điểu\", được coi là\nThần phương nam, trang bị này giúp người mặc may\nmắn, tăng cường sức mạnh\n",
    "T19.887.name": "Bạch Hổ Khố",
    "T19.887.reqClass": "|5|",
    "T19.887.description": "Bạch Hổ còn được gọi là \"Chiến Thần\", được coi là\nThần phương tây, trang bị này giúp người mặc may\nmắn, tăng cường sức mạnh\n",
    "T19.888.name": "Thanh Long Khố",
    "T19.888.reqClass": "|5|",
    "T19.888.description": "Còn gọi là \"Thương Long\", được coi là đông phương\nchi thần, tương truyền do thất túc phương đông hoá\nthành, trên có khắc pháp trận thất túc Thanh Long,\nkhiến người mặc được tăng cường sức mạnh\n",
    "T19.889.name": "Vô Úy Chiến Ngoa",
    "T19.889.reqClass": "|1|",
    "T19.889.description": "Tương truyền chỉ có các dũng sỹ của tộc Vô Ưu trải\nqua khảo nghiệm gian khổ mới được mang trang bị\nnày\n",
    "T19.890.name": "Nguyên Soái Chiến Ngoa",
    "T19.890.reqClass": "|1|",
    "T19.890.description": "Trang bị kế thừa từ các tướng lĩnh tử trận, tuy cũ\nnhưng khả năng phòng hộ khá cao\n",
    "T19.891.name": "Đế Vương Chiến Ngoa",
