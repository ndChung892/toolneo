    "T29.1320.name": "Mưu Kế Tình Yêu",
    "T29.1320.info": "Dùng tại mục Kỹ Năng Thú Cưng - Luyện Hóa",
    "T29.1320.description": "Sách kỹ năng thú cưng hệ Ác Ma trung cấp, chủ động - Ma pháp, tấn công ma pháp",
    "T29.1634.info": "Đạo cụ sự kiện",
