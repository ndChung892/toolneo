    "T29.2123.reqClass": "|2|",
    "T29.2123.description": "Kỹ năng pet dã thú cao cấp. Có xác suất lớn hấp\nthu sát thương ma pháp mỗi khi bị tấn công ma\npháp.",
    "T29.2124.name": "Cuồng Bạo Huyết",
    "T29.2124.info": "Dùng trong phần Luyện pet - Kỹ năng",
    "T29.2124.reqClass": "|2|",
    "T29.2124.description": "Kỹ năng pet dã thú cao cấp. Khi chiến đấu tùy\nthuộc vào trạng thái bản thân mà tăngmột ít sức\ntấn công vật lý. (Sức tấn công tăng có giới hạn)",
    "T29.2125.name": "Dã Thú Tâm",
    "T29.2125.info": "Dùng trong phần Luyện pet - Kỹ năng",
    "T29.2125.reqClass": "|2|",
    "T29.2125.description": "Kỹ năng pet dã thú cao cấp. Tăng vĩnh viễn tỷ lệ\nbỏ qua phòng ngự của mục tiêu đối với pet hệ dã\nthú",
    "T29.2126.name": "Thẻ Đổi Tên",
    "T29.2126.info": "Nhấp đôi sử dụng ,có cơ hội được đổi tên 1 lần",
    "T29.2126.reqClass": "|1|2|3|4|6|5|",
    "T29.2126.description": "Muốn thay tên đổi họ, hãy dùng thẻ này",
