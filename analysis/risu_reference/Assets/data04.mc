    "T12.2040.name": "Đại Ca Huyền Lâm",
    "T12.2041.name": "Đại Tỷ Lưu Hỏa",
    "T12.2042.name": "Marita【Quái Chính Hàng Lang Vô Tận AI1】",
    "T12.2042.msg": "Pháp lực của Barak đã bị ta phong ấn, muốn giết\nchết ta à? Các người có nghĩ đến hậu quả chưa?",
    "T12.2043.name": "Barak【Quái Phụ1 Hàng Lang Vô Tận AI1】",
    "T12.2043.msg": "Gruuuu! Giết chết Marita! Cứu ta! Ta sẽ cùng ngươi\nchiến đấu",
    "T12.2044.name": "Barak【Quái Phụ1 Hàng Lang Vô Tận AI1】|",
    "T12.2044.msg": "Chỉ cần ta phối hợp với Barak thì các người dù có\nliên thủ cũng không địch lại ta!",
    "T12.2045.name": "Halu【Tiểu Quái1 Hàng Lang Vô Tận AI1】",
    "T12.2045.msg": "Ta sẽ hút hết máu của ngươi là ngươi không còn khả\nnăng cứu chữa được nữa~",
    "T12.2046.name": "Oseen【Tiểu Quái2 Hàng Lang Vô Tận AI1】",
    "T12.2046.msg": "Cứ từ từ mà hưởng thụ nỗi đau không bằng chết!\nNhìn ngươi đau đớn thế này ta cảm thấy thật sảng\nkhoái",
    "T12.2047.name": "Gnaw【Quái Chính Hàng Lang Vô Tận AI2】",
    "T12.2047.msg": "Năng lượng ngày và đêm làm thân thể ta đao thương\nbất nhập. Nếu ngươi cả gan phá hoại, ta sẽ cho nếm\nmùi đau đớn khi bị phong ấn là như thế nào",
    "T12.2048.name": "Thủ Vệ Viêm Dương【Quái Phụ1 Hàng Lang Vô Tận AI2】",
    "T12.2048.msg": "Năng lượng đao làm thân thể không bao giờ bị tổn\nthương cả!",
    "T12.2049.name": "Thủ Vệ Băng Nguyệt【Quái Phụ2 Hàng Lang Vô Tận AI2】",
    "T12.2049.msg": "Năng lượng thuẫn làm thân thể không bao giờ bị tổn\nthương cả!",
    "T12.2050.name": "Dũng Sĩ Đao【Quái Phụ3 Hàng Lang Vô Tận AI2】",
    "T12.2050.msg": "Dùng mũi đao sắt nhọn này đưa vào cơ thể sẽ làm\nmất hết toàn bộ sức lực!",
    "T12.2051.name": "Dũng Sĩ Thuẫn【Quái Chính Hàng Lang Vô Tận AI2】",
    "T12.2051.msg": "Với cơ thể mạnh mẽ này, anh em ta sẽ không bị tổn\nthương!",
    "T12.2052.name": "Sứ Giả Phệ Hồn【Tiểu Quái1 Hàng Lang Vô Tận AI2】",
    "T12.2052.msg": "Không phải ngươi chết thì ta chết! Nếu ta sống sót\nthì ngươi coi chừng đấy!",
    "T12.2053.name": "Sứ Giả Tán Phách【Tiểu Quái2 Hàng Lang Vô Tận AI2】",
    "T12.2053.msg": "Dám lơ ta à? Hay là ngươi sợ ta đến phát khiếp\nluôn rồi? Haha!",
    "T12.2054.name": "Lucan【Quái Chính1-1 Hàng Lang Vô Tận AI3】",
    "T12.2054.msg": "Lucan, ta sắp không chịu nổi rồi! Hãy bảo vệ ta!",
    "T12.2055.name": "Lucan【Quái Chính1-2 Hàng Lang Vô Tận AI3】",
    "T12.2055.msg": "Ồ! Ngươi muốn giết chết ta à? Đừng hòng! Ta sẽ\nkhông khuất phục dưới tay ngươi!",
    "T12.2056.name": "Weken【Quái Chính2-1 Hàng Lang Vô Tận AI3】",
    "T12.2056.msg": "Buken, ta mà chết đi thì ngươi cũng suy yếu thôi!\nHãy bảo vệ ta cho tốt đi!",
    "T12.2057.name": "Weken【Quái Chính2-2 Hàng Lang Vô Tận AI3】",
    "T12.2057.msg": "Muốn thử kỹ năng áp chế không nào?",
    "T12.2058.name": "Lucan【Quái Chính3-1 Hàng Lang Vô Tận AI3】",
    "T12.2058.msg": "Weken, hãy khống chế bọn chúng! Không được để ta\nchết! Nếu không ngươi cũng không còn sức mạnh nữa!",
    "T12.2059.name": "Lucan【Quái Chính3-2 Hàng Lang Vô Tận AI3】",
    "T12.2059.msg": "Liken, ngươi đã áp chế được sức mạnh của ta, nhưng\nta sẽ truyền sức mạnh cho ngươi!",
    "T12.2060.name": "LiKen【Quái Chính4-1 Hàng Lang Vô Tận AI3】",
    "T12.2060.msg": "Lucan, đã đến lúc hồi máu cho ta, nếu ta chết thì\nsức mạnh ngươi cũng không còn",
    "T12.2061.name": "LiKen【Quái Chính4-2 Hàng Lang Vô Tận AI3】",
    "T12.2061.msg": "Weken, ngươi thật đáng chết! Nếu không bị ngươi áp\nchế thì một mình ta cũng đã thu phục được đám bọn\nchúng",
    "T12.2062.name": "Buken【Quái Chính5-1 Hàng Lang Vô Tận AI3】",
    "T12.2062.msg": "Ta mà hợp lực với Liken thì bọn ngươi sẽ sớm chầu\nông bà! Không tin thì cứ thử xem",
    "T12.2063.name": "Buken【Quái Chính5-2 Hàng Lang Vô Tận AI3】",
    "T12.2063.msg": "Ta đã khống chế sức mạnh của Lucan, tăng sức mạnh\ncho Liken nhưng vẫn không cứu sống nổi!",
    "T12.2065.name": "【Tiêu Trừ】Momo",
    "T12.2065.msg": "À há, ngươi dám đánh ta à?",
    "T12.2066.name": "【Tiêu Trừ】Loni",
    "T12.2066.msg": "À há, ngươi dám đánh ta à?",
    "T12.2067.name": "【Tiêu Trừ】Nhím Xanh",
