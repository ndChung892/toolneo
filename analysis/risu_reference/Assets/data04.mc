    "T19.1115.reqClassId": "|2|3|4|",
    "T19.1115.name": "Vĩnh Hằng Hạng Liên",
    "T19.1115.reqClass": "|1|2|3|4|5|6|",
    "T19.1115.description": "Thợ rèn giỏi nhất trên trái đất dùng tâm huyết cả\nđời chế tạo ra, mang đến sự sống bất tử cho người\nđeo\n",
    "T19.1116.reqClassId": "|1|5|6|",
    "T19.1116.name": "Hỗn Độn Hạng Liên",
    "T19.1116.reqClass": "|1|2|3|4|5|6|",
    "T19.1116.description": "Mang đến tinh lực vô hạn cho người đeo nhưng cũng\ngặm nhấm dần thần trí của họ, vì vậy chỉ người có\ný chí kiên cường mới đeo được\n",
    "T19.1117.reqClassId": "|2|3|4|",
    "T19.1117.name": "Vĩnh Hằng Giới Chỉ",
    "T19.1117.reqClass": "|1|2|3|4|5|6|",
    "T19.1117.description": "Thợ rèn giỏi nhất trên trái đất dùng tâm huyết cả\nđời chế tạo ra, mang đến sự sống bất tử cho người\nđeo\n",
    "T19.1118.reqClassId": "|1|5|6|",
