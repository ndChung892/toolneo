    "T29.2733.name": "Thịt",
    "T29.2733.reqClass": "|1|2|3|4|6|5|",
    "T29.2733.description": "Thịt ba chỉ với sự kết hợp của nạc và mỡ làm cho\nnhân bánh có vị béo đậm đà.",
    "T29.2734.name": "Đậu Xanh",
    "T29.2734.reqClass": "|1|2|3|4|6|5|",
    "T29.2734.description": "Loại đậu được trồng nhiều ở vùng đồi trung du Việt\nNam. Nguyên liệu không thể thiếu khi làm bánh.",
    "T29.2735.name": "Gạo Nếp",
    "T29.2735.reqClass": "|1|2|3|4|6|5|",
    "T29.2735.description": "Là gạo thu hoạch vụ mùa, hạt to, tròn và thơm dẻo.",
    "T29.2736.name": "Lá Dong",
    "T29.2736.reqClass": "|1|2|3|4|6|5|",
    "T29.2736.description": "Là loại dong rừng, to bản, đều nhau, không bị\nrách, có màu xanh mướt",
    "T29.2737.name": "Lạt Buộc",
    "T29.2737.reqClass": "|1|2|3|4|6|5|",
    "T29.2737.description": "Được làm từ ống cây giang. Lạt có thể được ngâm\nnước muối hay hấp cho mềm trước khi gói",
    "T29.2738.name": "Bánh Chưng",
    "T29.2738.reqClass": "|1|2|3|4|6|5|",
    "T29.2738.description": "Loại bánh Truyền Thống không thể thiếu trong Ngày\nTết của người Việt Nam. Tượng trưng cho Đất",
    "T29.2739.name": "Bánh Giầy",
    "T29.2739.reqClass": "|1|2|3|4|6|5|",
    "T29.2739.description": "Do hoàng tử Lang Liêu nghĩ ra, được dùng trong\nngày Tết chung với Bánh Chưng. Tượng trưng cho\nTrời",
    "T29.2740.name": "Bánh ngày Tết",
    "T29.2740.reqClass": "|1|2|3|4|6|5|",
    "T29.2740.description": "Gồm một cặp bánh Chưng, bánh Giầy. Tượng trưng cho\nĐất Trời hòa hợp",
    "T29.2741.name": "Bánh chữ Phúc",
    "T29.2741.reqClass": "|1|2|3|4|6|5|",
    "T29.2741.description": "Bánh được gói bằng giấy chữ Phúc. Dùng làm quà\ntặng trong dịp Tết",
    "T29.2742.name": "Bánh chữ Lộc",
    "T29.2742.reqClass": "|1|2|3|4|6|5|",
    "T29.2742.description": "Bánh được gói bằng giấy chữ Lộc. Dùng làm quà tặng\ntrong dịp Tết",
    "T29.2743.name": "Bánh chữ Thọ",
    "T29.2743.reqClass": "|1|2|3|4|6|5|",
    "T29.2743.description": "Bánh được gói bằng giấy chữ Thọ. Dùng làm quà tặng\ntrong dịp Tết",
    "T29.2744.name": "Mãng cầu",
    "T29.2744.reqClass": "|1|2|3|4|6|5|",
    "T29.2744.description": "Một loại quả không thể thiếu trong mâm Ngũ Quả",
    "T29.2745.name": "Dừa",
    "T29.2745.reqClass": "|1|2|3|4|6|5|",
    "T29.2745.description": "Một loại quả không thể thiếu trong mâm Ngũ Quả",
    "T29.2746.name": "Đu Đủ",
    "T29.2746.reqClass": "|1|2|3|4|6|5|",
    "T29.2746.description": "Một loại quả không thể thiếu trong mâm Ngũ Quả",
    "T29.2747.name": "Xoài",
    "T29.2747.reqClass": "|1|2|3|4|6|5|",
    "T29.2747.description": "Một loại quả không thể thiếu trong mâm Ngũ Quả",
    "T29.2748.name": "Sung",
    "T29.2748.reqClass": "|1|2|3|4|6|5|",
    "T29.2748.description": "Một loại quả không thể thiếu trong mâm Ngũ Quả",
    "T29.2749.name": "Mâm Ngũ Quả",
    "T29.2749.reqClass": "|1|2|3|4|6|5|",
    "T29.2749.description": "Là một mâm trái cây gồm 5 loại trái cây khác nhau.\nCác loại trái cây bày lên thể hiện nguyện ước của\ngia chủ qua tên gọi, màu sắc và cách sắp xếp",
    "T29.2750.name": "Ngũ Quả Phúc",
    "T29.2750.reqClass": "|1|2|3|4|6|5|",
    "T29.2750.description": "Mâm ngũ quả được gói bằng giấy chữ Phúc",
    "T29.2751.name": "Ngũ Quả Lộc",
    "T29.2751.reqClass": "|1|2|3|4|6|5|",
    "T29.2751.description": "Mâm ngũ quả được gói bằng giấy chữ Lộc",
    "T29.2752.name": "Ngũ Quả Thọ",
    "T29.2752.reqClass": "|1|2|3|4|6|5|",
    "T29.2752.description": "Mâm ngũ quả được gói bằng giấy chữ Thọ",
    "T29.2753.name": "Hoa Mai",
    "T29.2753.reqClass": "|1|2|3|4|6|5|",
    "T29.2753.description": "Hoa màu vàng tươi, tượng trưng cho sự phú quý,giàu\nsang. Không thể thiếu trong các gia đình mỗi dịp\nXuân về.",
    "T29.2754.name": "Hoa Đào",
    "T29.2754.reqClass": "|1|2|3|4|6|5|",
    "T29.2754.description": "Hoa màu đỏ thắm, tượng trưng cho sự an khang sung\ntúc. Dùng để trang trí trong dịp Tết.",
    "T29.2755.name": "Cây Quất",
    "T29.2755.reqClass": "|1|2|3|4|6|5|",
    "T29.2755.description": "Cây có nhiều kiểu dáng cầu kỳ, cành lá xum xuê,\nquả vàng chi chít thể hiện sự trù phú, hứa hẹn\nnămmới được mùa, ăn nên làm ra, dồi dào sức sống",
    "T29.2756.name": "Hoa ngày Tết",
    "T29.2756.reqClass": "|1|2|3|4|6|5|",
    "T29.2756.description": "Hoa trang trí làm cho ngày Tết trở nên đẹp, ấm\ncúng và nhiều ý nghĩa hơn",
    "T29.2757.name": "Hoa Phúc",
    "T29.2757.reqClass": "|1|2|3|4|6|5|",
    "T29.2757.description": "Hoa trang trí ngày Tết. Trên cành được treo nhiều\ngiấy chữ Phúc rất đẹp",
    "T29.2758.name": "Hoa Lộc",
    "T29.2758.reqClass": "|1|2|3|4|6|5|",
    "T29.2758.description": "Hoa trang trí ngày Tết. Trên cành được treo nhiều\ngiấy chữ Lộc rất đẹp",
    "T29.2759.name": "Hoa Thọ",
    "T29.2759.reqClass": "|1|2|3|4|6|5|",
    "T29.2759.description": "Hoa trang trí ngày Tết. Trên cành được treo nhiều\ngiấy chữ Thọ rất đẹp",
    "T29.2760.name": "Bao lì xì đỏ",
    "T29.2760.reqClass": "|1|2|3|4|6|5|",
    "T29.2760.description": "Bao lì xì màu đỏ rất đẹp, được dùng nhiều trong\ndịp Tết. Cả người lớn và trẻ em đều thích",
    "T29.2761.name": "Bao lì xì Phúc",
    "T29.2761.reqClass": "|1|2|3|4|6|5|",
    "T29.2761.description": "Bao lì xì tượng trưng cho sự may mắn, hạnh phúc",
    "T29.2762.name": "Bao lì xì Lộc",
    "T29.2762.reqClass": "|1|2|3|4|6|5|",
    "T29.2762.description": "Bao lì xì tượng trưng cho sự phú quý giàu sang",
    "T29.2763.name": "Bao lì xì Thọ",
    "T29.2763.reqClass": "|1|2|3|4|6|5|",
    "T29.2763.description": "Bao lì xì tượng trưng cho sự bền vững, dài lâu",
    "T29.2764.name": "Huy Chương An Khang Thịnh Vượng",
    "T29.2764.info": "Vật phẩm ma pháp, vui lòng nhấp đôi để sử dụng",
    "T29.2764.reqClass": "|1|2|5|3|6|4|",
