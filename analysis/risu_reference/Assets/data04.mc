    "T52.3304.codeName": "SKILL463001",
    "T52.3304.name": "Tâm Tâm Tương Ấn",
    "T52.3304.reqClass": "|1|2|3|4|5|6|",
    "T52.3304.description": "Gia tăng tất cả điểm tấn công và \n phòng ngự của bạn đời mức độ \n gia tăng phụ thuộc độ thân mật \n giữa hai người\n",
    "T52.3305.codeName": "SKILL463101",
    "T52.3305.name": "Đồng Khí Liên Chi",
    "T52.3305.reqClass": "|1|2|3|4|5|6|",
    "T52.3305.description": "Khôi phục HP của người yêu trong lúc chiến đấu, \n lượng HP khôi phục bằng 10% giới hạn HP của \n mục tiêu cộng thêm hiệu quả của độ thân mật, \n có thể thăng cấp kỹ năng bằng cách lập nhóm \n với người yêu rồi đến Anh Vũ Cảnh gặp Cupid.",
    "T52.3306.codeName": "SKILL463201",
    "T52.3306.name": "Thiên Trường Địa Cửu",
    "T52.3306.reqClass": "|1|2|3|4|5|6|",
    "T52.3306.description": "Hồi sinh mục tiêu, và hồi phục 1 \n lượng HP，mức độ hồi phục phụ thuộc \n độ thân mật giữa hai người",
    "T52.3307.codeName": "SKILL463301",
    "T52.3307.name": "Ác Ma Chi Kích",
    "T52.3307.reqClass": "|100|",
    "T52.3307.description": "Khi bị con cá của tiểu ác ma \n bắn vào thì sẽ trở nên rất \n dễ ghét, thường xuyên nhận được thẻ \n người tốt khiến trái tim sẽ thường \n xuyên bị tổn thương\n",
    "T52.3307.creKind": "5|2",
    "T52.3308.codeName": "SKILL463401",
    "T52.3308.name": "Tình Yêu Ngụy Kế",
    "T52.3308.reqClass": "|100|",
    "T52.3308.description": "Tiểu ác ma rất thích làm nên cạm \n bẫy tình yêu, cảnh con người đau \n đớn vì tình là niềm vui của hắn\n",
    "T52.3308.creKind": "5|2",
    "T52.3309.codeName": "SKILL463501",
    "T52.3309.name": "Mũi Tên Cupid",
    "T52.3309.reqClass": "|100|",
    "T52.3309.description": "Khi bị bắn bởi mũi tên của thần \n Cupid sẽ được nhiều người yêu say \n đắm và bị choáng bởi hàng ngàn \n cuộc hẹn của tình yêu.",
    "T52.3309.creKind": "5|2",
