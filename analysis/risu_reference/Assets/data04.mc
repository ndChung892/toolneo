    "T19.2135.name": "Kim Qua Giới Chỉ",
    "T19.2135.reqClass": "|1|2|3|4|5|6|",
    "T19.2135.description": "Giới Chỉ được các chiến thần chúc phúc, \ntuy mộc mạc bình dị nhưng uy lực vô song",
    "T19.2136.reqClassId": "|2|3|4|",
    "T19.2136.name": "Đạt Nhân Hạng Liên",
    "T19.2136.reqClass": "|1|2|3|4|5|6|",
    "T19.2136.description": "Trang bị chỉ dành tặng cho người có \ncống hiến lớn cho Đại Lục Vô Ưu",
    "T19.2137.reqClassId": "|2|3|4|",
    "T19.2137.name": "Đạt Nhân Giới Chỉ",
    "T19.2137.reqClass": "|1|2|3|4|5|6|",
    "T19.2137.description": "Trang bị chỉ dành tặng cho người có \ncống hiến lớn cho Đại Lục Vô Ưu",
    "T19.2138.reqClassId": "|1|5|6|",
    "T19.2138.name": "Tử Sính Ngọc",
    "T19.2138.reqClass": "|1|2|3|4|5|6|",
    "T19.2138.description": "Một loại ngọc thần bí của Đại Lục Vô Ưu, \nvô hình vô ảnh, nhưng dưới ánh mặt trời \nsẽ óng ánh màu tím khói",
    "T19.2139.reqClassId": "|2|3|4|",
    "T19.2139.name": "Xích Hồn Thạch",
    "T19.2139.reqClass": "|1|2|3|4|5|6|",
    "T19.2139.description": "Tinh thạch được ngưng tụ từ các tinh hồn\nkhiếm khuyết của chiến trường thượng cổ, \ncó thể tăng sức mạnh và ý chí",
    "T19.2140.reqClassId": "|2|3|4|",
    "T19.2140.name": "Nghi Ngọc",
    "T19.2140.reqClass": "|1|2|3|4|5|6|",
    "T19.2140.description": "Sở hữu khí chất mê huyễn, \nhấp dẫn mọi ánh nhình, \nlàm người khác rơi vào không gian \nảo mộng, si mê đắm đuối",
    "T19.2141.reqClassId": "|1|5|6|",
    "T19.2141.name": "Huyết Xương",
    "T19.2141.reqClass": "|1|2|3|4|5|6|",
    "T19.2141.description": "Màu đỏ sáng chói, lấp lánh khi \ncó ánh sáng rọi vào, có thể khiến \ncho máu huyết sôi trào, \nbộc phát sức mạnh vô hạn",
    "T19.2142.name": "Ung Kim Chiến Chùy",
    "T19.2142.reqClass": "|1|",
    "T19.2142.description": "Được tạo thành từ vỏ kim loại hiếm có \nở Đại Lục Vô Ưu, mỗi búa giáng xuống đều \ncó hào quang, làm người khác khiếp vía",
    "T19.2143.name": "Bi Nộ Quyền Trượng",
    "T19.2143.reqClass": "|3|",
    "T19.2143.description": "Mạc bi vưu thị từ trung quả, \nmạc nộ tâm khoan hóa can qua, \nvốn là 1 bộ phận của Thiên Ma Châu, \nbị tịnh hóa sau ban cho người ưu tú \ncủa Đông Huyền chữa trị cứu người",
    "T19.2144.name": "Tụ Biến S49",
    "T19.2144.reqClass": "|4|",
    "T19.2144.description": "Sản phẩm công nghệ cao Đông Huyền, \nlợi dụng năng lượng cực lớn từ tụ biến \nnguyên tố, một khi phóng ta, thiên địa \nbiến sắc, thăng cấp từ bản s39",
    "T19.2145.name": "Đoạn Hồn Kiếm",
    "T19.2145.reqClass": "|6|",
    "T19.2145.description": "Tà khí thần đệ phương đông cổ xưa \ntrong chiến trường viễn cổ kết hợp cùng\n\nma binh thiết luyện trong 9 cõi u minh, \nmột kiếm mất đoạt hồn, \ngiết địch vô hình. \nĐây chỉ là mảnh vỡ của thanh kiếm đó",
    "T19.2146.name": "Cửu Tiêu Hoàn Bội Cầm",
    "T19.2146.reqClass": "|2|",
    "T19.2146.description": "Hình thành từ thời Phục Hy, làm từ gỗ sam, \nmặt như tùng hoàng nhưng mặt cầm thì thô cổ. \nÂm sắc thương cổ như đại thánh di âm",
    "T19.2147.name": "Lăng Thiên Chiến Trượng",
    "T19.2147.reqClass": "|5|",
    "T19.2147.description": "Gậy tự nhiên luyện từ các thợ rèn ưu tú Đông\nHuyền,\nngắn gọn mà không mất bá khí, \ncó năng lượng lăng không liệt thiên",
    "T19.2148.name": "Phục Thù Mâu",
    "T19.2148.reqClass": "|1|",
    "T19.2148.description": "Vũ khí báo thù của các thiên sứ, \nchế tạo từ những trận pháp phức tạp, \ngiúp bảo hộ người mang theo \nvà giữ tín niệm bất bại",
    "T19.2149.name": "Tổ Tiên Trượng",
    "T19.2149.reqClass": "|3|",
    "T19.2149.description": "Dấu tích tổ tiên để lại, mỗi lần nhắc lại \nlàm người như dục quang huy, \nbất đồng cảm thụ",
    "T19.2150.name": "Súng Ác Ma",
    "T19.2150.reqClass": "|4|",
    "T19.2150.description": "Vì sao và thiên thạch lướt qua mặt đất \nđể lại dấu tích sức mạnh vũ trụ",
    "T19.2151.name": "Đoạt Linh Chủy Thủ",
    "T19.2151.reqClass": "|6|",
    "T19.2151.description": "Chủy thủ chuyên dùng ám sát, \nkiểu dáng cổ xưa, nhưng tựa hồ \nẩn chứa sức mạnh cực lớn",
    "T19.2152.name": "Đoạn Văn Cầm Cung",
    "T19.2152.reqClass": "|2|",
    "T19.2152.description": "Không biết làm từ nguyên liệu gì, \ncầm cung bể thành nhiều đoạn \nchứng tỏ niên đại cũng đã lâu, \nđường vân luôn tỏa ra năng lượng khiếp người",
    "T19.2153.name": "Thích Chùy",
    "T19.2153.reqClass": "|5|",
    "T19.2153.description": "Đẹp động lòng người, uyển chuyển như hà",
