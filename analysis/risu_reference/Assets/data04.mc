    "T29.204.name": "Thuốc Trị Liệu",
    "T29.204.description": "Đây là loại thuốc trị thương cực tốt do bác sĩ Đắc\nKỷ của thành Tiên Lạp phát minh ra\n",
    "T29.205.name": "Thư Kỳ Quái",
    "T29.205.description": "Lá thư rất kỳ lạ, không có chữ ký\n",
    "T29.206.name": "Mật Thư Thông Địch",
    "T29.206.description": "Lá thư thuộc hạ Băng Cung bí mật liên kết với kẻ\nđịch\n",
    "T29.207.name": "Danh Sách Phản Nghịch",
    "T29.207.description": "Danh sách ghi tên những kẻ phản nghịch trong Băng\nCung\n",
    "T29.208.name": "Lệnh Bài Thông Hành",
    "T29.208.description": "Đây là giấy thông hành cần thiết để vào Băng Cung\n",
    "T29.209.name": "Cổ Trùng",
    "T29.209.description": "Một loại trùng độc\n",
    "T29.210.name": "Huy Chương Tiêu Dao Ẩn Sĩ",
    "T29.210.info": "Nhấp đôi nhận được danh hiệu",
