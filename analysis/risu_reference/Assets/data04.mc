    "T29.1911.description": "Bản đồ du lịch của Nghệ Nhân Lữ Hành, cách đây\nkhông lâu đã bị Hải Dương Thị Nữ cướp đi mất.\n",
    "T29.1912.name": "Sổ Cũ Nát",
    "T29.1912.reqClass": "|1|2|3|4|6|5|",
    "T29.1912.description": "Sổ rơi ra từ người Bối Long, trông có vẻ cũ nát.\n",
