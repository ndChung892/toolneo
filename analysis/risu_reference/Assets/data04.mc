    "T45.5289.info": "Bắt 1 Điêu Linh Danh Y giao cho Tôn Lệ ở tiệm pet\nĐông Huyền Thành.",
    "T45.5289.reqClass": "all",
    "T45.5289.subType": "9-14",
    "T45.5289.startText": "Tiệm pet gần đây nhận được vô số đơn đặt hàng, hãy\nmau giúp bắt các loại pet đang hot nào!",
