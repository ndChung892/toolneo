    "T12.1892.name": "Thủ Vệ【Sổ Tay Ma Thú】",
    "T12.1893.name": "Thất Sắc Kê【Sổ Tay Ma Thú】",
    "T12.1893.msg": "Thịt em ăn không ngon, các anh chị đừng chọn em\nđược không?|Em chỉ là con gà nhỏ, muốn bay cao\ncũng bay không nổi.",
    "T12.1894.name": "Thỏ Điên Răng Vổ【Sổ Tay Ma Thú】",
    "T12.1894.msg": "Kẻ nào dám động đến ta hả? Có biết ta là anh của\nThỏ Đại Ca không?",
    "T12.1895.name": "Trưởng Lão Sơn Quái【Sổ Tay Ma Thú】",
    "T12.1895.msg": "Phải tôn trọng người già, biết không?",
    "T12.1896.name": "Ma Vương Bát Giác【Sổ Tay Ma Thú】",
    "T12.1896.msg": "Người chỉ có 2 chân, đánh không lại 8 chân như của\nta đâu.",
    "T12.1897.name": "Quân Sư Cẩu Đầu【Sổ Tay Ma Thú】",
    "T12.1897.msg": "Để ta suy nghĩ xem sẽ khiến người chết như thế\nnào.",
    "T12.1898.name": "Ốc Giáo Quan【Sổ Tay Ma Thú】",
    "T12.1898.msg": "Mọi người đi theo ta, cùng nhau đối phó thằng… đối\ndiện.",
    "T12.1899.name": "Cổ Thụ Lão Yêu【Sổ Tay Ma Thú】",
    "T12.1899.msg": "Ta đã sống… rất nhiều năm rồi.",
    "T12.1900.name": "Gấu Tuyết Tàn Bạo【Sổ Tay Ma Thú】",
    "T12.1900.msg": "Hừm… um… món ăn trưa không tệ lắm.",
    "T12.1901.name": "Chiến Thần Sói【Sổ Tay Ma Thú】",
    "T12.1901.msg": "Ây da, thị lực không tốt sợ giết nhầm quá!|Nhưng\nmà giết nhầm còn hơn bỏ sót! Giết sạch giết sạch\ncho ta.",
    "T12.1902.name": "Gấu Đen【Sổ Tay Ma Thú】",
    "T12.1902.msg": "Xem ra thịt ngươi ngon hơn mật ong.",
    "T12.1903.name": "Miêu Vương【Sổ Tay Ma Thú】",
    "T12.1903.msg": "Đưa cặp kính cho Đại Vương nào.",
    "T12.1904.name": "Nấm Yêu Huyết Hồng【Sổ Tay Ma Thú】",
    "T12.1904.msg": "Hình như ta bị sốt rồi, toàn thân nóng bừng!",
    "T12.1905.name": "Dạ Xoa Vương【Sổ Tay Ma Thú】",
    "T12.1905.msg": "Không giúp ta thì đêm nay ta không cho ngủ yên\nđâu…",
    "T12.1906.name": "Hấp Huyết Hoa Yêu【Sổ Tay Ma Thú】",
    "T12.1906.msg": "Ăn mật hoa mãi ngán quá, ta thèm hút máu lắm rồi!",
    "T12.1907.name": "Bọt Thủy Tinh【Sổ Tay Ma Thú】",
    "T12.1907.msg": "Ta là Bọt Thủy Tinh không phải là Thủy Lam Bọt, nó\nlà em trai của ta đừng nhận nhầm nhé.",
    "T12.1908.name": "Cự Nhân Ma【Sổ Tay Ma Thú】",
    "T12.1908.msg": "Có bao giờ thấy người khổng lồ đẹp trai như ta\nchưa?",
    "T12.1909.name": "Hải Tinh Phệ Hồn【Sổ Tay Ma Thú】",
    "T12.1909.msg": "Hãy giao nộp linh hồn các ngươi cho ta, ta sẽ giúp\ncác ngươi hồi sinh!",
    "T12.1910.name": "Ác Ma Thượng Cổ【Sổ Tay Ma Thú】",
    "T12.1910.msg": "Lalala, ta là một tiểu ác ma… lương thiện ~~",
    "T12.1911.name": "Ong Cửu Li Kịch Độc【Sổ Tay Ma Thú】",
    "T12.1911.msg": "Sao lại dám xem ta là cùng một bọn với lũ ong mật\nvô dụng kia chứ?",
    "T12.1912.name": "Cuồng Bạo Thần Tử【Sổ Tay Ma Thú】",
    "T12.1912.msg": "Ai cản ta là ta đánh hết!",
    "T12.1913.name": "Ác Hổ Ma Giới【Sổ Tay Ma Thú】",
    "T12.1913.msg": "Hmm, đừng có thấy ta nhỏ mà xem thường. Lúc ta\ntung hoành Địa phủ thì ngươi vẫn chưa ra đời đâu!",
    "T12.1914.name": "Băng Cung Chiến Thần【Sổ Tay Ma Thú】",
    "T12.1914.msg": "Ta lấy danh nghĩa Nữ thần băng tuyết thề đuổi hết\ntất cả kẻ xâm nhập ra khỏi đây.",
    "T12.1915.name": "Quỷ Vương【Sổ Tay Ma Thú】",
    "T12.1915.msg": "Loại bỏ tất cả kẻ yếu!|Ta sẽ trở nên mạnh mẽ!",
    "T12.1916.name": "Linh Hồn Danh Y【Sổ Tay Ma Thú】",
    "T12.1916.msg": "Ta là ma nhân hậu.|Đừng khống chế ta nhé!",
    "T12.1917.name": "Linh Hồn Ẩn Giả【Sổ Tay Ma Thú】",
    "T12.1917.msg": "...|Hút cho ngươi khô luôn!",
    "T12.1918.name": "Linh Hồn Nhạc Công【Sổ Tay Ma Thú】",
    "T12.1918.msg": "Sợ chưa, ta là ma sắp thành thần đấy!",
