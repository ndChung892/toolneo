    "T19.1236.reqClassId": "|2|3|4|",
    "T19.1236.name": "Nghịch Ma Hạng Liên",
    "T19.1236.reqClass": "|1|2|3|4|5|6|",
    "T19.1236.description": "Đeo lên người sẽ có sức mạnh của yêu ma,uy lực vô\nsong. Người có ý chí không kiênđịnh sẽ dễ dàng bị\nyêu ma khống chế\n",
    "T19.1237.reqClassId": "|1|5|6|",
    "T19.1237.name": "Hổ Uy Hạng Liên",
    "T19.1237.reqClass": "|1|2|3|4|5|6|",
    "T19.1237.description": "Hổ trên núi thật oai phong biết bao, vừamạnh mẽ\nlại vừa hung tơn, nếu không tinthì thử đi vuốt râu\nhùm mà xem.\n",
    "T19.1238.reqClassId": "|2|3|4|",
    "T19.1238.name": "Nghịch Ma Giới Chỉ",
    "T19.1238.reqClass": "|1|2|3|4|5|6|",
    "T19.1238.description": "Đeo lên người sẽ có sức mạnh của yêu ma,uy lực vô\nsong. Người có ý chí không kiênđịnh sẽ dễ dàng bị\nyêu ma khống chế\n",
    "T19.1239.reqClassId": "|1|5|6|",
    "T19.1239.name": "Hổ Uy Giới Chỉ",
    "T19.1239.reqClass": "|1|2|3|4|5|6|",
    "T19.1239.description": "Hổ trên núi thật oai phong biết bao, vừamạnh mẽ\nlại vừa hung tơn, nếu không tinthì thử đi vuốt râu\nhùm mà xem.\n",
    "T19.1240.reqClassId": "|2|3|4|",
    "T19.1240.name": "Phỉ Thúy",
    "T19.1240.reqClass": "|1|2|3|4|5|6|",
    "T19.1240.description": "Phỉ thúy là loại ngọc quý giá vô cùng, chínhvì thế\nsức tấn công của nó cũng không thểxem nhẹ.\n",
    "T19.1241.reqClassId": "|1|5|6|",
    "T19.1241.name": "Bạch Ngọc Tinh",
    "T19.1241.reqClass": "|1|2|3|4|5|6|",
    "T19.1241.description": "Tinh tú trên trời khó có được do ở quá xa,bạch\nngọc hiếm thấy vì quá khó gọt giũa.Nếu kết hợp\nđược 2 vật này thì quả thật là thần diệu!\n",
    "T19.1242.reqClassId": "|2|3|4|",
    "T19.1242.name": "Hắc Thủy Tinh",
    "T19.1242.reqClass": "|1|2|3|4|5|6|",
    "T19.1242.description": "Đeo hắc thủy tinh lên người sẽ có thể giảitrừ tà\nkhí trên người, nâng năng lực bản thânlên đến cực\nhạn. Tránh tà hóa hung, hấp thuô uế, là một hộ phù\nhữu hiệu\n",
    "T19.1243.reqClassId": "|1|5|6|",
    "T19.1243.name": "Huyền Thiên",
    "T19.1243.reqClass": "|1|2|3|4|5|6|",
    "T19.1243.description": "Được tạo thành từ kim loại ngưng kết đầutiên vào\nthời kỳ hỗn mang của đại lục, luồng khí thần kỳ\nliên tục tỏa ra.\n",
    "T19.1254.name": "Thảm Ma Pháp (Tân Thủ)",
    "T19.1254.reqClass": "|1|2|3|4|5|6|",
    "T19.1254.description": "Thảm bay thần kỳ trong truyền thuyết.\n",
    "T19.1255.name": "Sừng Thùy Vân",
    "T19.1255.reqClass": "|1|2|3|4|5|6|",
    "T19.1255.description": "Trang bị nhân tạo dành cho pet Đông Huyền,\nxung quanh bao bọc bởi đám mây điện tích\nlàm nhụt chí kẻ thù.\n",
    "T19.1256.name": "Sừng Thanh Hà",
    "T19.1256.reqClass": "|1|2|3|4|5|6|",
    "T19.1256.description": "Trang bị có hình dạng biến hóa khôn lường,\nphát ra ánh sáng đỏ, chế tạo bởi Tinh Linh\nQuân Cổ Đạo, mang đầy sức mạnh tự nhiên.\n",
    "T19.1257.name": "Sừng Hàn Băng",
    "T19.1257.reqClass": "|1|2|3|4|5|6|",
    "T19.1257.description": "Thần khí làm từ hàn băng vạn năm ở Lạp\nTuyết Địa, vừa sắc bén lại vừa tỏa ra hơi\nlạnh khiến kẻ thù run rẩy.\n",
    "T19.1258.name": "Sừng Mị Ảnh",
    "T19.1258.reqClass": "|1|2|3|4|5|6|",
    "T19.1258.description": "Trang bị khiến cho pet hóa thành 1 quái vật\nđịa ngục, sức nóng từ diệm hỏa trên trang\nbị có khả năng thiêu cháy mọi vật xung quanh.\n",
    "T19.1259.name": "Sừng Thiên Cang",
    "T19.1259.reqClass": "|1|2|3|4|5|6|",
    "T19.1259.description": "Trang bị thần bí không rõ nguồn gốc, được\nlàm từ 1 loại vật liệu của nền văn minh cổ đại,\nđộ cứng của nó có thể ngăn chặn mọi vũ khí.\n",
    "T19.1260.name": "Chuông Thùy Vân",
    "T19.1260.reqClass": "|1|2|3|4|5|6|",
    "T19.1260.description": "Trang bị nhân tạo dành cho pet Đông Huyền,\nxung quanh bao bọc bởi đám mây điện tích\ncó tác dụng bảo vệ.\n",
    "T19.1261.name": "Chuông Thanh Hà",
    "T19.1261.reqClass": "|1|2|3|4|5|6|",
    "T19.1261.description": "Trang bị có hình dạng biến hóa khôn lường,\nphát ra ánh sáng đỏ, chế tạo bởi Tinh Linh\nQuân Cổ Đạo, mang đầy sức mạnh tự nhiên.\n",
    "T19.1262.name": "Chuông Hàn Băng",
