    "T35.1182.scriptOff": "var script_expNumScp = 0.7;var script_MemberNum =\nGroup.getMemberNum(c) ;var script_num =\nadd(script_expNumScp, script_MemberNum*0.1,\nMath.random()*0.1);var script_index = 0; var\nscript_node = null;var script_arr = [];var\nspript_loot = rand3(1, 100);if( c\n){\tif(c.inGroup()) \t{\t\tscript_node =\nc.memberList.head;\t}\telse \t{\t\tscript_node =\n{};\t\tscript_node.obj =\nc.data.id;\t}\twhile(script_node != null)\t{\t\tvar\nspt_player = getCharactor( script_node.obj\n);\t\taddCharSpirituality(script_node.obj,\nscript_num*BASIC_SPIRITUALITY_MAP[spt_player.level]\n);\t\tvar script_level=spt_player.level;\t\tvar\nscript_midObj = 339;\n\t\tif(script_level>=80)\t\t{\t\t\tif(inRate(8))\t\t\t{\t\t\t\t_addMedalInBag(spt_player.data.id,script_midObj\n, true);\t\t\t}\t\t}\t\tscript_arr[script_index] =\nscript_node.obj;\t\tscript_index ++;\t\tscript_node =\nscript_node.next;\t}\t/*trace(\"@@@@@@@@@@@@@\");\ttrace(\"spript_loot\n=\n\"+spript_loot);\ttrace(\"@@@@@@@@@@@@@\");*/\tif(spript_loot\n< 5)\t{\t\tvar script_obj =\ngetPlanByRate(\"4-43\");\t\tvar script_rand = rand3(0,\nscript_arr.length -\n1);\t\tif(script_obj)\t\t{\t\t\taddItemByPlan(script_arr[script_rand],\nscript_obj,\n0);\t\t}\t}\tif(!d[33][27].script_chenshuiNum)\t{\t\nd[33][27].script_chenshuiNum = 1;\t}\telse\t{\t\nd[33][27].script_chenshuiNum\n++;\t}\tif(d[33][27].script_chenshuiNum > 20)\t{\t\tvar\nscript_line = c.line +\n1;\t\taddMultiNpcIns(1183,27,1,15);\t\tsystemMidMsgBroadcast(Lang.NPC_ScriptOff2.replace(\"{channel}\",script_line));\t\td[33][27].script_chenshuiNum\n= 0 ;\t}}",
