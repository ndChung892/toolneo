    "T19.1118.reqClass": "|1|2|3|4|5|6|",
    "T19.1118.description": "Mang đến tinh lực vô hạn cho người đeo nhưng cũng\ngặm nhấm dần thần trí của họ, vì vậy chỉ người có\ný chí kiên cường mới đeo được\n",
    "T19.1119.reqClassId": "|2|3|4|",
    "T19.1119.name": "Vương Giả Ấn",
    "T19.1119.reqClass": "|1|2|3|4|5|6|",
    "T19.1119.description": "Tương truyền có vị Vương giả đã ngủ quên trong đó,\nkhi dùng máu tươi để thức tỉnh, có thể mang đến\nthắng lợi\n",
    "T19.1120.reqClassId": "|1|5|6|",
    "T19.1120.name": "Long Tường Bội",
    "T19.1120.reqClass": "|1|2|3|4|5|6|",
    "T19.1120.description": "Vật báu có hình rồng bay lượn, có thể tăng cường\nsức mạnh, tượng trưng cho thân phận và địa vị\n",
    "T19.1121.reqClassId": "|2|3|4|",
    "T19.1121.name": "Lạc Dương Ấn",
    "T19.1121.reqClass": "|1|2|3|4|5|6|",
    "T19.1121.description": "Được chế tạo từ đoản kiếm của chiến sĩ và máu của\nanh hùng, ấn chương này chứa đựng dũng khí vô hạn\nmà nhân loại vốn có\n",
    "T19.1122.reqClassId": "|1|5|6|",
    "T19.1122.name": "Lưỡng Nghi Bảo Thạch",
    "T19.1122.reqClass": "|1|2|3|4|5|6|",
    "T19.1122.description": "Bảo vật thần kỳ, chỉ có người phi thường mới nắm\ngiữ được\n",
    "T19.1123.name": "Thu Thập Hộ Thủ Tân Thủ",
    "T19.1123.reqClass": "|1|2|3|4|5|6|",
    "T19.1123.description": "Găng tay cấp thấp, người chơi từ cấp 20 trở lên\nthì có thể sử dụng, hiệu suất thu thập trung bình\n",
    "T19.1124.name": "Thu Thập Hộ Thủ Trung Cấp",
    "T19.1124.reqClass": "|1|2|3|4|5|6|",
    "T19.1124.description": "Găng tay trung cấp, người chơi từ cấp 60 trở lên\nmới có thể sử dụng, hiệu suất thu thập cao hơn\n",
    "T19.1125.name": "Thu Thập Hộ Thủ Cao Cấp",
    "T19.1125.reqClass": "|1|2|3|4|5|6|",
    "T19.1125.description": "Găng tay cao cấp, người chơi từ cấp 80 trở lên mới\ncó thể sử dụng, hiệu suất thu thập cao hơn nhiều\nso với thu thập Hộ Thủ Trung Cấp\n",
    "T19.1126.name": "Thu Thập Hộ Thủ Đặc Cấp",
    "T19.1126.reqClass": "|1|2|3|4|5|6|",
    "T19.1126.description": "Găng tay đặc biệt, người chơi từ cấp 100 trở lên\nmới có thể sử dụng, hiệu suất thu thập thành công\nrất cao, thời gian thu thập cũng rút ngắn hơn\nnhiều\n",
    "T19.1127.name": "Thu Thập Hộ Thủ VIP",
    "T19.1127.reqClass": "|1|2|3|4|5|6|",
    "T19.1127.description": "Găng tay thu thập thần kỳ, hiệu suất thu thập vô\ncùng cao, không bao giờ thất bại, người chơi VIP\ntừ cấp 30 trở lên mới có thể sử dụng\n",
    "T19.1128.name": "Bạch Kim Giới Chỉ",
    "T19.1128.reqClass": "|1|2|3|4|5|6|",
    "T19.1128.description": "Mang đến cho người sử dụng sinhlực mạnh mẽ, nhưng\ncũng xâm chiếmthần trí của họ, chỉ có những\nngườithật sự kiên cường mới có thể đeo.\n",
    "T19.1129.name": "Bạc Kim Giới Chỉ",
    "T19.1129.reqClass": "|1|2|3|4|5|6|",
    "T19.1129.description": "Mang đến cho người sử dụng sinhlực mạnh mẽ, nhưng\ncũng xâm chiếmthần trí của họ, chỉ có những\nngườithật sự kiên cường mới có thể đeo.\n",
    "T19.1130.name": "Kim Cương Giới Chỉ",
    "T19.1130.reqClass": "|1|2|3|4|5|6|",
    "T19.1130.description": "Mang đến cho người sử dụng sinhlực mạnh mẽ, nhưng\ncũng xâm chiếmthần trí của họ, chỉ có những\nngườithật sự kiên cường mới có thể đeo.\n",
    "T19.1131.name": "Thu Thập Hộ Thủ VIP Tăng Cường",
    "T19.1131.reqClass": "|1|2|3|4|5|6|",
    "T19.1131.description": "Găng tay thu thập thần kỳ, hiệu suất thu thập vô\ncùng cao, không bao giờ thất bại, người chơi VIP\ntừ cấp 30 trở lên mới có thể sử dụng.\n",
    "T19.1132.name": "Huyền Vũ Phủ",
    "T19.1132.reqClass": "|1|",
    "T19.1132.description": "Huyền Vũ là linh vật kết hợp giữarùa và rắn, tượng\ntrưng cho sựhòa hợp cương nhu. Đây chính là món vũ\nkhí có uy lực manh, phốihợp tốt cương nhu.\n",
    "T19.1188.name": "Tinh Linh Quyền Trượng",
    "T19.1188.reqClass": "|3|",
    "T19.1188.description": "Sự phù hộ của tinh linh khiến choquyền trượng có\nsức bảo vệ và tấn công mãnh liệt, có tinh linh\nbảohộ muốn thua cũng khó.\n",
    "T19.1189.name": "Tạo Kim Hổ Đầu Lôi Xạ Súng",
    "T19.1189.reqClass": "|4|",
    "T19.1189.description": "Thân súng được đúc từ thép tinh,dài hơn 1 trượng,\nđầu súng khắchình đầu hổ, bắn ra các viên đạnbạch\nkim, uy lực khôn cùng.\n",
    "T19.1190.name": "Tử Tiêu Kiếm",
    "T19.1190.reqClass": "|6|",
    "T19.1190.description": "Thân kiếm phát ra ánh lửa tím, khiếncho cả thanh\nkiếm như một đám mâytím, vì thế có tên gọi là Tử\nTiêu, đứnggần còn bị thương, huống hồ bị tấncông.\n",
    "T19.1191.name": "Ngư Cầm",
    "T19.1191.reqClass": "|2|",
    "T19.1191.description": "Ngư Cầm nếu phối hợp với âmthanh thần kỳ của Ngư\nThích CầmCung thì sẽ tạo nên khúc nhạchoan hỉ êm\ndịu nhưng nguy hiểmbội phần, xâm nhập vào trí\nnãokhiến đối phương bị thương nặng.\n",
    "T19.1193.name": "U Minh Chiến Bổng",
    "T19.1193.reqClass": "|5|",
    "T19.1193.description": "Khó có ai có thể thấy được hìnhdạng của gậy này,\nvì thế đượcgọi là U Minh. Thợ Săn với tốc độnhanh\nnếu được gậy này trợ giúpthì sẽ càng lợi hại.\n",
    "T19.1194.name": "Quyến Cố Kỳ Thuẫn",
    "T19.1194.reqClass": "|1|",
    "T19.1194.description": "Rốt cuộc thì nhờ có được sự quantâm của thiên\nđường thì mới có đượcsức phòng ngự cao như vậy hay\ndobản thân thuẫn này đã có khả năngmạnh như vậy?\n",
    "T19.1195.name": "Kim Cang Bảo Điển",
    "T19.1195.reqClass": "|3|",
    "T19.1195.description": "Kiên cố, sắc bén, sức phá hủy cao,đồng thời không\ndễ bị phá hủy, cókhả năng vượt qua mọi thử\nthách,đạt đến thắng lợi cuối cùng.\n",
    "T19.1196.name": "Tê Giác Ngân Hộ Uyển",
    "T19.1196.reqClass": "|4|",
    "T19.1196.description": "Sừng tê giác bản thân chính là một vậttượng trưng\ncho sức tấn công mạnhmẽ, cộng thêm với ánh sáng\nbạc lấplánh phát ra sẽ làm cho kẻ địch run rẩy.\n",
    "T19.1197.name": "Lân Gia Chủy Thủ",
    "T19.1197.reqClass": "|6|",
    "T19.1197.description": "Chủy thủ sắc nhọn vô cùng, nếuđâm trúng kẻ địch\nthì hình dáng củadao sẽ khiến cho vết thương\ncàngnặng, quả là món bảo vật hiếm có.\n",
    "T19.1198.name": "Ngư Thích Cầm Cung",
    "T19.1198.reqClass": "|2|",
    "T19.1198.description": "Sự sắc bén của Ngư Thích nếu phốihợp với âm thanh\nthần kỳ của Ngư Cầm\nthì sẽ tạo nên khúc nhạchoan hỉ êm dịu nhưng nguy\nhiểmbội phần, xâm nhập vào trí nãokhiến đối phương\nbị thương nặng.\n",
    "T19.1199.name": "Vô Lượng Thủ",
    "T19.1199.reqClass": "|5|",
    "T19.1199.description": "Cho dù đối phương có tấn côngbạn mạnh đến đâu đi\nnữa thì đềucó thể hóa giải được một phần lớn,cuối\ncùng chỉ còn lại lực đánh nhẹ.\n",
    "T19.1200.name": "Thần Tôn Khôi",
    "T19.1200.reqClass": "|1|",
    "T19.1200.description": "Thần thánh là bậc chí cao vô thượng,là bậc tôn\nquý. Sau khi mặc trang bị nàysẽ như có thần thành\nphò trợ, yêu maquỷ quái nhìn thấy sẽ thất hồn lạc\nphách,không còn sức chiến đấu.\n",
    "T19.1201.name": "Dật Bồ Mão",
    "T19.1201.reqClass": "|3|",
    "T19.1201.description": "Không hề nao núng trước yêu ma, quyếttâm tiêu diệt\nchúng để phổ độ chúngsinh chính là nhiệm vụ của Bồ\nTát\n",
    "T19.1202.name": "Linh Thứu Mão",
    "T19.1202.reqClass": "|5|",
    "T19.1202.description": "Trang bị nhẹ nhàng giúp chủ nhân trở nênlinh hoạt,\nsức mạnh vô biên khiến cho quáithú cũng phải nể\nsợ. Có được trang bị thầnthánh này thì quả thật\nđáng ngưỡng mộ\n",
    "T19.1203.name": "Huyết Ma Khôi",
    "T19.1203.reqClass": "|6|",
    "T19.1203.description": "Hiệp sĩ vốn có năng lực hấp thu sinh mênh,nếu có\nthêm trang bị huyết ma thì năng lựcnày sẽ mạnh\nthêm bội phần, khiến bất kỳai cũng phải kiêng dè.\n",
    "T19.1204.name": "Uy Di Khôi",
    "T19.1204.reqClass": "|4|",
    "T19.1204.description": "Món trang bị có tốc độ của thần mã, chỉ cần vẻ bề\nngoài của nó cũng đủ khiến cho kẻ địch cách xa\ntrăm dặm cũng phảie dè\n",
    "T19.1205.name": "Đạp Lãng Hộ Uyển",
    "T19.1205.reqClass": "|2|",
    "T19.1205.description": "Cưỡi mây đạp sóng để đến được đích mộtcách nhanh\nchóng chính là mơ ước của mỗi một cao thủ, và\ntrang bị này sẽ giúpđạt được ước muốn đó.\n",
    "T19.1206.name": "Thần Tôn Giáp",
    "T19.1206.reqClass": "|1|",
    "T19.1206.description": "Thần thánh là bậc chí cao vô thượng,là bậc tôn\nquý. Sau khi mặc trang bị nàysẽ như có thần thành\nphò trợ, yêu maquỷ quái nhìn thấy sẽ thất hồn lạc\nphách,không còn sức chiến đấu.\n",
