    "T45.3828.name": "Thần Quan Mất Trí",
    "T45.3829.info": "Bắt 1 Dực Long, sau đó báo cáo tình hình với Tôn\nLệ ở tiệm pet.",
    "T45.3829.reqClass": "all",
    "T45.3829.subType": "9-11",
    "T45.3829.startText": "Gần đây, Thánh Ước Địa bị Dực Long quấy nhiễu, để\nkhông liên lụy đến người vô tội, hy vọng các vị\nhiệp sĩ ra tay chế ngự.",
    "T45.3829.completeText": "Cám ơn!!",
    "T45.3829.name": "Dực Long",
    "T45.3830.info": "Thu thập 1 Ngũ Sắc Thần Thạch giao cho Thủ Thư\nĐông Huyền Thành.",
    "T45.3830.reqClass": "all",
    "T45.3830.subType": "9-11",
    "T45.3830.startText": "Nghe nói gần đây Thủ Thư đang sưu tập một số đồ\ncổ, hãy đến đó xem sao!",
    "T45.3830.completeText": "Chà chà, đẹp quá, đáng để sưu tầm đây!",
    "T45.3830.name": "Ngũ Sắc Thần Thạch",
    "T45.3831.info": "Thu thập 1 Bảo Rương Vật Tư, sau đó báo cáo tình\nhình với Vệ Sĩ Bàng Bối Thành.",
    "T45.3831.reqClass": "all",
    "T45.3831.subType": "9-11",
    "T45.3831.startText": "Sưu tập 1*Bảo Rương Vật Tư",
    "T45.3831.completeText": "Cảm ơn, giúp ta bớt đi bao nhiêu phiền phức!",
    "T45.3831.name": "Bảo Rương Vật Tư",
    "T45.3832.info": "Thu thập 3 Đồng Vàng Cổ giao cho Thủ Thư Đông\nHuyền Thành.",
    "T45.3832.reqClass": "all",
    "T45.3832.subType": "9-11",
