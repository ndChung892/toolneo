    "T35.688.onServiceText": "Cỗ quan tài đá thật kỳ dị, bên trong có luồng sáng\nbí ẩn.",
    "T35.688.name": "Hướng Dẫn Vong Hồn",
    "T35.689.funcInfo": "-1|-1",
    "T35.689.subType": "all",
    "T35.689.onServiceText": "Cỗ quan tài đá thật kỳ dị, bên trong có luồng sáng\nbí ẩn.",
    "T35.689.name": "Pharaoh Cabu III",
    "T35.697.onServiceText": "Tâm nhãn hợp nhất, vũ khí chính là một phần cơ\nthể, không phải một sớm một chiều mà có thể luyện\nthành.",
    "T35.697.name": "Võ Sĩ Thượng Cổ",
    "T35.698.onServiceText": "Thắng không kiêu, bại không nản, đó là triết lý\nngàn năm. Ghi nhớ một điều, ngươi vĩnh viễn không\nthể trở thành kẻ mạnh nhất, vượt qua và bị vượt\nqua luôn đi cùng với nhau",
    "T35.698.name": "Thiên Sứ Hoán Đổi",
    "T35.701.onServiceText": "Một cái hòm bình thường, ít ra nhìn bên ngoài là\nnhư thế…",
    "T35.701.name": "Thùng Hàng",
