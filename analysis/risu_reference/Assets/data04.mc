    "T45.4988.subType": "9-13",
    "T45.4988.startText": "Tiệm pet gần đây nhận được vô số đơn đặt hàng, hãy\nmau giúp bắt các loại pet đang hot nào!",
    "T45.4988.completeText": "Loại tốt thế này ắt hắn nhiều người thích lắm. Ha\nha cảm ơn ngươi nhé!",
    "T45.4988.name": "Gấu Mật Đáng Yêu",
    "T45.4988.aScriptText": "Ngẫu nhiên nhận được 2 nguyên liệu và 1 Lệnh bài\ntreo thưởng, phẩm chất nhiệm vụ càng cao\n(trắng<lục<xanh<tím<cam) thì xác suất nhận được\nnguyên liệu cấp cao càng cao",
    "T45.4978.info": "Giáo huấn 1 Điêu Linh Cuồng Chiến và 30 Điêu Linh\nDanh Y, sau khi hoàn thành thì về báo cho Trưởng\nThôn Điêu Linh.",
    "T45.4978.reqClass": "all",
    "T45.4978.subType": "9-13",
    "T45.4978.startText": "Điêu Linh Cuồng Chiến dẫn theo rất nhiều Điêu Linh\nDanh Y đến thôn làm loạn, ngươi hãy giúp ta đi\ngiáo huấn bọn chúng!",
    "T45.4978.completeText": "Đa tạ ngươi, giờ chắc chúng sẽ chẳng dám gây sự\nnữa!",
    "T45.4978.name": "Danh Y Làm Loạn",
    "T45.4978.aScriptText": "Ngẫu nhiên nhận được 2 nguyên liệu và 1 Lệnh bài\ntreo thưởng, phẩm chất nhiệm vụ càng cao\n(trắng<lục<xanh<tím<cam) thì xác suất nhận được\nnguyên liệu cấp cao càng cao",
    "T45.5017.info": "Đến chỗ Thủ Vệ Cảng (365,220) ở Đông Huyền Thành\nđể được chuyển đến Điêu Linh Thôn, sau đó tìm Đại\nSư Kỹ Năng Sống để học kỹ năng sống.",
    "T45.5017.reqClass": "all",
    "T45.5017.startText": "Bây giờ có lẽ đã đến lúc ngươi đến Điêu Linh Thôn\ntìm Đại Sư Kỹ Năng Sống rồi, ông ấy sẽ hướng dẫn\nngươi học hệ thống kỹ năng sống!",
    "T45.5017.completeText": "Ta là Đại Sư Kỹ Năng Sống! Nào, chúng ta bắt đầu\nhọc thôi!",
    "T45.5017.name": "Tìm Đại Sư Kỹ Năng Sống",
    "T45.5001.info": "Nhận Sách Không Gian Đa Chiều từ Reck để Lão Ông\nĐiêu Linh giúp bạn đến Không Gian Đa Chiều",
    "T45.5001.reqClass": "all",
    "T45.5001.startText": "Nghe ông nội kể rằng gần thôn có 1 động vô danh\nsâu không đáy, bên trong có rất nhiều quái vật bay\nkỳ dị, nếu đánh bại chúng sẽ nhận được rất nhiều\nbảo thạch đặc biệt. Chỉ cần mang theo 1 Sách Không\nGian đặc biệt thì sẽ có thể vào đó thám hiểm. Nhớ\nlà phải có vật phẩm bay thì mới có thể đánh bọn\nquái vật.",
    "T45.5001.completeText": "Đây là Sách Không Gian Đa Chiều, còn thông tin cụ\nthể thì ngươi cần đi hỏi các trưởng lão trong\nthôn.",
    "T45.5001.name": "Trục Xoay Không Gian",
    "T45.4992.info": "Bắt 1 Người Rơm màu lục",
    "T45.4992.reqClass": "all",
    "T45.4992.startText": "Đến Mị Hoặc Lâm bắt 1 Người Rơm màu lục để giao\ncho người phát hiện bản vẽ",
    "T45.4992.completeText": "Ối~~~Sao lại mang đến cho ta con quái vật này?!",
    "T45.4992.name": "[Nhiệm Vụ Bản Vẽ A]",
    "T45.4993.info": "Nhận vật phẩm bay “Chổi Ma Pháp”.",
    "T45.4993.reqClass": "all",
    "T45.4993.startText": "Gần đây tộc ta có mở lớp dạy bay, mỗi thành viên\nĐông Huyền đều có thể đến chỗ ta để nhận miễn phí\n\"Chổi Ma Pháp\" dùng để tập bay sơ cấp. Sau khi đã\ncó vật phẩm bay, ngươi có thể tự do bay lượn trên\nbầu trời, có một số quái vật ở các bản đồ chỉ có\nthể nhìn thấy khi biết bay. Việc phi hành sẽ tổn\nhao độ bền của vật phẩm bay, tuy nhiên ngươi có\nthể sửa nó như các trang bị thông thường khác.\nNgươi có thể xem Trợ giúp trò chơi để tìm hiểu\nthêm các kiến thức về việc phi hành.",
    "T45.4993.completeText": "Sau khi trang bị lên người, nhấn vào nút Bay ở góc\nphải màn hình để bắt đầu bay",
    "T45.4993.name": "Phi Hành Sơ Cấp",
    "T45.5004.info": "Vào Hành Lang Thuận Phong, đặt Chìa Khóa Nghịch\nPhong vào Totem Linh Phong",
    "T45.5004.reqClass": "all",
    "T45.5004.name": "Hành Lang Thuận Phong",
    "T45.5004.aScriptText": "Phần thưởng chưa biết",
    "T45.4984.info": "Bắt 1 Điêu Linh Chiến Sĩ giao cho Tôn Lệ ở tiệm\npet Đông Huyền Thành.",
    "T45.4984.reqClass": "all",
    "T45.4984.subType": "9-13",
    "T45.4984.startText": "Tiệm pet gần đây nhận được vô số đơn đặt hàng, hãy\nmau giúp bắt các loại pet đang hot nào!",
    "T45.4984.completeText": "Loại tốt thế này ắt hắn nhiều người thích lắm. Ha\nha cảm ơn ngươi nhé!",
    "T45.4984.name": "Chiến Sĩ Đáng Yêu",
    "T45.4984.aScriptText": "Ngẫu nhiên nhận được 2 nguyên liệu và 1 Lệnh bài\ntreo thưởng, phẩm chất nhiệm vụ càng cao\n(trắng<lục<xanh<tím<cam) thì xác suất nhận được\nnguyên liệu cấp cao càng cao",
    "T45.4996.info": "Đến Tháp Khắc Nguyên bắt 1 Thủ Vệ Sói Mẹ",
    "T45.4996.reqClass": "all",
    "T45.4996.startText": "Thủ Vệ Sói Mẹ cũng hết hàng rồi, giúp ta bắt 1 con\nđi",
    "T45.4996.completeText": "Cảm ơn ngươi, tặng ngươi cái này! Cùng bộ với món\ntrang bị lúc nãy đấy! Bộ trang bị có càng nhiều\nphần thì sẽ càng có nhiều thuộc tính được kích\nhoạt",
    "T45.4996.name": "Trang Bị Pet - Bắt Thủ Vệ Sói Mẹ",
    "T45.4997.info": "Đến Lê Dương Thôn bắt 1 Hấp Huyết Hải Tinh",
    "T45.4997.reqClass": "all",
    "T45.4997.startText": "Hấp Huyết Hải Tinh cũng hết hàng rồi, giúp ta bắt\n1 con đi",
    "T45.4997.completeText": "Cảm ơn ngươi, tặng ngươi cái này! Cùng bộ với 2\nmón trang bị lúc nãy đấy! Bộ trang bị có càng\nnhiều phần thì sẽ càng có nhiều thuộc tính được\nkích hoạt",
    "T45.4997.name": "Trang Bị Pet - Bắt Hấp Huyết Hải Tinh",
    "T45.4998.info": "Đến Lê Dương Thôn tiêu diệt 50 Lê Dương Hồ Tặc",
    "T45.4998.reqClass": "all",
    "T45.4998.startText": "Ngươi giúp ta đến Lê Dương Thôn tiêu diệt 50 tên\nLê Dương Hồ Tặc được không? Ta bị chúng cướp mất\nrất nhiều thức ăn cho pet để ở đó!",
    "T45.4998.completeText": "Cảm ơn ngươi, tặng ngươi cái này! Cùng bộ với 3\nmón trang bị lúc nãy đấy! Bộ trang bị có càng\nnhiều phần thì sẽ càng có nhiều thuộc tính được\nkích hoạt",
    "T45.4998.name": "Trang Bị Pet - Tiêu Diệt Lê Dương Hồ Tặc",
    "T45.5009.reqClass": "all",
    "T45.5009.startText": "Cứu với! Cứu với!",
    "T45.5009.name": "Giáo Huấn Thỏ Thuận Phong",
    "T45.5009.aScriptText": "Phần thưởng chưa biết",
    "T45.5019.info": "Học kỹ năng trồng trọt trong hệ thống kỹ năng sống",
    "T45.5019.reqClass": "all",
    "T45.5019.startText": "Kỹ năng trồng trọt sẽ giúp trồng được nông sản\ndùng trong chế biến nguyên liệu hoặc có thể đem\nbán. Nông sản gồm 2 loại ngắn ngày và dài ngày,\ntrồng loại nào cũng cần tiêu hao 1 số điểm sức lực\nvà được cộng thêm điểm thành thục. Nông sản dài\nngày cần nhiều thời gian hơn để chín nhưng lượng\nđiểm thành thục thu được sẽ nhiều hơn nông sản\nngắn ngày. Khi đủ điểm thành thục sẽ có thể thăng\ncấp kỹ năng và trồng được nhiều loại nông sản hơn.\nĐiều cuối cùng cần phải nhớ đó là, nếu không thu\nhoạch khi nông sản vừa chín thì có thể bị người\nkhác trộm mất, đồng thời sau 20 phút kể từ lúc\nchín mà không thu hoạch thì nông sản sẽ bị héo úa.",
    "T45.5019.completeText": "Đó chính là kỹ năng trồng trọt, đừng lo lắng, các\nthao tác làm rất đơn giản!",
    "T45.5019.name": "Học Kỹ Năng Trồng Trọt",
    "T45.5011.info": "Đến Đông Xuất Vân hoặc Lê Dương Bắc câu 5 con Cá\nLa Hán",
    "T45.5011.reqClass": "all",
    "T45.5011.startText": "Ao hồ ở Đông Huyền Thành chưa được đẹp lắm, nếu\nngươi mang được vài con cá đẹp đến thả vào hồ thì\ntốt quá.",
    "T45.5011.completeText": "Đây là phần thưởng của ngươi",
    "T45.5011.name": "Hồ Đông Huyền - Cá La Hán",
    "T45.5011.aScriptText": "Phần thưởng kinh nghiệm",
    "T45.5002.info": "Có 1 Quân Đoàn Phi Ma chuẩn bị tấn công Tinh Linh\nThành, Bàng Bối Thành và Tiên Lạp Thành, các thành\nviên hãy nhanh chóng nhận nhiệm vụ tiến lên không\ntrung tiêu diệt chúng, bảo vệ an toàn cho các\nthành. (Quân Đoàn Phi Ma thường xuất hiện từ 9h\nđến 22h)",
    "T45.5002.reqClass": "all",
    "T45.5002.startText": "Có 1 quân đoàn phi ma chuẩn bị tấn công Tinh Linh\nThành, Bàng Bối Thành và Tiên Lạp Thành, các thành\nviên hãy nhanh chóng nhận nhiệm vụ tiến lên không\ntrung tiêu diệt chúng, bảo vệ sự an lành cho dân\nchúng. (Phi Ma thường xuất hiện từ 9 đến 22h)",
    "T45.5002.completeText": "Ngươi là niềm tự hào của Đông Huyền!",
    "T45.5002.name": "Phi Ma Tấn Công",
    "T45.5002.aScriptText": "Kinh nghiệm, có xác suất nhận được trang bị pet",
    "T45.5003.info": "Đến Phục Ma Cốc tìm Dịch Chuyển Thâm Uyên để mở\nnhiệm vụ phụ bản Liệt Diễm Thâm Uyên",
    "T45.5003.reqClass": "all",
    "T45.5003.startText": "Bây giờ các ngươi hãy mau đi đến Phục Ma Cốc tìm\ncông chúa Kamera, nàng ấy sẽ đưa các ngươi vào\nLiệt Diễm Thâm Uyên!",
    "T45.5003.completeText": "Các ngươi có thể đến Phục Ma Cốc tìm công chúa\nKamera rồi đi vào phó bản",
    "T45.5003.name": "Mở Nhiệm Vụ Liệt Diễm Thâm Uyên",
    "T45.5014.info": "Đến Lê Dương Thôn câu 5 con Cá Thiên Thần",
    "T45.5014.reqClass": "all",
    "T45.5014.startText": "Ao hồ ở Đông Huyền Thành chưa được đẹp lắm, nếu\nngươi mang được vài con cá đẹp đến thả vào hồ thì\ntốt quá.",
    "T45.5014.completeText": "Đây là phần thưởng của ngươi",
    "T45.5014.name": "Hồ Đông Huyền - Cá Thiên Thần",
    "T45.5014.aScriptText": "Phần thưởng kinh nghiệm",
    "T45.5005.info": "Đánh bại Thỏ Thuận Phong",
    "T45.5005.reqClass": "all",
    "T45.5005.name": "Giáo Huấn Thỏ Thuận Phong",
    "T45.5005.aScriptText": "Phần thưởng chưa biết",
    "T45.5006.info": "Tìm tung tích của Phong Trượng",
    "T45.5006.reqClass": "all",
    "T45.5006.name": "Sửa Chữa Totem",
    "T45.5006.aScriptText": "Phần thưởng chưa biết",
    "T45.5007.info": "Đánh bại Linh Phong Xà Vương",
    "T45.5007.reqClass": "all",
    "T45.5007.name": "Hành Lang Linh Xà",
    "T45.5007.aScriptText": "Phần thưởng chưa biết",
    "T45.5008.info": "Tìm dây chuyền bị mất",
    "T45.5008.reqClass": "all",
    "T45.5008.name": "Linh Hồn Đau Khổ",
    "T45.5008.aScriptText": "Phần thưởng chưa biết",
    "T45.5028.info": "Nắm vững kỹ năng chế thuốc, sử dụng các nguyên\nliệu có được sau khi trồng trọt, hái thuốc và câu\ncá rồi dựa vào công thức để chế 1 viên Ma Huyết\nHoàn giao cho Đại Sư Kỹ Năng Sống. Nếu không cẩn\nthận làm mất công thức thì có thể mua lại ở chỗ\nĐại Sư Kỹ Năn",
    "T45.5028.reqClass": "all",
    "T45.5028.startText": "Giờ ta muốn xem xem ngươi đã nắm vững kỹ năng chế\nthuốc hay chưa. Nào, hãy dựa vào công thức ta đưa\nđể chế 1 viên Ma Huyết Hoàn nhé. Nguyên liệu thì\nngươi tự tìm thử xem.",
    "T45.5028.completeText": "Giỏi lắm, ngươi đã nắm vững tất cả kỹ năng sống\nrồi! Nếu còn thắc mắc gì thì hãy vào phần trợ giúp\nđể xem nhé!",
    "T45.5028.name": "Hiểu Rõ Kỹ Năng Chế Thuốc",
    "T45.5020.info": "Nắm vững kỹ năng trồng trọt, đến chỗ Nông Dân John\n(178, 46) để vào nông trường, chọn 1 khu đất và\nbắt đầu trồng Lúa Mạch, sau khi chín thì thu hoạch\n5 phần Lúa Mạch giao cho Đại Sư Kỹ Năng Sống.",
    "T45.5020.reqClass": "all",
    "T45.5020.startText": "Ta đã dạy cho ngươi kỹ năng trồng trọt, giờ chỉ\ncòn xem ngươi đã thật sự hiểu chưa. Hãy đến gặp\nNông Dân John để được đưa vào nông trường, chọn 1\nkhu đất và trồng Lúa Mạch, sau khi thu hoạch hãy\nmang đến cho ta 5 phần là được!",
    "T45.5020.completeText": "Đấy, rất đơn giản đúng không? Học 1 tí là hiểu\nngay!",
    "T45.5020.name": "Hiểu Rõ Kỹ Năng Trồng Trọt",
    "T45.5021.info": "Học kỹ năng hái thuốc trong hệ thống kỹ năng sống",
    "T45.5021.reqClass": "all",
    "T45.5021.startText": "Học được kỹ năng hái thuốc sẽ giúp ngươi hái được\ncác loại thảo dược dùng để chế biến thức ăn hoặc\nlàm thuốc. Ngươi có thể tìm thấy các bãi thảo dược\nở vùng đất hoang dã và tiến hành thu thập, tất\nnhiên khi thu thập hết thì các điểm thu thập thảo\ndược này cũng sẽ biến mất. Chú ý: Các loại thảo\ndược khác nhau sẽ được phân bố ở các bản đồ khác\nnhau, cần chọn bản đồ có thảo dược phù hợp với cấp\nđộ kỹ năng của mình.",
    "T45.5021.completeText": "Đấy, rất đơn giản đúng không? Học 1 tí là hiểu\nngay!",
    "T45.5021.name": "Học Kỹ Năng Hái Thuốc",
    "T45.5012.info": "Đến Thiên Lục Châu câu 5 con Cá Bảy Màu",
    "T45.5012.reqClass": "all",
    "T45.5012.startText": "Ao hồ ở Đông Huyền Thành chưa được đẹp lắm, nếu\nngươi mang được vài con cá đẹp đến thả vào hồ thì\ntốt quá.",
    "T45.5012.completeText": "Đây là phần thưởng của ngươi",
    "T45.5012.name": "Hồ Đông Huyền - Cá Bảy Màu",
    "T45.5012.aScriptText": "Phần thưởng kinh nghiệm",
    "T45.5013.info": "Đến Quang Bình Nguyên câu 5 con Cá Kim Cương",
    "T45.5013.reqClass": "all",
    "T45.5013.startText": "Ao hồ ở Đông Huyền Thành chưa được đẹp lắm, nếu\nngươi mang được vài con cá đẹp đến thả vào hồ thì\ntốt quá.",
    "T45.5013.completeText": "Đây là phần thưởng của ngươi",
    "T45.5013.name": "Hồ Đông Huyền - Cá Kim Cương",
    "T45.5013.aScriptText": "Phần thưởng kinh nghiệm",
    "T45.5024.info": "Tìm hiểu kỹ năng câu cá, đến các vị trí câu cá cấp\n1 ở Đông Xuất Vân và Lê Dương Bắc câu 2 con Cá\nChạch giao cho Đại Sư Kỹ Năng Sống.",
    "T45.5024.reqClass": "all",
    "T45.5024.startText": "Bây giờ ngươi hãy lấy cần câu mà ta đưa cho ngươi,\nđến các vị trí câu cá cấp 1 và câu 2 con Cá Chạch\nvề đây! Vị trí câu cá cấp 1 có ở Đông Xuất Vân và\nLê Dương Bắc, kênh nào cũng có, cứ từ từ mà câu\nnhé.",
    "T45.5024.completeText": "Ngươi làm rất tốt!",
    "T45.5024.name": "Hiểu Rõ Kỹ Năng Câu Cá",
    "T45.5015.info": "Đến Vân Lộc Sơn câu 5 con Cá Ngân Long",
    "T45.5015.reqClass": "all",
    "T45.5015.startText": "Ao hồ ở Đông Huyền Thành chưa được đẹp lắm, nếu\nngươi mang được vài con cá đẹp đến thả vào hồ thì\ntốt quá.",
    "T45.5015.completeText": "Đây là phần thưởng của ngươi",
    "T45.5015.name": "Hồ Đông Huyền - Cá Ngân Long",
    "T45.5015.aScriptText": "Phần thưởng kinh nghiệm",
    "T45.5016.info": "Đến Tuyết Lâm câu 5 con Cá Kim Long",
    "T45.5016.reqClass": "all",
    "T45.5016.startText": "Ao hồ ở Đông Huyền Thành chưa được đẹp lắm, nếu\nngươi mang được vài con cá đẹp đến thả vào hồ thì\ntốt quá.",
    "T45.5016.completeText": "Đây là phần thưởng của ngươi",
    "T45.5016.name": "Hồ Đông Huyền - Cá Kim Long",
    "T45.5016.aScriptText": "Phần thưởng kinh nghiệm",
    "T45.5027.info": "Học kỹ năng chế thuốc trong hệ thống kỹ năng sống",
    "T45.5027.reqClass": "all",
    "T45.5027.startText": "Học được kỹ năng chế thuốc sẽ giúp ngươi bào chế\nđược các loại thuốc giúp phục hồi HP, MP và tăng\nthêm các hiệu ứng khi chiến đấu! Khi ra đường nhớ\nmang theo các loại thuốc hữu ích này. Nguyên liệu\nlàm thuốc có được sau khi hái thuốc, cũng có lúc\ncần phải trồng trọt và câu cá. Các công thức làm\nthuốc sơ cấp có thể mua ở chỗ ta, còn các công\nthức cao cấp thì cần phải dùng điểm cống hiến\ntrong bang hội để đổi.",
    "T45.5027.completeText": "Kỹ năng chế thuốc là vậy đấy!",
    "T45.5027.name": "Học Kỹ Năng Chế Thuốc",
    "T45.5018.info": "Bắt đầu tìm hiểu về kỹ năng sống ở chỗ Đại Sư",
    "T45.5018.reqClass": "all",
    "T45.5018.startText": "Kỹ năng sống bao gồm 5 kỹ năng là trồng trọt, hái\nthuốc, câu cá, nấu ăn và chế thuốc, mỗi kỹ năng\nđều có độ thành thục riêng. Chỉ cần luyện tập thì\nsẽ độ thành thục sẽ tăng lên. Khi đạt đến độ thành\nthục nhất định thì có thể vào giao diện kỹ năng để\nthăng cấp kỹ năng và học được cách làm ra các vật\nphẩm tương ứng.",
    "T45.5018.completeText": "Sao? Thấy chóng mặt rồi đúng không? Đừng lo, chúng\nta cứ từ từ tìm hiểu nhé!",
    "T45.5018.name": "Tìm Hiểu Kỹ Năng Sống",
    "T45.5029.info": "Thành chủ Tiên Lạp Thành có việc cần tìm bạn, hi\nvọng bạn nhanh chóng đến đó một chuyến.",
    "T45.5029.reqClass": "all",
    "T45.5029.startText": "Gần đây ta nhận được báo cáo rằng, ở Đoạn Cốc\nthường xảy ra hiện tượng tuyết lở, có rất nhiều\nnhà thám hiểm đã bị thương. Việc này rất bất\nthường, hi vọng ngươi có thể đi tìm hiểu nguyên\nnhân.",
    "T45.5029.completeText": "Ngươi đến thật là tốt, gần đây ở đây rối ren cả\nlên!",
    "T45.5029.name": "Kho Báu Cực Địa 14-1",
    "T45.5030.info": "Đi tìm Tộc Navi điên cuồng, hỏi bọn chúng vì sao\nlại điên cuồng phá băng như vậy",
    "T45.5030.reqClass": "all",
    "T45.5030.startText": "Mọi việc rất rắc rối! Bọn người tộc Navi dường như\nđã phát điên cả rồi! Cứ luôn miệng nhắc đến kho\nbáu gì đó! Núi băng đều bị bọn chúng đào nát cả\nrồi! Ngươi xem, đằng kia lại có 1 tên điên đang\nđến kìa!",
    "T45.5030.completeText": "Cãi nhau ồn ào quá! Không thấy ta đang đào báu vật\nà?",
    "T45.5030.name": "Kho Báu Cực Địa 14-2",
    "T45.5010.reqClass": "all",
    "T45.5010.name": "Giáo Huấn Thỏ Thuận Phong",
    "T45.5010.aScriptText": "Phần thưởng chưa biết",
    "T45.5022.info": "Tìm hiểu kỹ năng hái thuốc, đến các vị trí thu\nthập thảo dược ở Đông Xuất Vân và Lê Dương Bắc hái\n2 cây Ninh Thần Thảo về giao cho Đại Sư Kỹ Năng\nSống.",
    "T45.5022.reqClass": "all",
    "T45.5022.startText": "Ta đã dạy xong về kỹ năng hái thuốc, giờ chỉ cần\nxem ngươi rốt cuộc đã thật sự hiểu chưa. Hãy đến\ncác vị trí thu thập thảo dược cấp 1 và hái cho ta\n2 cây Ninh Thần Thảo. Vị trí hái thảo dược cấp 1\nnằm ở Đông Xuất Vân và Lê Dương Bắc, kênh nào cũng\ncó, vì thế đừng có lo lắng, cứ từ từ mà hái.",
    "T45.5022.completeText": "Ngươi rất sáng dạ!",
    "T45.5022.name": "Hiểu Rõ Kỹ Năng Hái Thuốc",
    "T45.5023.info": "Học kỹ năng câu cá trong hệ thống kỹ năng sống",
    "T45.5023.reqClass": "all",
    "T45.5023.startText": "Muốn học được kỹ năng câu cá, ngoài việc phải có\nSách Kỹ Năng Câu Cá thì còn cần phải có Cần Câu.\nChỉ cần vác cần đến khu vực chỉ định là có thể câu\ncá! Ngoài cần câu ra, ngươi còn có thể trang bị\nthêm 1 số Mồi Câu để tăng hiệu suất câu. Sau khi\nthăng cấp kỹ năng câu thì có thể đến các khu vực\nkhác để câu được các loại cá cấp cao hơn! Cá câu\nđược có thể dùng làm thức ăn hoặc đem bán, đồng\nthời có khi còn là vật phẩm yêu cầu của nhiệm vụ\nnào đó. Ngoài ra, có lúc sẽ có 1 số người muốn mua\ncá, nếu cung cấp được loại cá họ cần thì sẽ nhận\nđược phần thưởng bất ngờ.",
    "T45.5023.completeText": "Háo hức muốn đi câu ngay có đúng không?",
    "T45.5023.name": "Học Kỹ Năng Câu Cá",
    "T45.5034.info": "Giúp bác sĩ Đắc Kỷ đến Đoạn Cốc bắt về 1 Tinh Linh\nCực Quang",
    "T45.5034.reqClass": "all",
    "T45.5034.startText": "Theo ta thấy, Tộc Navi chắc đã gặp phải chuyện gì\nđó nên mới phát điên như vậy! Nhưng cụ thể là\nchuyện gì thì ta không rõ. Như thế này vậy, ngươi\nhãy đến Đoạn Cốc tìm 1 Tinh Linh Cực Quang về đây\nđể ta hỏi xem đã xảy ra chuyện gì ở đó. Nếu Tinh\nLinh Cực Quang không chịu giúp đỡ thì cứ bắt về\nđây!",
    "T45.5034.completeText": "Bọn Tinh Linh này rất kín miệng, nhưng ta vẫn sẽ\ncó cách bắt chúng phải nói ra, ha ha!",
    "T45.5034.name": "Kho Báu Cực Địa 14-6",
    "T45.5025.info": "Học kỹ năng nấu ăn trong hệ thống kỹ năng sống",
    "T45.5025.reqClass": "all",
    "T45.5025.startText": "Kỹ năng nấu ăn sẽ giúp ngươi nấu được các món ăn\nhấp dẫn. Các loại thức ăn khác nhau sẽ có các tác\ndụng khác nhau, là vật phẩm không thể thiếu trong\nlúc chiến đấu. Nguyên liệu dùng để nấu ăn có được\nbằng cách trồng trọt, thu thập và câu cá. Các Sách\nDạy Nấu Ăn có thể mua ở chỗ ta hoặc có được sau\nkhi đạt được cấp độ nhất định trong bang hội, dùng\nđiểm cống hiến để đổi, ngoài ra còn có thể có bằng\ncách tham gia một số sự kiện.",
    "T45.5025.completeText": "Đơn giản đúng không?",
    "T45.5025.name": "Học Kỹ Năng Nấu Ăn",
    "T45.5026.info": "Nắm vững kỹ năng nấu ăn, sử dụng các nguyên liệu\ncó được sau khi trồng trọt, hái thuốc và câu cá\nrồi dựa vào hướng dẫn trong sách để làm 1\nHamburger giao cho Đại Sư Kỹ Năng Sống. Nếu không\ncẩn thận làm mất sách dạy nấu ăn thì có thể mua ở\nchỗ Đại Sư.",
    "T45.5026.reqClass": "all",
    "T45.5026.startText": "Lúc nãy ta có tặng cho ngươi 1 quyển sách dạy làm\nHamburger, giờ ngươi hãy dựa vào công thức trong\nđó để làm thử 1 cái Hamburger cho ta xem để ta xem\nngươi đã nắm vững kỹ năng nấu ăn hay chưa. Còn về\nnguyên liệu, ngươi hãy tự tìm thử xem nhé!",
    "T45.5026.completeText": "Giỏi lắm, ngươi đã biết nấu ăn rồi đấy!",
    "T45.5026.name": "Hiểu Rõ Kỹ Năng Nấu Ăn",
    "T45.5037.info": "Giúp bác sĩ Đắc Kỷ đưa thuốc giải đến cho thành\nchủ Tiên Lạp Thành, để ông ta đi giải cứu Tộc Navi",
    "T45.5037.reqClass": "all",
    "T45.5037.startText": "Tốt lắm, ngươi hãy nhanh đưa thuốc giải đến cho\nthành chủ Tiên Lạp! Sau đó để thành chủ bố trí\nviệc giải cứu tộc Navi!",
    "T45.5037.completeText": "Ngươi làm khá lắm, ta sẽ bố trí người ngựa ngay!",
    "T45.5037.name": "Kho Báu Cực Địa 14-9",
    "T45.5038.info": "Đến Đoạn Cốc tìm Người Đóng Băng hỏi thăm tình\nhình",
    "T45.5038.reqClass": "all",
    "T45.5038.startText": "Mọi việc dường như vẫn chưa kết thúc! Lúc nãy\nNgười Đóng Băng ở Đoạn Cốc cho người đến báo, quả\nthực có 1 Băng Cự Long bị phong ấn dưới lòng đất!\nNhưng phong ấn vừa mới bị người tộc Navi đào trúng\nvà phá vỡ rồi... Con rồng này mà tỉnh giấc, mọi\nchuyển sẽ phúc tạp hơn... Ngươi mau đến gặp Người\nĐóng Băng lần nữa để hỏi rõ tình hình!",
    "T45.5038.completeText": "Ngươi đến thì hay quá! Con rồng này đã hoàn toàn\nkhông thể khống chế được nữa rồi!",
    "T45.5038.name": "Kho Báu Cực Địa 14-10",
    "T45.5039.info": "Đến Đoạn Cốc tìm Băng Cự Long thương lượng",
    "T45.5039.reqClass": "all",
    "T45.5039.startText": "Thật là phiền phức! Không ngờ tên Thuật Sĩ đã chết\nmà phong ấn vẫn bị Tộc Navi phá vỡ! Giờ Băng Cự\nLong đó đang làm loạn khắp nơi! Ta cũng hết cách\nrồi! Việc này chỉ còn có thể trông mong vào ngươi…",
    "T45.5039.completeText": "Cuối cùng ta cũng đã tỉnh giấc! Ngủ say mấy ngàn\nnăm, cuối cùng cũng đã thức!",
    "T45.5039.name": "Kho Báu Cực Địa 14-11",
    "T45.5040.info": "Đánh bại Băng Cự Long",
    "T45.5040.reqClass": "all",
    "T45.5040.startText": "Không! Ta tuyệt đối không thể quay lại lòng đất!\nTa muốn cùng các Tinh Linh Cực Quang chiếm giữ\nvùng đất băng giá này! Đây là lãnh địa của ta! Thế\ngiới của ta do ta làm chủ! Đừng ép ta phải mạnh\ntay!",
    "T45.5040.completeText": "Ta thua rồi… Ta lại thua rồi………",
    "T45.5040.name": "Kho Báu Cực Địa 14-12",
    "T45.5031.info": "Lấy Tinh Thạch Kỳ Lạ từ trong tay người của Tộc\nNavi",
    "T45.5031.reqClass": "all",
    "T45.5031.startText": "Không thấy ta đang bận à? Ở đây có kho báu! Chỉ\ncần đào được là giàu to! Ôi, ngươi hãy giúp ta đào\nnhé, đây, trả công cho ngươi trước bằng viên kim\ncương này! (Bạn nhìn viên đá trong suốt trên tay,\nlòng đầy ngờ vực)",
    "T45.5031.completeText": "Nhìn xem, kim cương kìa! Ha ha!",
    "T45.5031.name": "Kho Báu Cực Địa 14-3",
    "T45.5032.info": "Về Tiên Lạp Thành báo tin cho thành chủ",
    "T45.5032.reqClass": "all",
    "T45.5032.startText": "Ha ha! Kho báu ơi ta tới đây! Ha ha! (Người Navi\nnày dường như thần kinh có vấn đề rồi, bạn đành\nphải cầm tinh thạch thần bí quay về tìm thành chủ\nTiên Lạp Thành ngay)",
    "T45.5032.completeText": "Ngươi nói sao? Ở Đoạn Cốc có kho báu à?",
    "T45.5032.name": "Kho Báu Cực Địa 14-4",
    "T45.5033.info": "Thành chủ Tiên Lạp Thành bảo bạn đến tìm bác sĩ\nĐắc Kỷ để cùng nghĩ cách",
    "T45.5033.reqClass": "all",
    "T45.5033.startText": "Việc này thật sự rất bất thường! Sao có thể vì đào\nkho báu mà phát điên được? Vả lại ta làm thành chủ\nbao năm rồi, chưa hề nghe nói ở Đoạn Cốc có kho\nbáu! Không được, ngươi mau đi tìm bác sĩ Đắc kỷ,\nxem xem cô ấy có cách gì không!",
    "T45.5033.completeText": "Nghe lời kể của ngươi, ta nghĩ người tộc Navi thật\nsự bị mất lý trí cả rồi!",
    "T45.5033.name": "Kho Báu Cực Địa 14-5",
    "T45.5044.info": "Đi tìm Trưởng Thôn Điêu Linh để bàn việc nhập ngũ\ncủa Reck",
    "T45.5044.reqClass": "all",
    "T45.5044.startText": "Thật ra ta cũng rất muốn nhập ngũ, luôn muốn trở\nthành 1 chiến binh dũng cảm, sau đó trở thành\ntướng quân, nhưng thôn trưởng nhất quyết không\nđồng ý… Hay là người giúp ta đi thuyết phục ông ấy\nxem sao!?",
    "T45.5044.completeText": "Cái gì? Thằng bé Reck lại muốn đi lính sao?",
    "T45.5044.name": "Lệnh Tập Hợp Quân Đội 10-2",
    "T45.5035.info": "Đến Đoạn Cốc tìm Thuật Sĩ Đào Mỏ, đuổi hắn đi và\nlấy Thuốc Giải Thuật Pháp từ hắn",
    "T45.5035.reqClass": "all",
    "T45.5035.startText": "Thì ra ở Đoạn Cốc xuất hiện 1 tên Thuật Sĩ Đào Mỏ,\nhắn đã dùng ma thuật hắc ám để điều khiển người\ntộc Navi đi đào kho báu! Ngươi mau đến đó đuổi hắn\nđi, đồng thời bắt hắn phải chì cách giải trừ ma\nthuật!",
    "T45.5035.completeText": "Đừng làm ồn! Ta sắp thành công rồi!",
    "T45.5035.name": "Kho Báu Cực Địa 14-7",
    "T45.5036.info": "Đánh bại Thuật Sĩ Đào Mỏ, lấy Thuốc Giải Ma Thuật\ntrên người hắn",
    "T45.5036.reqClass": "all",
    "T45.5036.startText": "Ngươi thì biết gì chứ? Từ lâu ta đã biết dưới lòng\nđất Đoạn Cốc có một Băng Cự Long đang ngủ, chỉ cần\nđiều khiển được nó, ta sẽ trở thành chúa tể thiên\nhạ! Ngươi mau cút đi, đừng có ngăn cản ta! Sao?\nGiải trừ ma thuật ư? Đùa với ta à? Giải trừ ma\nthuật rồi thì ai giúp ta đào chứ? Thuốc giải trên\nngười ta này, có đánh chết ta cũng không đưa cho\nngươi!",
    "T45.5036.completeText": "Hay lắm, giờ ta chế thuốc giải đây!",
    "T45.5036.name": "Kho Báu Cực Địa 14-8",
    "T45.5047.info": "Đi tìm nông dân John và mời nhập ngũ",
    "T45.5047.reqClass": "all",
    "T45.5047.startText": "Ta vẫn không tin nó tự tìm được mấy thứ này! Ngươi\nkhông cần phải giải thích thay cho nó, chắc chắn\nlà do ngươi giúp nó rồi… Thôi vậy, nếu nó đã quyết\nnhư vậy thì ta cũng không cản nữa! Ta sẽ bảo Tướng\nQuân sắp xếp cho nó làm việc ở hậu phương trước! À\nmà ta nghe nói Nông Dân John cũng rất muốn nhập\nngũ, ngươi đi hỏi anh ta xem sao!?",
    "T45.5047.completeText": "Nhập ngũ sao? Ta muốn lắm!",
    "T45.5047.name": "Lệnh Tập Hợp Quân Đội 10-5",
    "T45.5048.info": "Giúp Nông Dân John thu thập 30 phần Cao Lương, 30\nphần Cacao và 30 con Cá Hồi",
    "T45.5048.reqClass": "all",
    "T45.5048.startText": "Trước nay ta luôn muốn nhập ngũ, nhưng ta còn phải\nnuôi gia đình! Vì thế ta quyết định sẽ làm người\ncung cấp quân nhu! Đây là danh sách hàng hóa của\nta, ngươi giúp ta 1 tay với nhé!",
    "T45.5048.completeText": "Số thức ăn này đủ cho các binh sĩ ăn 1 bữa no nê!",
    "T45.5048.name": "Lệnh Tập Hợp Quân Đội 10-6",
    "T45.5058.info": "Mang theo 2 cái Hamburger đến cho Michi",
    "T45.5058.reqClass": "all",
    "T45.5058.startText": "Hu hu hu, Michi sợ lắm… Michi đói… Michi đói bụng\nlắm… Có thể nào cho Michi ăn 2 cái Hamburger\nkhông… Michi đói… Hu hu hu",
    "T45.5058.completeText": "Giờ Michi không sợ nữa rồi!",
    "T45.5058.name": "Đứa Trẻ Mất Tích 14-5",
    "T45.5050.info": "Báo lại cho Tướng Quân Cô Thôn",
    "T45.5050.reqClass": "all",
    "T45.5050.startText": "Hay lắm, từ giờ lương thực cho quân đội sẽ luôn\nđược đảm bảo! Ngươi mau về báo cho Tướng Quân Cô\nThôn đi!",
    "T45.5050.completeText": "Vậy là Reck đồng ý nhập ngũ, còn John sẽ cung cấp\nlương thực?",
    "T45.5050.name": "Lệnh Tập Hợp Quân Đội 10-7",
    "T45.5041.info": "Sau khi thương lượng với Băng Cự Long, quay về báo\ncho Thành Chủ Tiên Lạp",
    "T45.5041.reqClass": "all",
    "T45.5041.startText": "Nếu là ngươi thì ngươi có chịu ngủ cả ngàn năm\ndưới lòng đất tối tăm không? Ta thật sự không muốn\nquay nơi đó nữa! Ta đảm bảo sau này sẽ nghe lời\nngươi, chỉ cần ngươi đừng bắt ta về đó…",
    "T45.5041.completeText": "Ý ngươi là ngươi đã thuần phục được con rồng đó\nrồi ư?",
    "T45.5041.name": "Kho Báu Cực Địa 14-13",
    "T45.5042.info": "Nói chuyện với Thành Chủ Tiên Lạp sau đó nhận phần\nthưởng",
    "T45.5042.reqClass": "all",
    "T45.5042.startText": "Ngươi đồng ý để ta điều khiển con rồng đó ư? Nếu\nhắn đã chịu nghe lời thì ta sẽ cho hắn sống yên ổn\nở Đoạn Cốc, như vậy có thể canh chừng được bọn\nngười Tộc Navi! Thời gian qua vất vả cho ngươi\nquá! Ở đây không có bao nhiêu, ngươi nhận tạm nhé",
    "T45.5042.completeText": "Khá lắm! Giờ Đoạn Cốc đã có thể yên ổn rồi!",
    "T45.5042.name": "Kho Báu Cực Địa 14-14",
    "T45.5043.info": "Tướng Quân Cô Thôn ở Điêu Linh Thôn muốn gặp bạn\nđể nhờ một việc.",
    "T45.5043.reqClass": "all",
    "T45.5043.startText": "Chào ngươi, bọn ta đang định mở rộng quy mô quân\nđội, nhưng ta hiện đang bận huấn luyện binh sĩ nên\nmuốn nhờ ngươi đến gặp người trong thôn, hỏi xem\ncó ai muốn gia nhập hàng ngũ đại quân chống ác ma\nkhông. Ngươi hãy đi hỏi Reck trước xem sao!",
    "T45.5043.completeText": "Sao? Muốn ta gia nhập quân đội à?",
    "T45.5043.name": "Lệnh Tập Hợp Quân Đội 10-1",
    "T45.5054.info": "Thôn Trưởng Điêu Linh mời bạn đến Điêu Linh Thôn\nđể giúp một chuyện.",
    "T45.5054.reqClass": "all",
    "T45.5054.startText": "Gần đây, địa bàn chúng ta thường xảy ra việc trẻ\ncon đột nhiên mất tích, mấy ngày trước lại vừa xảy\nra 1 vụ. Reck biết rất rõ sự việc này, người đến\ngặp anh ta hỏi thử xem nhé.",
    "T45.5054.completeText": "Ngươi đến hỏi ta về việc trẻ con bị mất tích à?",
    "T45.5054.name": "Đứa Trẻ Mất Tích 14-1",
    "T45.5045.info": "Nói cho Reck biết câu trả lời của trưởng thôn",
    "T45.5045.reqClass": "all",
    "T45.5045.startText": "Không được, tuyệt đối không được! Ta còn không rõ\nkhả năng của nó ư? Mỗi binh sĩ trong quân đội của\nchúng ta đều đã tiêu diệt hàng trăm tên địch! Nếu\nnó muốn đi lính thì ngươi bảo nó hãy đến Mị Hoặc\nLâm lấy 40 móng Bạo Liệt Long và 40 da Gấu Mật Mị\nHoặc về cho ta xem!",
    "T45.5045.completeText": "Ta biết ngay ông ấy sẽ bảo thế mà!",
    "T45.5045.name": "Lệnh Tập Hợp Quân Đội 10-3",
    "T45.5046.info": "Lần lượt thu thập 40 Móng Rồng trên người Bạo Liệt\nLong và 40 Da Gấu trên người Gấu Mật Mị Hoặc",
    "T45.5046.reqClass": "all",
    "T45.5046.startText": "Đâu phải cứ là binh sĩ là phải ra tiền tuyến! Ta\ncó thể làm việc khác trước mà, đợi khi ta thành\nthục thì mới ra trận chứ! Thật là… Hừ! À có cách\nrồi! Hay là ngươi giúp ta làm việc này đi! Chỉ cần\nngươi nói chính ta giao các chiến lợi phẩm ấy cho\nngươi là được thôi mà!",
    "T45.5046.completeText": "Sao? Nó thật sự làm được việc này ư?",
    "T45.5046.name": "Lệnh Tập Hợp Quân Đội 10-4",
    "T45.5057.info": "Đến Mị Hoặc Lâm tìm Michi đi lạc",
    "T45.5057.reqClass": "all",
    "T45.5057.startText": "Đi nào! Chúng ta lên đường đến Mị Hoặc Lâm! Nếu bị\nlạc nhau hoặc gặp tình huống bất ngờ thì phải nghĩ\ncách để thông báo cho ta nhé!!!",
    "T45.5057.completeText": "Hu hu hu, sợ quá đi, trong đây toàn là quái vật…",
    "T45.5057.name": "Đứa Trẻ Mất Tích 14-4",
    "T45.5067.info": "Nói chuyện với Trưởng Thôn Điêu Linh",
    "T45.5067.reqClass": "all",
    "T45.5067.startText": "Tạ ơn trời đất, ngươi đã an toàn trở về! Thật\nkhông hiểu sao tên Nhiếp Hồn Quái này lại đến làng\ncủa chúng ta! Nhưng dù sao thì vẫn phải cảm ơn\nngươi! Đây là thù lao mà mà ngươi xứng đáng nhận,\nđừng ngại nhé!",
    "T45.5067.completeText": "Bây giờ bọn trẻ đều đã được an toàn!",
    "T45.5067.name": "Đứa Trẻ Mất Tích 14-14",
    "T45.5059.info": "Tìm Tiểu Tinh Linh Mê Hoặc để hỏi rõ sự tình",
    "T45.5059.reqClass": "all",
    "T45.5059.startText": "Michi nhớ ra rồi, có 1 Tiểu Tinh Linh đã đánh thức\nMichi dậy! Tiểu Tinh Linh đó còn bảo Michi đứng\nchờ ở đây, không được đi đâu, nếu không sẽ bị quái\nvật ăn thịt… Hu hu hu, Michi không muốn bị ăn thịt\nđâu…",
    "T45.5059.completeText": "Chính ta đã tạo vòng ma pháp bao quanh cô bé để cô\nbé không bị quái vật tấn công.",
    "T45.5059.name": "Đứa Trẻ Mất Tích 14-6",
    "T45.5060.info": "Tiêu diệt 100 Tí Hon Rừng Rậm",
    "T45.5060.reqClass": "all",
    "T45.5060.startText": "Việc này… Ta không thể nói quá nhiều được... Bởi\nvì xung quanh đây có quá nhiều tai mắt. Trước tiên\nngươi chỉ cần giúp ta tiêu diệt bớt bọn chúng, sau\nđó ta mới có thể kể cho ngươi biết mọi chuyện",
    "T45.5060.completeText": "Bây giờ ta có thể yên tâm kể cho ngươi biết ngọn\nngành rồi!",
    "T45.5060.name": "Đứa Trẻ Mất Tích 14-7",
    "T45.5051.info": "Giáo huấn Điêu Linh Cung Thủ, Điêu Linh Chiến Sĩ,\nĐiêu Linh Danh Y và Điêu Linh Tiểu Đội Trưởng, mỗi\nloại 20 tên. Bay lượn ở Điêu Linh Thôn sẽ gặp được\nchúng.",
    "T45.5051.reqClass": "all",
    "T45.5051.startText": "Nghe tin ngươi báo ta rất vui, nhưng ta hiện lo\nlắng về vấn đề quản lý quân đội. Ngươi xem đám\nlính Điêu Linh kia kìa, ta phải khó khăn lắm mới\nthuyết phục được chúng đầu quân, nhưng bọn chúng\nlại rất không tuân mệnh lệnh! Một mình ta thì khó\nmà quản được đông người như vậy, ngươi giúp ta\ngiáo huấn chúng 1 phen đi!",
    "T45.5051.completeText": "Ha ha, phen này chúng phải chịu khuất phục thôi!",
    "T45.5051.name": "Lệnh Tập Hợp Quân Đội 10-8",
    "T45.5052.info": "Đánh bại Đội Trưởng Cô Thôn",
    "T45.5052.reqClass": "all",
    "T45.5052.startText": "Ta thấy võ công của ngươi thật cao cường, ta rất\nthích! Ngươi có đồng ý tỷ thí 1 phen với thủ hạ\ncủa ta là Đội Trưởng Cô Thôn không? Nếu ngươi\nthắng được hắn thì ta sẽ thưởng lớn cho ngươi, còn\nnếu ngươi thua thì phải gia nhập hàng ngũ của ta!",
    "T45.5052.completeText": "Ngươi đánh hay lắm! Ta thật sự rất thích ngươi!",
    "T45.5052.name": "Lệnh Tập Hợp Quân Đội 10-9",
    "T45.5053.info": "Nói chuyện với Tướng Quân Cô Thôn",
    "T45.5053.reqClass": "all",
    "T45.5053.startText": "Ta thấy thật vinh hạnh khi có 1 người bạn như\nngươi. Ngươi đã giúp ta chỉnh đốn quân kỷ, đây là\nphần thưởng mà ngươi xứng đáng được nhận, hãy cầm\nlấy! Nếu sau này ngươi đổi ý muốn gia nhập quân\nđội thì hãy đến tìm ta!",
    "T45.5053.completeText": "Hi vọng quân đội của chúng ta sẽ ngày càng lớn\nmạnh!",
    "T45.5053.name": "Lệnh Tập Hợp Quân Đội 10-10",
    "T45.5064.info": "Chuẩn bị cùng Người Chăm Sóc Rừng đi giải cứu bọn\ntrẻ",
    "T45.5064.reqClass": "all",
    "T45.5064.startText": "Làm tốt lắm! Ta đã thông bao cho John rồi, ông ấy\nsẽ đến ngay! Nhanh nào, chúng ta cùng đi cứu bọn\ntrẻ!",
    "T45.5064.completeText": "Hay quá, xem kìa, John đã đến rồi!",
    "T45.5064.name": "Đứa Trẻ Mất Tích 14-11",
    "T45.5055.info": "Reck bảo bạn đến tìm Nông Dân John để cùng vào Mị\nHoặc Lâm tìm đứa trẻ",
    "T45.5055.reqClass": "all",
    "T45.5055.startText": "Đúng vậy, mấy ngày trước, chính mắt ta nhìn thấy 1\nđứa trẻ trong thôn là Michi đi 1 mình vào Mị Hoặc\nLâm, gọi thế nào nó cũng không trả lời, cứ như thể\nbị ma nhập vậy. Ngươi cũng biết khu rừng đó vào\nthì dễ ra thì khó mà... Trong làng có Nông Dân\nJohn là gan dạ nhất, hay ngươi đến hỏi xem ông ấy\ncó đồng ý vào rừng cùng với ngươi không?",
    "T45.5055.completeText": "Tìm đứa trẻ ư? Được chứ, việc này đâu thể chậm\ntrễ!",
    "T45.5055.name": "Đứa Trẻ Mất Tích 14-2",
    "T45.5056.info": "Giúp Nông Dân John bắt 1 Người Rơm về để canh vườn",
    "T45.5056.reqClass": "all",
    "T45.5056.startText": "Nhưng nếu ta mà đi thì cây trái trong vườn sẽ bị\nbọn chim ăn sạch mất! Hay là thế này, trước tiên\nngươi hãy giúp ta vào Mị Hoặc Lâm bắt 1 Người Rơm\nvề để nó canh vườn giúp ta, vậy thì ta mới yên tâm\nđi được!",
    "T45.5056.completeText": "Hay lắm, giờ ta đi thôi!",
    "T45.5056.name": "Đứa Trẻ Mất Tích 14-3",
    "T45.5076.info": "Người Đào Đá nói cho bạn biết Cự Nhân Thạch Tượng\ntrong Cự Thạch Trận bỗng xuất hiện những ảo ảnh\nbiết tấn công người, bạn dự định đến đó thám hiểm\nmột chuyến",
    "T45.5076.reqClass": "all",
    "T45.5076.startText": "Thật phiền quá đi, dù cho tên Khai Sơn Thủ Lĩnh đó\nchịu an phận thì cũng đã sao chứ? Lúc trước ta có\nthể thường xuyên vào Cự Thạch Trận để đào đá, trừ\nbức tượng Cự Nhân Thạch khổng lồ ra, cái gì ở đó\nta cũng có thể chạm vào. Nhưng mấy tháng trước,\nkhi ta vào đó thì đột nhiên nghe thấy Thạch Tượng\nbảo ta tránh ra, còn có nhiều tượng đá lao vào tấn\ncông ta, làm ta chẳng dám quay lại đào đá! Nếu\nngươi có gan thì tự mình vào đó xem thử đi!",
    "T45.5076.completeText": "Tránh ra… Tránh ra…",
    "T45.5076.name": "Việc Lạ Ở Cự Thạch Trận",
    "T45.5068.info": "Đi tìm Tộc Trưởng Bối Tư để bắt đầu hành động mới",
    "T45.5068.reqClass": "all",
    "T45.5068.startText": "Ngươi đã nghỉ ngơi 1 thời gian dài, chắc là đã sẵn\nsàng cho hành động tiếp theo rồi đúng không?\nTrưởng Thôn Điêu Linh cho người mang thư tới, nhờ\nngươi đến đó 1 chuyến.",
    "T45.5068.completeText": "Ngươi đến rồi à? Ta muốn cho ngươi biết việc cần\nlàm tiếp theo!",
    "T45.5068.name": "Trở Lại Điêu Linh Thôn",
    "T45.5086.info": "Thu thập 200 quả Bí Ngô để đổi lấy danh hiệu Kỵ Sĩ\nBí Ngô",
    "T45.5086.reqClass": "all",
    "T45.5086.startText": "Thu thập 200 quả Bí Ngô để đổi lấy danh hiệu Kỵ Sĩ\nBí Ngô",
    "T45.5086.completeText": "Đây là phần thưởng của ngươi!",
    "T45.5086.name": "Kỵ Sĩ Bí Ngô",
    "T45.5087.info": "Thu thập 10 quả Bí Ngô để đổi lấy một loại thức ăn\nhoặc dược phẩm cao cấp ngẫu nhiên",
    "T45.5087.reqClass": "all",
    "T45.5087.startText": "Thu thập 10 quả Bí Ngô để đổi lấy một loại thức ăn\nhoặc dược phẩm cao cấp ngẫu nhiên",
    "T45.5087.completeText": "Đây là phần thưởng của ngươi!",
    "T45.5087.name": "Mười Quả Bí Ngô",
    "T45.5087.aScriptText": "Ngẫu nhiên nhận được dược phẩm và thức ăn cao cấp",
    "T45.5061.info": "Tìm Người Chăm Sóc Rừng để nói chuyện",
    "T45.5061.reqClass": "all",
    "T45.5061.startText": "Cách đây không lâu, đột nhiên có 1 con Nhiếp Hồn\nQuái xuất hiện trong Mị Hoặc Lâm, hắn đã dụ dỗ rất\nnhiều trẻ con vào rừng rồi nhốt chúng lại, dự định\nsẽ dùng chúng để bổ sung ma lực vào đêm trăng rằm\nsắp tới! Rất nhiều sinh vật trong rừng đều nghe\nlời hắn, chỉ riêng ta vẫn còn chống lại được! Ta\nmay mắn cứu được cô bé kia, còn về mấy đứa trẻ\nkhác, có lẽ ngươi nên đi hỏi Người Chăm Sóc Rừng,\nđường như ông ta đã gặp qua! Hành động nhanh nhé,\nngày mai chính là đêm trăng tròn rồi!",
    "T45.5061.completeText": "Ngươi đến rồi ư? Nhanh lên, ta sẽ nói cho ngươi\nbiết bọn trẻ đang ở đâu!",
    "T45.5061.name": "Đứa Trẻ Mất Tích 14-8",
    "T45.5062.info": "Tìm thấy mấy đứa trẻ bị nhốt và chuẩn bị giải cứu\nchúng",
    "T45.5062.reqClass": "all",
    "T45.5062.startText": "Việc là thế này, hôm đó ta vô tình nghe thấy tiếng\nkhóc của trẻ con, lần theo tiếng khóc, ta phát\nhiện chúng đang bị giam trong Loạn Thạch Trận. Ta\nđịnh vào cứu nhưng bị lũ quái vật ngăn lại, không\ncách nào vào được! Ngươi mau đi cứu chúng đi!",
    "T45.5062.completeText": "Hay quá, rốt cuộc cũng có người đến cứu chúng ta\nrồi!",
    "T45.5062.name": "Đứa Trẻ Mất Tích 14-9",
    "T45.5063.info": "Thu thập 50 chiếc chìa khóa từ Bạo Liệt Long,\nNgười Rơm, Tí Hon Rừng Rậm và Gấu Mật Mị Hoặc",
    "T45.5063.reqClass": "all",
    "T45.5063.startText": "Chúng tôi không thoát được! Chúng tôi ai ai cũng\nbị khóa đến 3, 4 cái khóa trên người, mà chìa khóa\nthì lại nằm trong tay bọn quái vật canh giữ đó!\nHãy đánh bại chúng để lấy chìa khóa cứu chúng tôi!",
    "T45.5063.completeText": "Đánh hay quá, giờ chúng ta hãy đi cứu người thôi!",
    "T45.5063.name": "Đứa Trẻ Mất Tích 14-10",
    "T45.5074.info": "Giúp Người Đào Đá thu thập 120 Nguyên liệu đá tinh\nchất từ trên người Sơn Thạch Quái",
    "T45.5074.reqClass": "all",
    "T45.5074.startText": "Đáng ghét, bọn Khai Sơn Thạch Quái dám làm hỏng\ncuốc của ta! Giờ ta phải mài lại đã. Phiền chết đi\nđược, ta còn rất nhiều đá cần phải thu thập, bọn\nquái đó lại suốt ngày làm phiền... Ái chà, hay là\nngươi, ngươi giúp ta lần nữa nhé, mau giúp ta thu\nthập 50 Nguyên liệu đá tinh chất về đây!",
    "T45.5074.completeText": "Được rồi, ta biết ngươi là người tốt, cứ vậy đi!",
    "T45.5074.name": "Thu Thập Nguyên Liệu Đá",
    "T45.5065.info": "Nói chuyện với Nhiếp Hồn Quái",
    "T45.5065.reqClass": "all",
    "T45.5065.startText": "Chúng ta sắp đưa được bọn trẻ trở về nhà rồi… Cái\ngì thế kia? Thôi chết, Nhiếp Hồn Quái đến rồi!\nNhanh lên, trước tiên ngươi hãy chặn con quái đó\nlại, còn ta và John sẽ đưa bọn trẻ về làng!",
    "T45.5065.completeText": "Ngươi là ai? Sao dám động đến thức ăn của ta?",
    "T45.5065.name": "Đứa Trẻ Mất Tích 14-12",
    "T45.5066.info": "Đánh bại Nhiếp Hồn Quái, nếu không, tính mạng của\nbạn và bọn trẻ đều khó bảo toàn!",
    "T45.5066.reqClass": "all",
    "T45.5066.startText": "Cái gì! Ngươi dám thả thức ăn của ta ư? Khốn kiếp!\nTa sẽ đánh chết ngươi! À mà không, ngươi có năng\nlực như vậy, ta phải hút hết năng lượng của ngươi!",
    "T45.5066.completeText": "Ngươi về rồi à?",
    "T45.5066.name": "Đứa Trẻ Mất Tích 14-13",
    "T45.5077.info": "Về Điêu Linh Thôn báo cho trưởng thôn biết việc kỳ\nlạ ở Cự Thạch Trận",
    "T45.5077.reqClass": "all",
    "T45.5077.startText": "(Ở lối vào Cự Thạch Trận, bạn bắt đầu cảm thấy khó\nthở, không thể tiến bước. Đúng lúc đó, bạn nhìn\nthấy bóng của một bức tượng khổng lồ lao đến, định\nđánh vào người bạn! Bất đắc dĩ, bạn quyết định\nquay về Điêu Linh Thôn trước để báo lại việc này\ncho trưởng thôn.)",
    "T45.5077.completeText": "Ngươi về rồi à? Có phát hiện được gì không?",
    "T45.5077.name": "Báo Cáo Với Trưởng Thôn Điêu Linh",
    "T45.5078.info": "Quay về Đông Huyền Thành báo cho Tộc Trưởng Bối Tư\nbiết sự việc ở Cự Thạch Trận Ảo Lâm, xem tộc\ntrưởng có cách giải quyết không",
    "T45.5078.reqClass": "all",
    "T45.5078.startText": "Sao? Ngươi nói trong Ảo Thạch Trận có 1 Cự Thạch\nTrận à? Còn có Cự Nhân Thạch Tượng? Lại còn tấn\ncông ngươi nữa sao? Xem ra trong đó thật sự có vấn\nđề! Chúng ta phải nghĩ cách phá giải ảo ảnh của Cự\nNhân Thạch Tượng đó.",
    "T45.5078.completeText": "Ngươi nói có một nơi gọi là Ảo Thạch Trận sao?",
    "T45.5078.name": "Quay Về Đông Huyền Thành",
    "T45.5069.info": "Đi qua Mị Hoặc Lâm để đến Ảo Thạch Trận để tìm\nNgười Gác Rừng",
    "T45.5069.reqClass": "all",
    "T45.5069.startText": "Qua khỏi Mị Hoặc Lâm là một vùng đất còn nguy hiểm\nvà kỳ quái hơn nữa, đó là Ảo Thạch Trận. Ở đó,\nkhắp nơi đều là cự thạch và ảo mộc, người bình\nthường không ai dám mạo hiểm vào đó. Bọn ta luôn\nnghi ngờ ở đó có tung tích của Ma Vương, nhưng\nkhông ai dám đến gần. Vì thế, bước tiếp theo chỉ\ncó thể trông cậy vào ngươi...",
    "T45.5069.completeText": "Hả? Ai nói cho ngươi biết ta là cao nhân ẩn sĩ\nvậy? Ha ha ha!",
    "T45.5069.name": "Đến Ảo Thạch Trận",
    "T45.5097.info": "Để có Bánh ngày Tết hãy mang Bánh Chưng và Bánh\nGiầy đến đổi cho Thợ Làm Bánh (Lúc đổi phải đảm\nbảo còn đủ khoảng trống trong Túi đồ)",
    "T45.5097.reqClass": "all",
    "T45.5097.startText": "Ha ha, tìm ta là sáng suốt đó, cả đại lục không ai\ncó thể làm bánh ngon hơn ta. Muốn ta ra tay thì\nmang nguyên liệu đến đây. Nếu đủ rồi thì chọn đi,\nmuốn làm bánh nào?",
    "T45.5097.completeText": "Làm khá lắm!",
    "T45.5097.name": "Đổi Bánh Tết",
    "T45.5071.info": "Giúp Người Gác Rừng lấy lại 100 phần Thịt gà từ\ntay Tung Thạch Giả",
    "T45.5071.reqClass": "all",
    "T45.5071.startText": "Thật Cảm ơn ngươi, nhưng ta hiện vẫn còn việc lo\nlắng… Gần đây không những có nhiều quái vật xuất\nhiện, mà còn có cả một đám Tung Thạch Giả cứ cách\nvài hôm là lại đến trộm gà của ta, khiến ta thiếu\nthốn lương thực... Người bạn à, ngươi giúp ta lấy\nlại 100 phần thịt gà từ tay chúng nhé!",
    "T45.5071.completeText": "Ha ha, rốt cuộc ta cũng có thể ăn thịt gà rồi!",
    "T45.5071.name": "Đoạt Lại Lương Thực",
    "T45.5072.info": "Giúp Người Gác Rừng chuyển một túi Thịt gà đến cho\nanh trai là Người Đào Đá. Người Đào Đá hiện đang ở\nsâu trong Lâm Không Địa, bạn có thể dùng Ẩn Dật\nThạch ở Thạch Tượng Đảo để đến Lâm Không Địa",
    "T45.5072.reqClass": "all",
    "T45.5072.startText": "Ôi, ngon quá! À phải rồi, ta đã chuẩn bị sãn 1 túi\nThịt gà, ngươi có thể giúp ta chuyển đến cho anh\ntrai ta đang ở Lâm Không Địa không? Anh ấy hơi\nnóng tính, không thích nói chuyện với người khác,\nanh ấy cũng rất ít khi trò chuyện với ta. Ta cũng\nkhông rõ hiện tại anh ấy ra sao, có bị quái vật\nquấy nhiễu không. Vậy nên ngươi giúp ta đến thăm\nanh ấy nhé! Ngươi có thể dùng Ẩn Dật Thạch ở Thạch\nTượng Đảo để đến Lâm Không Địa, anh ấy đang ở\ntrong ngôi nhà đá tại đó.",
    "T45.5072.completeText": "Ngươi là ai? Tránh ra, đừng có làm phiền ta! Tránh\nra!",
    "T45.5072.name": "Đưa Thức Ăn",
    "T45.5073.info": "Giúp Người Đào Đá lấy lại Cuốc đá của anh ta từ\nbọn Khai Sơn Thạch Quái",
    "T45.5073.reqClass": "all",
    "T45.5073.startText": "Thịt gà à? Thật là lắm chuyện! Ta sống một mình ở\nđây vẫn tốt, quái vật nào dám tới gần ta chứ? Duy\nchỉ có bọn Khai Sơn Thạch Quái thừa lúc ta không\nchú ý đã trộm Cuốc Đá của ta, làm ta không thể lên\nnúi đào đá! Ngươi mau đi tìm bọn Thạch Quái đó lấy\nlại cuốc đá cho ta!",
    "T45.5073.completeText": "Thật là, chậm chạp lề mề!",
    "T45.5073.name": "Lấy Lại Cuốc Đá",
    "T45.5084.info": "Sau khi kể tình hình cho Người Đào Đá thì quay về\nbáo cáo với trưởng thôn Điêu Linh",
    "T45.5084.reqClass": "all",
    "T45.5084.startText": "Thì ra Cự Nhân Thạch Tượng đó là do một Cự Nhân\nxây nên, thật là tài tình! Sống một mình trong đó\nhẳn anh ta sẽ cô đơn lắm! Ta nghĩ khi rảnh rỗi, ta\nsẽ đến đó thăm anh ta! Nè, ngươi còn đứng đây làm\ngì? Mau đi đi, ta còn phải đi đào đá nữa, không có\nthời gian nói chuyện với ngươi đâu! Ngươi hãy quay\nvề báo lại tình hình ở đây đi!",
    "T45.5084.completeText": "Ngươi nói Thạch Trận đó là do tộc Cự Nhân Xám tạo\nra, chứ không có liên quan gì đến Ma Vương à?",
    "T45.5084.name": "Quay Về Khởi Điểm",
    "T45.5075.info": "Giúp Người Đào Đá đến Thạch Tượng Đảo tìm Khai Sơn\nThủ Lĩnh, đánh bại hắn và cảnh cáo hắn không được\nđể bọn Khai Sơn Thạch Quái tiếp tục làm loạn",
    "T45.5075.reqClass": "all",
    "T45.5075.startText": "Cho dù có mài bén lại cuốc thì đã sao chứ? Bọn\nKhai Sơn Thạch Quái đó vẫn cứ làm theo lệnh của\nKhai Sơn Thủ Lĩnh. Chỉ khi khuất phục được hắn thì\nmới khiến bọn thủ hạ biết an phận. Khai Sơn Thủ\nLĩnh đang ở trên Thạch Tượng Đảo, ngươi mau đến đó\ncảnh cáo hắn, bảo hắn để cho ta yên!",
    "T45.5075.completeText": "Chà, giờ ta có thể yên ổn để đào đá rồi!",
    "T45.5075.name": "Cảnh Cáo Thủ Lĩnh",
    "T45.5095.reqClass": "all",
    "T45.5096.info": "Muốn làm được Bánh Chưng, Bánh Giầy ngon phải có\nđủ nguyên liệu tốt. Hãy thu thập chúng từ bọn quái\nvật đã đánh cắp ở các vùng đất hoang.",
    "T45.5096.reqClass": "all",
    "T45.5096.startText": "Ha ha, tìm ta là sáng suốt đó, cả đại lục không ai\ncó thể làm bánh ngon hơn ta. Muốn ta ra tay thì\nmang nguyên liệu đến đây. Nếu đủ rồi thì chọn đi,\nmuốn làm bánh nào?",
    "T45.5096.completeText": "Làm khá lắm!",
    "T45.5096.name": "Làm Bánh",
    "T45.5096.aScriptText": "Ngẫu nhiên nhận được 1 Bánh Chưng hoặc Bánh Giầy",
    "T45.5088.info": "Thu thập 1 quả Bí Ngô để đổi lấy phần thưởng Bạc",
    "T45.5088.reqClass": "all",
    "T45.5088.startText": "Thu thập 1 quả Bí Ngô để đổi lấy phần thưởng Bạc",
    "T45.5088.completeText": "Đây là phần thưởng dành cho ngươi",
    "T45.5088.name": "Một Quả Bí Ngô",
    "T45.5079.info": "Tộc Trưởng Bối Tư bảo bạn đến hỏi Tiến Sĩ Ultra\nxem có cách nào phá giải ảo ảnh Cự Nhân không",
    "T45.5079.reqClass": "all",
    "T45.5079.startText": "Ngươi nói trong Ảo Thạch Trận đó lại có một Cự\nThạch Trận nữa ư? Bên trong nó còn có ảo ảnh Cự\nNhân biết tấn công người khác à? Về việc này, tốt\nnhất ngươi hãy đến tìm Tiến sĩ Ultra, ông ấy có\nnghiên cứu về vấn đề này.",
    "T45.5079.completeText": "Sao sao? Có việc hay như vậy à?",
    "T45.5079.name": "Hỏi Nghiên Cứu Viên",
    "T45.5080.info": "Tiến Sĩ Ultra nhờ bạn đi thu thập 80 Vỏ Lượng Giáp\ncủa Sâu Giáp Đá ở Ảo Thạch Trận",
    "T45.5080.reqClass": "all",
    "T45.5080.startText": "Ảo ảnh tấn công được con người? Chà, việc này là\nchuyện nhỏ thôi! Muốn giải quyết đám ảo ảnh này,\nchỉ cần dùng vật màu đen phát sáng phản xạ lại ánh\nsáng mặt trời là được! Sao? Ngươi nói ở chỗ Ảo\nThạch Trận đó có một loại Sâu Giáp Đá, vỏ của\nchúng màu đen? Hay lắm, có được loại vỏ này thì ta\nsẽ có thể giúp ngươi chế tạo máy phản xạ phá giải\nảo ảnh!",
    "T45.5080.completeText": "Ngươi có vẻ làm việc rất tích cực, nhanh như vậy\nđã quay về rồi!",
    "T45.5080.name": "Nguyên Liệu Máy Phản Xạ",
    "T45.5070.info": "Giúp Người Gác Rừng tiêu diệt 100 Bàn Thạch Long",
    "T45.5070.reqClass": "all",
    "T45.5070.startText": "Ta ư? Ta chỉ là một người gác rừng bình thường mà\nthôi! Chúng ta nhiều đời nay đã bảo vệ Ảo Lâm,\nngăn cản không cho khách bộ hành lạc vào. Tuy\nnhiên gần đây trong rừng xảy ra nhiều chuyện lạ,\nquái vật quấy phá, khiến ta rất lo lắng... Ngươi\nnhìn xem, bọn Bàn Thạch Long kia lại đến rồi!\nNhanh lên, giúp ta tiêu diệt chúng đi!!!",
    "T45.5070.completeText": "Giờ ta nghĩ bọn Bàn Thạch Long chẳng dám đến nữa\nđâu, cảm ơn ngươi nhé!",
    "T45.5070.name": "Tiêu Diệt Ảo Thuật Yêu",
    "T45.5082.info": "Nghe xong câu chuyện của Ảo Ảnh Cự Nhân rồi đến\nKhông Trung Đảo tìm Cự Nhân Xám",
    "T45.5082.reqClass": "all",
    "T45.5082.startText": "Tộc Cự Nhân Xám… chỉ còn lại một mình ta…. Thạch\nTượng… là vật tượng trưng cho tộc nhân… Đừng quấy\nrầy họ… Ta rất cô độc, ta ở Không Trung Đảo… chờ\nngươi đến….",
    "T45.5082.completeText": "Ngươi có muốn nghe ta kể chuyện của Cự Nhân Xám\nkhông?",
    "T45.5082.name": "Cự Nhân Cô Độc",
    "T45.5083.info": "Nghe Cự Nhân cô độc kể chuyện của Cự Nhân Xám, sau\nđó về kể lại cho Người Đào Đá",
    "T45.5083.reqClass": "all",
    "T45.5083.startText": "Cự Nhân Xám chúng tôi đã xuất hiện cách đây mấy\nnghìn năm... Nhưng chỉ có mình ta sống được đến\nnay.... Vì thế, ta đã dựng nên Cự Thạch Trận\nnày... Ta chỉ muốn tưởng nhớ đến tộc của ta...\nNhưng bọn yêu ma cứ liên tục đến quấy phá, khiến\nta rất khó chịu... Vậy nên ta đã lập nên kết giới\nđể người trong tộc không bị bọn chúng làm ô uế...\nTa biết ngươi không có ý xấu... Ta ở trên đảo đã\nnhìn thấy ngươi đánh đuổi bọn quái đó... Ta không\ntrách ngươi... Ta sẽ tạo lại kết giới, nhưng lần\nnày sẽ cho Người Đào Đá kia vào khai thác đá, ta\nthấy hắn rất tôn trọng các Thạch Tượng... Ngươi\nhãy về nói với hắn nhé... Còn ta, ta cũng chẳng\nbiết tại sao tộc của ta chỉ còn mình ta sống sót,\nnếu ngươi có thể giúp ta tìm ra nguyên nhân, giúp\nta đoàn tụ với người trong tộc, ta rất biết ơn\nngươi....",
    "T45.5083.completeText": "Sao? Ngươi nói có một Cự Nhân sinh sống trong Ảo\nThạch Trận ư?",
    "T45.5083.name": "Lời Kể Của Cự Nhân",
    "T45.5094.reqClass": "all",
    "T45.5085.info": "Trưởng Thôn Điêu Linh bảo bạn nghỉ ngơi, chờ sau\nkhi ông ta bàn bạc xong với người trong thôn sẽ có\nquyết định tiếp theo",
    "T45.5085.reqClass": "all",
    "T45.5085.startText": "Xem ra mọi việc lại quay về khởi điểm rồi. Nếu Cự\nThạch Trận không có liên quan gì đến Ma Vương, vậy\nta cần hỏi lại người trong thôn, xem họ có tìm\nđược dấu vết nào không... Ngoài ra, về nguyên nhân\nmất tích của Tộc Cự Nhân Xám, ta cũng sẽ giúp\nngươi tìm hiểu, ngươi giờ hãy cứ nghỉ ngơi đi nhé!",
    "T45.5085.completeText": "Cứ nghỉ ngơi đi, khi có thông tin ta sẽ báo ngay\ncho ngươi!",
    "T45.5085.name": "Nghỉ Ngơi Tịnh Dưỡng",
    "T45.13143.info": "Tìm 1 ít Công Thức Thái Dương Thủy",
    "T45.13143.reqClass": "all",
    "T45.13143.subType": "7-9",
    "T45.13143.startText": "Thợ Săn Edward cần một ít Công Thức Thái Dương\nThủy, ngươi mau giúp thu thập về đi",
    "T45.13143.completeText": "Cảm ơn ngươi!",
    "T45.13143.name": "Tìm Công Thức Thái Dương Thủy",
    "T45.13144.info": "Tìm 1 ít Công Thức Nguyệt Lượng Thủy",
    "T45.13144.reqClass": "all",
    "T45.13144.subType": "7-9",
    "T45.13144.startText": "Thợ Săn Casey cần một ít Công Thức Nguyệt Lượng\nThủy, ngươi mau giúp thu thập về đi",
    "T45.13144.completeText": "Cảm ơn ngươi!",
    "T45.13144.name": "Tìm Công Thức Nguyệt Lượng Thủy",
    "T45.13145.info": "Tìm 1 ít Công Thức Minh Tinh Dược Thủy",
    "T45.13145.reqClass": "all",
    "T45.13145.subType": "7-9",
    "T45.13145.startText": "Quan Tuần Tra Lê Dương cần một ít Công Thức Minh\nTinh Dược Thủy, ngươi mau giúp thu thập về đi",
    "T45.13145.completeText": "Cảm ơn ngươi!",
    "T45.13145.name": "Tìm Công Thức Minh Tinh Dược Thủy",
    "T45.5089.info": "Thu thập 200 quả Bí Ngô để đổi lấy \"Sách Dạy Nấu\nXúp Bí Ngô\" chỉ có trong dịp lễ Halloween",
    "T45.5089.reqClass": "all",
    "T45.5089.startText": "Thu thập 200 quả Bí Ngô để đổi lấy \"Sách Dạy Nấu\nXúp Bí Ngô\" chỉ có trong dịp lễ Halloween",
    "T45.5089.completeText": "Đây là phần thưởng dành cho ngươi",
    "T45.5089.name": "Sách Dạy Nấu Xúp Bí Ngô",
    "T45.5090.info": "Thu thập 10 quả Bí Ngô để đổi lấy 1 tấm Thẻ Bí Ngô",
    "T45.5090.reqClass": "all",
    "T45.5090.startText": "Thu thập 10 quả Bí Ngô để đổi lấy 1 tấm Thẻ Bí Ngô",
    "T45.5090.completeText": "Đây là phần thưởng dành cho ngươi",
    "T45.5090.name": "Thẻ Bí Ngô",
    "T45.13148.info": "Tìm 1 ít Công Thức Đậu Khấu Lộ",
    "T45.13148.reqClass": "all",
    "T45.13148.subType": "7-9",
    "T45.13148.startText": "Nghiên Cứu Gia XX cần một ít Công Thức Đậu Khấu\nLộ, ngươi mau giúp thu thập về đi",
    "T45.13148.completeText": "Cảm ơn ngươi!",
    "T45.13148.name": "Tìm Công Thức Đậu Khấu Lộ",
    "T45.5081.info": "Dùng Máy Phản Xạ Ảo Ảnh mà Tiến Sĩ Ultra đã đưa\ncho bạn khi chiến đấu với Cự Nhân để làm giảm\nthuộc tính của Cự Nhân, sau đó đánh bại hắn",
    "T45.5081.reqClass": "all",
    "T45.5081.startText": "Xong rồi, đây chính là Máy Phản Xạ Ảo Ảnh! Giờ thì\nngươi không còn phải sợ khi chiến đấu với ảo ảnh\nnữa! Trước khi đấu, chỉ cần ngươi dùng máy này thì\nhắn sẽ bị ánh sáng chiếu rọi, sức tấn công tự\nnhiên sẽ giảm! Ha ha, tới lúc đó thì ngươi có thể\nyên tâm tấn công rồi!",
    "T45.5081.completeText": "Thật ra… Ta chỉ là… không muốn có người tới làm\nphiền…",
    "T45.5081.name": "Phá Giải Ảo Ảnh",
    "T45.5093.info": "Bắt 1 Gà Tây cam và lấy được danh hiệu Người Tuyết\nCuồng Bạo giao cho Âu Dương Quán",
    "T45.5093.reqClass": "all",
    "T45.5093.startText": "Giáng Sinh vui vẻ! Ta cảm thấy danh hiệu Người\nTuyết Cuồng Bạo rất oai, ngươi có thể đem đến cho\nta được không?Sau đó hãy bắt 1 con Gà Tây cam để\nta có nấu các móng ngon! Sao mau đi đi! Nhớ là Gà\nTây cam đó nhé!",
    "T45.5093.completeText": "Danh hiệu này là của ngươi!",
    "T45.5093.name": "Kẻ Hủy Diệt Gà Tây",
    "T45.5104.info": "Trưng bày Ngũ Quả Thọ trong dịp tết sẽ được sức\nkhỏe, sống lâu. Muốn có hãy mang Mâm Ngũ Quả và\nGiấy gói quà chữ Thọ đến đổi ở chỗ Nghệ Nhân Kết\nTrái Cây(Giấy gói quà có thể thu thập từ quái vật\nở các vùng đất hoang hoặc mua tại Shop)",
    "T45.5104.reqClass": "all",
    "T45.5104.startText": "Lề mề thế, ngươi tưởng ngươi có nhiều lựa chọn lắm\nà, cả đại lục ta là \"vô đối\" vì chỉ có duy nhất\nmình ta là Nghệ Nhân Kết Trái Cây. Biết sợ thì nói\nnhanh, muốn kết hay đổi Mâm Ngũ Quả nào",
    "T45.5104.completeText": "Làm khá lắm!",
    "T45.5104.name": "Đổi Ngũ Quả Thọ",
    "T45.5105.info": "Tết dùng hoa để trang trí sẽ khiến không khí thêm\nấm áp. Thợ Trồng Hoa ở Anh Vũ Cảnh hiện đang rỗi\nrảnh, hãy thu thập Hoa Mai, Hoa Đào, Cây Quất đã\nbị bọn quái vật ở các vùng đất hoang cướp đoạt đến\nnhờ ông ấy trang trí giúp (Lúc nhận phải đảm bảo\ncòn đủ",
    "T45.5105.reqClass": "all",
    "T45.5105.startText": "Hoa Đào, Hoa Mai và Cây Quất ta dùng để trang trí\ntết đã bị bọn quái vật cướp trên đường chuyển đến\nĐông Huyền Thành. Nếu lấy lại được hãy mang đến\nAnh Vũ Cảnh, ta trang trí cho, đảm bảo không đẹp\nkhông tính tiền.",
    "T45.5105.completeText": "Làm khá lắm!",
    "T45.5105.name": "Trang Trí Hoa Tết",
    "T45.5106.info": "Trong nhà có hoa tết trang trí chữ Phúc thì chắc\nchắn sẽ được may mắn. Thợ Trồng Hoa đang trang trí\nmiễn phí hãy mang Hoa ngày Tết và Giấy gói quà chữ\nPhúc đến nhờ ông ấy (Giấy gói quà có thể thu thập\ntừ quái vật ở các vùng đất hoang hoặc mua tại\nShop)",
    "T45.5106.reqClass": "all",
    "T45.5106.startText": "Hoa Đào, Hoa Mai và Cây Quất ta dùng để trang trí\ntết đã bị bọn quái vật cướp trên đường chuyển đến\nĐông Huyền Thành. Nếu lấy lại được hãy mang đến\nAnh Vũ Cảnh, ta trang trí cho, đảm bảo không đẹp\nkhông tính tiền.",
    "T45.5106.completeText": "Làm khá lắm!",
    "T45.5106.name": "Trang Trí Hoa Phúc",
    "T45.5107.info": "Trong nhà có hoa tết trang trí chữ Lộc thì chắc\nchắn sẽ gặp vận may phát tài. Thợ Trồng Hoa đang\ntrang trí miễn phí hãy mang Hoa ngày Tết và Giấy\ngói quà chữ Lộc đến nhờ ông ấy (Giấy gói quà có\nthể thu thập từ quái vật ở các vùng đất hoang hoặc\nmua tại Sh",
    "T45.5107.reqClass": "all",
    "T45.5107.startText": "Hoa Đào, Hoa Mai và Cây Quất ta dùng để trang trí\ntết đã bị bọn quái vật cướp trên đường chuyển đến\nĐông Huyền Thành. Nếu lấy lại được hãy mang đến\nAnh Vũ Cảnh, ta trang trí cho, đảm bảo không đẹp\nkhông tính tiền.",
    "T45.5107.completeText": "Làm khá lắm!",
    "T45.5107.name": "Trang Trí Hoa Lộc",
    "T45.5098.info": "Nhận được Bánh chữ Phúc cả năm sẽ được may mắn\nhạnh phúc. Muốn có hãy mang Bánh ngày Tết và Giấy\ngói quà chữ Phúc đến đổi cho Thợ Làm Bánh. (Giấy\ngói quà có thể thu thập từ quái vật ở các vùng đất\nhoang hoặc mua tại Shop)",
    "T45.5098.reqClass": "all",
    "T45.5098.startText": "Ha ha, tìm ta là sáng suốt đó, cả đại lục không ai\ncó thể làm bánh ngon hơn ta. Muốn ta ra tay thì\nmang nguyên liệu đến đây. Nếu đủ rồi thì chọn đi,\nmuốn làm bánh nào?",
    "T45.5098.completeText": "Làm khá lắm!",
    "T45.5098.name": "Đổi Bánh Chữ Phúc",
    "T45.5099.info": "Bánh làm theo công thức của Chiêu Tài Mao, ai nhận\nđược sẽ được giàu sang phú quý. Muốn có hãy mang\nBánh ngày Tết và Giấy gói quà chữ Lộc đến đổi cho\nThợ Làm Bánh (Giấy gói quà có thể thu thập từ quái\nvật ở các vùng đất hoang hoặc mua tại Shop)",
    "T45.5099.reqClass": "all",
    "T45.5099.startText": "Ha ha, tìm ta là sáng suốt đó, cả đại lục không ai\ncó thể làm bánh ngon hơn ta. Muốn ta ra tay thì\nmang nguyên liệu đến đây. Nếu đủ rồi thì chọn đi,\nmuốn làm bánh nào?",
    "T45.5099.completeText": "Làm khá lắm!",
    "T45.5099.name": "Đổi Bánh Chữ Lộc",
    "T45.5100.info": "Nghe đồn Lão Cổ Thụ sống được ngàn năm là nhờ ăn\nvụng Bánh chữ Thọ của Thợ Làm Bánh. Muốn có hãy\nmang Bánh ngày Tết và Giấy gói quà chữ Thọ đến đổi\ncho ông ấy (Giấy gói quà có thể thu thập từ quái\nvật ở các vùng đất hoang hoặc mua tại Shop)",
    "T45.5100.reqClass": "all",
    "T45.5100.startText": "Ha ha, tìm ta là sáng suốt đó, cả đại lục không ai\ncó thể làm bánh ngon hơn ta. Muốn ta ra tay thì\nmang nguyên liệu đến đây. Nếu đủ rồi thì chọn đi,\nmuốn làm bánh nào?",
    "T45.5100.completeText": "Làm khá lắm!",
    "T45.5100.name": "Đổi Bánh Chữ Thọ",
    "T45.5101.info": "Để kết được Mâm Ngũ Quả hãy đến các vùng đất hoang\nđánh bại bọn quái vật và mang các loại trái cây về\ncho Nghệ Nhân Kết Trái Cây (Lúc nhận phải đảm bảo\ncòn đủ khoảng trống trong Túi đồ)",
    "T45.5101.reqClass": "all",
    "T45.5101.startText": "Lề mề thế, ngươi tưởng ngươi có nhiều lựa chọn lắm\nà, cả đại lục ta là \"vô đối\" vì chỉ có duy nhất\nmình ta là Nghệ Nhân Kết Trái Cây. Biết sợ thì nói\nnhanh, muốn kết hay đổi Mâm Ngũ Quả nào",
    "T45.5101.completeText": "Làm khá lắm!",
    "T45.5101.name": "Kết Mâm Ngũ Quả",
    "T45.5091.info": "Bắt 1 con Gà Tây Tím để đổi lấy 1 quyển \"Sách Dạy\nNấu Gà Tây Giáng Sinh\"",
    "T45.5091.reqClass": "all",
    "T45.5091.startText": "Giáng Sinh đến rồi, nhà hàng định sẽ làm món Gà\nTây đặc biệt, cần nguyên liệu là 1 con Gà Tây phẩm\nchất tím. Nếu ngươi giúp ta tìm được nguyên liệu,\nta sẽ tặng cho ngươi 1 quyển Sách Dạy Nấu Gà Tây\nGiáng Sinh!",
    "T45.5091.completeText": "Sách này tặng cho ngươi",
    "T45.5091.name": "Sách Dạy Nấu Gà Tây Giáng sinh",
    "T45.5092.info": "Bắt 1 con Gà Tây giao cho Âu Dương ở quán rượu để\nchế biến thành Thịt Gà Tây (Nhắc nhở: Nguyên liệu\n\"Hồ Tiêu\" dùng để chế biến món Gà Tây Giáng Sinh\ncó thể thu thập được ở Lê Dương Bắc và Lê Dương\nĐảo)",
    "T45.5092.reqClass": "all",
    "T45.5092.startText": "Trong dịp lễ Giáng Sinh, ngươi chỉ cần đến đây,\ngiao Gà Tây và trả một ít bạc, ta sẽ giúp ngươi\ngia công thành Thịt Gà Tây. Thịt Gà Tây là nguyên\nliệu quan trọng để làm món Gà Tây Giáng Sinh",
    "T45.5092.completeText": "Gia công xong rồi",
    "T45.5092.name": "Gia Công Gà Tây",
    "T45.13142.info": "Tìm 1 ít Công Thức Kỳ Tích Thủy",
    "T45.13142.reqClass": "all",
    "T45.13142.subType": "7-9",
    "T45.13142.startText": "Nghiên Cứu Gia XX cần một ít Công Thức Kỳ Tích\nThủy, ngươi mau giúp thu thập về đi",
    "T45.13142.completeText": "Cảm ơn ngươi!",
    "T45.13142.name": "Tìm Công Thức Kỳ Tích Thủy",
    "T45.5108.info": "Trong nhà có hoa tết trang trí chữ Thọ thì chắc\nchắn sẽ được khỏe mạnh, sống lâu. Thợ Trồng Hoa\nđang trang trí miễn phí hãy mang Hoa ngày Tết và\nGiấy gói quà chữ Lộc đến nhờ ông ấy. (Giấy gói quà\ncó thể thu thập từ quái vật ở các vùng đất hoang\nhoặc mua t",
    "T45.5108.reqClass": "all",
    "T45.5108.startText": "Hoa Đào, Hoa Mai và Cây Quất ta dùng để trang trí\ntết đã bị bọn quái vật cướp trên đường chuyển đến\nĐông Huyền Thành. Nếu lấy lại được hãy mang đến\nAnh Vũ Cảnh, ta trang trí cho, đảm bảo không đẹp\nkhông tính tiền.",
    "T45.5108.completeText": "Làm khá lắm!",
    "T45.5108.name": "Trang Trí Hoa Thọ",
    "T45.13146.info": "Tìm 1 ít Công Thức Ma Năng Dược Tễ",
    "T45.13146.reqClass": "all",
    "T45.13146.subType": "7-9",
    "T45.13146.startText": "Người Chăn Cừu cần một ít Công Thức Ma Năng Dược\nTễ, ngươi mau giúp thu thập về đi",
    "T45.13146.completeText": "Cảm ơn ngươi!",
    "T45.13146.name": "Tìm Công Thức Ma Năng Dược Tễ",
    "T45.13147.info": "Tìm 1 ít Công Thức Thiên Hương Hoàn",
    "T45.13147.reqClass": "all",
    "T45.13147.subType": "7-9",
    "T45.13147.startText": "Trưởng Thôn Stoff\ncần một ít Công Thức Thiên Hương Hoàn, ngươi mau\ngiúp thu thập về đi",
    "T45.13147.completeText": "Cảm ơn ngươi!",
    "T45.13147.name": "Tìm Công Thức Thiên Hương Hoàn",
    "T45.5111.info": "Các cư dân có Bánh chữ Lộc, Ngũ Quả Lộc, Hoa Lộc\nhãy mang đến tặng cho Thần Tài sẽ nhận được Bao lì\nxì Lộc\nchứa vô số vật phẩm quý (Lúc nhận phải đảm bảo còn\nđủ ô trống trong Túi đồ)",
    "T45.5111.reqClass": "all",
    "T45.5111.startText": "Ha ha, năm mới mà gặp ta đảm bảo sẽ phát tài. Hãy\nmang các hộp lễ vật đến cho ta sẽ được tặng một\nbao lì xì may mắn",
    "T45.5111.completeText": "Làm khá lắm!",
    "T45.5111.name": "Đổi Bao Lì Xì Lộc",
    "T45.5112.info": "Các cư dân có Bánh chữ Thọ, Ngũ Quả Thọ, Hoa Thọ\nhãy mang đến tặng cho Thần Tài sẽ nhận được Bao lì\nxì Thọ chứa vô số vật phẩm quý (Lúc nhận phải đảm\nbảo còn đủ ô trống trong Túi đồ)",
    "T45.5112.reqClass": "all",
    "T45.5112.startText": "Ha ha, năm mới mà gặp ta đảm bảo sẽ phát tài. Hãy\nmang các hộp lễ vật đến cho ta sẽ được tặng một\nbao lì xì may mắn",
    "T45.5112.completeText": "Làm khá lắm!",
    "T45.5112.name": "Đổi Bao Lì Xì Thọ",
    "T45.5102.info": "Trưng bày Ngũ Quả Phúc vào dịp tết sẽ được may mắn\nhạnh phúc. Muốn có hãy mang Mâm Ngũ Quả và Giấy\ngói quà chữ Phúc đến đổi ở chỗ Nghệ Nhân Kết Trái\nCây (Giấy gói quà có thể thu thập từ quái vật ở\ncác vùng đất hoang hoặc mua tại Shop)",
    "T45.5102.reqClass": "all",
    "T45.5102.startText": "Lề mề thế, ngươi tưởng ngươi có nhiều lựa chọn lắm\nà, cả đại lục ta là \"vô đối\" vì chỉ có duy nhất\nmình ta là Nghệ Nhân Kết Trái Cây. Biết sợ thì nói\nnhanh, muốn kết hay đổi Mâm Ngũ Quả nào",
    "T45.5102.completeText": "Làm khá lắm!",
    "T45.5102.name": "Đổi Ngũ Quả Phúc",
    "T45.5103.info": "Trưng bày Ngũ Quả Lộc trong dịp tết sẽ được phú\nquý giàu sang. Muốn có hãy mang Mâm Ngũ Quả và\nGiấy gói quà chữ Lộc đến đổi ở chỗ Nghệ Nhân Kết\nTrái Cây (Giấy gói quà có thể thu thập từ quái vật\nở các vùng đất hoang hoặc mua tại Shop)",
    "T45.5103.reqClass": "all",
    "T45.5103.startText": "Lề mề thế, ngươi tưởng ngươi có nhiều lựa chọn lắm\nà, cả đại lục ta là \"vô đối\" vì chỉ có duy nhất\nmình ta là Nghệ Nhân Kết Trái Cây. Biết sợ thì nói\nnhanh, muốn kết hay đổi Mâm Ngũ Quả nào",
    "T45.5103.completeText": "Làm khá lắm!",
    "T45.5103.name": "Đổi Ngũ Quả Lộc",
    "T45.13152.info": "Tìm 1 ít Mướp",
    "T45.13152.reqClass": "all",
    "T45.13152.subType": "7-9",
    "T45.13152.startText": "Nghệ Nhân Lữ Hành đang cần một số Khiên Bán Đằng,\nhãy mau giúp ông ấy!",
    "T45.13152.completeText": "Cảm ơn ngươi!",
    "T45.13152.name": "Tìm Mướp",
    "T45.5143.info": "Đến nơi có nhiều cá để câu 6 con Cá Băng Long giao\ncho Âu Dương ở quán rượu chế biến thành Nhân Cá,\ndùng Nhân Cá này để gói thành Sủi Cảo Hải Sản thơm\nngon nhé!",
    "T45.5143.reqClass": "all",
    "T45.5143.startText": "Vào dịp Tết, ngươi hãy mang những con Cá Kim Long\nmà ngươi câu được đến cho ta và trả một ít chi\nphí, ta sẽ giúp ngươi gia công thành Nhân Cá. Nhân\nCá là nguyên liệu quan trọng dùng để chế biến sủi\ncảo hải sản đấy.。",
    "T45.5143.completeText": "Gia công xong rồi",
    "T45.5143.name": "Gia Công Nhân Cá",
    "T45.5144.info": "Đem 5000 con Cá Trê và Cá Đổng Quéo đổi 1 cuốn\nSách Dạy Nấu Sủi Cảo Hải Sản",
    "T45.5144.reqClass": "all",
    "T45.5144.startText": "Tết đến rồi, trong quán cần rất nhiều cá để làm\nthức ăn, đang cần gấp 5000 con Cá Trê và Cá Đổng\nQuéo. Nếu ngươi có thể giúp, ta sẽ tặng ngươi\nquyển Sách Dạy Nấu Sủi Cảo Hải Sản làm phần thưởng",
    "T45.5144.completeText": "Quyển sách này đã là của ngươi",
    "T45.5144.name": "Sách Dạy Nấu Sủi Cảo Hải Sản",
    "T45.5145.info": "Tộc trưởng Bối Tư nhờ bạn đến Tử Tức Đảo tìm Người\nLái Đò Harker để hỏi thăm về tình hình ở đó",
    "T45.5145.reqClass": "all",
    "T45.5145.startText": "Chúng tôi vừa nhận được tin, đợt sương mù mới ở\nbiên giới Đại Lục đã tan đi, nhưng lại xuất hiện\nmột hòn đảo tràn đầy chết chóc. Ta đã cử Người Lái\nĐò Harker đến đó để điều tra tình hình, nhưng cho\nđến nay vẫn chưa thấy báo tin gì về, ta lo rằng đã\ncó chuyện gì xảy ra với ông ấy. Ngươi hãy nhanh\nchóng đến đó xem sao, nhưng mong sao đừng xảy ra\nrắc rối gì. Thủ Vệ Cảng sẽ đưa ngươi đến đó bằng\nthuyền.",
    "T45.5145.completeText": "Sao? Ngươi được tộc trưởng Bối Tư cử đến à? Vậy\nthì tốt quá!",
    "T45.5145.name": "Tử Tức Đảo 16-1",
    "T45.5146.info": "Người Lái Đò Harker nhờ bạn trở về Đông Huyền\nThành, báo cho tộc trưởng Bối Tư biết tình hình ở\nTử Tức Đảo",
    "T45.5146.reqClass": "all",
    "T45.5146.startText": "Ngay khi ta muốn trở về Đông Huyền Thành thì bỗng\nphát hiện kẻ nào đó đã làm hỏng nó. Hình như ở đây\ncũng bị nhiễu từ trường, mọi thiết bị liên lạc đều\nkhông sử dụng được, ta chẳng biết làm sao cả.\nNhưng giờ ngươi đã đến đây thì tốt quá. Ngươi hãy\nmau hồi báo với tộc trưởng Bối Tư rằng, nơi này có\nmột sức mạnh dị thường. Bọn quái vật trogn rừng\ncũng dường như lớn mạnh hơn! Ngươi hãy mau đi đi!",
    "T45.5146.completeText": "Ngươi nói có một sức mạnh dị thường trên Tử Tức\nĐảo à?",
    "T45.5146.name": "Tử Tức Đảo 16-2",
    "T45.5147.info": "Tộc trưởng Bối Tư lại nhờ bạn quay lại Tử Tức Đảo,\nbắt 1 Hải Tinh Tử Thần Lam mang về cho nghiên cứu\nviên XX nghiên cứu",
    "T45.5147.reqClass": "all",
    "T45.5147.startText": "Xem ra có gì đó mà chúng ta chưa biết đang tồn tại\ntrên Tử Tức Đảo. Nhưng tại sao bọn quái vật ở đó\nlại trở nên lớn mạnh như vậy chứ? Chúng ta phải\nnghiên cứu thật kỹ mới được. Hay là như vầy, ta\nnghe nói trên Tử Tức Đảo có một loại quái vật gọi\nlà Hải Tinh Tử Thần, ngươi hãy đến đó bắt 1 con về\nđây để nghiên cứu viên XX nghiên cứu kỹ. Hãy nhớ\nnếu phẩm chất quái vật quá thấp thì không được đâu\nnhé!",
    "T45.5147.completeText": "Đây là gì vậy? Hải Tinh Tử Thần trên Tử Tức Đảo à?\nTuyệt quá!!!",
    "T45.5147.name": "Tử Tức Đảo 16-3",
    "T45.5148.info": "Nghiên cứu viên XX nhờ bạn báo cho tộc trưởng Bối\nTư biết phát hiện của anh ta.",
    "T45.5148.reqClass": "all",
    "T45.5148.startText": "Ồ, sức mạnh này đúng là thật khó tưởng tượng nổi!\nPhẩm chất của những sinh vật này cao đến lạ\nthường! Rõ ràng rằng, nếu đem chúng giao cho pet\nđể biến hóa thì ắt hẳn pet chúng ta sẽ mạnh lên\nrất nhiều! Ngươi đã làm rất tốt! Ta thưởng cho\nngươi hòn đá này, ngươi hãy mau trở về báo cáo với\ntộc trưởng Bối Tư đi!",
    "T45.5148.completeText": "Ồ, đúng là… thật là… kỳ diệu!",
    "T45.5148.name": "Tử Tức Đảo 16-4",
    "T45.5149.info": "Tộc trưởng Bối Tư nhờ bạn trở về Tử Tức Đảo tìm\nngười lái đò Harker, xem có hỏi được lí do tại sao\nyêu ma biến dị hay không",
    "T45.5149.reqClass": "all",
    "T45.5149.startText": "Đúng vậy, nghiên cứu viên XX đã liên lạc với ta.\nTừ miêu tả của anh ta, ta có thể kết luận rằng: Có\nkẻ nào đó đã làm bùa phép với những sinh vậy ấy,\nmục đích là muốn huấn luyệ chúng trở thành pet ma\nhùng mạnh! Nhưng cụ thể thế nào thì ta vẫn chưa\nrõ, ngươi hãy đến đó hỏi Người Lái Đò Harker xem\nông ta có biết gì không",
    "T45.5149.completeText": "Ngươi nói bọn quái vật bị biến dị là do bùa chú à?\nNếu vậy thì… Đúng rồi! Có lẽ là có liên quan đến\nnơi đó!!!",
    "T45.5149.name": "Tử Tức Đảo 16-5",
    "T45.5150.info": "Người lái đò Harker cho bạn biết, trên đảo có một\nnơi gọi là Thạch Trận Kỳ Quái, có lẽ bạn sẽ phát\nhiện được gì đó",
    "T45.5150.reqClass": "all",
    "T45.5150.startText": "Nếu đúng vậy thì đó quả thật là một nơi rất kỳ lạ!\nNgươi nhìn xem, bên kia có một Thạch Trận kỳ lạ,\ncứ đến đêm là sẽ phát ra ánh sáng màu xanh le lói.\nĐôi khi ta còn nghe thấy âm thanh kỳ lạ phát ra từ\nđó, đáng sợ lắm! Ta không dám đến đó một mình, nếu\nngươi đủ can đảm thì tự mình đi xem thử đi……",
    "T45.5150.completeText": "Ngươi là ai? Đến đây làm gì? Hãy rời khỏi đây đi!",
    "T45.5150.name": "Tử Tức Đảo 16-6",
    "T45.5151.info": "Phù thủy Blair nhờ bạn tiêu diệt 50 Khổng Lồ Lex\nvà 50 Hercules",
    "T45.5151.reqClass": "all",
    "T45.5151.startText": "Ồ, ta còn tưởng có chuyện gì nữa chứ. Đúng vậy, ta\nđã làm pháp thuật để tạo ra những ánh sáng xanh\nvào mỗi tối, nhưng ta cũng phát hiện ra rằng nơi\nnày đã bị bùa thuật, nên ta định xóa bỏ chúng để\ngiải thoát cho các sinh vật trong rừng này đó! Có\nđiều, loại bùa này thật sự quá mạnh, một mình ta\nkhông thể làm được! Nhìn xem, lại là bọn Khổng Lồ\nLex và Hercules đáng ghét đó, ngươi hãy giúp ta\ntiêu diệt chúng đí!",
    "T45.5151.completeText": "Cảm ơn ngươi! Ngươi đã giúp ta thật nhiều!!",
    "T45.5151.name": "Tử Tức Đảo 16-7",
    "T45.5152.info": "Đi tìm người lái đò Harker, cùng ông ta trở về\nĐông Huyền Thành",
    "T45.5152.reqClass": "all",
    "T45.5152.startText": "Được rồi, ta đã bày xong Ma Pháp Trận, lợi dụng\nđặc tính vốn có của Thạch Trận này để tạo ra ma\nthuật mạnh mẽ. Đến lúc đó, các sinh vật trên đảo\nsẽ được giải cứu! Nhưng ta không thể đảm bảo an\ntoàn cho ngươi và người lái đò kia, các ngươi hãy\nnhanh chóng rời khỏi đây đi, nơi này nguy hiểm\nlắm!",
    "T45.5152.completeText": "Trở về Đông Huyền Thành ư? Tại sao chứ?",
    "T45.5152.name": "Tử Tức Đảo 16-8",
    "T45.5153.info": "Bạn cảm thấy hình như đã bị Blair lừa dối, quyết\nđịnh quay lại Thạch Trận để tìm hiểu tình hình",
    "T45.5153.reqClass": "all",
    "T45.5153.startText": "Trong Thạch Trận có một phù thủy đang giải trừ bùa\nchú à? Bà ta bảo chúng ta mau rời khỏi đây hả? Sao\nta cứ cảm thấy rằng ngươi đã bị lừa. Ta ở đây cũng\nlâu rồi, nhưng chưa từng nhìn thấy bóng dáng con\nngười, lẽ nào phù thủy này lại đến đây trước ta?\nLàm sao bà ta biết bùa thuật ở đây là loại bùa\nnào? Bà ta có đảm bảo là giải trừ được nó không?\nCòn nữa, nếu Ma Pháp Trận rất nguy hiểm, sao bà ta\nlại không rời khỏi đó? Kỳ lạ... Tốt nhất ngươi nên\nquay lại đó hỏi cho rõ……",
    "T45.5153.completeText": "Sao ngươi lại quay về đây? Nhưng mọi việc đều đã\nmuộn rồi, ha ha ha!",
    "T45.5153.name": "Tử Tức Đảo 16-9",
    "T45.5154.info": "Đánh bại 80 Phù Thủy Đen, sau đó trở về tìm người\nlái đò Harker",
    "T45.5154.reqClass": "all",
    "T45.5154.startText": "Không ngờ ngươi dễ bị lừa như vậy, ta chỉ không\nmuốn để ngươi ngăn cản ta bày trận pháp bùa chú,\nnên ta đã dụ ngươi đi nơi khác. Giờ ngươi có quay\nlại thì cũng đã muộn rồi! Trận pháp của ta đã được\nhoàn thành, mọi sinh vật ở đây đều sẽ có ma lực\nlớn mạnh vĩnh hằng! Ngươi không thể nào ngăn được\nta đâu! Ha ha ha ha! Ngươi muốn làm gì? Người đâu,\nngăn hắn lại cho ta!",
    "T45.5154.completeText": "Sao thế này? Tên phù thủy này ở đâu ra vậy?",
    "T45.5154.name": "Tử Tức Đảo 16-10",
    "T45.5155.info": "Người lái đò Harker bảo bạn nhanh chóng trở về\nĐông Huyền Thành tìm tộc trưởng Bối Tư, tìm ra\ncách giải quyết",
    "T45.5155.reqClass": "all",
    "T45.5155.startText": "Ta đã nói là ngươi bị lừa rồi mà! Mau, ngươi hãy\nmau trở về Đông Huyền Thành tìm tộc trưởng Bối Tư,\nxem ông ấy có cách để giải quyết rắc rối này hay\nkhông. Ta sẽ ở lại đây giúp ngươi chống đỡ một\nthời gian, nhưng nếu lâu quá thì ta không chịu nổi\nđâu nhé!",
    "T45.5155.completeText": "Ma thuật hắc ám à? Ngươi muốn nói ngươi đã gặp\nphải ma thuật hắc ám sao???",
    "T45.5155.name": "Tử Tức Đảo 16-11",
    "T45.5156.info": "Tộc trưởng Bối Tư nhờ bạn đến tìm Thủ Thư mượn\nThánh Quang Kính, sau đó dùng nó để tiêu diệt phù\nthủy Blair",
    "T45.5156.reqClass": "all",
    "T45.5156.startText": "Ma thuật hắc ám…… Ôi, Ma Vương lại giở trò nữa\nrồi…… Nhưng vấn đề không lớn, ngươi hãy đi tìm Thủ\nThư, nói là ta nhờ ngươi đến mượn Thánh Quang\nKính, còn cách sử dụng thì ta sẽ nói với ngươi\nsau……",
    "T45.5156.completeText": "Sao lại là ngươi nữa? Ồ, tộc trưởng Bối Tư phái\nngươi đến à? Muốn mượn cái gì?",
    "T45.5156.name": "Tử Tức Đảo 16-12",
    "T45.5157.info": "Mang theo Thánh Quang Kính quay lại Tử Tức Đảo tìm\nphù thủy Blair",
    "T45.5157.reqClass": "all",
    "T45.5157.startText": "Thánh Quang Kính à, đển ta tìm xem…… Đây rồi! Cẩn\nthận đừng làm vỡ đấy! Sử dụng nó thế nào à? Rất\nđơn giản, ngươi chỉ cần cầm nó thì có thể phản xạ\nlại sức mạnh của ma lực hắc ám, bảo vệ ngươi khỏi\nsự khống chế của nó! Yên tâm, tuyệt đối an toàn\nmà!",
    "T45.5157.completeText": "Ngươi còn dám quay lại đây sao?!",
    "T45.5157.name": "Tử Tức Đảo 16-13",
    "T45.5158.info": "Dùng Thánh Quang Kính để đánh bại phù thủy Blair,\nsau đó trở về Đông Huyền Thành trả lại Thánh Quang\nKính cho Thủ Thư (Chỉ dưới ảnh hưởng BUFF của thế\nlực hắc ám mới có thể làm bị thương phù thủy\nBlair)",
    "T45.5158.reqClass": "all",
    "T45.5158.startText": "Nếu ngươi đã muốn chết, ta đành phải làm theo ý\nngươi thôi! Xem đây, ma lực hắc ám!",
    "T45.5158.completeText": "Ngươi quay lại rồi a, để ta xem thử kính…… Rất\ntốt, không bị hư hại gì!",
    "T45.5158.name": "Tử Tức Đảo 16-14",
    "T45.5159.info": "Đến gặp tộc trưởng Bối Tư để báo cáo tình hình mới\nnhất",
    "T45.5159.reqClass": "all",
    "T45.5159.startText": "Thánh Quang Kính không bị hư hại gì, ta yên tâm\nrồi…… Ai cần quan tâm ngươi như thế nào chứ? Được\nrồi, ngươi hãy quay về tìm tộc trưởng Bối Tư để\nbáo cho ông ấy biết kết quả",
    "T45.5159.completeText": "Đã xử lý xong mọi chuyện rồi chứ?",
    "T45.5159.name": "Tử Tức Đảo 16-15",
    "T45.5160.info": "Báo với tộc trưởng Bối Tư về tình hình của Tử Tức\nĐảo",
    "T45.5160.reqClass": "all",
    "T45.5160.startText": "Tốt lắm, ngươi làm rất khá! Tuy tạm thời không thể\nphá giải bùa thuật hắc ám, nhưng ta thấy đó không\nphải là vấn đề lớn! Còn về các sinh vật lớn mạnh\nđó, hãy để cho các thành viên dũng cảm đi bắt\nchúng, bắt được rồi thì đưa cho pet của mình để\nbiến hóa, ha ha. Thời gian qua ngươi đã vất vả\nnhiều, đây là phần thưởng giành cho ngươi, xin Cảm\nơn ngươi!",
    "T45.5160.completeText": "Nếu rảnh rỗi, ngưỡi cũng có thể đến Tử Tức Đảo bắt\nmột số sinh vật mang về cho pet biến hóa, ha ha!",
    "T45.5160.name": "Tử Tức Đảo 16-16",
    "T45.5161.info": "Tiêu diệt 10 Hercules và 10 Hải Dương Nữ, sau đó\nbáo cáo với Trưởng Cận Vệ Đông Huyền Thành.",
    "T45.5161.reqClass": "all",
    "T45.5161.subType": "9-10",
    "T45.5161.startText": "Nghe nói gần đây tình hình ở Tử Tức Đảo và Mê\nQuang Tự rất lộn xộn, ngươi hãy đến đó xử lý.",
    "T45.5161.completeText": "Thay mặt dân chúng cảm ơn ngươi!！",
    "T45.5161.name": "Dẹp Loạn",
    "T45.5161.aScriptText": "Ngẫu nhiên nhận được 2 nguyên liệu trang bị và 1\nLệnh bài treo thưởng, phẩm chất nhiệm vụ càng cao\n(trắng<lục<xanh<tím<cam) thì xác suất nhận được\nnguyên liệu cấp cao càng cao",
    "T45.5162.info": "Tiêu diệt 10 Thạch Bia Tinh và 10 Khổng Lồ Lex,\nsau đó báo cáo với Trưởng Cận Vệ Đông Huyền Thành.",
    "T45.5162.reqClass": "all",
    "T45.5162.subType": "9-10",
    "T45.5162.startText": "Nghe nói gần đây tình hình ở Thủ Hộ Địa và Tử Tức\nĐảo rất lộn xộn, ngươi hãy đến đó xử lý.",
    "T45.5162.completeText": "Thay mặt dân chúng cảm ơn ngươi!！",
    "T45.5162.name": "Dẹp Loạn",
    "T45.5162.aScriptText": "Ngẫu nhiên nhận được 2 nguyên liệu trang bị và 1\nLệnh bài treo thưởng, phẩm chất nhiệm vụ càng cao\n(trắng<lục<xanh<tím<cam) thì xác suất nhận được\nnguyên liệu cấp cao càng cao",
    "T45.5163.info": "Tiêu diệt 10 Phù Thủy Đen và 10 Cua Yêu, sau đó\nbáo cáo với Trưởng Cận Vệ Đông Huyền Thành.",
    "T45.5163.reqClass": "all",
    "T45.5163.subType": "9-10",
    "T45.5163.startText": "Nghe nói gần đây tình hình ở Tử Tức Đảo và Mê\nQuang Tự rất lộn xộn, ngươi hãy đến đó xử lý.",
    "T45.5163.completeText": "Thay mặt dân chúng cảm ơn ngươi!！",
    "T45.5163.name": "Dẹp Loạn",
    "T45.5163.aScriptText": "Ngẫu nhiên nhận được 2 nguyên liệu trang bị và 1\nLệnh bài treo thưởng, phẩm chất nhiệm vụ càng cao\n(trắng<lục<xanh<tím<cam) thì xác suất nhận được\nnguyên liệu cấp cao càng cao",
    "T45.5164.info": "Tiêu diệt 10 Sứ Giả Địa Ngục và 10 Hải Tinh Tử\nThần, sau đó báo cáo với Trưởng Cận Vệ Đông Huyền\nThành.",
    "T45.5164.reqClass": "all",
    "T45.5164.subType": "9-10",
    "T45.5164.startText": "Nghe nói gần đây tình hình ở Thủ Hộ Địa và Tử Tức\nĐảo rất lộn xộn, ngươi hãy đến đó xử lý.",
    "T45.5164.completeText": "Thay mặt dân chúng cảm ơn ngươi!！",
    "T45.5164.name": "Dẹp Loạn",
    "T45.5164.aScriptText": "Ngẫu nhiên nhận được 2 nguyên liệu trang bị và 1\nLệnh bài treo thưởng, phẩm chất nhiệm vụ càng cao\n(trắng<lục<xanh<tím<cam) thì xác suất nhận được\nnguyên liệu cấp cao càng cao",
    "T45.5165.info": "Tiêu diệt 10 Phù Thủy Đen và 10 Rùa Nika, sau đó\nbáo cáo với Trưởng Cận Vệ Đông Huyền Thành.",
    "T45.5165.reqClass": "all",
    "T45.5165.subType": "9-10",
    "T45.5165.startText": "Nghe nói gần đây tình hình ở Tử Tức Đảo và Mê\nQuang Tự rất lộn xộn, ngươi hãy đến đó xử lý..",
    "T45.5165.completeText": "Thay mặt dân chúng cảm ơn ngươi!！",
    "T45.5165.name": "Dẹp Loạn",
    "T45.5165.aScriptText": "Ngẫu nhiên nhận được 2 nguyên liệu trang bị và 1\nLệnh bài treo thưởng, phẩm chất nhiệm vụ càng cao\n(trắng<lục<xanh<tím<cam) thì xác suất nhận được\nnguyên liệu cấp cao càng cao",
    "T45.5166.info": "Tiêu diệt 10 Bò Cạp Răng Độc và 10 Hải Tinh Tử\nThần, sau đó báo cáo với Trưởng Cận Vệ Đông Huyền\nThành.",
    "T45.5166.reqClass": "all",
    "T45.5166.subType": "9-10",
    "T45.5166.startText": "Nghe nói gần đây tình hình ở Thủ Hộ Địa và Tử Tức\nĐảo rất lộn xộn, ngươi hãy đến đó xử lý.",
    "T45.5166.completeText": "Thay mặt dân chúng cảm ơn ngươi!！",
    "T45.5166.name": "Dẹp Loạn",
    "T45.5166.aScriptText": "Ngẫu nhiên nhận được 2 nguyên liệu trang bị và 1\nLệnh bài treo thưởng, phẩm chất nhiệm vụ càng cao\n(trắng<lục<xanh<tím<cam) thì xác suất nhận được\nnguyên liệu cấp cao càng cao",
    "T45.5167.info": "Tiêu diệt 1 Lôi Bạo, sau đó báo cáo với Vệ Sĩ Đông\nHuyền Thành.",
    "T45.5167.reqClass": "all",
    "T45.5167.subType": "9-10",
    "T45.5167.startText": "Nghe nói lão đại Lôi Bạo của Tử Tức Đảo gây nhiều\ntội ác, hy vọng có người ra tay tiêu diệt hắn.",
    "T45.5167.completeText": "Đúng là tuổi trẻ tài cao, ha ha!",
    "T45.5167.name": "Lôi Bạo",
    "T45.5167.aScriptText": "Ngẫu nhiên nhận được 2 nguyên liệu trang bị và 1\nLệnh bài treo thưởng, phẩm chất nhiệm vụ càng cao\n(trắng<lục<xanh<tím<cam) thì xác suất nhận được\nnguyên liệu cấp cao càng cao",
    "T45.5168.info": "Bắt 1 Hercules, sau đó báo cáo tình hình với Tôn\nLệ ở tiệm pet.",
    "T45.5168.reqClass": "all",
    "T45.5168.subType": "9-10",
    "T45.5168.startText": "Gần đây, Hercules thường xuyên gây rối ở Tử Tức\nĐảo, để tránh liên lụy đến người dân vô tội, hy\nvọng các hiệp sĩ hãy đến đó chế ngự hắn.",
    "T45.5168.completeText": "Cảm ơn ngươi!!",
    "T45.5168.name": "Hercules",
    "T45.5168.aScriptText": "Ngẫu nhiên nhận được 2 nguyên liệu trang bị và 1\nLệnh bài treo thưởng, phẩm chất nhiệm vụ càng cao\n(trắng<lục<xanh<tím<cam) thì xác suất nhận được\nnguyên liệu cấp cao càng cao",
    "T45.5169.info": "Bắt 1 Phù Thủy Đen, sau đó báo cáo tình hình với\nTôn Lệ ở tiệm pet.",
    "T45.5169.reqClass": "all",
    "T45.5169.subType": "9-10",
    "T45.5169.startText": "Gần đây, Hercules thường xuyên gây rối ở Tử Tức\nĐảo, để tránh liên lụy đến người dân vô tội, hy\nvọng các hiệp sĩ hãy đến đó chế ngự hắn.",
    "T45.5169.completeText": "Cảm ơn ngươi!!",
    "T45.5169.name": "Phù Thủy Đen",
    "T45.5169.aScriptText": "Ngẫu nhiên nhận được 2 nguyên liệu trang bị và 1\nLệnh bài treo thưởng, phẩm chất nhiệm vụ càng cao\n(trắng<lục<xanh<tím<cam) thì xác suất nhận được\nnguyên liệu cấp cao càng cao",
    "T45.5170.info": "Bắt 1 Khổng Lồ Lex, sau đó báo cáo tình hình với\nTôn Lệ ở tiệm pet.",
    "T45.5170.reqClass": "all",
    "T45.5170.subType": "9-10",
    "T45.5170.startText": "Gần đây, Khổng Lồ Lex thường xuyên gây rối ở Tử\nTức Đảo, để tránh liên lụy đến người dân vô tội,\nhy vọng các hiệp sĩ hãy đến đó chế ngự hắn.",
    "T45.5170.completeText": "Cảm ơn ngươi!!",
    "T45.5170.name": "Khổng Lồ Lex",
    "T45.5170.aScriptText": "Ngẫu nhiên nhận được 2 nguyên liệu trang bị và 1\nLệnh bài treo thưởng, phẩm chất nhiệm vụ càng cao\n(trắng<lục<xanh<tím<cam) thì xác suất nhận được\nnguyên liệu cấp cao càng cao",
    "T45.5171.info": "Tiêu diệt 20 Khổng Lồ Lex, sau đó tìm Trưởng\nThương Hội Đông Huyền Thành để nhận thưởng.",
    "T45.5171.reqClass": "all",
    "T45.5171.subType": "9-10",
    "T45.5171.startText": "Gần đây, thương đội gặp rất nhiều sự cố ở Tử Tức\nĐảo, việc này ắt hẳn có liên quan đến bọn quái vật\nở đó. Thương hội hy vọng nhân sĩ các giới giúp đỡ\ntiêu diệt quái vật để giảm bớt tổn thất.",
    "T45.5171.completeText": "Cảm ơn ngươi đã giúp đỡ, thương đội đã được an\ntoàn hơn rồi!",
    "T45.5171.name": "Tử Tức Đảo",
    "T45.5171.aScriptText": "Ngẫu nhiên nhận được 2 nguyên liệu trang bị và 1\nLệnh bài treo thưởng, phẩm chất nhiệm vụ càng cao\n(trắng<lục<xanh<tím<cam) thì xác suất nhận được\nnguyên liệu cấp cao càng cao",
    "T45.5172.info": "Tiêu diệt 20 Phù Thủy Đen, sau đó tìm Trưởng\nThương Hội Đông Huyền Thành để nhận thưởng.",
    "T45.5172.reqClass": "all",
    "T45.5172.subType": "9-10",
    "T45.5172.startText": "Gần đây, thương đội gặp rất nhiều sự cố ở Tử Tức\nĐảo, việc này ắt hẳn có liên quan đến bọn quái vật\nở đó. Thương hội hy vọng nhân sĩ các giới giúp đỡ\ntiêu diệt quái vật để giảm bớt tổn thất.",
    "T45.5172.completeText": "Cảm ơn ngươi đã giúp đỡ, thương đội đã được an\ntoàn hơn rồi!",
    "T45.5172.name": "Tử Tức Đảo",
    "T45.5172.aScriptText": "Ngẫu nhiên nhận được 2 nguyên liệu trang bị và 1\nLệnh bài treo thưởng, phẩm chất nhiệm vụ càng cao\n(trắng<lục<xanh<tím<cam) thì xác suất nhận được\nnguyên liệu cấp cao càng cao",
    "T45.5173.info": "Tiêu diệt 20 Hercules, sau đó tìm Trưởng Cận Vệ\nĐông Huyền Thành để nhận thưởng.",
    "T45.5173.reqClass": "all",
    "T45.5173.subType": "9-10",
    "T45.5173.startText": "Gần đây tình hình trên Tử Tức Đảo rất bất ổn, Vệ\nSĩ đang cần sự trợ giúp của mọi người.",
    "T45.5173.completeText": "Diệt trừ ta ma, bảo vệ chính đạo, đây chính là lúc\nnên cùng hợp sức lại!",
    "T45.5173.name": "Tử Tức Đảo",
    "T45.5173.aScriptText": "Ngẫu nhiên nhận được 2 nguyên liệu trang bị và 1\nLệnh bài treo thưởng, phẩm chất nhiệm vụ càng cao\n(trắng<lục<xanh<tím<cam) thì xác suất nhận được\nnguyên liệu cấp cao càng cao",
    "T45.5174.info": "Tiêu diệt 20 Hải Tinh Tử Thần, sau đó tìm Trưởng\nCận Vệ Đông Huyền Thành để nhận thưởng.",
    "T45.5174.reqClass": "all",
    "T45.5174.subType": "9-10",
    "T45.5174.startText": "Gần đây tình hình trên Tử Tức Đảo rất bất ổn, Vệ\nSĩ đang cần sự trợ giúp của mọi người.",
    "T45.5174.completeText": "Diệt trừ ta ma, bảo vệ chính đạo, đây chính là lúc\nnên cùng hợp sức lại!",
    "T45.5174.name": "Tử Tức Đảo",
    "T45.5174.aScriptText": "Ngẫu nhiên nhận được 2 nguyên liệu trang bị và 1\nLệnh bài treo thưởng, phẩm chất nhiệm vụ càng cao\n(trắng<lục<xanh<tím<cam) thì xác suất nhận được\nnguyên liệu cấp cao càng cao",
    "T45.5175.info": "Thu thập đủ số Ngải Cứu, Đậu Phộng và Gạo Nếp để\nđổi lấy 1 quyển \"Sách Dạy Nấu Bánh Thanh Minh\"",
    "T45.5175.reqClass": "all",
    "T45.5175.startText": "Tiết Thanh Minh đã đến, nhà hàng cần chuẩn bị một\nsố bánh Thanh Minh để bán nên cần gấp rất nhiều\nNgải Cứu, Đậu Phộng và Gạo Nếp. Nếu ngươi có thể\ngiúp ta, ta sẽ tặng ngươi 1 quyển \"Sách Dạy Nấu\nBánh Thanh Minh\" để tạ lễ!",
    "T45.5175.completeText": "Quyển sách này là của ngươi",
    "T45.5175.name": "Sách Dạy Nấu Bánh Thanh Minh",
    "T45.5176.info": "Dùng 1 lá Cờ Tổ Quốc đổi lấy 1 Ngũ Sắc Thần Thạch",
    "T45.5176.reqClass": "all",
    "T45.5176.startText": "Ngươi Cờ Tổ Quốc không? Nếu đưa cho ta 1 lá, ta sẽ\ncho ngươi 1 viên Ngũ Sắc Thần Thạch!",
    "T45.5176.completeText": "Rất tốt! Cảm ơn ngươi!",
    "T45.5176.name": "Đổi - Thẻ Nhân Vật",
    "T45.5177.info": "Dùng 2 lá Cờ Tổ Quốc đổi lấy 1 Lệnh Bài Treo\nThưởng",
    "T45.5177.reqClass": "all",
    "T45.5177.startText": "Ngươi có Cờ Tổ Quốc không? Nếu ngươi dùng 2 lá cờ\nđể đổi, ta sẽ đưa cho ngươi 1 Lệnh Bài Treo Thưởng\nđấy!",
    "T45.5177.completeText": "Rất tốt! Cảm ơn ngươi!",
    "T45.5177.name": "Đổi - Thăng Tinh Thạch",
    "T45.5178.info": "Dùng 2 lá Cờ Tổ Quốc và 1 Xe Tăng đổi lấy 1 tờ Bản\nĐồ Kho Báu",
    "T45.5178.reqClass": "all",
    "T45.5178.startText": "Ngươi có Cờ Tổ Quốc và Xe Tăng không? Nếu ngươi có\n2 lá Cờ Tổ Quốc và 1 Xe Tăng, ta sẽ đổi cho ngươi\n1 tấm Bản Đồ Kho Báu.",
    "T45.5178.completeText": "Rất tốt! Cảm ơn ngươi!",
    "T45.5178.name": "Đổi-Bản Đồ Kho Báu",
    "T45.5179.info": "Dùng 3 Xe Tăng và 3 lá Cờ Tổ Quốc đổi lấy 1 Quy\nNguyên Đơn (Thần Thú)",
    "T45.5179.reqClass": "all",
    "T45.5179.startText": "Ngươi có Cờ Tổ Quốc và Xe Tăng không? Nếu ngươi có\n3 lá Cờ Tổ Quốc và 3 Xe Tăng, ta sẽ đổi cho ngươi\n1 Quy Nguyên Đơn (Thần Thú)!",
    "T45.5179.completeText": "Rất tốt! Cảm ơn ngươi!",
    "T45.5179.name": "Đổi - Sách Tăng 3 Lần EXP (1 Giờ)",
    "T45.5180.info": "Dùng 10 Xe Tăng và 10 Cờ Tổ Quốc đổi lấy 1 tấm Bản\nĐồ Kho Báu Cao Cấp",
    "T45.5180.reqClass": "all",
    "T45.5180.startText": "Ngươi có Cờ Tổ Quốc và Xe Tăng không? Nếu ngươi có\n10 lá Cờ Tổ Quốc và 10 Xe Tăng, ta sẽ đổi cho\nngươi 1 tấm Bản Đồ Kho Báu Cao Cấp!",
    "T45.5180.completeText": "Rất tốt! Cảm ơn ngươi!",
    "T45.5180.name": "Đổi-Bản Đồ Kho Báu Cao Cấp",
    "T45.5181.info": "Dùng 10 Xe Tăng và 10 Cờ Tổ Quốc đổi lấy 1 Thuốc\nTăng Trưởng Pet Siêu Cấp Loại C",
    "T45.5181.reqClass": "all",
    "T45.5181.startText": "Ngươi có Cờ Tổ Quốc không? Có Xe Tăng không? Nếu\nngươi đồng ý đưa cho ta 10 lá Cờ Tổ Quốc và 10 Xe\nTăng, ta sẽ đổi cho ngươi 1 Thuốc Tăng Trưởng Pet\nSiêu Cấp Loại C!",
    "T45.5181.completeText": "Rất tốt! Cảm ơn ngươi!",
    "T45.5181.name": "Đổi-Thuốc Tăng Trưởng Pet Siêu Cấp Loại C",
    "T45.5182.info": "Dùng 15 Cờ Tổ Quốc và 15 Xe Tăng đổi lấy 1 Thuốc\nTăng Trưởng Pet Siêu Cấp Loại D",
    "T45.5182.reqClass": "all",
    "T45.5182.startText": "Ngươi có Cờ Tổ Quốc và Xe Tăng không? Nếu ngươi\nđồng ý đưa cho ta 15 lá Cờ Tổ Quốc và 15 Xe Tăng,\nta sẽ đổi cho ngươi 1 Thuốc Tăng Trưởng Pet Siêu\nCấp Loại D!",
    "T45.5182.completeText": "Rất tốt! Cảm ơn ngươi!",
    "T45.5182.name": "Đổi-Thuốc Tăng Trưởng Pet Siêu Cấp Loại D",
    "T45.5183.info": "Dùng 30 Cờ Tổ Quốc và 30 Xe Tăng đổi lấy 1 Linh\nHồn Thạch Cao Cấp",
    "T45.5183.reqClass": "all",
    "T45.5183.startText": "Ngươi có Cờ Tổ Quốc không? Có Xe Tăng không? Nếu\nngươi đồng ý đưa cho ta 30 lá Cờ Tổ Quốc và 30 Xe\nTăng, ta sẽ đổi cho ngươi 1 Linh Hồn Thạch Cao\nCấp!",
    "T45.5183.completeText": "Rất tốt! Cảm ơn ngươi!",
    "T45.5183.name": "Đổi-Linh Hồn Thạch Cao Cấp",
    "T45.5184.info": "Dùng 50 Xe Tăng và Cờ Tổ Quốc đổi lấy 1 Linh Hồn\nThạch Đặc Cấp",
    "T45.5184.reqClass": "all",
    "T45.5184.startText": "Ngươi có Cờ Tổ Quốc không? Có Xe Tăng không? Nếu\nngươi đồng ý đưa cho ta 50 lá Cờ Tổ Quốc và 50 Xe\nTăng, ta sẽ đổi cho ngươi 1 Linh Hồn Thạch Đặc\nCấp!",
    "T45.5184.completeText": "Rất tốt! Cảm ơn ngươi!",
    "T45.5184.name": "Đổi-Linh Hồn Thạch Đặc Cấp",
    "T45.5185.info": "Đến tầng 1 tìm Pha Lê Ma Hóa và đào 30 Tinh Lạp Ma\nHóa, nhớ cẩn thận đề phòng Lính Hộ Vệ ở đó!",
    "T45.5185.reqClass": "all",
    "T45.5185.startText": "Các ngươi là ai? Sao? Tộc trưởng Bối Tư phái các\nngươi đến đây à? Vậy thì tốt quá! Ta đang tranh\nthủ thời gian sửa lại vết nứt trên phong ấn nhưng\nlại không có đủ vật liệu. Các ngươi hãy nhanh\nchóng giúp ta thu thập 30 Tinh Lạp Ma Hóa, sau đó\nchúng ta sẽ cùng vào tầng 1!",
    "T45.5185.completeText": "Mới đây mà đã thu thập đủ rồi sao? Tuyệt quá!\nChúng ta hãy nhanh chóng vào tầng 1 thôi!",
    "T45.5185.name": "Liệt Diễm Thâm Uyên (1)",
    "T45.5185.aScriptText": "Phần thưởng chưa biết",
    "T45.5109.info": "Các cư dân có Bánh ngày Tết, Mâm Ngũ Quả, Hoa ngày\nTết\nhãy mang đến tặng cho Thần Tài sẽ nhận được Bao lì\nxì đỏ chứa vô số vật phẩm quý (Lúc nhận phải đảm\nbảo còn đủ ô trống trong Túi đồ)",
    "T45.5109.reqClass": "all",
    "T45.5109.startText": "Ha ha, năm mới mà gặp ta đảm bảo sẽ phát tài. Hãy\nmang các hộp lễ vật đến cho ta sẽ được tặng một\nbao lì xì may mắn",
    "T45.5109.completeText": "Làm khá lắm!",
    "T45.5109.name": "Đổi Bao Lì Xì",
    "T45.5187.info": "Đến tầng 3 tiêu diệt Cuồng Ma Liệt Diễm, sau đó\nđánh bại Mamun hầu cận Ma Đế, rồi đến tầng trên\ncùng hội họp với Công Chúa Kamera",
    "T45.5187.reqClass": "all",
    "T45.5187.startText": "Tầng 3 là nơi ở của Mamun - kẻ hầu cận trung thành\ncủa Ma Đế Abate, thực lực của hắn không phải ít!\nNhưng nếu muốn khiêu chiến với hắn, chúng ta phải\ntiêu diệt 9 Cuồng Ma Liệt Diễm ở tầng 3 trước! Hãy\ncẩn thận nhé! Chúng ta sẽ đợi ngươi ở tầng cuối\ncùng!",
    "T45.5187.completeText": "Cuối cùng các ngươi cũng đã đến! Thắng lợi ngay\ntrước mắt rồi! Mau hành động thôi!!!",
    "T45.5187.name": "Liệt Diễm Thâm Uyên (3)",
    "T45.5187.aScriptText": "Phần thưởng chưa biết",
    "T45.5188.info": "Nghĩ mọi cách để đánh bại Ma Đế Abate (Phù Thủy\nLiệt Diễm ở trên không hình như có liên quan đến\nMa Đế, thử đánh bại chúng xem sao)",
    "T45.5188.reqClass": "all",
    "T45.5188.startText": "Giờ chỉ còn 1 việc cuối cùng! Các ngươi hãy tiêu\ndiệt Địa Ngục Ma Đế Abate, như vậy thì ma khí mới\nyếu đi, phong ấn sẽ hoàn thành! Còn nữa, bọn Phù\nThủy Liệt Diễm dường như có liên quan đến Ma Đế\nAbate, hãy diệt sạch chúng, Abate sẽ bị yếu đi.\nCòn chờ gì nữa, hãy hành động thôi!",
    "T45.5188.completeText": "Các ngươi đã thành công rồi! Ma Đế Abate đã bị\nđánh bại! Liệt Diễm Thâm Uyên sắp bị phong ấn! Mọi\nviệc đều đã kết thúc!!!",
    "T45.5188.name": "Liệt Diễm Thâm Uyên (4)",
    "T45.5188.aScriptText": "Phần thưởng chưa biết",
    "T45.5189.info": "Làm theo lời Tân Thủ Sứ, đi tìm Trưởng Thương Hội\nĐông Huyền để đến Bàng Bối Thành.",
    "T45.5189.reqClass": "all",
    "T45.5189.startText": "Ôi, sự việc ngày càng phức tạp hơn. Chúng ta phải\nliên hệ với người dân ở các thành để cùng đối mặt\nvới tình hình này. Phải rồi, ngươi hãy đến gặp\nTrưởng Thương Hội Đông Huyền, có lẽ ông ấy sẽ cho\nngươi biết tiếp theo nên làm gì.",
    "T45.5189.completeText": "Ồ, nghe nói ngươi sắp đến, ta cũng vừa định viết\nthư giới thiệu để ngươi mang đến Bàng Bối Thành!\nSao? Ngươi chưa từng nghe đến Bàng Bối Thành à?",
    "T45.5189.name": "Đến Thăm Bàng Bối Thành",
    "T45.5190.info": "Giao 100 Đậu Phộng cho Âu Dương ở quán rượu để gia\ncông thành Nhân Đậu Phộng, sau đó dùng Nhân Đậu\nPhộng này để chế biến thành Bánh Thanh Minh thơm\nngon nhé",
    "T45.5190.reqClass": "all",
    "T45.5190.startText": "Trong thời gian sự kiện, ngươi mang Đậu Phộng đến\nđây để ta làm Nhân Đậu Phộng dùng chế biến Bánh\nThanh Minh, đương nhiên phải tốn chút phí nha.",
    "T45.5190.completeText": "Làm tốt lắm",
    "T45.5190.name": "Gia Công Nhân Đậu Phộng",
    "T45.5191.info": "100 điểm chiến tích sẽ đổi được 1 Huy Chương Vàng",
    "T45.5191.reqClass": "all",
    "T45.5191.startText": "100 điểm chiến tích sẽ đổi được 1 Huy Chương Vàng",
    "T45.5191.completeText": "Huy chương của ngươi đây",
    "T45.5191.name": "100 Chiến Tích Đổi Huy Chương",
    "T45.5192.info": "500 điểm chiến tích sẽ đổi được 1 Huy Chương Thiếu\nTướng",
    "T45.5192.reqClass": "all",
    "T45.5192.startText": "500 điểm chiến tích sẽ đổi được 1 Huy Chương Thiếu\nTướng",
    "T45.5192.completeText": "Huy chương của ngươi đây",
    "T45.5192.name": "500 Chiến Tích Đổi Huy Chương",
    "T45.5193.info": "1000 điểm chiến tích sẽ đổi được 1 Huy Chương\nThượng Tướng",
    "T45.5193.reqClass": "all",
    "T45.5193.startText": "1000 điểm chiến tích sẽ đổi được 1 Huy Chương\nThượng Tướng",
    "T45.5193.completeText": "Huy chương của ngươi đây",
    "T45.5193.name": "1000 Chiến Tích Đổi Huy Chương",
    "T45.5186.info": "Đến tầng 2 tiêu diệt một số Lính Tuần Tra, sau đó\nđi tìm Đội Trưởng Tuần Tra Carl và đánh bại hắn",
    "T45.5186.reqClass": "all",
    "T45.5186.startText": "Điểm dịch chuyển đến tầng tiếp theo đã xuất hiện,\nchúng ta phải nhanh chân lên! Đội Trưởng Tuần Tra\nCarl và thuộc hạ của hắn đang ở tầng 2, phải đánh\nbại Carl mới có thể vào tầng 3…… Các ngươi hãy\ntiêu diệt bọn Linh Tuần Tra trước, như vậy mới dụ\nđược hắn xuất hiện!",
    "T45.5186.completeText": "Carl đã bị tiêu diệt rồi à?! Tốt quá, chúng ta có\nthể tiếp tục vào tầng 3 rồi!",
    "T45.5186.name": "Liệt Diễm Thâm Uyên (2)",
    "T45.5186.aScriptText": "Phần thưởng chưa biết",
    "T45.5110.info": "Các cư dân có Bánh chữ Phúc, Ngũ Quả Phúc, Hoa\nPhúc hãy mang đến tặng cho Thần Tài sẽ nhận được\nBao lì xì Phúc chứa vô số vật phẩm quý (Lúc nhận\nphải đảm bảo còn đủ ô trống trong Túi đồ)",
    "T45.5110.reqClass": "all",
    "T45.5110.startText": "Ha ha, năm mới mà gặp ta đảm bảo sẽ phát tài. Hãy\nmang các hộp lễ vật đến cho ta sẽ được tặng một\nbao lì xì may mắn",
    "T45.5110.completeText": "Làm khá lắm!",
    "T45.5110.name": "Đổi Bao Lì Xì Phúc",
    "T45.13149.info": "Tìm 1 ít Cá Hồi Xám",
    "T45.13149.reqClass": "all",
    "T45.13149.subType": "7-9",
    "T45.13149.startText": "Tiến Sĩ Ultra đang cần một số con Cá Hồi Xám, hãy\nmau giúp ông ấy!",
    "T45.13149.completeText": "Cảm ơn ngươi!",
    "T45.13149.name": "Tìm Cá Hồi Xám",
    "T45.13150.info": "Tìm 1 ít Cá Tuyết",
    "T45.13150.reqClass": "all",
    "T45.13150.subType": "7-9",
    "T45.13150.startText": "Tiến Sĩ Ultra đang cần một số con Cá Tuyết, hãy\nmau giúp ông ấy!",
    "T45.13150.completeText": "Cảm ơn ngươi!",
    "T45.13150.name": "Tìm Cá Tuyết",
    "T45.13151.info": "Tìm 1 ít Bầu",
    "T45.13151.reqClass": "all",
    "T45.13151.subType": "7-9",
    "T45.13151.startText": "Nghệ Nhân Lữ Hành đang cần một số trái Bầu, hãy\nmau giúp ông ấy!",
    "T45.13151.completeText": "Cảm ơn ngươi!",
    "T45.13151.name": "Tìm Bầu",
    "T45.13153.info": "Tìm 1 ít La Cân Thảo",
    "T45.13153.reqClass": "all",
    "T45.13153.subType": "7-9",
    "T45.13153.startText": "Tinh Thể Học Giả cần một ít La Cân Thảo, ngươi mau\ngiúp thu thập về đi",
    "T45.13153.completeText": "Cảm ơn ngươi!",
    "T45.13153.name": "Tìm La Cân Thảo",
    "T45.13154.info": "Tìm 1 ít Khiên Bán Đằng",
    "T45.13154.reqClass": "all",
    "T45.13154.subType": "7-9",
    "T45.13154.startText": "Tinh Thể Học Giả cần một ít Khiên Bán Đằng, ngươi\nmau giúp thu thập về đi",
    "T45.13154.completeText": "Cảm ơn ngươi!",
    "T45.13154.name": "Tìm Khiên Bán Đằng",
    "T45.5214.info": "Nghe theo ý kiến của Tôn Mỹ Mỹ ở tiệm pet, đi tìm\nDiễn Tập Chiến Đấu để xem đoạn phim về cảnh chiến\nđấu kịch liệt năm xưa",
    "T45.5214.reqClass": "all",
    "T45.5214.startText": "Giờ ngươi đã có trang bị và pet, tiếp theo hãy đi\ntìm hiểu cách chiến đấu! Đừng lo lắng, ngươi hãy\nđi tìm Diễn Tập Chiến Đấu để xem các đoạn phim về\ncảnh chiến đấu của các anh hùng năm xưa! Hãy cố\ngắng nhé!",
    "T45.5214.completeText": "Đơn giản quá phải không? Ta nghĩ ngươi đã nắm bắt\nđược rồi!",
    "T45.5214.name": "Tìm Hiểu Chiến Đấu",
    "T45.5215.info": "Đến Tuyết Lâm câu 5 con cá Ảo Long",
    "T45.5215.reqClass": "all",
    "T45.5215.startText": "Ao hồ ở Đông Huyền Thành chưa được đẹp lắm, nếu\nngươi mang được vài con cá đẹp đến thả vào hồ thì\ntốt quá!",
    "T45.5215.completeText": "Đây là phần thưởng của ngươi",
    "T45.5215.name": "Hồ Đông Huyền - Cá Ảo Long",
    "T45.5215.aScriptText": "Phần thưởng kinh nghiệm",
    "T45.5216.info": "Đến nông trường trồng Lúa Mạch và Lúa Gạo",
    "T45.5216.reqClass": "all",
    "T45.5216.startText": "Nông trường hiện đang cần gấp một số Lúa Mạch và\nLúa Gạo, nếu ngươi giúp ta trồng được một ít thì\ntốt quá!",
    "T45.5216.completeText": "Đây là phần thưởng cho ngươi",
    "T45.5216.name": "Nông Trường Pháp Thuật - Cấp 1",
    "T45.5216.aScriptText": "Phần thưởng kinh nghiệm, có xác suất nhận được hạt\ngiống quý hiếm và vật phẩm nhuộm",
