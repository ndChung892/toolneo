    "T35.21.onServiceText": "Nấm to quá (Nghe nói nhà hàng Âu Dương Đông Huyền\nThành đang thu mua)!",
    "T35.21.name": "Nấm Tươi",
    "T35.22.at": "0-23|0-6|1-31|0-11|MushroomFruit",
    "T35.22.onServiceText": "Nấm to quá (Nghe nói nhà hàng Âu Dương Đông Huyền\nThành đang thu mua)!",
    "T35.22.name": "Nấm Tươi",
