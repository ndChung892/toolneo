    "T29.731.reqClass": "|1|2|3|4|5|6|",
    "T29.731.description": "Người mang lệnh kỳ này sẽ được gia tộc đặc cấp cho\nphép trực tiếp thay đổi các thông báo nhận thưởng\nvà nhận các nhiệm vụ các màu.\n",
    "T29.732.name": "Da Hoàn Mỹ",
    "T29.732.description": "Một tấm da hoàn hảo, không tỳ vết\n",
    "T29.733.name": "Cọc Gỗ",
    "T29.733.description": "Nguyên liệu để làm hàng rào tốt nhất\n",
    "T29.734.name": "Gỗ Bản Thô",
    "T29.734.description": "Nguyên liệu làm xà nhà tốt nhất\n",
    "T29.735.name": "Gỗ Thô Tốt",
    "T29.735.description": "Nguyên liệu này dùng làm gì cũng thật tiếc\n",
    "T29.736.name": "Gỗ Thô Đẹp",
    "T29.736.description": "Nếu làm đồ gia dụng thì nhất định là rất tốt\n",
    "T29.737.name": "Kim Loại Gỉ",
    "T29.737.description": "Chỉ có thể làm chùy bình thường, các thứ khác đều\nkhông thể làm\n",
    "T29.738.name": "Kim Loại Sáng",
    "T29.738.description": "Chỉ có thể làm đầu mũi tên\n",
    "T29.739.name": "Kim Loại Cứng",
    "T29.739.description": "Kim loại cứng rắn như thế, để làm trang bị phòng\nngự là tốt nhất.\n",
    "T29.740.name": "Kim Loại Hảo Hạng",
    "T29.740.description": "Loại kim loại này là nguyên liệu tốt nhất để chế\ntạo bảo kiếm\n",
    "T29.741.name": "Ngọc Vụn",
    "T29.741.description": "Ngoài trừ vết rạn nứt thì vẫn được xem như một\nkhối ngọc tốt\n",
    "T29.742.name": "Ngọc Hoàn Chỉnh",
    "T29.742.description": "Ngoại trừ không có vết nứt ra thì không có gì đặc\nbiệt\n",
    "T29.743.name": "Vụn Thủy Tinh",
    "T29.743.description": "Thật đáng tiếc, thủy tinh tốt như vậy nhưng lại có\nvết nứt.\n",
    "T29.744.name": "Thủy Tinh Hoàn Mỹ",
    "T29.744.description": "Đá thủy tinh trong suốt lấp lánh,\nkhông thể chê vào đâu được\n",
    "T29.745.name": "Vải Lam",
    "T29.745.description": "Vải này dùng để làm đồ phòng ngự\n",
    "T29.746.name": "Vải Thạch Sa",
    "T29.746.description": "Vải này thật bền, so với các loại da bình thường\ncòn tốt hơn.\n",
    "T29.747.name": "Vải Phù Văn",
    "T29.747.description": "Một loại vải đặc biệt, nghe nói có liên quan đến\nsự biến dị của động vật\n",
    "T29.748.name": "Vải Ma Vân",
    "T29.748.description": "Vải được làm từ phù văn bố và thuốc đặc biệt\n",
    "T29.749.name": "Huy Chương Chức Nghiệp Sơ Cấp",
    "T29.749.info": "Nhấp đôi sử dụng",
    "T29.749.reqClass": "|1|2|3|5|6|4|",
    "T29.749.description": "Chúc mừng bạn đã nhận được tư cách phổ cập\n",
    "T29.750.name": "Bàn Địa Sơ Cấp Chứng Nhận",
    "T29.750.info": "Chứng nhận phổ cập",
    "T29.750.reqClass": "|1|",
    "T29.750.description": "Chứng nhận thăng cấp của Bàn Địa tộc, chứng minh\nbạn đủ tư cách thăng cấp Chiến binh sơ cấp.\n",
    "T29.756.name": "Huyền Lâm Sơ Cấp Chứng Nhận",
    "T29.756.info": "Chứng nhận phổ cập",
    "T29.756.reqClass": "|5|",
    "T29.756.description": "Chứng nhận thăng cấp của Huyền Lâm Tộc, chứng minh\nbạn đã đủ tư cách thăng chức thợ săn sơ cấp\n",
    "T29.757.name": "Thiên Khung Sơ Cấp Chứng Nhận",
    "T29.757.info": "Chứng nhận phổ cập",
    "T29.757.reqClass": "|4|",
    "T29.757.description": "Chứng nhận thăng cấp của Thiên Khung Tộc, chứng\nminh bạn đã đủ tư cách thăng chức xạ thủ sơ cấp\n",
    "T29.759.name": "Bàn Địa Trung Cấp Chứng Nhận",
    "T29.759.info": "Chứng nhận phổ cập",
    "T29.759.reqClass": "|1|",
    "T29.759.description": "Chứng nhận thăng cấp của Bàn Địa tộc, chứng minh\nbạn đủ tư cách thăng cấp Chiến binh trung cấp.\n",
    "T29.760.name": "Linh Vũ Sơ Cấp Chứng Nhận",
    "T29.760.info": "Chứng nhận phổ cập",
    "T29.760.reqClass": "|3|",
    "T29.760.description": "Chứng nhận thăng cấp của Linh Vũ tộc, chứng minh\nbạn đủ tư cách thăng cấp Danh y sơ cấp.\n",
    "T29.761.name": "Linh Vũ Trung Cấp Chứng Nhận",
    "T29.761.info": "Chứng nhận phổ cập",
    "T29.761.reqClass": "|3|",
    "T29.761.description": "Chứng nhận thăng cấp của Linh Vũ tộc, chứng minh\nbạn đủ tư cách thăng cấp Danh y trung cấp.\n",
    "T29.762.name": "Huyền Lâm Trung Cấp Chứng Nhận",
    "T29.762.info": "Chứng nhận phổ cập",
    "T29.762.reqClass": "|5|",
    "T29.762.description": "Chứng nhận thăng cấp của Huyền Lâm tộc, chứng minh\nbạn đủ tư cách thăng cấp Thợ săn trung cấp.\n",
    "T29.763.name": "Thiên Khung Trung Cấp Chứng Nhận",
    "T29.763.info": "Chứng nhận phổ cập",
    "T29.763.reqClass": "|4|",
    "T29.763.description": "Chứng nhận thăng cấp của Thiên Khung tộc, chứng\nminh bạn đủ tư cách thăng cấp Xạ thủ trung cấp.\n",
    "T29.766.name": "Liêu Vân Sơ Cấp Chứng Nhận",
    "T29.766.info": "Chứng nhận phổ cập",
    "T29.766.reqClass": "|2|",
    "T29.766.description": "Chứng nhận thăng cấp của Liêu Vân tộc, chứng minh\nbạn đủ tư cách thăng cấp Nhạc công sơ cấp.\n",
    "T29.767.name": "Liêu Vân Trung Cấp Chứng Nhận",
    "T29.767.info": "Chứng nhận phổ cập",
    "T29.767.reqClass": "|2|",
    "T29.767.description": "Chứng nhận thăng cấp của Liêu Vân tộc, chứng minh\nbạn đủ tư cách thăng cấp Nhạc công trung cấp.\n",
    "T29.783.name": "Trứng Gà",
    "T29.783.info": "Không thích tặng Tiên hoa thì tặng cái này là hay\nnhất",
    "T29.783.reqClass": "|1|2|3|4|5|6|",
    "T29.783.description": "Nghe nói bị ném thứ này vào người thì sẽ bị giảm\nnhân khí.\n",
    "T29.784.name": "Thư Hồi Âm",
    "T29.784.reqClass": "|1|2|3|4|6|5|",
    "T29.784.description": "Thư hồi âm viết cho Tộc Trưởng Bối Tư,sau khi thu\nthập đủ 8 thư thì hãy quay vềgiao lại cho Tộc\nTrưởng",
    "T29.787.name": "Thịt Bạch Tuộc",
    "T29.787.description": "Trông có vẻ rất ngon\n",
    "T29.788.name": "Huy Chương Chức Nghiệp Trung Cấp",
    "T29.788.info": "Nhấp đôi sử dụng",
    "T29.788.reqClass": "|1|2|3|5|6|4|",
    "T29.788.description": "Chúc mừng, cấp bậc chức nghiệp của bạn đã tăng\n",
    "T29.789.name": "Kẹp Bắt Thú",
    "T29.789.info": "Tăng 1 điểm bắt pet, dùng khi chiến đấu",
    "T29.789.reqClass": "|1|2|5|3|6|4|",
    "T29.789.description": "Dụng cụ săn bắt thần kỳ có thể gia tăng 1 điểm\nnăng lực săn bắt~Duy trì liên tục trong 10 lượt\nđánh\n",
    "T29.790.name": "Tinh Linh Cầu",
    "T29.790.info": "Tăng 3 điểm bắt pet, dùng khi chiến đấu",
    "T29.790.reqClass": "|1|2|5|3|6|4|",
    "T29.790.description": "Dụng cụ săn bắt thần kỳ có thể gia tăng 3 điểm\nnăng lực săn bắt~Duy trì liên tục trong 10 lượt\nđánh\n",
