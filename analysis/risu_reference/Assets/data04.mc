    "T19.759.reqClass": "|5|",
    "T19.759.description": "Vật phẩm bình thường, dành cho người mới ^^!\n",
    "T19.762.reqClassId": "|2|3|4|",
    "T19.762.name": "Thần Mục Hạng Liên",
    "T19.762.reqClass": "|1|2|3|4|6|5|",
    "T19.762.description": "Viên Bảo Thạchgiống mắt người, tương truyền có vị\nthần vì muốn bảo vệ Đông Huyền mà đã để lại một\ncon mắt của mình để chăm sóc bách tính\n",
    "T19.766.name": "Vô Úy Khôi",
    "T19.766.reqClass": "|1|",
    "T19.766.description": "Tương truyền chỉ có các dũng sỹ của tộc Vô Ưu trải\nqua khảo nghiệm gian khổ mới được mang trang bị\nnày\n",
    "T19.767.name": "Nguyên Soái Khôi",
    "T19.767.reqClass": "|1|",
    "T19.767.description": "Trang bị kế thừa từ các tướng lĩnh tử trận, tuy cũ\nnhưng khả năng phòng hộ khá cao\n",
    "T19.768.name": "Đế Vương Khôi",
    "T19.768.reqClass": "|1|",
    "T19.768.description": "Trang bị của bậc đế vương mà mọi người đều mong\nmột lần được mặc\n",
    "T19.769.name": "Chiến Thần Khôi",
    "T19.769.reqClass": "|1|",
    "T19.769.description": "Trang bị mơ ước của tất cả võ sĩ, có khả năng hoá\ngiải hầu hết mọi đòn tấn công\n",
    "T19.770.name": "Thất Tinh Mão",
    "T19.770.reqClass": "|2|",
    "T19.770.description": "Trang bị chứa năng lượng của thất tinh bắc đẩu với\nsức mạnh tự nhiên rất lớn\n",
    "T19.771.name": "Thương Khung Mão",
    "T19.771.reqClass": "|2|",
    "T19.771.description": "Trang bị chứa sức mạnh thần kỳ của tộc người khổng\nlồ phương Bắc\n",
    "T19.772.name": "Huyền Mục Mão",
    "T19.772.reqClass": "|2|",
    "T19.772.description": "Trang bị không những đẹp mà còn có sức phòng ngự\ntốt, đây là trang bị hiếm có\n",
    "T19.773.name": "Trục Nhật Mão",
    "T19.773.reqClass": "|2|",
    "T19.773.description": "Được làm từ da thần thú Trục Nhật, khó bị tổn hại\nbởi công kích thông thường\n",
    "T19.774.name": "Hạo Nguyệt Khôi",
    "T19.774.reqClass": "|4|",
    "T19.774.description": "Tinh hoa lấy từ ánh trăng và huyền thiết đã làm\nnên trang bị này, giúp nâng khả năng phòng ngự vốn\ncó lên đẳng cấp mới\n",
    "T19.775.name": "Tụ Năng Khôi",
    "T19.775.reqClass": "|4|",
    "T19.775.description": "Có khả năng hấp thu nguyên khí của trời đất, tuy\nchậm nhưng vẫn có ích cho người mặc\n",
    "T19.776.name": "Hậu Nghệ Khôi",
    "T19.776.reqClass": "|4|",
    "T19.776.description": "Trang bị của đông phương tiên giới xạ thủ trong\ntruyền thuyết, thần lực vô song, với một mũi tên\ncó thể bắn hạ nhật nguyệt\n",
    "T19.777.name": "Hủy Diệt Khôi",
    "T19.777.reqClass": "|4|",
    "T19.777.description": "Có thể huỷ diệt trời đất đồng thời khả năng phòng\nngự cao\n",
    "T19.778.name": "Trí Tuệ Mão",
    "T19.778.reqClass": "|3|",
    "T19.778.description": "Trang bị mà thánh hiền dùng để bảo vệ bản thân\n",
    "T19.779.name": "Cứu Thục Mão",
    "T19.779.reqClass": "|3|",
    "T19.779.description": "Trang bị phòng ngự tốt đối với pháp thuật ánh\nsáng, mạnh hơn cả trang bị của Long tộc\n",
    "T19.780.name": "Thánh Đồ Mão",
    "T19.780.reqClass": "|3|",
    "T19.780.description": "Người mặc trang bị này sẽ trở thành hoá thân của\nthiên sứ và sở hữu sức mạnh của thiên sứ\n",
    "T19.781.name": "Thiên Sứ Mão",
    "T19.781.reqClass": "|3|",
    "T19.781.description": "Trang bị của thiên sứ, hấp thu năng lượng có hại,\nsức phòng ngự kinh người\n",
    "T19.782.name": "Lỗ Mãng Khôi",
    "T19.782.reqClass": "|6|",
    "T19.782.description": "Trang bị có sức phòng hộ cao làm từ vàng và tơ tằm\ncao cấp phù hợp cho người có địa vị cao và tài\ngiỏi\n",
    "T19.783.name": "Cuồng Bạo Khôi",
    "T19.783.reqClass": "|6|",
    "T19.783.description": "Trang bị giúp người mặc đạt trạng thái cuồng bạo\nkhi chiến đấu, phòng ngự, sức mạnh và tốc độ đều\ntăng lên đáng kể\n",
    "T19.784.name": "Huyết Ẩm Khôi",
    "T19.784.reqClass": "|6|",
    "T19.784.description": "Tương truyền là trang bị của một tướng quân đời\nxưa mặc tại chiến trường, mang lại hào lực và khả\nnăng chiến đấu vô hạn\n",
    "T19.785.name": "Mạt Nhật Khôi",
    "T19.785.reqClass": "|6|",
    "T19.785.description": "Trang bị cổ xưa làm từ ô kim, ẩn chứa sức mạnh\nthần bí\n",
    "T19.786.name": "Huyền Vũ Mão",
    "T19.786.reqClass": "|5|",
    "T19.786.description": "Huyền Vũ còn được gọi là \"Chân Vũ\", được coi là\nThần phương bắc， trang bị này giúp người mặc may\nmắn, tăng cường sức mạnh\n",
    "T19.787.name": "Chu Tước Mão",
    "T19.787.reqClass": "|5|",
    "T19.787.description": "Chu Tước còn được gọi là \"Huyền Điểu\", được coi là\nThần phương nam, trang bị này giúp người mặc may\nmắn, tăng cường sức mạnh\n",
    "T19.788.name": "Bạch Hổ Mão",
    "T19.788.reqClass": "|5|",
    "T19.788.description": "Bạch Hổ còn được gọi là \"Chiến Thần\", được coi là\nThần phương tây, trang bị này giúp người mặc may\nmắn, tăng cường sức mạnh\n",
    "T19.789.name": "Thanh Long Mão",
    "T19.789.reqClass": "|5|",
    "T19.789.description": "Thanh Long còn được gọi là \"Thương Long\", được coi\nlà Thần phương đông, trang bị này giúp người mặc\nmay mắn, tăng cường sức mạnh\n",
    "T19.790.name": "Vô Úy Hộ Kiên",
    "T19.790.reqClass": "|1|",
