    "T35.143.subType": "3165|3166|3167|3168|3169|3170|3171|3172|3173|3174|3175|3176|3177|3178|3179|3180|50377",
    "T35.143.onServiceText": "BOSS thưởng vàng cho phép khiêu chiến ở những cấp\nđộ khác nhau, nhận được những phần thưởng kim\nphiếu khá lớn. Từ cấp 20 trở đi, đề nghị lập nhóm\nkhiêu chiến.Khiêu chiến cấp 5 thành công sẽ nhận\nđược 1000 ngân phiếuKhiêu chiến cấp 10 thành công\nsẽ nhậ",
    "T35.143.name": "Chiêu Tài Mao",
