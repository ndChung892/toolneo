    "T29.1325.description": "Có thể dùng để mở Ma Huyễn Bảo Rương\n",
    "T29.1326.name": "Túi Quà Pet Lễ Tình Nhân",
    "T29.1326.info": "Nhấp đôi mở túi quà",
    "T29.1326.reqClass": "|1|2|3|4|5|6|",
    "T29.1326.description": "Có thể nhận được pet Thiên Sứ Mít Ướt hoặc Ác Ma\nQuấy Phá bảo bảo phẩm chất 1.5 (cấp độ sử dụng 10)",
    "T29.1327.name": "Túi Quà Tình Duyên",
    "T29.1327.info": "Nhấp đôi mở túi quà",
    "T29.1327.reqClass": "|1|2|3|4|5|6|",
    "T29.1327.description": "Bên trong chứa 9 đoá hoa hồng, thiên nhãn phù,\nhình nhân, tiêu diêu phù, 5 loa, Đông Huyền lệnh\nkỳ, ma huyễn bảo rương, chìa khoá tình duyên\n",
    "T29.1328.name": "Một Bó Hoa Hồng",
    "T29.1328.description": "Bó hoa hồng kết từ vô số cây hoa hồng nhỏ, thể\nhiện hạnh phúc ngọt ngào, rất được các cô gái yêu\nmến.\n",
    "T29.1330.name": "Đông Huyền Lệnh Kỳ (Trắng)",
    "T29.1330.info": "Dùng để nhận nhiệm vụ mới ở Nhiệm Vụ Treo Thưởng",
    "T29.1330.reqClass": "|1|2|3|4|5|6|",
    "T29.1330.description": "Người mang lệnh kỳ này sẽ được gia tộc đặc cấp cho\nphép trực tiếp thay đổi các thông báo nhận thưởng\nvà nhận các nhiệm vụ màu trắng.\n",
    "T29.1331.name": "Đông Huyền Lệnh Kỳ (Lục)",
    "T29.1331.info": "Dùng để nhận nhiệm vụ mới ở Nhiệm Vụ Treo Thưởng",
    "T29.1331.reqClass": "|1|2|3|4|5|6|",
    "T29.1331.description": "Người mang lệnh kỳ này sẽ được gia tộc đặc cấp cho\nphép trực tiếp thay đổi các thông báo nhận thưởng\nvà nhận các nhiệm vụ màu lục.\n",
    "T29.1332.name": "Đông Huyền Lệnh Kỳ (Lam)",
