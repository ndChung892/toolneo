    "T19.1058.reqClassId": "|2|3|4|",
    "T19.1058.name": "Diệu Hắc Hạng Liên",
    "T19.1058.reqClass": "|1|2|3|4|5|6|",
    "T19.1058.description": "Dây chuyền được làm từ hắc thạch, được ếm pháp\nthuật mạnh, mang lại cảm giác an toàn cho người\nđeo\n",
    "T19.1059.reqClassId": "|1|5|6|",
    "T19.1059.name": "Trục Dương Hạng Liên",
    "T19.1059.reqClass": "|1|2|3|4|5|6|",
    "T19.1059.description": "Dây chuyền tạo nên từ kỹ thuật đặc biệt, có thể\ntrục độc tránh tà, giúp tăng sức mạnh cho người\nđeo\n",
    "T19.1060.reqClassId": "|2|3|4|",
    "T19.1060.name": "Diệu Hắc Giới Chỉ",
    "T19.1060.reqClass": "|1|2|3|4|5|6|",
    "T19.1060.description": "Nhẫn được làm từ hắc thạch, được ếm pháp thuật\nmạnh, mang lại cảm giác an toàn cho người đeo\n",
    "T19.1061.reqClassId": "|1|5|6|",
    "T19.1061.name": "Trục Dương Giới Chỉ",
    "T19.1061.reqClass": "|1|2|3|4|5|6|",
    "T19.1061.description": "Nhẫn tạo nên từ kỹ thuật đặc biệt, có thể trục độc\ntránh tà, giúp tăng sức mạnh cho người đeo\n",
    "T19.1062.reqClassId": "|2|3|4|",
    "T19.1062.name": "Dũng Tinh Thạch",
    "T19.1062.reqClass": "|1|2|3|4|5|6|",
    "T19.1062.description": "Giúp mang lại dũng khí cho người đeo\n",
    "T19.1063.reqClassId": "|1|5|6|",
    "T19.1063.name": "Thần Viêm Thạch",
    "T19.1063.reqClass": "|1|2|3|4|5|6|",
    "T19.1063.description": "Ánh sáng lấp lánh trong viên đá tương truyền chính\nlà tinh hỏa ngàn năm, có thể tương giao với chân\nkhí người đeo\n",
    "T19.1064.reqClassId": "|2|3|4|",
    "T19.1064.name": "Nguyên Tố",
    "T19.1064.reqClass": "|1|2|3|4|5|6|",
    "T19.1064.description": "Hộ phù có sức mạnh nguyên tố, lúc quan trọng sẽ\nphát huy sức mạnh bất ngờ\n",
    "T19.1065.reqClassId": "|1|5|6|",
    "T19.1065.name": "Bích Linh Ngọc",
    "T19.1065.reqClass": "|1|2|3|4|5|6|",
    "T19.1065.description": "Ngọc thạch đỏ đẹp mắt, trợ giúp nhiều cho người\nđeo\n",
    "T19.1067.name": "Nghiệt Long Chùy",
    "T19.1067.reqClass": "|1|",
    "T19.1067.description": "Binh khí đặc biệt, được đúc bằng vàng, phía trước\ncó thanh đoản kiếm dài 2 tấc. Chưa rõ nguồn gốc\ncủa nó, tương truyền còn có Nghiệt Long Chùy Pháp\nphối hợp với nó\n",
    "T19.1068.name": "Hồn Xướng Trượng",
    "T19.1068.reqClass": "|3|",
    "T19.1068.description": "Tương truyền có một Tư Tế vĩ đại dùng trượng này\ntiêu diệt quái vật ở các nơi, giúp nhân loại thoát\nkhỏi đại nạn\n",
    "T19.1069.name": "Tử Mẫu Ma Pháp Súng",
    "T19.1069.reqClass": "|4|",
    "T19.1069.description": "Súng kỹ thuật cao, có thể tháo rời, dự trữ năng\nlượng gấp đôi, đồng thời có thể tấn công, khiến kẻ\nđịch khó có thể đề phòng\n",
    "T19.1070.name": "Vô Tình Kiếm",
    "T19.1070.reqClass": "|6|",
    "T19.1070.description": "Dường như hữu tình mà lại vô tình, mũi kiếm điềm\nđạm như bóng đêm, nhưng lại sắc bén như ánh trăng\nlạnh lẽo\n",
    "T19.1071.name": "Dực Phong Cầm",
    "T19.1071.reqClass": "|2|",
    "T19.1071.description": "Vũ khí chế tạo rất tinh xảo, nếu bỏ đi lớp gỉ sét\ntheo năm tháng thì vẫn sáng bóng vô cùng\n",
    "T19.1072.name": "Thiên Cơ Bổng",
    "T19.1072.reqClass": "|5|",
    "T19.1072.description": "Tương truyền có thể chia nó thành 12 loại vũ khí\nkhác nhau, tạo nên uy danh hiển hách\n",
    "T19.1073.name": "Linh Hồn Thủ Vệ Thuẫn",
    "T19.1073.reqClass": "|1|",
    "T19.1073.description": "Phòng ngự tấn công vật lý, còn có thể phòng ngự sự\ntấn công của tinh lực và linh hồn, bảo vệ người\ncầm thuẫn từ mọi hướng\n",
    "T19.1074.name": "Chúng Thần Luận",
    "T19.1074.reqClass": "|3|",
    "T19.1074.description": "Do Giáo Hoàng các đời nắm giữ, ghi lại một số bí\nmật người đời không biết\n",
    "T19.1075.name": "Nộ Long Hộ Uyển",
    "T19.1075.reqClass": "|4|",
    "T19.1075.description": "Thành tựu tâm đắc của thợ rèn bậc thầy, hình dáng\ntựa như con rồng đang nổi giận, bên trong ẩn chứa\nnhiều cơ quan tinh vi\n",
    "T19.1076.name": "Kim Xà Chủy Thủ",
    "T19.1076.reqClass": "|6|",
    "T19.1076.description": "Hình dạng như rắn, toàn thân mạ vàng, linh hoạt và\nsắc bén vô cùng. Lúc ra đòn hay đáp trả đều phát\nra tiếng kêu nhè nhẹ\n",
    "T19.1077.name": "Dực Phong Cầm Cung",
    "T19.1077.reqClass": "|2|",
    "T19.1077.description": "Thân đen tuyền, phát ra ánh sáng xanh, khua nhẹ\nphát ra tiếng kêu ai oán\n",
    "T19.1078.name": "Thất Sát Thủ",
    "T19.1078.reqClass": "|5|",
    "T19.1078.description": "Các thợ rèn phương đông hợp sức đúc thành \"Sát Phá\nLang\", nó là một trong số đó, được gọi là \"Thất\nSát\", ẩn giấu bí mật kinh thiên động địa, nhưng\ntới nay chưa ai giải được, chỉ còn lưu truyền\nnhững câu nói không hoàn chỉnh\n",
    "T19.1079.name": "Thiên Tôn Khôi",
    "T19.1079.reqClass": "|1|",
    "T19.1079.description": "Phát ra sát khí kinh người, sức tấn công thông\nthường không thể phá vỡ sức phòng ngự kiên cố của\nnó. Tương truyền ở điều kiện nhất định nó còn có\nthể phản xạ tấn công ma pháp\n",
    "T19.1080.name": "Thần Uy Mão",
    "T19.1080.reqClass": "|3|",
    "T19.1080.description": "Ẩn chứa sức mạnh thần thánh, khiến người khác phải\nthành kính quỳ bái, không rõ nguồn gốc xuất xứ\n",
    "T19.1081.name": "Tuyệt Ảnh Mão",
    "T19.1081.reqClass": "|5|",
    "T19.1081.description": "Giúp Thợ săn nhanh nhẹn và kiên trì hơn, đến hay\nđi đều nhẹ nhàng như gió\n",
    "T19.1082.name": "Lưu Quang Khôi",
    "T19.1082.reqClass": "|6|",
    "T19.1082.description": "Nhìn sơ thì không có gì đặc biệt, nhưng ánh sáng\ngợn sóng mà nó phát ra khiến người khác cảm nhận\nđược vẻ thần bí và giá trị của nó, đội vào lúc tác\nchiến sẽ bay lượn như ánh sáng vậy\n",
    "T19.1083.name": "Dạ Ma Khôi",
    "T19.1083.reqClass": "|4|",
    "T19.1083.description": "Tương truyền xuất hiện ở âm giới, không rõ chế tạo\ntừ nguyên liệu gì. Các cao nhân tiền bối đã khống\nchế một phần ma tính, nhưng nguồn sức mạnh thần bí\nxuất phát từ đâu thì không ai rõ\n",
    "T19.1084.name": "Diệu Quang Mão",
