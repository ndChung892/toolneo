    "T19.796.name": "Huyền Mục Hộ Kiên",
    "T19.796.reqClass": "|2|",
    "T19.796.description": "Trang bị không những đẹp mà còn có sức phòng ngự\ntốt, đây là trang bị hiếm có\n",
    "T19.797.name": "Trục Nhật Hộ Kiên",
    "T19.797.reqClass": "|2|",
    "T19.797.description": "Được làm từ da thần thú Trục Nhật, khó bị tổn hại\nbởi công kích thông thường\n",
    "T19.798.name": "Hạo Nguyệt Hộ Kiên",
    "T19.798.reqClass": "|4|",
    "T19.798.description": "Tinh hoa lấy từ ánh trăng và huyền thiết đã làm\nnên trang bị này, giúp nâng khả năng phòng ngự vốn\ncó lên đẳng cấp mới\n",
    "T19.799.name": "Tụ Năng Hộ Kiên",
    "T19.799.reqClass": "|4|",
    "T19.799.description": "Có khả năng hấp thu nguyên khí của trời đất, tuy\nchậm nhưng vẫn có ích cho người mặc\n",
    "T19.800.name": "Hậu Nghệ Hộ Kiên",
    "T19.800.reqClass": "|4|",
    "T19.800.description": "Trang bị của đông phương tiên giới xạ thủ trong\ntruyền thuyết, thần lực vô song, với một mũi tên\ncó thể bắn hạ nhật nguyệt\n",
    "T19.801.name": "Hủy Diệt Hộ Kiên",
    "T19.801.reqClass": "|4|",
    "T19.801.description": "Có thể huỷ diệt trời đất đồng thời khả năng phòng\nngự cao\n",
    "T19.802.name": "Trí Tuệ Hộ Kiên",
    "T19.802.reqClass": "|3|",
    "T19.802.description": "Trang bị mà thánh hiền dùng để bảo vệ bản thân\n",
    "T19.803.name": "Cứu Thục Hộ Kiên",
    "T19.803.reqClass": "|3|",
    "T19.803.description": "Trang bị phòng ngự tốt đối với pháp thuật ánh\nsáng, mạnh hơn cả trang bị của Long tộc\n",
    "T19.804.name": "Thánh Đồ Hộ Kiên",
    "T19.804.reqClass": "|3|",
    "T19.804.description": "Người mặc trang bị này sẽ trở thành hoá thân của\nthiên sứ và sở hữu sức mạnh của thiên sứ\n",
    "T19.805.name": "Thiên Sứ Hộ Kiên",
    "T19.805.reqClass": "|3|",
    "T19.805.description": "Trang bị của thiên sứ, hấp thu năng lượng có hại,\nsức phòng ngự kinh người\n",
    "T19.806.name": "Lỗ Mãng Hộ Kiên",
    "T19.806.reqClass": "|6|",
    "T19.806.description": "Trang bị có sức phòng hộ cao làm từ vàng và tơ tằm\ncao cấp phù hợp cho người có địa vị cao và tài\ngiỏi\n",
    "T19.807.name": "Cuồng Bạo Hộ Kiên",
    "T19.807.reqClass": "|6|",
    "T19.807.description": "Trang bị giúp người mặc đạt trạng thái cuồng bạo\nkhi chiến đấu, phòng ngự, sức mạnh và tốc độ đều\ntăng lên đáng kể\n",
    "T19.808.name": "Huyết Ẩm Hộ Kiên",
    "T19.808.reqClass": "|6|",
    "T19.808.description": "Tương truyền là trang bị của một tướng quân đời\nxưa mặc tại chiến trường, mang lại hào lực và khả\nnăng chiến đấu vô hạn\n",
    "T19.809.name": "Mạt Nhật Hộ Kiên",
    "T19.809.reqClass": "|6|",
    "T19.809.description": "Trang bị cổ xưa làm từ ô kim, ẩn chứa sức mạnh\nthần bí\n",
    "T19.810.name": "Huyền Vũ Hộ Kiên",
    "T19.810.reqClass": "|5|",
    "T19.810.description": "Huyền Vũ còn được gọi là \"Chân Vũ\", được coi là\nThần phương bắc, trang bị này giúp người mặc may\nmắn, tăng cường sức mạnh\n",
    "T19.811.name": "Chu Tước Hộ Kiên",
    "T19.811.reqClass": "|5|",
    "T19.811.description": "Chu Tước còn được gọi là \"Huyền Điểu\", được coi là\nThần phương nam, trang bị này giúp người mặc may\nmắn, tăng cường sức mạnh\n",
    "T19.812.name": "Bạch Hổ Hộ Kiên",
