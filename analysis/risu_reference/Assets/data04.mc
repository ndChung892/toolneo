    "T19.1284.name": "Cánh Thiên Cang",
    "T19.1284.reqClass": "|1|2|3|4|5|6|",
    "T19.1284.description": "Trang bị thần bí không rõ nguồn gốc, được\nlàm từ 1 loại vật liệu của nền văn minh cổ đại,\nđộ cứng của nó có thể ngăn chặn mọi vũ khí.\n",
    "T19.1285.name": "Sừng Tử Điện",
    "T19.1285.reqClass": "|1|2|3|4|5|6|",
    "T19.1285.description": "Nguyên tố gió và nước giao hòa tạo thành\nluồng sấm sét tím đáng sợ, trang bị này có\nthể làm chủ được năng lượng ấy.\n",
    "T19.1286.name": "Sừng Ngọ Liệt",
    "T19.1286.reqClass": "|1|2|3|4|5|6|",
    "T19.1286.description": "Trong xương của khổng lồ Hư Không Mạc có\nchứa sức mạnh nham thạch viễn cổ, trang bị này\nlàm từ xương của chúng và cũng có sức mạnh ấy.\n",
    "T19.1287.name": "Sừng Thương Hỏa",
    "T19.1287.reqClass": "|1|2|3|4|5|6|",
    "T19.1287.description": "Thương Hỏa là ngọn lửa trong người của Hỏa\nTinh Linh, dùng lửa này để chế tạo ra trang bị\ncó sức mạnh kinh người nhưng khó khống chế\n",
    "T19.1288.name": "Sừng Phi Trần",
    "T19.1288.reqClass": "|1|2|3|4|5|6|",
    "T19.1288.description": "Mặt đất rắn chắc khi hóa thành bụi thì lại nhẹ\nnhàng,\ntrang bị này mang trong mình sức mạnh giao hòa\n2 tính chất rắn mà nhẹ của nguyên tố địa\n",
    "T19.1289.name": "Sừng Lam Minh",
    "T19.1289.reqClass": "|1|2|3|4|5|6|",
    "T19.1289.description": "Lam Minh là thần thú chuyên ăn ký ức được tạo\nthành từ 4 nguyên tố, tương truyền có 1 thợ săn\nvĩ đại đã bắt và dùng tinh thể của nó làm ra trang\nbị này\n",
    "T19.1290.name": "Chuông Tử Điện",
    "T19.1290.reqClass": "|1|2|3|4|5|6|",
