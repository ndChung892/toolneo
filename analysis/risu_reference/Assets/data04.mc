    "T19.743.reqClass": "|5|",
    "T19.743.description": "Chống các tổn thương do đao kiếm hoặc ma pháp\n",
    "T19.744.name": "Thần Quang Ngoa",
    "T19.744.reqClass": "|5|",
    "T19.744.description": "Chất liệu tuyệt đỉnh tự tỏa sáng giống như ánh\nsáng bình minh\n",
    "T19.745.name": "Vi Lộ Ngoa",
    "T19.745.reqClass": "|5|",
    "T19.745.description": "Được làm từ vỏ cây nhưng sức phòng ngự còn cao hơn\ncả sắt thép\n",
    "T19.746.name": "Phá Hy Ngoa",
    "T19.746.reqClass": "|5|",
    "T19.746.description": "Làm bằng da gấu bền chắc, lại được gia công tỷ mỉ\nnên rất tốt\n",
