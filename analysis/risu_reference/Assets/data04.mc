    "T45.50446.aScriptText": "Chưa biết",
    "T45.50420.info": "Không dùng BUFF Túi Thù Du mới hoàn thành khiêu\nchiến",
    "T45.50420.reqClass": "all",
    "T45.50420.startText": "Bộ muốn đánh lộn lắm hả?",
    "T45.50420.completeText": "Hứ",
