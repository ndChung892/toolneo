    "T19.916.name": "Huyền Vũ Khố",
    "T19.916.reqClass": "|5|",
    "T19.916.description": "Huyền Vũ còn được gọi là \"Chân Vũ\", được coi là\nThần phương bắc, trang bị này giúp người mặc may\nmắn, tăng cường sức mạnh\n",
    "T19.932.name": "Đơn Thân Giới Chỉ",
    "T19.932.reqClass": "|4|6|5|3|2|1|",
    "T19.932.description": "Chiếc nhẫn dành cho người đang độc thân hoặc tôn\nthờ chủ nghĩa độc thân\n",
    "T19.940.name": "Thanh Cang Chủy Thủ",
    "T19.940.reqClass": "|6|",
    "T19.940.description": "Thân dao sắc nhọn vô cùng do không hề có tạp chất\n",
    "T19.941.name": "Thích Tâm Chùy",
    "T19.941.reqClass": "|6|",
    "T19.941.description": "Được luyện bằng gang tinh chế thượng đẳng, bên\nngoài mạ một lớp kim loại mỏng, mũi chùy nhọn sắc\nnhọn, là tượng trưng của sự khiếp đảm và cái chết\n",
    "T19.942.name": "Tước Kim Chủy Thủ",
    "T19.942.reqClass": "|6|",
    "T19.942.description": "Chủy Thủ này có thể chém sắt như chém bùn. Có được\ncây Chủy Thủ này trong tay, khắp thiên hạ đều nằm\ntrong tay ta\n",
    "T19.943.name": "Bích Huyết Chủy Thủ",
    "T19.943.reqClass": "|6|",
    "T19.943.description": "Tương truyền đầu Chủy Thủ có công năng hút máu, có\nthể nâng cao uy lực\n",
    "T19.944.name": "Khô Mộc Long Cầm",
    "T19.944.reqClass": "|2|",
    "T19.944.description": "Khi đàn, âm thanh nghe như rồng thiêng đang gào\nthét bên tai. Nghe nói cây đàn này có bí mật chưa\nđược khám phá, không biết ai có thể khám nó\n",
    "T19.945.name": "Cuồng Chiến Bổng",
    "T19.945.reqClass": "|5|",
    "T19.945.description": "Là một trong những vũ khí của cuồng chiến sĩ.\nCuồng chiến sĩ sau khi cuồng hóa có thể tăng tăng\ncường khả năng phòng vệ lẫn công kích của bản thân\nlên cực đại, hiện nay số lượng người tộc cuồng\nchiến sĩ còn rất ít\n",
    "T19.946.name": "Tử Kim Bổng",
    "T19.946.reqClass": "|5|",
    "T19.946.description": "Được làm bằng Ô Kim, bóng loáng, khí thế hơn\nngười, thân bổng cứng chắc, nếu không phải người\ncó sức mạnh vô song thì không thể sử dụng\n",
    "T19.947.name": "Tu La Bổng",
    "T19.947.reqClass": "|5|",
    "T19.947.description": "Chủ nhân trước của vũ khí này đã dùng nó chiến đấu\ntrong trăm trận chiến lớn đại kích Đông Huyền\nThành\n",
    "T19.948.name": "Du Long Bổng",
    "T19.948.reqClass": "|5|",
    "T19.948.description": "Tương truyền là một vũ khí của kẻ mạnh kiếp trước,\ntự đặt tên là \"du long\", nghe nói người này chưa\nbại trận bao giờ\n",
    "T19.950.name": "Gia Tốc Súng",
    "T19.950.reqClass": "|4|",
    "T19.950.description": "Súng được chế tạo theo nguyên lý điện từ, uy lực\nlớn không thể coi khinh\n",
    "T19.951.name": "Đẳng Ly Tử Súng",
    "T19.951.reqClass": "|4|",
    "T19.951.description": "Plasma là trạng thái vật chất thứ tư sau thể rắn,\nthể lỏng, thể khí. Súng đặc chế từ nguyên liệu đó\ncó thể tiêu diệt mục tiêu trong chớp mắt\n",
    "T19.952.name": "Dụ Đảo Quang Tốc Súng",
    "T19.952.reqClass": "|4|",
    "T19.952.description": "Đây là loại kỹ thuật dường như không thể giải\nthích được, là phương\npháp tạo ra \"vũ khí ánh sáng có thể chuyển hướng\",\ndù ở đâu cũng đều có thể bắn trúng mục tiêu\n",
    "T19.953.name": "Tịch Diệt Ma Pháp Súng",
    "T19.953.reqClass": "|4|",
    "T19.953.description": "Sự kết hợp giữa kỹ thuật cao và ma pháp thần kỳ\n,có sức công kích đáng sợ\n",
    "T19.954.name": "Khu Ma Thần Trượng",
    "T19.954.reqClass": "|3|",
    "T19.954.description": "Trượng luôn giúp chủ nhân của nó giữ được trạng\nthái chiến đấu tốt nhất, đặc biệt nó có năng lực\nkhống chế yêu ma rất tốt\n",
    "T19.955.name": "Thánh Quang Chùy",
    "T19.955.reqClass": "|1|",
    "T19.955.description": "Chùy chiến có thêm thần lực \"Thánh quang\" có sức\ntàn phá ghê gớm mà con người không theo kịp, trong\nthiên hạ người sở hữu nó chỉ đếm trên đầu ngón tay\n",
    "T19.956.name": "Thủ Vệ Thuẫn",
    "T19.956.reqClass": "|1|",
    "T19.956.description": "Truyền thuyết kể rằng là cái khiên của người bảo\nvệ thần mộ, có thể ngăn chặn vật phòng vệ của thần\nlực, người bình thường không thể phá vỡ\n",
    "T19.957.name": "Mật Vương Kinh",
    "T19.957.reqClass": "|3|",
    "T19.957.description": "Đây là quyển sách mà các tín đồ mong có nhất\n",
    "T19.958.name": "Quang Minh Thánh Điển",
    "T19.958.reqClass": "|3|",
    "T19.958.description": "Cuốn sách ghi chép những ma pháp về ánh sáng, bóng\ntối\n",
    "T19.959.name": "Long Ngữ Mật Điển",
    "T19.959.reqClass": "|3|",
    "T19.959.description": "Nghe nói ma pháp long ngữ thần bí và đồ sộ, người\ncó thể xem và hiểu được ngôn ngữ này là rất ít\n",
    "T19.960.name": "Thần Thánh Hộ Tịch",
    "T19.960.reqClass": "|3|",
    "T19.960.description": "Một loại sách thần thánh mà người bình thường\nkhông thể lĩnh ngộ, tương truyền là \"thiên thư\" mà\nthần thánh để lại nhân gian\n",
    "T19.961.name": "Thánh Linh Hộ Uyển",
    "T19.961.reqClass": "|4|",
    "T19.961.description": "Là giáp bảo vệ tay thần kỳ nghe nói có thể hóa\ngiải năng lượng âm ma, khiến người sử dụng luôn\ngiữ được trạng thái chiến đấu sung sức nhất\n",
    "T19.962.name": "Thương Long Hộ Uyển",
    "T19.962.reqClass": "|4|",
    "T19.962.description": "Được làm từ răng rồng và da rồng ngàn năm, khả\nnăng phòng ngự của chất liệu này có thể khiến cho\nngười sử dụng ở vào thế bất bại\n",
    "T19.963.name": "Phệ Hồn Hộ Uyển",
    "T19.963.reqClass": "|4|",
    "T19.963.description": "Đặc điểm lớn nhất của giáp bảo vệ tay này là sau\nkhi tiêu diệt kẻ địch có thể hút linh hồn của họ,\nnghe nói hút được càng nhiều linh hồn năng lực của\nnó càng mạnh\n",
    "T19.964.name": "Thiên Ma Hộ Uyển",
    "T19.964.reqClass": "|4|",
    "T19.964.description": "Giáp bảo vệ tay có năng lực đặc biệt của ma pháp\nkèm theo, có thể trực tiếp làm khiếp sợ tâm trí\nđịch, nhưng nếu đụng độ với kẻ địch mạnh hơn hẳn\nta về mọi mặt thì sẽ phản tác dụng\n",
    "T19.965.name": "Hắc Ngọc Cầm Cung",
    "T19.965.reqClass": "|2|",
    "T19.965.description": "Được làm bằng chất liệu cao cấp cẩn thêm ngọc đen\nvà kỹ thuật tinh chế bảo đảm độ cứng chắc của nó,\ncó thể dùng làm vũ khí\n",
    "T19.966.name": "Bí Ngân Cầm Cung",
    "T19.966.reqClass": "|2|",
    "T19.966.description": "Được làm từ bí ngân nguyên liệu ma pháp quý hiếm,\nbí ngân là nguyên liệu quan trọng trong các đồ ma\npháp, có tác dụng truyền dẫn ma pháp ưu việt\n",
    "T19.967.name": "Xích Tinh Cầm Cung",
    "T19.967.reqClass": "|2|",
    "T19.967.description": "Cung phát sáng đỏ lấp lánh, giúp phát huy tối đa\ntính năng của đàn\n",
    "T19.968.name": "Khô Mộc Thần Cung",
    "T19.968.reqClass": "|2|",
    "T19.968.description": "Hình dạng bình thường nhưng uy lực bên trong vô\ncùng dũng mãnh, có thể thi triển ma pháp siêu việt\n",
    "T19.969.name": "Kim Cương Thủ",
    "T19.969.reqClass": "|5|",
    "T19.969.description": "Được luyện bằng gang tinh chế, các khớp nối mềm\ndẻo khiến người sử dụng dể cử động, ngoài năng lực\nphòng ngự mạnh mẽ ra nó còn có tác dụng công kích\nđối phương\n",
    "T19.970.name": "Cự Mãng Thủ",
    "T19.970.reqClass": "|5|",
    "T19.970.description": "Được tinh chế từ da rắn ngàn năm tuổi trong rừng\nĐông Huyền, găng tay có khă năng phòng ngự vật lý\nvà ma pháp tốt, nhưng không nên đeo nó quá lâu\n",
    "T19.971.name": "Cầu Long Thủ",
    "T19.971.reqClass": "|5|",
    "T19.971.description": "Được làm từ da con hải trùng long sống lâu năm\ndưới biển sâu, có được nó là có được sức mạnh của\nÁ Long tộc(tộc nửa người nửa rồng).Găng tay có sức\nphòng ngự không thể tưởng tượng,và có thiết bị\nđược đặc chế từ thân thể long tộc\n",
    "T19.972.name": "Viêm Ma Thủ",
    "T19.972.reqClass": "|5|",
    "T19.972.description": "Trong môi trường cạnh tranh khốc liệt, viêm ma đã\ncó năng lực sinh tồn cực mạnh, lại thêm bản thân\nviêm ma là ma thú loại nguyên tố, có sức chống cự\nkinh hoàng, vượt hơn hẳn long tộc.Găng tay được\nlàm từ lông của viêm ma\n",
    "T19.973.reqClassId": "|2|3|4|",
    "T19.973.name": "Huỳnh Quang Hạng Liên",
    "T19.973.reqClass": "|1|2|3|5|6|4|",
    "T19.973.description": "Dây chuyền được làm từ đá huỳnh quang, ban đêm có\nthể phát ra ánh sáng huyền ảo,rất đẹp\n",
    "T19.974.reqClassId": "|2|3|4|",
    "T19.974.name": "Hấp Huyết Hạng Liên",
    "T19.974.reqClass": "|1|2|3|5|6|4|",
    "T19.974.description": "Nghe nói người đeo dây chuyền này bỗng nhiên có\ncông năng hút máu, nhưng trên thực tế điều ấy vẫn\ncòn phải chứng minh\n",
    "T19.975.reqClassId": "|2|3|4|",
    "T19.975.name": "Xá Lợi Hạng Liên",
    "T19.975.reqClass": "|1|2|3|5|6|4|",
    "T19.975.description": "Xá lợi tử còn gọi là \"linh cốt\", theo cách nói của\nngười dân Đông Huyền thành thì nó là kết tinh\nthành quả nghiên cứu của những nhân sĩ cao thâm\n",
    "T19.976.reqClassId": "|2|3|4|",
    "T19.976.name": "Ma Long Hạng Liên",
    "T19.976.reqClass": "|1|2|3|5|6|4|",
    "T19.976.description": "Đây là dây chuyền nghe nói đã được đánh dấu trước\nkhi ma pháp ngân long ra đời ,nằm sâu dưới đất đợi\nchủ nhân đời sau khai quật\n",
    "T19.977.reqClassId": "|1|5|6|",
    "T19.977.name": "Tinh Kim Hạng Liên",
    "T19.977.reqClass": "|1|2|3|5|6|4|",
    "T19.977.description": "Được làm bằng vàng ròng, đẹp và chắc chắn, có vị\nnhân sĩ rất ưa thích và lùng kiếm nó suốt mấy trăm\nnăm\n",
    "T19.978.reqClassId": "|1|5|6|",
    "T19.978.name": "Long Nhãn Hạng Liên",
    "T19.978.reqClass": "|1|2|3|5|6|4|",
    "T19.978.description": "Dây chuyền được mô phỏng theo mắt rồng, nhưng\ntrong nó ẩn chứa năng lực phát tán, rất kỳ dị\n",
    "T19.979.reqClassId": "|1|5|6|",
    "T19.979.name": "Bồ Đề Hạng Liên",
    "T19.979.reqClass": "|1|2|3|5|6|4|",
    "T19.979.description": "Bồ đề có nghĩa khoan dung độ lượng, đại từ đại bi,\nbiết phân biệt thiện ác, giác ngộ chân lý. Người\nđeo chúng cũng trở nên hiền hòa hơn\n",
    "T19.980.reqClassId": "|1|5|6|",
    "T19.980.name": "Bàn Long Hạng Liên",
    "T19.980.reqClass": "|1|2|3|5|6|4|",
    "T19.980.description": "Kiểu dáng hết sức bình thường,nhưng không ngờ rằng\nbên trong lại ẩn chứa nhiều sức mạnh thần kỳ\nthế.Người đeo được sợi dây chuyền , cả thân người\ntoát lên vẻ uy nghiêm của một con rồng\n",
    "T19.981.reqClassId": "|2|3|4|",
    "T19.981.name": "Huỳnh Quang Giới Chỉ",
    "T19.981.reqClass": "|1|2|3|5|6|4|",
    "T19.981.description": "Nhẫn được làm từ đá huỳnh quang, ban đêm có thể\nphát ra ánh sáng huyền ảo, rất đẹp\n",
    "T19.982.reqClassId": "|2|3|4|",
    "T19.982.name": "Hấp Huyết Giới Chỉ",
    "T19.982.reqClass": "|1|2|3|5|6|4|",
    "T19.982.description": "Nghe nói người đeo nhẫn này bỗng nhiên có khả năng\nhút máu, nhưng trên thực tế điều ấy vẫn còn phải\nchứng minh\n",
    "T19.983.reqClassId": "|2|3|4|",
    "T19.983.name": "Xá Lợi Giới Chỉ",
    "T19.983.reqClass": "|1|2|3|5|6|4|",
    "T19.983.description": "Xá lợi tử còn gọi là \"linh cốt\", theo cách nói của\nngười dân Đông Huyền thành thì nó là kết tinh\nthành quả nghiên cứu của những nhân sĩ cao thâm\n",
    "T19.984.reqClassId": "|2|3|4|",
    "T19.984.name": "Ma Long Giới Chỉ",
    "T19.984.reqClass": "|1|2|3|5|6|4|",
    "T19.984.description": "Đây là chiếc nhẫn nghe nói đã được đánh dấu trước\nkhi ma pháp ngân long ra đời, nằm sâu dưới đất đợi\nchủ nhân đời sau khai quật\n",
    "T19.985.reqClassId": "|1|5|6|",
    "T19.985.name": "Tinh Kim Giới Chỉ",
    "T19.985.reqClass": "|1|2|3|5|6|4|",
    "T19.985.description": "Được làm bằng vàng ròng, đẹp và chắc chắn, có vị\nnhân sĩ rất ưa thích và lùng kiếm nó suốt mấy trăm\nnăm\n",
    "T19.986.reqClassId": "|1|5|6|",
    "T19.986.name": "Long Nhãn Giới Chỉ",
    "T19.986.reqClass": "|1|2|3|5|6|4|",
    "T19.986.description": "Nhẫn được mô phỏng theo mắt rồng, nhưng trong nó\nẩn chứa năng lực phát tán, rất kỳ dị\n",
    "T19.987.reqClassId": "|1|5|6|",
    "T19.987.name": "Bồ Đề Giới Chỉ",
    "T19.987.reqClass": "|1|2|3|5|6|4|",
    "T19.987.description": "Bồ đề có nghĩa khoan dung độ lượng, đại từ đại bi,\nbiết phân biệt thiện ác, giác ngộ chân lý. Người\nđeo chúng cũng trở nên hiền hòa hơn\n",
    "T19.988.reqClassId": "|1|5|6|",
    "T19.988.name": "Bàn Long Giới Chỉ",
    "T19.988.reqClass": "|1|2|3|5|6|4|",
    "T19.988.description": "Kiểu dáng hết sức bình thường,nhưng không ngờ rằng\nbên trong lại ẩn chứa nhiều sức mạnh thần kỳ thế.\nNgười đeo được chiếc nhẫn, cả thân người toát lên\nvẻ uy nghiêm của một con rồng\n",
    "T19.989.reqClassId": "|2|3|4|",
    "T19.989.name": "Tỉnh Thần Thạch",
    "T19.989.reqClass": "|1|2|3|5|6|4|",
    "T19.989.description": "Đá thần kỳ đeo trong thời gian dài giúp tinh thần\nsảng khoái , trừ khử mọi tà khí\n",
    "T19.990.reqClassId": "|2|3|4|",
    "T19.990.name": "Thái Tinh Thạch",
    "T19.990.reqClass": "|1|2|3|5|6|4|",
    "T19.990.description": "Được mài từ Bảo Thạchđa sắc, khi đeo ra nắng ngọc\nbội ánh lên sắc cầu vồng nên mọi người rất ưa\nthích\n",
    "T19.991.reqClassId": "|2|3|4|",
    "T19.991.name": "Huyền Hạc Linh Thạch",
    "T19.991.reqClass": "|1|2|3|5|6|4|",
    "T19.991.description": "Là viên đá kỳ lạ, có ma tính và có thể thay đổi\nhình thái, là niềm mơ ước của nhiều người\n",
    "T19.992.reqClassId": "|2|3|4|",
    "T19.992.name": "Long Nha",
    "T19.992.reqClass": "|1|2|3|5|6|4|",
    "T19.992.description": "Nghe nói đây là chiến lợi phẩm sau một trận huyết\nchiến giữa dũng sĩ diệt rồng với con rồng lớn đã\nsống hàng ngàn năm, sau được coi là ngọc bội ma\npháp có sức mạnh cực kỳ lớn\n",
    "T19.993.reqClassId": "|1|5|6|",
    "T19.993.name": "Thanh Tâm Thạch",
    "T19.993.reqClass": "|1|2|3|5|6|4|",
    "T19.993.description": "Đeo viên đá trong thời gian dài sẽ khiến con người\nluôn tươi vui, dễ chịu, tâm hồn được thanh lọc.\n",
    "T19.994.reqClassId": "|1|5|6|",
    "T19.994.name": "Lưu Ly Thạch",
    "T19.994.reqClass": "|1|2|3|5|6|4|",
    "T19.994.description": "Được làm từ \"lưu ly thạch\" và \"lưu li mẫu\", là sản\nphẩm công nghệ vô cùng đẹp, hoa văn sắc nét từng\nchi tiết\n",
    "T19.995.reqClassId": "|1|5|6|",
    "T19.995.name": "Hồng Huyết Thạch",
    "T19.995.reqClass": "|1|2|3|5|6|4|",
    "T19.995.description": "Được tinh chế từ loại đá có màu đỏ tươi như máu,\nthường bị hiểu nhầm là đá sinh mệnh\n",
    "T19.996.reqClassId": "|1|5|6|",
    "T19.996.name": "Hổ Phách",
    "T19.996.reqClass": "|1|2|3|5|6|4|",
    "T19.996.description": "Được làm từ hổ phách quý hiếm, phải trải qua hàng\nnghìn đến hàng vạn năm mới hình thành\n",
    "T19.997.reqClassId": "|2|3|4|",
    "T19.997.name": "Thánh Hồn Tỏa",
    "T19.997.reqClass": "|1|2|3|5|6|4|",
    "T19.997.description": "Chìa khóa làm từ một loại đá thần kỳ, nghe nói có\ntác dụng giảm bớt các thương tổn do công kích gây\nra\n",
    "T19.998.reqClassId": "|2|3|4|",
    "T19.998.name": "Hắc Ngọc Thạch",
    "T19.998.reqClass": "|1|2|3|5|6|4|",
    "T19.998.description": "Hắc ngọc là một trong những khoáng sản hiếm có của\nĐông Huyền Thành, là nguyên liệu giải thể ma lực\nquan trọng, xung quang mỏ đá hắc ngọc thường có đá\nmạc tinh\n",
    "T19.999.reqClassId": "|2|3|4|",
    "T19.999.name": "Hấp Tinh Thạch",
    "T19.999.reqClass": "|1|2|3|5|6|4|",
    "T19.999.description": "Viên đá thần kỳ có lực ma pháp tương đối mạnh,\nnghe nói có thể hút và tỏa ra công năng thần kỳ\nđầy ma lực\n",
    "T19.1000.reqClassId": "|2|3|4|",
    "T19.1000.name": "Hải Nguyệt Thanh Huy",
    "T19.1000.reqClass": "|1|2|3|5|6|4|",
    "T19.1000.description": "Được kết tinh tự nhiên ở độ sâu hàng chục mét dưới\nđáy biển, rất khó tìm và được gọi là \"nước mắt\nthần biển\", có công năng thần kỳ\n",
    "T19.1001.reqClassId": "|1|5|6|",
    "T19.1001.name": "Thánh Linh Tỏa",
    "T19.1001.reqClass": "|1|2|3|5|6|4|",
    "T19.1001.description": "Là một loại khóa thần kỳ, nghe nói có tác dụng mở\ncánh của bên kia thế giới, tiễn đưa các linh hồn\nvà giải phóng các thương tổn do công kích gây ra\n",
    "T19.1002.reqClassId": "|1|5|6|",
    "T19.1002.name": "Mặc Tinh Thạch",
    "T19.1002.reqClass": "|1|2|3|5|6|4|",
    "T19.1002.description": "Mặc tinh là một trong những khoáng sản hiếm có của\nĐông Huyền Thành, là nguyên liệu giải thể ma lực\nquan trọng\n",
    "T19.1003.reqClassId": "|1|5|6|",
    "T19.1003.name": "Thần Nguyên Ma Thạch",
    "T19.1003.reqClass": "|1|2|3|5|6|4|",
    "T19.1003.description": "Viên đá thần kỳ có năng lực hút các nguyên tố và\nchuyển thành năng lượng\n",
    "T19.1004.reqClassId": "|1|5|6|",
    "T19.1004.name": "Du Long Ngọc",
    "T19.1004.reqClass": "|1|2|3|5|6|4|",
    "T19.1004.description": "Trong suốt, màu xanh trong vắt, gõ vào thanh thoát\nnghe như âm thanh gõ vào ngọc\n",
    "T19.1005.name": "Trang Bị Ngắn Hạn",
    "T19.1005.reqClass": "|1|2|3|4|6|5|",
    "T19.1005.description": "Dây chuyền màu lam làm bằng nanh rồng đen sống tại\nmê cung rừng sâu, thời gian tồn tại rất ngắn\n",
    "T19.1006.name": "Phụng Minh Chùy",
    "T19.1006.reqClass": "|1|",
    "T19.1006.description": "Chùy này không phải vũ khí mà là công cụ đặc biệt\nchuyên dùng để tháo gỡ hoặc rèn đúc nguyên liệu\nquý, tuy vậy do nó là một công cụ quá tốt nên khi\ncùng trong chiến đấu cũng phát huy tác dụng mạnh\n",
    "T19.1007.name": "Tân Thủ Hạng Liên",
    "T19.1007.reqClass": "|1|2|3|4|6|5|",
    "T19.1007.description": "Đông Huyền Thành làm ra dây chuyền đặc biệt có\nthuộc tính dũng mãnh cho thành viên mới\n",
    "T19.1008.name": "Tân Thủ Giới Chỉ",
    "T19.1008.reqClass": "|1|2|3|4|6|5|",
    "T19.1008.description": "Đông Huyền Thành làm ra nhẫn đặc biệt có thuộc\ntính dũng mãnh cho thành viên mới\n",
    "T19.1009.name": "Tân Thủ Trang Sức (Trái)",
    "T19.1009.reqClass": "|1|2|3|4|6|5|",
    "T19.1009.description": "Đông Huyền Thành làm ra ngọc bội đặc biệt có thuộc\ntính dũng mãnh cho thành viên mới\n",
    "T19.1010.name": "Tân Thủ Trang Sức (Phải)",
    "T19.1010.reqClass": "|1|2|3|4|6|5|",
    "T19.1010.description": "Đông Huyền Thành làm ra ngọc bội đặc biệt có thuộc\ntính dũng mãnh cho thành viên mới\n",
    "T19.1011.name": "Thánh Dương Trượng",
    "T19.1011.reqClass": "|3|",
    "T19.1011.description": "Cây trượng biểu trưng cho sức mạnh thần thánh giúp\ntrị thương và hồi sinh cực mạnh\n",
    "T19.1012.name": "Đả Cẩu Bổng",
    "T19.1012.reqClass": "|5|",
    "T19.1012.description": "Tuy gọi là đả cẩu nhưng sức sát thương của cây gậy\nnày đối với yêu ma cũng rất mạnh. Tương truyền có\nmột bổng pháp chuyên phối hợp với vũ khí này nhưng\nđã bị thất truyền từ lâu\n",
    "T19.1013.name": "Lưu Ảnh Kiếm",
    "T19.1013.reqClass": "|6|",
    "T19.1013.description": "Thanh kiếm khi sử dụng chỉ thấy bóng kiếm vun vút\nvà âm thanh sắc bén\n",
    "T19.1014.name": "Thực Ma Súng",
    "T19.1014.reqClass": "|4|",
    "T19.1014.description": "Ưu điểm lớn nhất của khẩu súng này là sẽ làm suy\nyếu pháp thuật của kẻ địch, từ đó mang lại tác\ndụng rất lớn khi chiến đấu\n",
    "T19.1015.name": "Thánh Âm Cầm",
    "T19.1015.reqClass": "|2|",
    "T19.1015.description": "Âm thanh réo rắt trầm bổng cùa cây đàn sẽ dẫn dắt\nbạn đến thế giới tươi đẹp của thần thánh, nhưng\nkhi được sử dụng trước kẻ thù thì tiếng đàn lại\nmang tới cho chúng cơn ác mộng khủng khiếp nhất\n",
    "T19.1016.name": "Khiêu Chiến Thuẫn",
    "T19.1016.reqClass": "|1|",
    "T19.1016.description": "Tấm khiên đuôi yến khá dài, trên mặt có khắc hình\nsư tử trông rất đáng sợ\n",
    "T19.1017.name": "Thánh Ngôn",
    "T19.1017.reqClass": "|3|",
    "T19.1017.description": "Nội dung sách chứa những lời dạy của bậc thần\nthánh\n",
    "T19.1018.name": "Quy Nguyên Thủ",
    "T19.1018.reqClass": "|5|",
    "T19.1018.description": "Trang bị phòng ngự cực hữu dụng.\n",
    "T19.1019.name": "Triều Lộ Chủy Thủ",
    "T19.1019.reqClass": "|6|",
    "T19.1019.description": "Rèn từ thiên thạch và sương mai, khá khó chế tạo\nnhưng bù lại uy lực rất mạnh\n",
    "T19.1020.name": "Ảo Ma Hộ Uyển",
    "T19.1020.reqClass": "|4|",
    "T19.1020.description": "Vòng bảo vệ cổ tay bí ẩn, không xác minh được lai\nlịch\n",
    "T19.1021.name": "Thánh Âm Cầm Cung",
    "T19.1021.reqClass": "|2|",
    "T19.1021.description": "Khi phối hợp với Thánh Âm Cầm thì uy lực sẽ càng\nmạnh mẽ hơn\n",
    "T19.1022.name": "Long Lân Khôi",
    "T19.1022.reqClass": "|1|",
    "T19.1022.description": "Mũ sắt mang khí chất của rồng và lân, có tác dụng\ntrừ ma hiệu quả, tuy nhiên nhớ đừng để lũ rồng\ntrông thấy…\n",
    "T19.1023.name": "Duệ Trí Mão",
    "T19.1023.reqClass": "|3|",
    "T19.1023.description": "Chiếc mão quyền quý phù hợp với bậc đế vương\n",
    "T19.1024.name": "Linh Thú Mão",
    "T19.1024.reqClass": "|5|",
    "T19.1024.description": "Ẩn chứa khả năng giúp người và dã thú thấu hiểu\nnhau\n",
    "T19.1025.name": "Huy Hoàng Khôi",
    "T19.1025.reqClass": "|6|",
    "T19.1025.description": "Đúng như tên gọi, mũ sẽ mang đến sự huy hoàng cho\nngười sử dụng\n",
    "T19.1026.name": "Tinh Nguyệt Khôi",
    "T19.1026.reqClass": "|4|",
    "T19.1026.description": "Nghe nói mũ này được chế tạo từ đá mặt trăng,\nnhưng không biết có đúng như vậy hay không\n",
    "T19.1027.name": "Ác Mộng Mão",
    "T19.1027.reqClass": "|2|",
    "T19.1027.description": "Vừa tăng phòng ngự linh hồn lại vừa tăng phòng ngự\nvật lý, giúp tăng lợi thế trong trận chiến cho\nngười mặc\n",
    "T19.1028.name": "Long Lân Giáp",
    "T19.1028.reqClass": "|1|",
    "T19.1028.description": "Áo giáp mang khí chất của rồng và lân, có tác dụng\ntrừ ma hiệu quả, tuy nhiên nhớ đừng để lũ rồng\ntrông thấy…\n",
