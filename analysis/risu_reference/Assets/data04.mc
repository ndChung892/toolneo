    "T35.2412.name": "Huyền Nội Lão Nhân",
    "T35.2413.onServiceText": "Thế Giới Số là nơi Ác Ma Thú thống trị, ngươi nhất\nđịnh phải đánh bại hắn",
    "T35.2413.name": "Huyền Nội Lão Nhân",
    "T35.2414.scriptOff": "var script_index = 0;var script_loot = rand3(1,\n100); var script_node = null;if( c\n){\tif(c.inGroup()) \t{\t\tscript_node =\nc.memberList.head;\t}\telse \t{\t\tscript_node =\n{};\t\tscript_node.obj =\nc.data.id;\t}\twhile(script_node != null)\t{\t\tvar\nspt_player = getCharactor( script_node.obj );\t\tvar\nspt_monNum = 0.5;\t\tvar spt_expNum =\n1;\t\taddChaExp(script_node.obj,\nBASIC_GET_EXP[spt_player.level]*spt_expNum);\t\taddMoney(script_node.obj,\"moneyBind\",BASIC_GET_MONEY[spt_player.level]*spt_monNum);\t\tscript_index\n++;\t\tscript_node = script_node.next;\t}}",
    "T35.2414.onServiceText": "Thế Giới Số thật sự rất đẹp",
    "T35.2414.name": "Su Su Sắt",
    "T35.2415.scriptOff": "var script_index = 0;var script_loot = rand3(1,\n100); var script_node = null;if( c\n){\tif(c.inGroup()) \t{\t\tscript_node =\nc.memberList.head;\t}\telse \t{\t\tscript_node =\n{};\t\tscript_node.obj =\nc.data.id;\t}\twhile(script_node != null)\t{\t\tvar\nspt_player = getCharactor( script_node.obj );\t\tvar\nspt_monNum = 0.5;\t\tvar spt_expNum =\n1;\t\taddChaExp(script_node.obj,\nBASIC_GET_EXP[spt_player.level]*spt_expNum);\t\taddMoney(script_node.obj,\"moneyBind\",BASIC_GET_MONEY[spt_player.level]*spt_monNum);\t\tscript_index\n++;\t\tscript_node = script_node.next;\t}}",
    "T35.2415.onServiceText": "Hôm nay chưa uống thuốc, cảm thấy mình đẹp lạ đẹp\nlùng hè!",
    "T35.2415.name": "Bạo Long Thú",
    "T35.2416.onServiceText": "Ta chỉ là bà con xa của Thú Ác Ma thôi à, có thể\nnào đừng đập ta không?/(ㄒoㄒ)/~~",
    "T35.2416.name": "Tiểu Ma Thú",
    "T35.2417.name": "Tiểu Q",
