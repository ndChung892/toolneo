    "T29.1740.name": "Túi Mừng",
    "T29.1740.info": "Kẹo",
    "T29.1740.reqClass": "|1|2|3|4|5|6|",
    "T29.1740.description": "Túi mừng do cô dâu chú rể rải xuống khi diễu hành,\nngười chơi khác có thể nhặt, mở ra sẽ nhận phần\nquà bất ngờ",
    "T29.1741.name": "Linh Hồn Phong Ấn",
    "T29.1741.description": "Vong hồn mang đầy oán khí, chỉ có cách phong ấn\nchúng lại thì mới có thể đảm bảo an toàn cho người\nmang chúng theo\n",
    "T29.1742.name": "Anh Hùng Giáp",
    "T29.1742.description": "Áo giáp anh hùng từng mặc\n",
    "T29.1743.name": "Phong Tinh Thể",
    "T29.1743.description": "Thể kết tinh từ gió, có thể hoàn nguyên trở lại\nthành Phong Nguyên Tố\n",
    "T29.1744.name": "Phong Nguyên Tố",
    "T29.1744.description": "Thể nguyên tố của gió",
    "T29.1745.name": "Địa Tinh Thể",
    "T29.1745.description": "Thể kết tinh từ đất, có thể hoàn nguyên trở lại\nthành Địa Nguyên Tố\n",
    "T29.1746.name": "Địa Nguyên Tố",
    "T29.1746.description": "Thể nguyên tố của đất\n",
    "T29.1747.name": "Hỏa Tinh Thể",
    "T29.1747.description": "Thể kết tinh từ lửa, có thể hoàn nguyên trở lại\nthành Hỏa Nguyên Tố\n",
    "T29.1748.name": "Hỏa Nguyên Tố",
    "T29.1748.description": "Thể nguyên tố của lửa\n",
    "T29.1749.name": "Thủy Tinh Thể",
    "T29.1749.description": "Thể kết tinh từ nước, có thể hoàn nguyên trở lại\nthành Thủy Nguyên Tố\n",
    "T29.1750.name": "Thiên Niên Hàn Băng",
    "T29.1750.description": "Vật chí hàn trong tự nhiên, cũng là vật chí thuần,\ncó thể tịnh hóa vạn vật\n",
    "T29.1751.name": "Tịnh Hóa Đơn",
    "T29.1751.description": "Thuốc điều chế từ Thiên Niên Hàn Băng\n",
    "T29.1752.name": "Mật Rùa Biển",
    "T29.1752.description": "Mật của Rùa biển, nghe nói có một công hiệu đặc\nbiệt\n",
    "T29.1753.name": "Mai Cua",
    "T29.1753.description": "Mai của Cua Yêu, nghe nói có một công hiệu thần kỳ\n",
    "T29.1754.name": "Lệ Hải Dương Nữ",
    "T29.1754.description": "Nước mắt của Hải Dương Nữ, khi rơi xuống sẽ trở\nthành trân châu quý giá\n",
    "T29.1755.name": "Quang Minh Thủy Tinh",
    "T29.1755.description": "Pha lê do ánh sáng ngưng tụ thành, là vũ khí chống\nlại bóng tối cực hữu dụng\n",
    "T29.1756.name": "Thủ Hộ Kiếm",
    "T29.1756.description": "Bảo kiếm anh hùng từng dùng qua, ẩn chứa sức sát\nthương cực lớn, bách chiến bách thắng\n",
    "T29.1757.name": "Bột Thôi Miên",
    "T29.1757.description": "Chỉ cần bị rắc bột này lên thì sẽ ngủ ngay\n",
    "T29.1758.name": "Nến Trắng Tinh Linh",
    "T29.1758.description": "Nến Trắng của Tinh Linh Tộc, ánh nến có một tác\ndụng thần kỳ\n",
    "T29.1759.name": "Chìa Khóa Địa Ngục",
    "T29.1759.description": "Tương truyền có thể mở ra cánh cổng địa ngục\n",
    "T29.1760.name": "Thẻ Thông Hành Địa Ngục",
    "T29.1760.description": "Thẻ thông hành để đến địa ngục\n",
    "T29.1761.name": "Sách Mê Huyễn Thuật",
    "T29.1761.description": "Ghi lại cách thi triển Mê Huyễn Thuật, tuy nhiên\nchỉ có Ác Ma mới có thể đọc hiểu\n",
    "T29.1762.name": "Hải Dương Ngưng Lộ",
    "T29.1762.description": "Tinh hoa của nước biển, trải qua một khoảng thời\ngian dài đã ngưng kết thành tinh thể\n",
    "T29.1763.name": "Vảy Công Chúa Hải Vực",
    "T29.1763.description": "Vảy trên mình Công Chúa Hải Vực, vô cùng quý giá\n",
    "T29.1764.name": "Bụi Hắc Ám",
    "T29.1764.description": "Một loại bụi cổ xưa, có liên quan đến một loại ma\nthuật hắc ám\n",
    "T29.1765.name": "Mặt Nạ Ác Ma",
    "T29.1765.description": "Mặt nạ mang đầy khí tức tà ma\n",
    "T29.1766.name": "Tinh Thể Tự Nhiên",
    "T29.1766.description": "Tinh thể tinh luyện từ tự nhiên, tương truyền có\nthể tịnh hóa khí tức tà ác\n",
    "T29.1767.name": "Lông Vũ Pháp Sư",
    "T29.1767.description": "Vật tượng trưng của Ác Ma Pháp Sư\n",
    "T29.1774.name": "Mộng Cảnh Truyền Tống Phù",
    "T29.1774.info": "Nhấp đôi sử dụng để vào Tử Mộng Cảnh",
    "T29.1774.reqClass": "|1|2|3|4|6|5|",
    "T29.1774.description": "Một quyển sách có chứa nhũng phù chú thần bí, sử\ndụng sẽ đến được Tử Mộng Cảnh của Vong Linh (nhấp\nđôi sử dụng, vận chuyển đến Tử Mộng Cảnh)\n",
    "T29.1775.name": "Vong Linh Tịnh Hóa",
    "T29.1775.info": "Nhấp đôi mở nhiệm vụ",
    "T29.1775.reqClass": "|1|2|3|4|6|5|",
    "T29.1775.description": "Giải trừ Vong Linh Oán Niệm (nhấp đôi để bắt đầu\nnhiệm vụ)\n",
    "T29.1776.name": "Nguyên Tố Ma Cầu",
    "T29.1776.info": "Nhấp đôi mở nhiệm vụ",
    "T29.1776.reqClass": "|1|2|3|4|6|5|",
    "T29.1776.description": "Quả cầu ma pháp chứa 5 loại nguyên tố của tự nhiên\n(nhấp đôi để bắt đầu nhiệm vụ)\n",
    "T29.1777.name": "Thủy Tinh Evan",
    "T29.1777.info": "Nhấp đôi mở nhiệm vụ",
    "T29.1777.reqClass": "|1|2|3|4|6|5|",
    "T29.1777.description": "Mảnh thủy tinh Evan giấu dưới bia đá (nhấp đôi để\nbắt đầu nhiệm vụ)\n",
    "T29.1778.name": "Sách Bí Mật",
    "T29.1778.info": "Nhấp đôi mở nhiệm vụ",
    "T29.1778.reqClass": "|1|2|3|4|6|5|",
    "T29.1778.description": "Quyển sách ẩn chứa bí mật của công chúa Tuyết\nLiên, ngườ ghi chép là Evan (nhấp đôi để bắt đầu\nnhiệm vụ)\n",
    "T29.1779.name": "Giải Trừ Thôi Miên Phù",
    "T29.1779.info": "Nhấp đôi sử dụng để vào Mộng Cảnh",
    "T29.1779.reqClass": "|1|2|3|4|6|5|",
    "T29.1779.description": "Bùa chú có thể giải trừ trạng thái thôi miên (nhấp\nđôi để rời khỏi Mộng Cảnh)\n",
    "T29.1781.name": "Xương Rồng Trấp",
    "T29.1781.description": "Loài thực vật có sức sống mãnh liệt nhất trên sa\nmạc, chất dịch ép ra từ thân cây có giá trị khá\ncao\n",
    "T29.1782.name": "Thôi Miên Phù",
    "T29.1782.info": "Nhấp đôi sử dụng để vào Kiếm Hồn Cảnh",
    "T29.1782.reqClass": "|1|2|3|4|6|5|",
    "T29.1782.description": "Phù chú đặc biệt có khả năng thôi miên (nhấp đôi\nđể vào Kiếm Hồn Cảnh)\n",
    "T29.1783.name": "Thịt Sư Tử Khổng Lồ",
    "T29.1783.description": "Thịt yết hầu của Sư Tử Khổng Lồ, vừa ngon lại vừa\ncó thể dùng làm thuốc\n",
    "T29.1784.name": "Đuôi Ma Cát",
    "T29.1784.description": "Đuôi màu xanh của Ma Cát, rất mềm mại\n",
    "T29.1785.name": "Gậy Khuấy",
    "T29.1785.description": "Lưỡi dao sắc nhọn có thể cắt đứt mọi thứ, cây gậy\ncó cắm lười dao này còn được Ma Cát dùng để khuấy\n",
    "T29.1786.name": "Nhiếp Tâm Thạch",
    "T29.1786.description": "Tinh thạch tạo thành từ vật phẩm đặc biệt, có thể\nsử dụng để chiến đấu tâm linh\n",
    "T29.1787.name": "Thiếp Qua Cửa",
    "T29.1787.description": "Có được Văn Thiếp này thì có thể tự do ra vào Chỉ\nPhong Cốc\n",
    "T29.1788.name": "Đơn Giao Hàng",
    "T29.1788.description": "Đơn giao hàng của Thương Hội Trưởng\n",
    "T29.1789.name": "Roi Luyện Sư",
    "T29.1789.description": "Sở hữu được chiếc roi này thì mới có khả năng huấn\nluyện được Sư Tử Khổng Lồ\n",
    "T29.1790.name": "Thuốc Nước Giải Độc",
    "T29.1790.reqClass": "|1|2|3|4|5|6|",
    "T29.1790.description": "Thuốc giải độc do Dược Sỹ bào chế\n",
    "T29.1791.name": "Kim Cương Điểm Thưởng",
    "T29.1791.info": "Vật phẩm hàng hóa",
    "T29.1791.reqClass": "|1|2|3|4|5|6|",
    "T29.1791.description": "Sau khi dùng có thể đổi lấy 1000 điểm thưởng\n",
    "T29.1792.name": "Thuốc Viên Hồi Ức",
    "T29.1792.description": "Thuốc viên giúp trị bệnh mất ký ức của Tinh Linh\nTộc\n",
    "T29.1793.name": "Cổ Nguyên",
    "T29.1793.description": "Tương truyền Cổ Trùng từ đây mà ra\n",
    "T29.1794.name": "Huy Chương Thủ Hộ Chi Hồn",
    "T29.1794.info": "Nhấp đôi nhận được danh hiệu",
    "T29.1794.reqClass": "|1|2|3|5|6|4|",
    "T29.1794.description": "Bạn sẽ được phong danh hiệu Thủ Hộ Chi Hồn\n",
    "T29.1795.name": "Thuốc Tốt",
    "T29.1795.description": "Thuốc mà Dược Sỹ cần\n",
    "T29.1796.name": "Bát Xương Rồng Trấp",
