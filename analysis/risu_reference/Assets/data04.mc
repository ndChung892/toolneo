    "T19.866.reqClass": "|5|",
    "T19.866.description": "Bạch Hổ còn được gọi là \"Chiến Thần\", được coi là\nThần phương tây, trang bị này giúp người mặc may\nmắn, tăng cường sức mạnh\n",
    "T19.867.name": "Thanh Long Đai",
    "T19.867.reqClass": "|5|",
    "T19.867.description": "Thanh Long còn được gọi là \"Thương Long\", được coi\nlà Thần phương đông, trang bị này giúp người mặc\nmay mắn, tăng cường sức mạnh\n",
    "T19.868.name": "Vô Úy Khố",
    "T19.868.reqClass": "|1|",
    "T19.868.description": "Tương truyền chỉ có các dũng sỹ của tộc Vô Ưu trải\nqua khảo nghiệm gian khổ mới được mang trang bị\nnày\n",
    "T19.869.name": "Đế Vương Khố",
    "T19.869.reqClass": "|1|",
    "T19.869.description": "Trang bị của bậc đế vương mà mọi người đều mong\nmột lần được mặc\n",
    "T19.870.name": "Thất Tinh Khố",
    "T19.870.reqClass": "|2|",
    "T19.870.description": "Trang bị chứa năng lượng của thất tinh bắc đẩu với\nsức mạnh tự nhiên rất lớn\n",
    "T19.871.name": "Thương Khung Khố",
