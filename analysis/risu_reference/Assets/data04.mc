    "T29.1903.reqClass": "|1|2|3|4|6|5|",
    "T29.1903.description": "Thư Lão Âu gửi Người Nuôi Dơi.\n",
    "T29.1904.name": "Canh Mê Hồn",
    "T29.1904.reqClass": "|1|2|3|4|6|5|",
    "T29.1904.description": "Mê Hồn Giáo Chủ luôn mang theo bên người, nghe nói\nnếu uống canh này thì sẽ quên một số chuyện quan\ntrọng vừa xảy ra gần đây.\n",
    "T29.1905.name": "Canh Mê Hồn Đậm Đặc",
    "T29.1905.reqClass": "|1|2|3|4|6|5|",
    "T29.1905.description": "Dùng 30 chén Canh Mê Hồn sắc lại mà thành, hiệu\nquả của nó đến ác ma cũng khó chống lại.\n",
    "T29.1906.name": "Đuôi Bò Cạp",
    "T29.1906.reqClass": "|1|2|3|4|6|5|",
    "T29.1906.description": "Đuôi của Bò Cạp Răng Độc, có vẻ có độc tính rất\nmạnh.\n",
    "T29.1907.name": "Ngón Chân Rùa Biển",
    "T29.1907.reqClass": "|1|2|3|4|6|5|",
    "T29.1907.description": "Ngón chân rùa biển, chắc đã rất lâu không cắt móng\nchân rồi.\n",
    "T29.1908.name": "Ngọc Cua Yêu",
    "T29.1908.reqClass": "|1|2|3|4|6|5|",
    "T29.1908.description": "Mắt của Cua Yêu, trông hơi gớm và trơn nhớt.\n",
