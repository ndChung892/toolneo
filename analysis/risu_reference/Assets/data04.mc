    "T35.685.onServiceText": "Cỗ quan tài đá thật kỳ dị, bên trong có luồng sáng\nbí ẩn.",
    "T35.685.name": "Độc Xà Lãnh Chúa",
    "T35.686.funcInfo": "-1|-1",
