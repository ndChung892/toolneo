    "T35.1508.name": "Kẻ Phá Rừng",
    "T35.1509.at": "0-23|0-6|1-2|3-3",
    "T35.1509.name": "Sứ Giả Sự Kiện Cá Tháng Tư",
    "T35.1510.onServiceText": "Sau ngàn năm bị phong ấn, cuối cùng ta đã tỉnh!",
    "T35.1510.name": "Băng Cự Long",
    "T35.1511.subType": "all",
    "T35.1511.onServiceText": "Hu hu, Michi lạc đường rồi, không biết sao lại đến\nđây nữa, Michi sợ quá, hu hu hu…",
    "T35.1511.name": "Michi Lạc Đường",
    "T35.1512.subType": "all",
    "T35.1512.onServiceText": "Có ai cứu chúng tôi không? Người đến cứu chúng tôi\nsao? Suỵt, yên lặng không Nhiếp Hồn Quái phát hiện\nđấy!",
    "T35.1512.name": "Đứa Trẻ Bị Giam",
    "T35.1513.onServiceText": "Ta phải hút hết hồn phách của con người! Có như\nvậy ta mới trở thành vô địch!",
    "T35.1513.name": "Nhiếp Hồn Quái",
    "T35.1514.at": "20-23|0-0|1-31|0-11",
    "T35.1514.name": "Hướng Dẫn Giác Đấu",
    "T35.1515.name": "Dịch Chuyển Giác Đấu",
    "T35.1516.funcInfo": "|55,Điêu Linh Thôn,3000,770,245",
    "T35.1516.onServiceText": "Muốn đi đò à? Trả công không cao thì ta không chở\nđâu!",
    "T35.1516.name": "Người Lái Đò Harker",
    "T35.1517.name": "Phù Thủy Blair",
    "T35.1518.subType": "all",
    "T35.1518.onServiceText": "Ta là chuyên viên phá hoại hôn lễ, chuyên viên\ncướp dâu!",
    "T35.1518.name": "Perito Làm Loạn",
    "T35.1519.at": "new|2024/10/31/0/0/0-2024/11/2/23/59/0",
    "T35.1519.onServiceText": "Bọn Người Rơm và Bí Ngô lợi dụng Halloween đã làm\nloạn khắp nơi, khẩu hiệu của chúng là không đưa đồ\nthì cứ làm loạn. Mọi người hãy mau ngăn chúng lại\nnào!",
    "T35.1519.name": "Sứ Giả Sự Kiện Halloween",
    "T35.1520.name": "Shop Điểm Thưởng Giác Đấu",
    "T35.1521.at": "0-23|0-6|10-12|2-2",
    "T35.1521.name": "Sứ Giả Sự Kiện Tết Trồng Cây",
