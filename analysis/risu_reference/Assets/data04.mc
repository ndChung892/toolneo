    "T45.3852.reqClass": "all",
    "T45.3852.subType": "9-11",
    "T45.3852.startText": "Nghe nói Long Phi Dực ở Thánh Ước Địa gây nhiều\ntội ác, mong có ai đó ra tay tiêu diệt.",
    "T45.3852.completeText": "Thật cám ơn sự giúp đỡ của ngài!",
    "T45.3852.name": "Long Phi Dực",
    "T45.3853.info": "Tiêu diệt 30 Bạch Kim Thuẫn, sau đó đến chỗ Trưởng\nCận Vệ Đông Huyền Thành nhận thưởng.",
    "T45.3853.reqClass": "all",
    "T45.3853.subType": "9-11",
    "T45.3853.startText": "Gần đây tình hình ở Thánh Ước Địa khá bất ổn, Vệ\nSĩ mong các giới ra tay giúp đỡ.",
    "T45.3853.completeText": "Trừ tà giúp chính, đây là lúc thích hợp để ra tay\nđây!",
    "T45.3853.name": "Thánh Ước Địa",
    "T45.3854.info": "Tiêu diệt 30 Chim Ưng Cổ, sau đó đến chỗ Trưởng\nThương Hội ở Đông Huyền Thành nhận thưởng.",
    "T45.3854.reqClass": "all",
    "T45.3854.subType": "9-11",
    "T45.3854.startText": "Gần đây, Thương Đội gặp nhiều sự cố tại Thánh Ước\nĐịa, việc này chắc chắn có liên quan đến quái vật\nở đó, Thương Hội công cáo thiên hạ, mong nhân sĩ\ncác giới ra tay tiêu diệt quái vật, giảm thiểu tốn\nthất.",
    "T45.3854.completeText": "Thật cám ơn sự giúp đỡ của ngài! Lần ngày Thương\nĐội được an toàn rồi.",
    "T45.3854.name": "Thánh Ước Địa",
    "T45.3855.info": "Tiêu diệt 30 Lợi Trảo Long, sau đó báo cáo với Vệ\nSĩ ở Đông Huyền Thành.",
    "T45.3855.reqClass": "all",
    "T45.3855.subType": "9-11",
    "T45.3855.startText": "Các dũng sĩ có chí khí hãy giúp tiêu diệt quái\nvật.",
    "T45.3855.completeText": "Khá lắm!",
    "T45.3855.name": "Thần Di Cảnh",
    "T45.3856.info": "Tiêu diệt 30 Mộng Lão Ông, sau đó báo cáo với Vệ\nSĩ ở Đông Huyền Thành.",
    "T45.3856.reqClass": "all",
    "T45.3856.subType": "9-11",
    "T45.3856.startText": "Các dũng sĩ có chí khí hãy giúp tiêu diệt quái\nvật.",
    "T45.3856.completeText": "Khá lắm!",
    "T45.3856.name": "Thần Di Cảnh",
    "T45.3857.info": "Tiêu diệt 30 Sứ Giả Thánh Quang, sau đó đến chỗ\nTrưởng Thương Hội ở Đông Huyền Thành nhận thưởng.",
    "T45.3857.reqClass": "all",
    "T45.3857.subType": "9-11",
    "T45.3857.startText": "Gần đây, Thương Đội gặp nhiều sự cố tại Thánh Ước\nĐịa, việc này chắc chắn có liên quan đến quái vật\nở đó, Thương Hội công cáo thiên hạ, mong nhân sĩ\ncác giới ra tay tiêu diệt quái vật, giảm thiểu tốt\nthất.",
    "T45.3857.completeText": "Thật cám ơn sự giúp đỡ của ngài! Lần ngày Thương\nĐội được an toàn rồi.",
    "T45.3857.name": "Thánh Ước Địa",
    "T45.3858.info": "Tiêu diệt 30 Thánh Kiếm, sau đó báo cáo với Vệ Sĩ\nở Đông Huyền Thành.",
    "T45.3858.reqClass": "all",
    "T45.3858.subType": "9-11",
    "T45.3858.startText": "Các dũng sĩ có chí khí hãy giúp tiêu diệt quái\nvật.",
    "T45.3858.completeText": "Đúng là tuổi trẻ tài cao! Haha!",
    "T45.3858.name": "Thần Di Cảnh",
    "T45.3859.info": "Tiêu diệt 30 Thần Quan Mất Trí, sau đó báo cáo với\nVệ Sĩ ở Đông Huyền Thành.",
    "T45.3859.reqClass": "all",
    "T45.3859.subType": "9-11",
    "T45.3859.startText": "Các dũng sĩ có chí khí hãy giúp tiêu diệt quái\nvật.",
    "T45.3859.completeText": "Không ngờ ngươi lại đi thật, haha.",
    "T45.3859.name": "Thần Di Cảnh",
    "T45.3860.info": "Tiêu diệt 30 Dực Long, sau đó đến chỗ Trưởng Cận\nVệ ở Đông Huyền Thành nhận thưởng.",
    "T45.3860.reqClass": "all",
    "T45.3860.subType": "9-11",
    "T45.3860.startText": "Gần đây tình hình ở Thánh Ước Địa khá bất ổn, Vệ\nSĩ mong các giới ra tay giúp đỡ.",
    "T45.3860.completeText": "Trừ tà giúp chính, đây là lúc thích hợp để ra tay\nđây!",
    "T45.3860.name": "Thánh Ước Địa",
    "T45.20001.info": "Liên hệ Tiệm Vũ Khí A Nhĩ",
    "T45.20001.reqClass": "all",
    "T45.20001.subType": "11-1",
    "T45.20001.startText": "Để xây dựng bang hội cần phải có tay nghề của\nnhững người thợ. Bạn hãy mau mờ họ về đây nhé!",
    "T45.20001.completeText": "Yên tâm, ta nhất định sẽ giúp ngươi!",
