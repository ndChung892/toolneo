    "T35.2405.funcInfo": "|9,Đông Huyền Thành,100,2228,1336",
    "T35.2405.onServiceText": "Thời Không Luân sắp mở !",
    "T35.2405.name": "Chuyển Dịch Thiên Không",
    "T35.2406.onServiceText": "Ta sớm đã được rèn luyện trong gian khổ!",
    "T35.2406.name": "Hộ Vệ Phương Đông",
    "T35.2407.onServiceText": "Ta sẽ chiến đấu thay cho những người không còn\nđược chiến đấu nữa",
    "T35.2407.name": "Hộ Vệ Phương Nam",
    "T35.2408.onServiceText": "Tất cả những anh hùng đều phải nghe lệnh ta.",
