    "T45.50442.aScriptText": "Chưa biết",
    "T45.50416.info": "Phải mang ít nhất 2 loại bùa chú mới có thể hoàn\nthành khiêu chiến (chỉ tính bùa chú nhận được từ\nÁc Linh)",
    "T45.50416.reqClass": "all",
    "T45.50416.startText": "Bộ muốn đánh lộn lắm hả?",
    "T45.50416.completeText": "Hứ",
    "T45.50416.name": "NV Khiêu Chiến 2-Không Sợ Bùa Chú",
    "T45.50417.info": "Trong Túi Thù Du cấp độ BUFF không vượt quá 3 cấp\nmới hoàn thành khiêu chiến",
    "T45.50417.reqClass": "all",
    "T45.50417.startText": "Bộ muốn đánh lộn lắm hả?",
    "T45.50417.completeText": "Hứ",
    "T45.50417.name": "NV Khiêu Chiến 2-Bá Vương Thương",
    "T45.50418.info": "Không dùng pet chiến đấu mới hoàn thành khiêu\nchiến",
