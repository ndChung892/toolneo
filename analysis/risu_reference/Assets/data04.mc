    "T35.1901.at": "0-23|0-6|31-31|1-1",
    "T35.1901.onServiceText": "Đây là món quà nhỏ bù đắp tổn thất cho các cư dân\nserver Memory trong thời gian qua. Những bạn cấp\n30 trở lên đều có thể nhận được món quà này",
    "T35.1901.name": "Tiểu Phương",
    "T35.1902.scriptOff": "if(npc.nid && fromBF){\tif( c )\t{\t\tvar\nscript_creatureId1= 1384;\t\tvar script_creatureId2=\n1385;\t\tvar script_creatureId3= 1386;\t\tvar\nscript_creatureId4= 1387;\t\tvar killNum1 =\n(c.battleKill && c.battleKill[script_creatureId1])\n? Number(c.battleKill[script_creatureId1]) :\n0;\t\tvar killNum2 = (c.battleKill &&\nc.battleKill[script_creatureId2]) ?\nNumber(c.battleKill[script_creatureId2]) : 0;\t\tvar\nkillNum3 = (c.battleKill &&\nc.battleKill[script_creatureId3]) ?\nNumber(c.battleKill[script_creatureId3]) : 0;\t\tvar\nkillNum4 = (c.battleKill &&\nc.battleKill[script_creatureId4]) ?\nNumber(c.battleKill[script_creatureId4]) :\n0;\t}\ttrace(\"killNum1:\"+killNum1);\ttrace(\"killNum2:\"+killNum2);\ttrace(\"killNum3:\"+killNum3);\ttrace(\"killNum4:\"+killNum4);\tvar\nscript_index = 0; \tvar script_node = null;\tvar\nspt_expNum = 3;\tvar spt_monNum = 1.5;\tvar\nspt_baoshiNum = Math.round(killNum2/5);\tvar\nspt_daojuNum = Math.round(killNum4/10);\tvar\nspt_expNumall =\nMath.round(add(spt_expNum,killNum1/3));\tvar\nspt_monNumall =\nMath.round(add(spt_monNum,killNum3/6));\ttrace(\"spt_baoshiNum:\"+spt_baoshiNum);\ttrace(\"spt_daojuNum:\"+spt_daojuNum);\tvar\nspt_playername = encode(TBL_CHARACTOR, c.data.id,\nc.data.name);\tif( c )\t{\t\tif(c.inGroup())\n\t\t{\t\t\tscript_node = c.memberList.head;\t\t}\t\telse\n\t\t{\t\t\tscript_node = {};\t\t\tscript_node.obj =\nc.data.id;\t\t}\t\twhile(script_node != null)\t\t{\t\t\tvar\nspt_player = getCharactor( script_node.obj\n);\t\t\tvar i=0;\t\t\taddChaExp(script_node.obj,\nBASIC_GET_EXP[spt_player.level]*spt_expNumall);\t\t\taddMoney(script_node.obj,\"moneyBind\",BASIC_GET_MONEY[spt_player.level]*spt_monNumall);\t\t\tfor(i=0;i<spt_baoshiNum;i++)\t\t\t{\t\t\t\tvar\nscript_obj1 =\ngetPlanByRate(\"3-1259\");\t\t\t\taddItemByPlan(script_node.obj,\nscript_obj1,\n0);\t\t\t}\t\t\tfor(i=0;i<spt_daojuNum;i++)\t\t\t{\t\t\t\tvar\nscript_obj2 =\ngetPlanByRate(\"3-1260\");\t\t\t\taddItemByPlan(script_node.obj,\nscript_obj2, 0);\t\t\t}\t\t\tscript_index\n++;\t\t\tscript_node = script_node.next;\t\t}\t}}",
