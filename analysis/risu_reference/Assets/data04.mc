    "T29.2787.name": "Túi Rồng Cao Cấp",
    "T29.2787.info": "Nhấp đôi sử dụng chìa khóa",
    "T29.2787.reqClass": "|1|2|5|3|6|4|",
    "T29.2787.description": "Có thể nhận được pet hệ rồng",
    "T29.2788.name": "Thiếu Nữ Rồng",
    "T29.2788.info": "Nhấp đôi để mở túi quà",
    "T29.2788.reqClass": "|1|2|5|3|6|4|",
    "T29.2788.description": "Có thể nhận được Linh Long",
    "T29.2789.name": "Túi Quà Thỏ Baby",
    "T29.2789.info": "Nhấp đôi để mở túi quà",
    "T29.2789.reqClass": "|1|2|3|4|6|5|",
    "T29.2789.description": "Chứa 1 pet Thỏ Baby Bảo Bảo phẩm chất 1.5 (cấp độ\nmang theo 80), có xác suất nhận được 1 Cà Rốt Thần\nKỳ.",
    "T29.2790.name": "Hoàng Kim Lễ (5000)",
    "T29.2790.info": "Nhấp đôi sử dụng để đổi kim phiếu",
    "T29.2790.reqClass": "|1|2|3|4|6|5|",
    "T29.2790.description": "Cuộn giấy dùng để đổi lấy kim phiếu",
    "T29.2791.name": "Hoàng Kim Lễ (80000)",
    "T29.2791.info": "Nhấp đôi sử dụng để đổi kim phiếu",
    "T29.2791.reqClass": "|1|2|3|4|6|5|",
    "T29.2791.description": "Cuộn giấy dùng để đổi lấy kim phiếu",
    "T29.2792.name": "Kim Cương Điểm Thưởng (Nhỏ)",
    "T29.2792.info": "Vật phẩm tiền",
    "T29.2792.reqClass": "|1|2|3|4|6|5|",
    "T29.2792.description": "Sau khi dùng sẽ nhận được 500 điểm thưởng",
    "T29.2793.name": "Cà Rốt Thần Kỳ",
    "T29.2793.info": "Cà rốt ngon lành, chỉ có Thỏ Baby mới có thể ăn,\nCTRL+ nhấp đôi sử dụng",
    "T29.2793.reqClass": "|3|",
    "T29.2793.description": "Cà Rốt Thần Kỳ là một loại rau ngon nhất thế giới!\nTất nhiên đây chỉ là điều mà Thỏ Baby nghĩ thôi.\nVị ngọt của cà rốt và các chất dinh dưỡng trong đó\nsẽ giúp Thỏ Baby Bảo Bảo luôn tràn trề năng lượng,\nngoài ra còn có thể học được 1 trong 2 kỹ năn",
    "T29.2794.name": "Hạt Giống Tết Trồng Cây",
    "T29.2794.info": "Nhấp đôi sử dụng",
    "T29.2794.reqClass": "|1|2|3|4|6|5|",
    "T29.2794.description": "Hạt giống dùng để trồng cây trong dịp Tết Trồng\nCây, có thể đến gặp Sứ Giả Sự Kiện Tết Trồng Cây ở\nĐông Huyền Thành để vào khu vực trồng",
    "T29.2795.name": "Kết Tinh Thần Tu (Mỗi ngày chỉ dùng 3 cái)",
    "T29.2795.info": "Sau khi dùng sẽ ngẫu nhiên nhận được 1 lượng điểm\nthần tu",
    "T29.2795.reqClass": "|1|2|5|3|6|4|",
    "T29.2795.description": "Vật phẩm thần kỳ cao cấp giúp nhận được điểm thần\ntu, cấp độ càng cao thì nhận được càng nhiều.\nNgoài ra còn có phần quà bất ngờ, tuy nhiên mỗi\nngười mỗi ngày chỉ có thể dùng 3 cái.",
    "T29.2796.name": "Kết Tinh Thần Tu (Mỗi ngày chỉ dùng 5 cái)",
    "T29.2796.info": "Sau khi dùng sẽ ngẫu nhiên nhận được 1 lượng điểm\nthần tu",
    "T29.2796.reqClass": "|1|2|5|3|6|4|",
    "T29.2796.description": "Vật phẩm thần kỳ cao cấp giúp nhận được điểm thần\ntu, cấp độ càng cao thì nhận được càng nhiều.\nNgoài ra còn có phần quà bất ngờ, tuy nhiên mỗi\nngười mỗi ngày chỉ có thể dùng 5 cái.",
    "T29.2797.name": "Dược Thủy Sức Sống",
    "T29.2797.info": "Khôi phục tối đa điểm sức lực",
    "T29.2797.reqClass": "|1|2|3|4|6|5|",
    "T29.2797.description": "Dược phẩm thần kỳ giúp khôi phục toàn bộ điểm sức\nlực, mỗi người mỗi ngày chỉ có thể dùng 2 bình.",
    "T29.2798.name": "Sách Triệu Hồi Cao Cấp (30 Ngày)",
    "T29.2798.info": "Nhấp đôi sử dụng để gọi Thần thú theo sau!",
    "T29.2798.reqClass": "|1|2|5|3|6|4|",
    "T29.2798.description": "Sau khi dùng sẽ gọi được pet thần thú tím\ntrở lên xuất hiện sau nhân vật trong 30 ngày",
    "T29.2799.name": "Thẻ Chơi Xỏ Cá Tháng Tư",
