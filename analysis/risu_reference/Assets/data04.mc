    "T19.791.name": "Nguyên Soái Hộ Kiên",
    "T19.791.reqClass": "|1|",
    "T19.791.description": "Trang bị kế thừa từ các tướng lĩnh tử trận, tuy cũ\nnhưng khả năng phòng hộ khá cao\n",
    "T19.792.name": "Đế Vương Hộ Kiên",
    "T19.792.reqClass": "|1|",
    "T19.792.description": "Trang bị của bậc đế vương mà mọi người đều mong\nmột lần được mặc\n",
    "T19.793.name": "Chiến Thần Hộ Kiên",
    "T19.793.reqClass": "|1|",
    "T19.793.description": "Trang bị mơ ước của tất cả võ sĩ, có khả năng hoá\ngiải hầu hết mọi đòn tấn công\n",
