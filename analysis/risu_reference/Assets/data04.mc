    "T19.709.description": "Được làm từ vỏ cây nhưng sức phòng ngự còn cao hơn\ncả sắt thép\n",
    "T19.710.name": "Phá Hy Hộ Kiên",
    "T19.710.reqClass": "|5|",
    "T19.710.description": "Làm bằng da gấu bền chắc, lại được gia công tỷ mỉ\nnên rất tốt\n",
    "T19.711.name": "Thanh Đồng Ngoa",
    "T19.711.reqClass": "|1|",
    "T19.711.description": "Giày chiến dễ làm, rẻ tiền được làm từ thanh đồng,\nlà lựa chọn tốt nhất dành cho tân thủ\n",
    "T19.712.name": "Tinh Thiết Ngoa",
    "T19.712.reqClass": "|1|",
    "T19.712.description": "Giày chiến được luyện bằng sắt tinh luyện có tình\nnăng phòng hộ tốt hơn so với các dụng cụ phòng hộ\nbằng thanh đồng\n",
    "T19.713.name": "Hợp Kim Ngoa",
    "T19.713.reqClass": "|1|",
    "T19.713.description": "Được tôi luyện từ các loại kim loại cao cấp, có\nđặc tính ưu việt hơn hẳn giày chiến thông thường\n",
    "T19.714.name": "Dũng Sĩ Ngoa",
    "T19.714.reqClass": "|1|",
    "T19.714.description": "Dũng sĩ tộc người Vô Ưu đi giày chiến này khi đi\nsăn bắn hoặc chiến đấu có thể giảm thiểu thương\nvong\n",
    "T19.715.name": "Tướng Quân Ngoa",
    "T19.715.reqClass": "|1|",
    "T19.715.description": "Khi tướng quân xuất trận đi giày chiến này có khả\nnăng phòng hộ tương đối tốt, uy phong lẫm liệt\n",
    "T19.716.name": "Hoàng Kim Ngoa",
    "T19.716.reqClass": "|1|",
    "T19.716.description": "Dũng sĩ có chiến công vang dội mới có tư cách đi\ngiày chiến bằng vàng\n",
    "T19.717.name": "Khinh Bì Ngoa",
    "T19.717.reqClass": "|2|",
    "T19.717.description": "Được chế tạo từ da động vật, không những nhẹ nhàng\ntiện dụng mà còn thể chống được phong hàn\n",
    "T19.718.name": "Nhạn Linh Ngoa",
    "T19.718.reqClass": "|2|",
    "T19.718.description": "Được làm từ lông vũ của chim nhạn, vì thế hết sức\nmềm mại, nhẹ nhàng và sở hữu khả năng phòng ngự\nđáng kể\n",
    "T19.719.name": "Tinh Linh Ngoa",
    "T19.719.reqClass": "|2|",
    "T19.719.description": "Các thương nhân vì muốn kiếm lời nên đã mô phỏng\nchế tạo theo trang bị chiến đấu của Tinh Linh Tộc,\ntất nhiên chất lượng không thể tốt bằng\n",
    "T19.720.name": "Quý Tộc Ngoa",
    "T19.720.reqClass": "|2|",
    "T19.720.description": "Trang phục của quý tộc, hoa lệ và cá tính, phô\ntrương sự vô tận về tài phú cùng quyền lực\n",
    "T19.721.name": "Linh Động Ngoa",
    "T19.721.reqClass": "|2|",
    "T19.721.description": "Được dệt từ một loại gấm vô danh, nhẹ nhàng phiêu\ndật, bề ngoài nhìn có vẻ mỏng manh nhưng rất bền\n",
    "T19.722.name": "Tước Sĩ Ngoa",
    "T19.722.reqClass": "|2|",
    "T19.722.description": "Tầng lớp quý tộc thượng lưu thường sử dụng, màu\nsắc đẹp và sáng, khả năng phòng hộ tốt\n",
    "T19.723.name": "Sa Nhung Ngoa",
    "T19.723.reqClass": "|4|",
    "T19.723.description": "Được làm từ sa nhung thông thường mà người dân vẫn\nhay mặc\n",
    "T19.724.name": "Tằm Tơ Ngoa",
    "T19.724.reqClass": "|4|",
    "T19.724.description": "Dệt từ tơ tằm, bền và có chức năng phòng hộ nhất\nđịnh\n",
    "T19.725.name": "Nộ Đào Ngoa",
    "T19.725.reqClass": "|4|",
    "T19.725.description": "Được chế từ tơ lụa thượng hạng, hoa văn nổi bật,\nkhí thế bất phàm\n",
    "T19.726.name": "Lôi Ảnh Ngoa",
    "T19.726.reqClass": "|4|",
    "T19.726.description": "Trang bị ẩn chứa sức mạnh của sấm sét\n",
    "T19.727.name": "Bạo Phong Ngoa",
    "T19.727.reqClass": "|4|",
    "T19.727.description": "Trang bị sở hữu năng lực phòng ngự từ gió bão cực\nmạnh\n",
    "T19.728.name": "Liệt Diệm Ngoa",
    "T19.728.reqClass": "|4|",
    "T19.728.description": "Được làm bởi người thợ nổi tiếng có \n tay nghề xuất sắc nên rất bảo \n đảm về năng lực phòng ngự",
    "T19.729.name": "Miên Bố Ngoa",
    "T19.729.reqClass": "|3|",
    "T19.729.description": "Được dệt từ vải bông mà đa số người dân thường\ndùng\n",
    "T19.730.name": "Dương Bì Ngoa",
    "T19.730.reqClass": "|3|",
    "T19.730.description": "Được làm từ lông cừu, ấm áp thực dụng nhưng khả\nnăng phòng ngự rất bình thường\n",
    "T19.731.name": "Kim Ty Ngoa",
    "T19.731.reqClass": "|3|",
    "T19.731.description": "Được dệt từ tơ vàng, giá thành cao, hiệu quả phòng\nngự rất tốt\n",
    "T19.732.name": "Chúc Phúc Ngoa",
    "T19.732.reqClass": "|3|",
    "T19.732.description": "Vốn là trang bị làm từ chất liệu thông thường\nnhưng sau khi được pháp sư chúc phúc thì hiệu quả\nhoàn toàn khác\n",
    "T19.733.name": "Nhân Từ Ngoa",
    "T19.733.reqClass": "|3|",
    "T19.733.description": "Được làm bằng nguyên liệu cao cấp của giáo hội, có\ntác dụng phòng thân rất tốt\n",
    "T19.734.name": "Tín Ngưỡng Ngoa",
    "T19.734.reqClass": "|3|",
    "T19.734.description": "Tương truyền từng là trang bị của một nhà sư khi\nlàm ra bước vào thế giới thần thánh\n",
    "T19.735.name": "Hắc Đào Chiến Ngoa",
    "T19.735.reqClass": "|6|",
    "T19.735.description": "Được nung nóng bởi bùn đen và sợi gai đặc biệt,\ntuy dễ bị hỏng nhưng dùng rất thoải mái\n",
    "T19.736.name": "Vân Thiết Chiến Ngoa",
    "T19.736.reqClass": "|6|",
    "T19.736.description": "Có độ cứng chắc hơn so các dụng cụ phòng hộ bằng\nsắt khác\n",
    "T19.737.name": "Phá Ma Chiến Ngoa",
    "T19.737.reqClass": "|6|",
    "T19.737.description": "Trang bị mà các dũng sĩ bình thường tương đối yêu\nthích, khả năng phòng ngự hơn hẳn các trang bị\nthông thường\n",
    "T19.738.name": "Nộ Trảm Chiến Ngoa",
    "T19.738.reqClass": "|6|",
    "T19.738.description": "Được làm bởi người thợ nổi tiếng có \n tay nghề xuất sắc nên rất bảo \n đảm về năng lực phòng ngự",
    "T19.739.name": "Nhiệt Huyết Chiến Ngoa",
    "T19.739.reqClass": "|6|",
    "T19.739.description": "Được làm từ tay của người thợ thuộc trường phái\nLưu Hỏa, truyền rằng giầy này được đo theo kích\nthước của dũng sĩ trong tộc, có tác dụng chống đỡ\ntổn thương cục bộ\n",
    "T19.740.name": "Vô Cự Chiến Ngoa",
    "T19.740.reqClass": "|6|",
    "T19.740.description": "Trang bị phòng ngự mang đến dũng khí cho người sử\ndụng\n",
    "T19.741.name": "Tử Đằng Ngoa",
    "T19.741.reqClass": "|5|",
    "T19.741.description": "Được làm bằng sợi gai tím nhỏ và mềm,rất nhẹ nên\nthợ đi săn thường dùng khi đi săn\n",
    "T19.742.name": "Hổ Bì Ngoa",
    "T19.742.reqClass": "|5|",
    "T19.742.description": "Được làm bằng da hổ, tuy xấu xí nhưng bền và dễ\nmặc, có thể tăng khả năng phòng hộ\n",
