    "T35.1036.at": "0-23|0-6|1-31|0-11|FbNpc",
    "T35.1036.onServiceText": "Ngươi có thể dùng nấm hái được trong Tiên Cảnh để\nđổi lấy phần thưởng ở chỗ ta.",
    "T35.1036.name": "Sứ Giả Hoán Đổi",
    "T35.1037.at": "0-23|0-6|1-31|0-11|FbNpc",
    "T35.1037.onServiceText": "Ta có thể giúp ngươi làm chìa khóa vạn năng, nhưng\nngươi phải trả tiền, ha ha!",
    "T35.1037.name": "Thợ Làm Chìa Khóa Tham Lam",
