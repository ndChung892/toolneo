    "T35.1756.name": "Cường Đạo Bánh Kem",
    "T35.1757.at": "new|2012/9/20/0/0/0-2012/9/29/23/59/0",
    "T35.1757.onServiceText": "Để trở thành dũng sĩ trí dũng song toàn thì hãy\nđến khiêu chiến với thử thách của học viện ma\nthuật này để có thể học thêm nhiều điều bổ ích!",
    "T35.1757.name": "Nhân Viên Thẩm Định",
    "T35.1758.scriptOff": "deleteNpcInstance(npc.id);",
    "T35.1758.name": "Bảo Rương Kỷ Niệm",
    "T35.1759.onServiceText": "Vĩnh Dạ Cảng đâu đâu cũng là bóng đêm, thật đúng\nlà thiên đường cho Muỗi Quỷ",
    "T35.1759.name": "Thợ Săn Muỗi",
    "T35.1760.scriptOff": "deleteNpcInstance(npc.id);",
    "T35.1760.name": "Sứ Giả Đón Tiếp",
    "T35.1761.onServiceText": "Để trở thành dũng sĩ trí dũng song toàn thì hãy\nđến khiêu chiến với thử thách của học viện ma\nthuật này để có thể học thêm nhiều điều bổ ích!",
    "T35.1761.name": "Nhân Viên Thẩm Định",
    "T35.1762.onServiceText": "Trên để trừ ác đế, dưới để trừ tà yêu, tâm cũng là\nnghĩa, thiên hạ là chí.",
    "T35.1762.name": "Đạo Sư Lưu Hỏa",
    "T35.1763.onServiceText": "Hoan nghênh đến với thánh địa của đồ ăn ngon và\nlinh hồn của nghệ thuật âm nhạc - Liêu Vân Tộc.\nLiêu Vân Tộc là nơi hội tụ của nhưng người có tâm\nhồn và khát khao nghệ thuật, vẻ cổ kính của nó gắn\nliền với thời âm nhạc mới xuất hiện tại đại lục Vô\nƯu, điề",
    "T35.1763.name": "Đạo Sư Liêu Vân",
    "T35.1764.onServiceText": "Chào mừng ngươi đến với thành trì của sức sống và\nniềm vui - Huyền Lâm Tộc",
    "T35.1764.name": "Đạo Sư Huyền Lâm",
    "T35.1765.onServiceText": "Hoan nghênh đến với Linh Vũ Tộc. Linh Vũ Tộc là\nmột tộc cổ, cùng với năm tộc nổi tiếng khác. Gia\ntộc luôn bồi dưỡng về lễ nghĩa, dược liệu và\ntruyền dạy những kỹ năng trị liệu và phụ trợ và\nđược nhiều người tôn trọng. Từ trước đến nay chúng\nta luôn trong",
    "T35.1765.name": "Đạo Sư Linh Vũ",
    "T35.1766.scriptOff": "if(!d[33][npc.posMapId].fight1){\td[33][npc.posMapId].fight1\n= true;}",
    "T35.1766.onServiceText": "Đây là Bàn Địa Tộc phía đông Quang Bình Nguyên. Là\nmột tộc cổ có hàng trăm năm lịch sử, chúng ta nổi\ntiếng khắp đại lục về kiến thức kiến trúc thổ mộc\nvà thăm dò địa chất. Hôm nay cùng với sáu tộc lớn\nkhác xây dựng nên Đông Huyền, vị trí của chúng ta\nnằm",
    "T35.1766.name": "Đạo Sư Bàn Địa",
    "T35.1767.scriptOff": "if(!d[33][npc.posMapId].fight2){\td[33][npc.posMapId].fight2\n= true;}",
    "T35.1767.onServiceText": "Chào mừng đến với Thiên Khung Tộc, nơi sẽ đào tạo\nngươi thành Xạ thủ tài ba.",
    "T35.1767.name": "Đạo Sư Thiên Khung",
    "T35.1768.scriptOff": "if(!d[33][npc.posMapId].last){\td[33][npc.posMapId].last\n= true;}",
    "T35.1768.onServiceText": "Vận mệnh tương lai nằm trong tay các ngươi!",
