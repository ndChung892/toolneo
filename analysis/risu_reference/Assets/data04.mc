    "T98.573.name": "Quyết Chiến Mạt Nhật",
    "T99.1.description": "Chuyển đến 1 vị trí ngẫu nhiêu trong phạm vi từ 1\n- 2 ô",
    "T99.1.name": "Tâm Khiêu Ma Phương",
    "T99.2.description": "Chuyển đến Điểm Đầu hoặc Điểm Cuối",
    "T99.2.name": "Không Gian Mộng Ảo",
    "T99.3.description": "Giảm từ 1- 3 điểm hành động",
    "T99.3.name": "Giảm Thiểu Hành Động",
    "T99.4.description": "Tăng từ 1- 3 điểm hành động",
    "T99.4.name": "Gia Tăng Hành Động",
    "T99.5.description": "Hồi phục 1 lượng HP",
    "T99.5.name": "Tuyền Thủy Sinh Mệnh",
    "T99.6.description": "Giảm 1 lượng HP",
    "T99.6.name": "Cạm Bẫy Chí Mạng",
    "T99.7.description": "Tăng 1 lượng HP, tấn công, phòng ngự, tốc độ",
    "T99.7.name": "Nữ Thần May Mắn",
    "T99.8.description": "Có cơ hội mua được vật phẩm giảm giá",
    "T99.8.name": "Giảm Giá Tinh Phẩm",
    "T99.9.description": "Có cơ hội rút nhận bảo vật",
    "T99.9.name": "Khai Mở Bảo Rương",
    "T99.10.description": "Trả lời 1 lượng câu hỏi, lượng câu đáp đúng càng\ncao, phần thưởng càng nhiều",
    "T99.10.name": "Đáp Án Trí Tuệ",
    "T99.11.description": "Khi gặp Quái Vật Làm Loạn, nếu thất bại sẽ giảm 1\nnửa HP",
    "T99.11.name": "Quái Vật Làm Loạn",
    "T99.12.description": "Khi gặp Tiểu Đội Tinh Anh, nếu thất bại sẽ giảm 1\nnửa HP",
    "T99.12.name": "Tiểu Đội Tinh Anh",
    "T99.13.description": "Khi gặp Ngộ Lâm Ngộ Tập, nếu thất bại sẽ giảm 1\nnửa HP",
    "T99.13.name": "Mật Lâm Ngộ Tập",
    "T99.14.description": "Khi khiêu chiến BOSS, nếu thất bại sẽ giảm 1 nửa\nHP",
    "T99.14.name": "Khiêu Chiến BOSS",
    "T99.15.name": "Phần Thưởng Cuối",
    "T100.1.discription": "Thiên Sứ Mít Ướt là hóa thân của thần Tình Yêu, vì\nthế có nhiều kỹ năng rất kỳ diệu. Nếu sở hữu Hào\nQuang Ái Thần, pet sẽ có khả năng trị liệu cho\nnhiều người, nếu có kỹ năng Mũi Tên Cupid, pet sẽ\nkhiến cho nhiều địch thủ rơi vào trạng thái hỗn\nloạn, đặc",
    "T100.1.name": "Thiên Sứ Mít Ướt",
    "T100.2.discription": "Ác Ma Quấy Phá có năng lực phá hoại cực mạnh. Nếu\nsở hữu Ác Ma Chi Kích, pet sẽ có năng lực sát\nthương cực mạnh, nếu có Tình Yêu Ngụy Kế, pet sẽ\ntạo sát thương cho số đông, đặc biệt là kỹ năng\nLời Ngọt Ngào có thể cùng lúc gây sát thương cho\n10 mục tiêu,",
    "T100.2.name": "Ác Ma Quấy Phá",
    "T100.3.discription": "Y Tá MM là một y tá đẳng cấp của gia tộc Đông\nHuyền, vừa tận tâm, vừa ôn hòa, dễ mến. Bằng tài\nnăng và sự chân thành, có Y Tá MM bên cạnh, mọi\nvết thương trên người đều sẽ được trị khỏi. Tuy\nnhiên trong những cuộc chiến sinh tử, Y Tá MM luôn\ncó năng lực s",
    "T100.3.name": "Y Tá MM",
    "T100.4.discription": "Là nhân vật hình mẫu của các gia tộc. Vẻ ngoài\nxinh xắn, nhưng năng lực biến hóa khôn lường. Muốn\nthử nghiệm thì cứ động thủ !",
    "T100.4.name": "Tiểu Lương Tử",
    "T100.5.discription": "Chú dê con bé nhỏ này rất thích hợp cho những\nngười chơi mới do có sức tấn công mạnh, tốc độ\nnhanh, bạo kích cao, lại có thuộc tính ám hỗ trợ,\nđiểm yếu là lượng HP tương đối thấp và dễ bị pet\nthuộc tính quang khắc chế.",
    "T100.5.name": "Hổ Bì Dương",
    "T100.6.discription": "Thực lực của Kim Ngưu là quá rõ ràng, các điểm tư\nchất cao, sức tấn công mạnh và lượng HP dồi dào,\ncộng thêm vẻ ngoài đáng sợ đã khiến Kim Ngưu trở\nthành 1 trong những pet đáng gờm trên Vô Ưu Đại\nLục. Một pet Kim Ngưu có kỹ năng Dã Thú Cuồng Vũ\nchính là m",
    "T100.6.name": "Kim Ngưu",
    "T100.7.discription": "Tinh Linh Hộ Thú tuy không sở hữu sức tấn công\nmạnh mẽ, cũng không có ma pháp huyền diệu, nhưng\nđộ trung thành của pet này là không thể xem\nthường. Khả năng liều mình ngăn chặn tấn công vật\nlý cho chủ nhân và đồng đội chắc chắn sẽ khiến bạn\nyên tâm trên b",
    "T100.7.name": "Tinh Linh Hộ Thú",
    "T100.8.discription": "Long tộc là chủng tộc pet cao quý trên Vô Ưu Đại\nLục, khả năng miễn 70% sát thương khiến cho kẻ\nđịch phải chùn bước. Nếu có thêm các kỹ năng hỗ\ntrợ, pet rồng sẽ khiến cho kẻ nào dám đương đầu\nđều sẽ hối hận!",
    "T100.8.name": "Đinh Long",
    "T100.9.discription": "Long tộc là chủng tộc pet cao quý trên Vô Ưu Đại\nLục, khả năng miễn 70% sát thương khiến cho kẻ\nđịch phải chùn bước. Nếu có thêm các kỹ năng hỗ\ntrợ, pet rồng sẽ khiến cho kẻ nào dám đương đầu\nđều sẽ hối hận!",
    "T100.9.name": "Thần Long Viễn Cổ",
    "T100.10.discription": "Không nên xem thường quả dứa bé nhỏ này, chất độc\ntrên người nó khiến cho loài rồng cũng phải kiêng\ndè. Các kỹ năng độc và hồi HP của pet này đều rất\nđáng nể.",
    "T100.10.name": "Dứa Mật",
    "T100.11.discription": "Dê thì phải ăn cỏ thôi, bộ lạ lắm à?",
    "T100.11.name": "Dê Con II",
    "T100.12.discription": "Chúa sơn lâm đã xuất hiện! Đừng nhìn vẻ bề ngoài\nđáng yêu của pet mà xem thường nhé. Các kỹ năng\nhấp thu HP của Kim Hổ tạo sát thương cực mạnh,\nkhiến cho pet này có năng lực chiến đấu mạnh mẽ\ntrên chiến trường và sức chịu đựng bền bỉ.",
    "T100.12.name": "Kim Hổ",
    "T100.13.discription": "Là người thừa kế duy nhất của hoàng tộc vương quốc\nmáy móc, vẻ mặt đáng yêu thánh thiện, Momo sở hữu\nnhững kỹ năng sử dụng năng lượng sóng điện như Mê\nTâm hay Khóa Mục Tiêu, khiến đối thương trúng sát\nthương trong chớp mắt. Ngoài ra các kỹ năng hệ máy\nnhư",
    "T100.13.name": "Momo",
    "T100.14.discription": "Hoàng Tử Thiên Sứ là niềm tự hào của Tộc Thiên Sứ,\ncó khả năng dẫn dắt sức mạnh thần thánh, bảo vệ và\ntăng sức chiến đấu cho bản thân và đồng đội.",
    "T100.14.name": "Hoàng Tử Thiên Sứ",
    "T100.15.discription": "Đừng để vẻ đẹp của Công Chúa Ác Ma đánh lừa bạn,\nkhả năng phá hoại của cô ấy khiến cho Ma Vương\ncũng phải ngán ngẩm, bản lĩnh dẫn dắt sức mạnh ma\ngiới sẽ tạo sát thương cực mạnh cho kẻ địch.",
    "T100.15.name": "Công Chúa Ác Ma",
    "T100.16.discription": "Nhím Xanh là tinh linh cao cấp, tuy vẻ ngoài đáng\nyêu và có chút yếu ớt nhưng bên trong lại có sức\nmạnh kinh hồn mà bản thân chưa biết. Có thể học\nđược tất cả kỹ năng hệ thực vật. Hai kỹ năng đặc\nbiệt nhất là Tiêu Nhược và Phản Xạ. Khi lâm vào\nhoàn cảnh s",
    "T100.16.name": "Nhím Xanh",
    "T100.17.discription": "Tuy có vẻ ngoài vô cùng đáng yêu nhưng sức chiến\nđấu của pet này thật sự rất đáng nể. Với bản chất\nthông minh, kế thừa và phát huy được các ưu thế\ncủa pet hệ người, ngoài ra còn sở hữu 2 kỹ năng\ntấn công ma pháp liên tục và ngăn chặn sát thương,\nThỏ Baby",
    "T100.17.name": "Thỏ Baby",
    "T100.18.discription": "Nấm Điện xuất thân từ vương quốc nấm xa xôi, nghe\nnói bọn yêu ma từng dụ dỗ Nấm Điện chống lại các\ngia tộc, nhưng Nấm Điện chính nghĩa đã không nghe\ntheo. Nấm Điện có đòn tấn công sát thương quy mô\nlớn, là pet thích hợp dùng để luyện cấp 50 - 80.",
    "T100.18.name": "Nấm Điện",
    "T100.19.discription": "Camy là truyền nhân của dòng tộc ác ma. Nhờ vào\nnhững ca khúc 《Linh Hồn Khúc》 ai oán, thần bí mà\ncó thể trói buộc được linh hồn của đối phương, làm\nkẻ thù mất đi khả năng tự hồi phục và trị liệu.\nĐây cũng là kỹ năng làm cho người khác khiếp sợ\ntrong hệ Ác",
    "T100.19.name": "Camy",
    "T100.20.discription": "Loni vốn là con gải của Đông Hải Long Vương, thông\nminh, đáng yêu, hiền lành, tốt bụng, và đặc biệt\nluôn hiếu kỳ với cuộc sống của nhân gian. Sở hữu\nkỹ năng ma pháp bí chú lợi hại, nhưng do tuổi còn\nquá nhỏ, công lực bí chú chưa được phát huy ổn\nđịnh",
    "T100.20.name": "Loni",
    "T100.21.discription": "Pony là truyền nhân nhí, dễ thương của gia tộc\nNgựa Một Sừng, luôn mong muốn đem lại hòa bình cho\nthế giới. Sở hữu ma pháp trị liệu thần thánh của\ngia tộc và rất ghét chiến tranh.",
    "T100.21.name": "Pony",
    "T100.22.discription": "Kỳ Kỳ là một tinh linh của tộc người Naga truyền\nthuyết, nắm giữ sức mạnh hắc ám vô biên của vùng\nbiển cổ xưa và chỉ có Kỳ Kỳ mới có khả năng thi\ntriển năng lực huyền bí của tộc Naga",
    "T100.22.name": "Kỳ Kỳ",
    "T100.23.discription": "Hình dáng bất định, sức mạnh bất ngờ. Không ai đối\nđầu nổi với Ma Hồn",
    "T100.23.name": "Ma Hồn【Kiếp Nạn Vô Ưu - Ma Hồn】",
    "T100.24.discription": "Linh vật biểu tượng cho sự tài phú. Mèo ta sẵn\nsàng cho các cư dân một món tài sản kết xù nhưng\nkhông phải ai cũng có được dễ dàng. Phải chứng\nminh mình là người xứng đáng nhé!",
    "T100.24.name": "Chiêu Tài Mao",
    "T100.25.discription": "Yêu thú bên cảnh của Ma Vương. Bề ngoài to lớn,\nhung ác, xấu xí, đủ làm cho mọi người không dám\nđến gần, huống hồ chi là khiêu chiến",
    "T100.25.name": "Phủ Ma",
    "T100.26.discription": "Bề ngoài như 1 đứa con nít dễ thương nhưng thực ra\nlà 1 binh khí chiến đấu lợi hại của vương quốc\nrobot. Tuy không trang bị nhiều đạn dược nhưng\ncũng đủ làm cho kẻ địch phải lao đao",
    "T100.26.name": "Búp Bê Máy",
    "T100.27.discription": "Đây là vị cua bạo ngược nhất trong lịch sử, được\nchôn cất ở lăng mộ nằm sâu trong hoang mạc. Khi\nphong ấn không còn, hắn sẽ là nỗi kinh hoàng cho\ntất cả cư dân",
    "T100.27.name": "Pharaoh Cabu III 【Kho Báu Đại Mạc】",
    "T100.28.discription": "Đây là chiến tướng ác ma được phong ấn sâu trong\nLiệt Diễm Thâm Uyên. Lần theo thời gian, sức phong\nấn giảm dần, Abate tìm cách trốn thoát, thống soái\nma giới",
    "T100.28.name": "Abate 【BOSS Liệt Diễm 4】",
    "T100.29.discription": "Truyền thuyết kể rằng, hộ sĩ sau khi chiến đấu ác\nma đã rơi vào giấc ngủ say, nhưng không biết vì lý\ndo gì, sau khi tỉnh giấc, hắn hoàn toàn thay đổi,\ntrởi thành linh hồn núp sau loài cây kịch động ở\nMê Huyễn, đợi thời cơ tấn công Vô Ưu",
    "T100.29.name": "Cự Ma Mê Huyễn 【4 BOSS chính Mê Huyễn】",
    "T100.30.discription": "Đây là hồn phách của thủ lĩnh tử trận năm xưa. Sau\nkhi bị ma khí xâm nhập thể xác đã trở nên cuồng\nbộ, luôn muốn tấn công vào Tinh Linh Thành",
    "T100.30.name": "Thành Chủ【Boss Chính Tuyến】",
    "T100.31.discription": "Làm nhiều chuyện xấu quá nên phải đeo kính đen để\ntránh bị truy nã",
    "T100.31.name": "Mèo Kính Đen",
    "T100.32.discription": "Đeo kính mát để che giấu đôi mắt gian xảo, thích\ntrêu ghẹo người khác của mình",
    "T100.32.name": "Mèo Yêu Tinh Nghịch",
    "T100.33.discription": "Không biết học yêu thuật từ phương nào mà phù thủy\nnày toàn thân đều có mùi lá cây",
    "T100.33.name": "Phù Thủy Tà Ác 【Lục Tiên Cảnh】",
    "T100.34.discription": "Không tà cũng không chính, giết người chủ yếu chỉ\nlà sở thích của Atula Vương",
    "T100.34.name": "Atula Vương",
    "T100.35.discription": "Vì hút quá nhiều máu người nên được phong là vua\ntrong các loài muỗi",
    "T100.35.name": "Muỗi Đại Vương",
    "T100.36.discription": "Vị thống soái tàn bạo nhất trong giới ác ma. Là\nđại diện cho năng lực tà ác",
    "T100.36.name": "Chu Ma Vương【Quái Chính 5 Chu Ma Điện】",
    "T100.37.discription": "Tuy không có sức nóng công phá như mặt trời thật\nsự nhưng cũng đủ làm nhân loại một phen điên đảo",
    "T100.37.name": "Tiểu Thái Dương",
    "T100.38.discription": "Là cua nhưng lại thích sống trên cạn hơn dưới\nnước. Vì vậy mà sức mạnh của nó cũng rất khó lường",
    "T100.38.name": "Cua Yêu",
    "T100.39.discription": "Nhìn như vũ khí uy lực to lớn, có khả năng phá vỡ\nbất kỳ tảng băng cứng rắn nào",
    "T100.39.name": "Cơ Giáp Phá Băng Loại 300",
    "T100.40.discription": "Có khả năng khống chế thế giới thực và ảo, tính\ntình quái dị, ma lực thần bí. Không ai ở Đại Lục\nVô Ưu này là không biết độ khủng của bọn chúng",
    "T100.40.name": "Ma Chiến",
    "T100.41.discription": "Là một trong những yêu ma mạnh nhất luôn đối đầu\nvới thế giới chính nghĩa. Khi xuất hiện luôn có\nngọn lửa bao quanh người",
    "T100.41.name": "Ma Thần",
    "T100.42.discription": "Có khả năng tự thay đổi diện mạo một cách nhanh\nchóng, không ai biết được bộ mặt thật",
    "T100.42.name": "Thiên Diện Ma Vương",
    "T100.43.discription": "Được gọi là Tử thần của Cổ Thần, đã tham gia chinh\nphạt nhiều năm, kinh nghiệm chiến đấu hơn người",
    "T100.43.name": "Tiểu Binh Cổ Thành【BOSS lv150】",
    "T100.44.discription": "Núp bóng dưới hình hài 1 con rồng nhỏ dễ thương\nnhưng thật ra nó chẳng có họ hàng gì với loài rồng",
    "T100.44.name": "Mammon",
    "T100.45.discription": "Không ai có thể tùy tiện bắt nạt được Samael",
    "T100.45.name": "Samael",
    "T100.46.discription": "Chỉ thích một cuộc sống yên bình, vì vậy đã sống\nẩn dật nhiều năm ở các dãy núi Vân Lộc Sơn. Ai làm\nphiền Leviathan sẽ phải gánh chịu hậu quả nặng nề",
    "T100.46.name": "Leviathan",
    "T100.47.discription": "Gia nhập vào binh đoàn ác ma từ lâu nên các thủ\nđoạn tội ác của chúng Lợi Trảo Long đều rất thông\nthuộc và từ từ mất đi tính tôn quý từ gia tộc Rồng",
    "T100.47.name": "Lợi Trảo Long",
    "T100.48.discription": "Đôi cánh là binh khí uy lực nhất của sinh vật gia\ntộc Rồng này",
    "T100.48.name": "Dực Long",
    "T100.49.discription": "Không biết vì nguyên do gì mà từ một con rồng ôn\nhòa lại trở nên nóng nảy như vậy. Hễ ai chọc giận\nBạo Liệt Long là đều có có kết cục đẹp",
    "T100.49.name": "Bạo Liệt Long",
    "T100.50.discription": "Sinh vật của dòng dõi Rồng sống tại Bàn Địa Tộc,\ncó sứ mạnh công phá uy dũng",
    "T100.50.name": "Bàn Thạch Long",
    "T100.51.discription": "Một sinh linh sống tại Mễ Quang Tự. Không ai biết\nđây là người hay ma, chỉ biết hắn có tài làm người\nta rơi vào ảo giác",
    "T100.51.name": "Mê Hồn Giáo Chủ",
    "T100.52.discription": "Nhóm người có trí tuệ thông minh, có khả năng chế\ntạo các người máy chiến đấu, ẩn cư vùng băng tuyết",
    "T100.52.name": "Tộc Navi",
    "T100.53.discription": "Tập đoàn cướp bóc xuyên đại lục, là 1 trong những\nmối nguy hại hàng đầu của Đại Lục Vô Ưu",
    "T100.53.name": "Thủ Lĩnh Hải Tặc",
    "T100.54.discription": "Luôn có dã tâm trở lại xâm chiếm Đại Lục Vô Ưu, là\n1 trong những mối nguy hại hàng đầu",
    "T100.54.name": "Phản Quân Đại Tướng",
    "T100.55.discription": "So với đám hải tặc, Phi tặc có tài cướp bóc nhưng\ntrong chốn không người. Ra tay nhanh chóng, gọn lẹ\nlà ưu điểm của chúng",
    "T100.55.name": "Phi Tặc",
    "T100.56.discription": "Vua ma thần vĩ đại, không chỉ cực mạnh mà còn là\nkẻ đứng đầu ma giới, lãnh đạo 72 ma thần.",
    "T100.56.name": "Solomon",
    "T100.57.discription": "Đây là con trai của thần Sấm Sét, vì bị thần Hắc\nÁm đầu độc nên cùng với đứa em trai của mình -\nthần Sức Mạnh liên kết giết chết cha ruột của mình\nvà sai khiến Solomon hủy diệt Đại Lục Vô Ưu.",
    "T100.57.name": "Mehdi",
    "T100.58.discription": "Hỏi thế gian tình là gì? Tình khiến sinh tử tương\nhứa. Trời nam đất bắc song phi nhạn. Cổ thụ mấy\nmùa hàng sơn. Hoan lạc thú, biệt ly sầu.",
    "T100.58.name": "Cô Gái Si Tình",
    "T100.59.discription": "Vì có những trai lăng nhăng này mà những cô gái si\ntình càng thêm đau khổ",
    "T100.59.name": "Chàng Trai Lăng Nhăng",
    "T100.60.discription": "Thuần chủng máu trâu, thuần chủng sức mạnh, không\nai địch lại",
    "T100.60.name": "Huyết Ngưu Thuần Chủng",
    "T100.61.discription": "Bất kể là người hay ma thì đều có 1 tuổi thơ và\nhình ảnh ngậm sữa bình vẫn luôn là đáng nhớ nhất",
    "T100.61.name": "Ác Long Sơ Sinh",
    "T100.62.discription": "Đừng tưởng Long tộc chỉ biết dùng sức mạnh móng\nvuốt. Linh Long ngoài hình dáng xinh xắn, còn có\nmê lực hơn người",
    "T100.62.name": "Linh Long",
    "T100.63.discription": "Là em gái của Linh Long, sắc đẹp cũng như tài\nnăng, không thua kém gì người chị của mình",
    "T100.63.name": "Tiểu Linh Long",
    "T100.64.discription": "Trang điểm xong rồi mặc áo ngủ đi chơi mới là thú\nvị ^_^",
    "T100.64.name": "Momo Bản Du Hành【Du Hành】",
    "T100.65.discription": "Người bạn tốt của nông dân là đây …",
    "T100.65.name": "Chim Ưng",
    "T100.66.discription": "Chú dê con bé nhỏ này rất thích hợp cho những\nngười chơi mới do có sức tấn công mạnh, tốc độ\nnhanh, bạo kích cao, lại có thuộc tính ám hỗ trợ,\nđiểm yếu là lượng HP tương đối thấp và dễ bị pet\nthuộc tính quang khắc chế.",
    "T100.66.name": "Dê Con",
    "T100.67.discription": "Tuy là có họ hàng với gà bát vị nhưng theo kinh\nnghiệm của Nhà Hàng Âu Dương thì thiếu 1 vị như\nThất Vị Kê vẫn rất là hấp dẫn",
    "T100.67.name": "Thất Vị Kê",
    "T100.68.discription": "Máu là nguồn dinh dưỡng nuôi sống hải tinh, và từ\nlâu hắn luôn mục tiêu có các binh đoàn khát máu\nchiêu mộ",
    "T100.68.name": "Hấp Huyết Hải Tinh",
    "T100.69.discription": "Tất cả công phu đều là tự luyện thành. Mỗi ngày\ngấu trúc phải ăn 1 lượng lớn cơm để bồi bổ công\nlực",
    "T100.69.name": "Gấu Trúc Kungfu",
    "T100.70.discription": "Tâm nguyện luôn muốn trở thành con người, nhưng do\nhoàn cảnh đưa đẩy mà chỉ biến hình được cái kính\nmát và khăn đỏ buột đầu. Đừng vì ngoại hình kỳ\nquái này mà khinh thường rùa ta ~!~",
    "T100.70.name": "Rùa Nika",
    "T100.71.discription": "Đây là sủng vật của các chư thần, chạy trốn trên\nkhông trung. Tốc độ di chuyển nhanh như gió. Vì\nvậy sức chiến đấu cũng rất đáng nể",
    "T100.71.name": "Tuần Lộc Mị Ảnh",
    "T100.72.discription": "Là 1 trong những á ma truyền thuyết,. Một phần\nthân thể bị giam ở Đăng Vân Địa, nhiều lần toan\ntính thoát khỏi nhưng đều thất bại, Vì vậy, nhiều\nphân thân của hắn cứ xuất hiện quấy phá cư dân",
    "T100.72.name": "Hidra【Kiếp Nạn Vô Ưu - Hidra】",
    "T100.73.discription": "Sinh vật kịch độc trong Mê Huyễn Động, chỉ cần bị\ngai nhọn đâm vào là có thể chết ngay tức khắc",
    "T100.73.name": "Xương Rồng Cực Độc",
    "T100.74.discription": "Dù có tin hay không thì nấm điện vẫn là 1 cô gái\ndễ thương không kém gì mỹ nhân nào ^_^",
    "T100.74.name": "Nấm Điện【Bản Trưởng Thành】",
    "T100.75.discription": "Là yêu nữ của Băng Tuyết, có khả năng đưa người\nkhác vào trạng thái mơ ảo giữa thực và hư",
    "T100.75.name": "Ảo Mộng Nữ Yêu 【BOSS Phi Hành lv135】",
    "T100.76.discription": "Người bạn đồng hành trung thành nhất của các dũng\nsĩ Vô Ưu",
    "T100.76.name": "Tiểu Nấm Yêu",
    "T100.77.discription": "Tuy hình dáng thật thà, dễ thương nhưng chỉ cần sơ\nhở là sẽ bị nuốt chửng. Một cái chết bất ngờ và\nnhẹ nhàng",
    "T100.77.name": "Cây Nắp Ấm",
    "T100.78.discription": "Ếch vốn là sinh vật ôn hòa, nhưng vì chịu nguyền\nrủa của bóng đêm mà thay đổi trở thành độc ác và\nsẵn sàng bất kỳ ai xâm phạm vào lãnh thổ đầm lầy\ncủa nó",
    "T100.78.name": "Ếch Độc Đầm Lầy",
    "T100.79.discription": "Sinh trưởng dưới đáy đại dương, làm kẻ thù phải\nchết ngạt trong môi trường thiếu oxy",
    "T100.79.name": "Dây Rong",
    "T100.80.discription": "Vua thực vật sinh sống tại Linh Lan, cực mạnh và\nđầy quyền lực, gần đây hắn đang triệu tập lực\nlượng để chống lại các gia tộc.",
    "T100.80.name": "Bách Thảo Tinh",
    "T100.81.discription": "Là thần thú trong truyền thuyết, sinh ra từ tinh\nhoa của các vì sao,\nsở hữu nguồn năng lực không thể tưởng tượng nổi.",
    "T100.81.name": "Hắc Nhân Mã",
    "T100.82.discription": "Với kungfu cái thế, Chiến Dương là 1 trong những\nthần thú đáng gờm nhất Đại Lục Vô Ưu",
    "T100.82.name": "Chiến Dương",
    "T100.83.discription": "Tề Thiên Đại Thánh, nhất thế chí tôn, đi nam về\nbắc, lên trời xuống đất, thần kỳ bách biến.",
    "T100.83.name": "Đại Thánh Chí Tôn",
    "T100.84.discription": "Chim phượng hoàng sinh là từ ngọn lửa bất tử\nphương nam.\nMỗi lần chết đi, quanh thân sẽ xuất hiện vòng lửa,\nsau đó tiếp tiếp tục từ lửa mà tái sinh, \nđồng thời sức mạnh càng tăng gấp bội phần",
    "T100.84.name": "Moltres",
    "T100.85.discription": "Vì tấm lòng yêu thương nhân loại, \nShiba được xem là sứ giả hòa bình may mắn",
    "T100.85.name": "Võ Sĩ Shiba",
    "T100.86.discription": "Hóa thân của Hiệp Sĩ Lợn, tiêu trừ cái ác, đem lại\nhòa bình cho thế giới",
    "T100.86.name": "Burin",
    "T100.87.discription": "Chú chuột thông minh, tài hoa.",
    "T100.87.name": "Jery",
    "T100.88.discription": "Sau một trận cuồng phong, \nLong Tiểu Thanh xuất hiện trên một đám mây",
    "T100.88.name": "Long Tiểu Thanh",
    "T100.89.discription": "Vân tập sự huyền bí của Nam thất tinh túc",
    "T100.89.name": "Kim Tước",
    "T100.90.discription": "Xung quah bao trùm linh khí huyền vũ",
    "T100.90.name": "Huyền Minh Linh Vũ",
    "T100.91.discription": "Hàn khí ngùn ngụt",
    "T100.91.name": "Bạch Hổ Cuồng Nộ",
    "T100.92.discription": "Một sinh vật hùng mạnh mang sức mạnh sấm sét",
    "T100.92.name": "Lôi Lân Ảnh",
