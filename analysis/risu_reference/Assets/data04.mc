    "T35.1543.name": "Tinh Linh Cây Tham Tiền",
    "T35.1544.onServiceText": "Lắp ráp được Xe Tăng và Cờ Tổ Quốc thì có thể đến\ngặp ta để đổi lấy phần thưởng.Thời gian sự kiện\n12:00 - 20:00 từ ngày 27/4 - 9/5",
    "T35.1544.name": "Sứ Giả Sự Kiện 30/4",
    "T35.1545.scriptOff": "if(fromBF){\tvar script_npc_level = 90;\tvar\nspript_loot = rand3(1, 100);\tvar\nscript_midObj = {1:1,2:12}; \tif(spript_loot <\n5)\t{\t\tif( c )\t\t{\t\t\tif(c.inGroup())\n\t\t\t{\t\t\t\tscript_node =\nc.memberList.head;\t\t\t}\t\t\telse \t\t\t{\t\t\t\tscript_node\n= {};\t\t\t\tscript_node.obj =\nc.data.id;\t\t\t}\t\t\twhile(script_node !=\nnull)\t\t\t{\t\t\t\tvar spt_player = getCharactor(\nscript_node.obj );\t\t\t\tvar spt_index = rand3(1,2);\n\t\t\t\t\tif(minus(spt_player.level,script_npc_level) >\n10 ||spt_player.level<80)\t\t\t\t\t\t{\t\t\t\t\t\trequire =\ntrue;\t\t\t\t\t}\t\t\t\t\telse\t\t\t\t\t{\t\t\t\t\t\t_addMedalInBag(script_node.obj,\nscript_midObj[spt_index], true);\t\t\t\t\tif\n(inRate(2))\t\t\t\t\t{\t\t\t\t\t\tvar num\n=100;\t\t\t\t\t\taddStoneSealPointDirectly(script_node.obj,\nnum);\t\t\t\t\t}\t\t\t\t\t}\t\t\t\tscript_node =\nscript_node.next;\t\t\t}\t\t}\t}\tif(inRate(10))\t{\t\tif( c\n)\t\t{\t\t\tif(c.inGroup()) \t\t\t{\t\t\t\tscript_node =\nc.memberList.head;\t\t\t}\t\t\telse \t\t\t{\t\t\t\tscript_node\n= {};\t\t\t\tscript_node.obj =\nc.data.id;\t\t\t}\t\t\twhile(script_node !=\nnull)\t\t\t{\t\t\t\tif\n(inRate(50))\t\t\t\t{\t\t\t\t\taddItem(script_node.obj, 29,\n5609, 1 , 0, 0, \"\", null);\t\t\t\t}\t\t\t\tscript_node =\nscript_node.next;\t\t\t}\t\t}\t}}",
    "T35.1545.subType": "all",
