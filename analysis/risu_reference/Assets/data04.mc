    "T35.151.name": "Chướng Thi Vương",
    "T35.169.subType": "all",
    "T35.169.name": "Bách Thảo Tinh",
    "T35.170.subType": "all",
    "T35.170.name": "Phủ Ma",
    "T35.171.subType": "all",
    "T35.171.name": "Ma Chiến",
    "T35.180.subType": "all",
    "T35.180.onServiceText": "(Cần 3 người lập nhóm, các thành viên trong nhóm\nđạt cấp 40 trở lên mới có thể tấn công)",
    "T35.180.name": "Thổ Phỉ Quấy Nhiễu",
    "T35.181.subType": "all",
    "T35.181.onServiceText": "(Cần 3 người lập nhóm, các thành viên trong nhóm\nđạt cấp 40 trở lên mới có thể tấn công)",
    "T35.181.name": "Ác Bá Quấy Nhiễu",
    "T35.182.subType": "all",
    "T35.182.name": "Chiến Thần",
    "T35.183.subType": "all",
    "T35.183.name": "Ma Thần",
    "T35.184.subType": "all",
    "T35.184.name": "Tà Thần",
    "T35.185.subType": "all",
    "T35.185.name": "Tử Thần",
    "T35.186.name": "Chuyên Viên Phát Lương",
    "T35.187.name": "Pha Lê",
    "T35.188.name": "Kim Loại Hiếm",
    "T35.189.name": "Kim Loại Hiếm",
    "T35.190.onServiceText": "Cần phải cẩn thận với những nguy hiểm phía trước.",
    "T35.190.name": "Thủ Hoang Nhân Tầng 1",
    "T35.191.onServiceText": "Cần phải cẩn thận với những nguy hiểm phía trước.",
    "T35.191.name": "Thủ Hoang Nhân Tầng 2",
    "T35.192.onServiceText": "Tầng thứ ba là một ma pháp trận, tương truyền là\ndo Tư tế Ai Cập cổ thiết lập để ngăn chặn người\nngoài xâm nhập. Tuy nhiên nó cũng có quy luật nhất\nđịnh: Giữa các ma pháp trận tương đồng nhau sẽ có\nthể dịch chuyển qua lại…",
    "T35.192.name": "Người Thần Bí",
    "T35.193.onServiceText": "Công chúa Olin thật là đáng thương…",
    "T35.193.name": "Linh Hồn Thị Nữ",
    "T35.194.onServiceText": "Một linh hồn xinh đẹp đi lại trong gương, dường\nnhư muốn nói với ngươi điều gì đó",
    "T35.194.name": "Quỷ Kính",
    "T35.195.item": "5-3",
    "T35.195.qid": "|1462",
    "T35.195.onServiceText": "Rương khá cũ, có vẻ chứa đựng một báu vật thần bí\nnào đó",
    "T35.195.name": "Bảo Rương Cổ",
    "T35.196.item": "5-3",
    "T35.196.qid": "|1462",
    "T35.196.onServiceText": "Rương khá cũ, có vẻ chứa đựng một báu vật thần bí\nnào đó",
    "T35.196.name": "Bảo Rương Cổ",
    "T35.197.item": "5-3",
    "T35.197.qid": "|1462",
    "T35.197.onServiceText": "Rương khá cũ, có vẻ chứa đựng một báu vật thần bí\nnào đó",
    "T35.197.name": "Bảo Rương Cổ",
    "T35.198.name": "Sứ Giả Dịch Chuyển Đại Mạc",
    "T35.199.name": "Sứ Giả Quản Lý Phụ Bản",
    "T35.200.onServiceText": "Trách nhiệm của ta là giúp ngươi mở nhiệm vụ thám\nhiểm mê cung, những nhiệm vụ mê cung sau này nếu\nmuốn mở cũng cần phải tìm đến ta. Sau khi mở thành\ncông, ta sẽ giao cho ngươi một vật phẩm đặc biệt\nmà mỗi ngày chỉ được nhận 1 lần, đó là vật phẩm\ncần thiế",
    "T35.200.name": "Sử Giả Mở Phụ Bản",
    "T35.201.item": "5-3",
    "T35.201.qid": "|1462",
    "T35.201.onServiceText": "Rương khá cũ, có vẻ chứa đựng một báu vật thần bí\nnào đó",
    "T35.201.name": "Bảo Rương Cổ",
    "T35.202.item": "5-3",
    "T35.202.qid": "|1462",
    "T35.202.onServiceText": "Rương khá cũ, có vẻ chứa đựng một báu vật thần bí\nnào đó",
    "T35.202.name": "Bảo Rương Cổ",
    "T35.203.scriptOff": "deleteNpcInstance(npc.id);",
    "T35.203.subType": "all",
    "T35.203.name": "Quái Vật Bảo Bảo",
    "T35.206.subType": "all",
    "T35.206.name": "Xe Hoa",
    "T35.207.scriptOff": "deleteNpcInstance(npc.id);",
    "T35.207.subType": "all",
    "T35.207.name": "Chủ Nhân Mật Thất",
    "T35.208.subType": "all",
    "T35.208.name": "Thần Binh",
    "T35.210.subType": "all",
    "T35.210.name": "Thần Tướng",
    "T35.211.name": "Quản Lý Bang Hội Chiến",
    "T35.212.scriptOff": "deleteNpcInstance(npc.id);",
    "T35.212.name": "Bảo Rương Mật Thất",
    "T35.213.scriptOff": "deleteNpcInstance(npc.id);",
    "T35.213.subType": "all",
    "T35.213.name": "Bảo Rương Mật Thất",
    "T35.214.name": "Thần Thú Bảo Bảo",
    "T35.215.onServiceText": "Ngươi tin vào tình yêu chứ? Ngươi có muốn tìm tình\nyêu của cuộc đời mình không?",
    "T35.215.name": "Cupid",
    "T35.216.subType": "all",
    "T35.216.onServiceText": "(Cần 3 người lập nhóm, các thành viên trong nhóm\nđạt cấp 50 trở lên)",
    "T35.216.name": "Thủ Lĩnh Cường Đạo",
    "T35.217.onServiceText": "Hi hi, ngươi không nhận ra ta à?",
    "T35.217.name": "Người Thần Bí",
    "T35.218.name": "Trục Yêu Sư",
    "T35.219.onServiceText": "Ta nguyền rủa ngươi, sợ chưa?",
    "T35.219.name": "Phù Chú Vương",
    "T35.220.name": "Phá Hoại Vương",
    "T35.221.name": "Ác Mộng Vương",
    "T35.222.name": "Phong Ấn Thủ Vệ - Lam",
    "T35.223.name": "Phong Ấn Thủ Vệ - Lục",
    "T35.224.name": "Phong Ấn Thủ Vệ - Vàng",
    "T35.225.name": "Phong Ấn Thủ Vệ - Đỏ",
    "T35.226.name": "Phong Ấn Thủ Vệ - Tím",
    "T35.227.name": "Phong Ấn Thủ Vệ - Bạc",
    "T35.228.name": "Linh Hồn",
    "T35.229.onServiceText": "Hic, bị phát hiện rồi!",
    "T35.229.name": "Ôn Dịch Ma",
    "T35.230.onServiceText": "Xuất Vân Thôn là nơi bắt nguồn của loài Xương Rồng\nchúng ta.",
    "T35.230.name": "Xương Rồng Ma",
    "T35.231.onServiceText": "Xuất Vân Thôn được xây dựng trên đỉnh núi. Năm xưa\nkhi tổ tiên chúng ta đến đại lục Vô Ưu đã bám trụ\nlại đây, cuối cùng trở thành chủ nhân của đại lục,\nvì vậy chúng ta coi đây là khởi điểm của mọi sự.",
    "T35.231.name": "Trưởng Thôn Stoff",
    "T35.232.onServiceText": "Chào, đây là tiệm rèn Xuất Vân Thôn! Ta là thợ rèn\nA Nhĩ! Ngươi muốn mua gì nào?",
    "T35.232.name": "Tiệm Vũ Khí A Nhĩ",
    "T35.233.onServiceText": "Kim Linh Tử của rừng Huyền Lâm có thể chữa bại\nliệt, cỏ Vân Vụ của Trầm Thụy Lâm có thể chữa đau\nbụng, những thứ thuốc mới này đều phải ghi chép\nlại mới được… À, quý khách trông xanh xao quá, cần\nmua thuốc gì nào?",
    "T35.233.name": "Tiệm Thuốc Ông Vương",
    "T35.234.onServiceText": "Thu thập được bất kỳ các tổ hợp chữ như \"Chúc\nMừng\", \"Chúc Mừng Sinh Nhật\", \"Chúc Mừng Sinh Nhật\nVua Pháp Thuật\", \"Chúc Mừng Sinh Nhật Vua Pháp\nThuật Lần 4\" thì có thể đến gặp Thiên Sứ Sự Kiện ở\nĐông Huyền Thành để đổi quà.",
    "T35.234.name": "Thiên Sứ Sự Kiện",
    "T35.235.at": "0-23|0-6|1-31|0-11|WorldDropydbaoxiang",
    "T35.235.name": "Bảo Rương Chúc Phúc",
    "T35.236.subType": "all",
    "T35.236.onServiceText": "(Cần 3 người lập nhóm, các thành viên trong nhóm\nđạt cấp 50 trở lên)",
    "T35.236.name": "Cường Đạo Đoạt Bảo",
    "T35.237.onServiceText": "Chào mừng đến với tiệm pet Xuất Vân Thôn, nơi đây\ncó bán các loại thuốc tăng thọ mệnh và trung thành\ncủa pet, ngươi có cần ta giúp gì không?",
    "T35.237.name": "Tiệm Pet Mỹ Mỹ",
    "T35.238.onServiceText": "Phải có trang bị tốt trên người thì mới có thể\nchiến đấu thật tốt! Nhớ bảo quản kỹ trang bị của\nmình, khi không còn độ bền thì nhớ phải sửa chữa.",
    "T35.238.name": "Tiệm Trang Bị Isla",
    "T35.239.onServiceText": "Hàng hóa đều được bày trên giá, cần gì thì cứ chọn\nnhé.",
    "T35.239.name": "Tiệm Tạp Hóa Ông Triệu",
    "T35.240.onServiceText": "Học tập là một chặng đường tuy dài nhưng lại tràn\nngập niềm vui… Mỗi một tân thủ khi đến đây đều\nmang theo ước mơ và hi vọng của mình, mong mỏi sẽ\ncó ngày thành tài!",
    "T35.240.name": "Tân Thủ Sứ",
    "T35.241.subType": "all",
    "T35.241.onServiceText": "(Cần 3 người lập nhóm, các thành viên trong nhóm\nđạt cấp 40 trở lên)",
    "T35.241.name": "Thỏ Ngọc 2",
    "T35.242.name": "Cổng Dịch Chuyển Không Gian Ma Chiến",
    "T35.243.at": "new|2026/1/1/0/0/0-2026/1/9/23/59/0",
    "T35.243.onServiceText": "Năm mới vui vẻ, phát tài! Bạn có thể tự tạo cho\nmình những tấm thiệp độc đáo dành tặng cho bạn bè.",
    "T35.243.name": "Sứ Giả Năm Mới",
    "T35.244.at": "new|2026/2/15/0/0/0-2026/2/21/23/59/0",
    "T35.244.onServiceText": "Năm mới vui vẻ, phát tài!",
    "T35.244.name": "Sứ Giả Sự Kiện Tết",
    "T35.245.at": "0-23|0-6|31-31|1-1",
    "T35.245.onServiceText": "Điểm thưởng sự kiện đạt mức nhất định thì có thể\nđến chỗ ta để đổi lấy một số vật phẩm O(∩_∩)O",
    "T35.245.name": "Sứ Giả Sự Kiện Tết Nguyên Tiêu",
    "T35.246.at": "0-23|0-6|31-31|1-1",
    "T35.246.onServiceText": "Nhiệm vụ này có 10 vòng, nếu bỏ cuộc giữa chừng\nthì cần chờ 10 phút sau mới có thể nhận lại\nO(∩_∩)O",
    "T35.246.name": "Sứ Giả Lễ Tình Nhân",
    "T35.247.onServiceText": "Nếu như đồ đạc quá nhiều, ngươi có thể gửi một ít\nlại chỗ ta, bảo đảm tuyệt đối an toàn.",
    "T35.247.name": "Thủ Kho",
    "T35.248.at": "12-23|0-6|31-31|1-1",
    "T35.248.onServiceText": "Trong khoảng thời gian từ 14 đến 16 tháng 2 năm\n2010, người chơi cấp 30 trở lên mỗi ngày có thể\nđến chỗ ta để nhận bao lì xì, trong đó có thể mở\nra lượng kim phiếu nhất định, Pháo Hoa Ngũ Sắc,\nPháo Trúc, người chơi may mắn còn có thể nhận được\nbảo thạch O",
    "T35.248.name": "Trưởng Lão Hồng Bao",
    "T35.249.onServiceText": "Nhiệm vụ này gồm 10 vòng, bỏ cuộc giữa chừng hoặc\nhoàn thành đủ 10 vòng thì cần phải chờ 10 phút sau\nmới có thể nhận lại O(∩_∩)O",
    "T35.249.name": "Đại Sứ Lao Động",
    "T35.250.at": "0-23|0-6|1-31|0-11|guijie",
    "T35.250.onServiceText": "Vào các đêm cúng vong hồn, rất nhiều Tiểu Quỷ ham\nchơi đã chạy đến Vô Ưu Đại Lục, hù dọa mọi người,\nquấy rầy cuộc sống bình yên của dân lành. Sứ Giả\nSự Kiện Vong Hồn hi vọng mọi người có thể bắt được\nbọn chúng, trả lại sự bình yên cho thôn làng",
    "T35.250.name": "Sứ Giả Sự Kiện Vong Hồn",
    "T35.251.at": "0-23|0-6|31-31|1-1",
    "T35.251.name": "Cây Giáng Sinh",
    "T35.252.at": "0-23|0-6|31-31|1-1",
    "T35.252.name": "Cây Giáng Sinh",
    "T35.253.at": "0-23|0-6|31-31|1-1",
    "T35.253.name": "Cây Giáng Sinh",
    "T35.254.at": "0-23|0-6|31-31|1-1",
    "T35.254.name": "Cây Giáng Sinh",
    "T35.260.at": "0-23|0-6|30-30|1-1",
    "T35.260.onServiceText": "Ha ha, tìm ta là sáng suốt đó, cả đại lục không ai\ncó thể làm bánh ngon hơn ta. Muốn ta ra tay thì\nmang nguyên liệu đến đây. Nếu đủ rồi thì chọn đi,\nmuốn làm bánh nào?",
    "T35.260.name": "Thợ Làm Bánh",
    "T35.261.at": "0-23|0-6|30-30|1-1",
    "T35.261.onServiceText": "Lề mề thế, ngươi tưởng ngươi có nhiều lựa chọn lắm\nà, cả đại lục ta là \"vô đối\" vì chỉ có duy nhất\nmình ta là Nghệ Nhân Kết Trái Cây. Biết sợ thì nói\nnhanh, muốn kết hay đổi Mâm Ngũ Quả nào",
    "T35.261.name": "Nghệ Nhân Kết Trái Cây",
    "T35.262.at": "0-23|0-6|30-30|1-1",
    "T35.262.onServiceText": "Chúc mừng năm mới, mặc dù tên ta là Thợ Trồng Hoa\nnhưng thật sự ta không biết trồng mà chỉ biết\ntrang trí hoa thôi",
    "T35.262.name": "Thợ Trồng Hoa",
    "T35.263.at": "0-23|0-6|30-30|1-1",
    "T35.263.onServiceText": "Ha ha, năm mới mà gặp ta đảm bảo sẽ phát tài. Hãy\nmang các hộp lễ vật đến cho ta sẽ được tặng một\nbao lì xì may mắn",
    "T35.263.name": "Thần Tài",
    "T35.272.onServiceText": "Đông Huyền của chúng ta là do sáu tộc lớn chung\nsức dựng lên, cơ sở chính sẽ đóng ở thành Đông\nHuyền",
    "T35.272.name": "Tộc Trưởng Bối Tư",
    "T35.273.scriptOff": "deleteNpcInstance(npc.id);",
    "T35.273.name": "Túi Mừng",
    "T35.274.onServiceText": "Chào quý khách! Có phải Ali ở quán rượu đó không?\nRượu mật ong ta đặt mua đâu? Hả? Nhận nhầm người\nrồi à? Xin lỗi nhé! Ta xin tự giới thiệu, ta tên\nlà Mark, \"thợ rèn ma men\" chính là đại thúc ta, có\nviệc gì cần cứ đến tìm ta nhé. Ngươi cũng không\ncần phải",
    "T35.274.name": "Tiệm Vũ Khí Mark",
    "T35.275.onServiceText": "Đây là tiệm tạp hóa Đông Huyền, vật phẩm ở đây tuy\nđơn giản nhưng trong thời khắc quan trọng sẽ phát\nhuy hiệu quả đến không ngờ, nên cho dù như thế\nnào, hãy cố gắng mua một ít mang theo trên người\nvẫn tốt hơn.",
    "T35.275.name": "Tiệm Tạp Hóa Ông Mộ",
    "T35.277.onServiceText": "Bảo vệ thành Đông Huyền là trách nhiệm của chúng\nta",
    "T35.277.name": "Trưởng Cận Vệ Đông Huyền",
    "T35.280.onServiceText": "Xin chào, hoan nghênh đến với tiệm Pet Đông Huyền,\nta là Tôn Lệ, sẵn lòng phục vụ quý khách. Tiệm ta\nchuyên bán các vật phẩm liên quan đến Pet, cung\ncấp các vật tư trên lộ trình của ngươi và thú\ncưng. Tất nhiên, nuôi dưỡng và trang bị cho Pet là\nmột nghệ",
    "T35.280.name": "Tiệm Pet Tôn Lệ",
    "T35.283.onServiceText": "Hello, xin hoan nghênh các ngươi đến chợ bán đấu\ngiá của Đông Huyền, ở đây ngươi có thể treo những\nvật phẩm mà ngươi không dùng lên, đợi những người\nchơi khác cần chúng sẽ chọn mua. Không cần lo lắng\ntìm người mua ở khắp nơi, cũng không cần lo lắng\nchuyện",
    "T35.283.name": "Quản Lý Đấu Giá",
    "T35.287.onServiceText": "Xin chào, ta là cận vệ ở Đông Huyền Thành, được\nphân công canh gác nơi đây.",
    "T35.287.name": "Cận Vệ Đông Huyền",
    "T35.288.onServiceText": "Sách là nấc thang tiến bộ, là kiến thức được đúc\nkết lại! Khi chiến đấu mệt rồi, thì nên ghé lại\nđây xem sách, có khi ngươi sẽ tìm được những thông\ntin hữu ích đấy.",
    "T35.288.name": "Thủ Thư",
    "T35.290.onServiceText": "Xin chào, hoan nghênh đến với Tinh Linh Thành nằm\nở phía bắc Trầm Thụy Lâm. Không phải ta ba hoa,\nnhưng thực sự thành Tinh Linh là thành phố màu\nxanh trong sạch nhất trên đại lục, ngay cả thành\nTiên Lạp của đảo Băng cũng không sánh kịp.",
    "T35.290.name": "Thành Chủ Tinh Linh",
    "T35.291.onServiceText": "Hoan nghênh đã đến tiệm vũ khí Madoff thành Tinh\nLinh, ta là thợ rèn Madoff. Tuy tay nghề của ta\nkhông thể so sánh được với anh ta là Mark, nhưng\nsử dụng nguyên liệu từ Khoáng Thạch đặc sản của\nthành Tinh Linh được tinh luyện và dát mỏng thì\ncũng không kh",
    "T35.291.name": "Tiệm Vũ Khí Madoff",
    "T35.295.onServiceText": "Này! Người ta cần là ngươi đó. Có hứng thú gia\nnhập đội của ta không?",
    "T35.295.name": "Vệ Sĩ Tinh Linh",
    "T35.299.funcInfo": "|12,Bàn Địa Tộc,10,800,1285|13,Liêu Vân\nTộc,10,1800,1256|11,Linh Vũ\nTộc,10,465,1214|32,Thiên Khung\nTộc,10,1193,1341|39,Huyền Lâm\nTộc,10,210,1180|25,Lưu Hỏa Tộc,10,2033,1500|",
    "T35.299.onServiceText": "Chiến Binh\n→→→→→→ Bàn Địa Tộc Nhạc Công →→→→→→ Liêu Vân Tộc\nDanh Y\n→→→→→→ Linh Vũ Tộc Xạ Thủ\n→→→→→→ Thiên Khung Tộc Thợ Săn\n→→→→→→ Huyền Lâm Tộc Hiệp Sĩ\n→→→→→→ Lưu Hỏa Tộc",
    "T35.299.name": "Hướng Dẫn Viên Ryan",
    "T35.300.funcInfo": "|15,Lê Dương Bắc,1000,1763,637|",
    "T35.300.onServiceText": "Ngươi muốn về Lê Dương Bắc ư? ",
    "T35.300.name": "Mật Đạo Tiểu Binh",
    "T35.304.onServiceText": "Đồng bằng này đầy rẫy những viên Bảo Thạch kì lạ,\ndùng những viên đá này để làm trang sức thì không\nchỉ đẹp lấp lánh mà còn có hiệu quả thần kỳ khác\nnhau.",
    "T35.304.name": "Tiệm Trang Sức Khả Vi Nhi",
    "T35.307.onServiceText": "Hoan nghênh đến với tiệm trang sức thành Tinh\nLinh.",
    "T35.307.name": "Tiệm Trang Sức Văn Văn",
    "T35.310.subType": "3-0",
    "T35.310.onServiceText": "Đây là Bàn Địa Tộc phía đông Quang Bình Nguyên. Là\nmột tộc cổ có hàng trăm năm lịch sử, chúng ta nổi\ntiếng khắp đại lục về kiến thức kiến trúc thổ mộc\nvà thăm dò địa chất. Hôm nay cùng với sáu tộc lớn\nkhác xây dựng nên Đông Huyền, vị trí của chúng ta\nnằm",
    "T35.310.name": "Đạo Sư Bàn Địa",
    "T35.311.subType": "3-0",
    "T35.311.onServiceText": "Hoan nghênh đến với Linh Vũ Tộc. Linh Vũ Tộc là\nmột tộc cổ, cùng với năm tộc nổi tiếng khác. Gia\ntộc luôn bồi dưỡng về lễ nghĩa, dược liệu và\ntruyền dạy những kỹ năng trị liệu và phụ trợ và\nđược nhiều người tôn trọng. Từ trước đến nay chúng\nta luôn trong",
    "T35.311.name": "Đạo Sư Linh Vũ",
    "T35.312.subType": "3-0",
    "T35.312.onServiceText": "Hoan nghênh đến với thánh địa của đồ ăn ngon và\nlinh hồn của nghệ thuật âm nhạc - Liêu Vân Tộc.\nLiêu Vân Tộc là nơi hội tụ của nhưng người có tâm\nhồn và khát khao nghệ thuật, vẻ cổ kính của nó gắn\nliền với thời âm nhạc mới xuất hiện tại đại lục Vô\nƯu, điề",
    "T35.312.name": "Đạo Sư Liêu Vân",
    "T35.325.onServiceText": "Nơi đây có bán sách kỹ năng.",
    "T35.325.name": "Kho Sách Linh Vũ",
    "T35.328.onServiceText": "Nơi đây có bán sách kỹ năng.",
    "T35.328.name": "Kho Sách Liêu Vân",
    "T35.330.onServiceText": "Nơi đây có bán sách kỹ năng.",
    "T35.330.name": "Kho Sách Bàn Địa",
    "T35.331.funcInfo": "|9,Đông Huyền Thành,10,1698,1527|30,Quyến Cố\nThành,100,1153,1163|",
    "T35.331.onServiceText": "Ngươi muốn về Đông Huyền Thành ư? ",
    "T35.331.name": "Tinh Linh Dịch Chuyển Liêu Vân",
    "T35.332.funcInfo": "|9,Đông Huyền Thành,10,1982,1146|30,Quyến Cố\nThành,100,1153,1163|",
    "T35.332.onServiceText": "Ngươi muốn về Đông Huyền Thành ư? ",
    "T35.332.name": "Tinh Linh Dịch Chuyển Bàn Địa",
    "T35.333.funcInfo": "|9,Đông Huyền Thành,10, 1550,1207|30,Quyến Cố\nThành,100,1153,1163|",
    "T35.333.onServiceText": "Ngươi muốn về Đông Huyền Thành ư? ",
    "T35.333.name": "Tinh Linh Dịch Chuyển Linh Vũ",
    "T35.336.onServiceText": "Cưỡi ngựa săn bắn trên thảo nguyên thật là một thú\nvui không gì sánh bằng…",
    "T35.336.name": "Thợ Săn Casey",
    "T35.339.onServiceText": "Ha ha, hoan nghênh các ngươi gia nhập Bàn Địa Tộc,\nta là bậc tiền bối của các ngươi, về sau ta sẽ phụ\ntrách phần kỹ năng, nếu có vấn đề gì không hiểu,\nhãy đến hỏi, ta sẽ cố gắng giải đáp.",
    "T35.339.name": "Tộc Trưởng Bàn Địa",
    "T35.341.onServiceText": "Mấu chốt của việc chiến đấu là nắm vững tiết tấu,\ndiễn tấu âm nhạc bằng chính trái tim mình, cộng\nhưởng được với linh lực bản thân, sinh ra năng\nlượng mạnh gấp trăm ngàn lần, nào hãy cùng cố\ngắng.",
    "T35.341.name": "Tộc Trưởng Liêu Vân",
    "T35.342.onServiceText": "Ta là Tộc Trưởng Linh Vũ, muốn học kỹ năng gia tộc\nthì cứ đến tìm ta.",
    "T35.342.name": "Tộc Trưởng Linh Vũ",
    "T35.343.onServiceText": "Hoan nghênh các ngươi đến Đông Huyền Thành",
    "T35.343.name": "Đông Huyền Sứ",
    "T35.351.onServiceText": "Hoan nghênh các thành viên mới. Nếu là chuyển giao\nthư từ thì ta là cừ nhất đấy",
    "T35.351.name": "Thùng Thư Xuất Vân",
    "T35.357.onServiceText": "Xin chào, ta có thể giúp gì cho ngươi?",
    "T35.357.name": "Thùng Thư Đông Huyền",
    "T35.373.onServiceText": "Hoan nghênh đến Đông Huyền Thành. Chỗ ta chuyên\nbán quần áo.",
    "T35.373.name": "Tiệm Trang Bị Mary",
    "T35.374.onServiceText": "Chỉ cần ngươi trả tiền thì đôi chân của ta cũng là\nđôi chân của ngươi.",
    "T35.374.name": "Thùng Thư Tinh Linh",
    "T35.375.onServiceText": "Ta có thể giúp ngươi lưu giữ những vật phẩm chưa\ncần thiết",
    "T35.375.name": "Thủ Kho",
    "T35.376.onServiceText": "Ở đây ta có những món ăn thơm ngon nhất thành Đông\nThành.",
    "T35.376.name": "Nhà Hàng Âu Dương",
    "T35.377.onServiceText": "Ta là nghiên cứu gia XX, ngươi thấy hai chữ XX kỳ\nlạ ư? Có lúc ta cũng cảm thấy như vậy, nhưng ngươi\nkhông thấy gọi thế nghe rất ngầu sao? XX là vũ\ntrụ, là vạn vật trên thế gian. Khi ngươi cảm nhận\nđược ý nghĩa thật sự của từ XX thì có thể cùng ta\nnghiên",
    "T35.377.name": "Nghiên Cứu Gia XX",
    "T35.378.name": "Người Tuyết 1",
    "T35.379.name": "Người Tuyết 2",
    "T35.380.name": "Người Tuyết 3",
    "T35.381.name": "Người Tuyết Lớn",
    "T35.382.name": "Cây Thông Giáng Sinh",
    "T35.383.at": "0-23|0-6|1-31|0-11|nianshouone",
    "T35.383.onServiceText": "Loài người nhỏ bé chớ làm phiền ta!",
    "T35.383.name": "Niên Thú Làm Loạn",
    "T35.384.onServiceText": "Loài người nhỏ bé chớ làm phiền ta!",
    "T35.384.name": "Niên Thú Tướng Quân",
    "T35.385.name": "Hoa Hồng Nhỏ",
    "T35.386.onServiceText": "Cây hoa hồng này đã lớn, đang nở hoa",
    "T35.386.name": "Hoa Hồng Lớn",
    "T35.387.onServiceText": "Cây hoa hồng này đã lớn, đang nở hoa",
    "T35.387.name": "Cây Ước Nguyện",
    "T35.388.onServiceText": "Cần cấp cứu hãy mau đến tìm ta!",
    "T35.388.name": "Y Sĩ Chiến Trường",
    "T35.403.onServiceText": "Sức mạnh của Hắc Diệu Thạch thật đáng sợ, bao\nnhiêu người tài giỏi đều trở nên điên cuồng hết\nrồi. Ta vừa thoát ra từ dãy Vân Lộc Sơn, đấy giờ\nkhông còn là ngọn núi hiền hòa như ngày trước rồi.",
    "T35.403.name": "Thợ Săn Luca",
    "T35.404.onServiceText": "Ngươi muốn đi đến đấu trường à? Đấu trường là nơi\ncác thành viên cùng học hỏi lẫn nhau, nhớ rằng\ntrước khi vào phải chỉnh đốn trang bị trên người,\ncần mang ít thuốc nếu bị đả thương, điểm cần chú ý\nlà nếu ra tay quá mạnh sẽ bị kỷ luật.",
    "T35.404.name": "Anh Béo",
    "T35.405.funcInfo": "|55,Điêu Linh Thôn,2000,770,245|61,Tử Tức\nĐảo,3000,240,300",
    "T35.405.onServiceText": "Các bạn thân mến, hoan nghênh đến với bến tàu Đông\nHuyền.",
    "T35.405.name": "Cận Vệ Cảng",
    "T35.409.onServiceText": "Ngươi cảm thấy không khỏe chỗ nào? Để ta khám cho\nnhé?",
    "T35.409.name": "Y Tá Loli",
    "T35.410.onServiceText": "Nếu gửi tiền có thể gửi ngay, còn nếu rút tiền xin\nđợi một lúc.",
    "T35.410.name": "Nhân Viên Ngân Hàng",
    "T35.411.onServiceText": "Gần đây kinh tế suy thoái, làm ăn buôn bán ngày\ncàng khó khăn rồi, chà chà…",
    "T35.411.name": "Thương Hội Trưởng Đông Huyền",
    "T35.412.onServiceText": "A, ngươi đến để mua thuốc à, để ta đi lấy thêm\nthuốc cho ngươi",
    "T35.412.name": "Tiệm Thuốc Bác Sĩ Vương",
    "T35.413.onServiceText": "Các ngươi nhớ để ý giữ gìn sức khỏe.",
    "T35.413.name": "Bác Sĩ Lý",
    "T35.414.onServiceText": "Hê hê, ngươi cho rằng y tá trên đời đều chỉ toàn\ncầm kim tiêm hay sao?",
    "T35.414.name": "Y Tá Vương",
    "T35.416.onServiceText": "Ngươi không nhận nhầm người đâu, ta chính là tiến\nsĩ Ultra.",
    "T35.416.name": "Tiến Sĩ Ultra",
    "T35.418.onServiceText": "Khi ra ngoài nên mang thêm một ít thuốc, người xưa\ncó câu \"Cẩn tắc vô áy náy\".",
    "T35.418.name": "Tiệm Thuốc Cammy",
    "T35.421.onServiceText": "Ngươi muốn đàm đạo với ta ư?",
    "T35.421.name": "Đại Hiền Triết Fetocci",
    "T35.422.onServiceText": "Khi không bị thương cũng nên thường xuyên đến thăm\nta nhé.",
    "T35.422.name": "Tiên Tử Trị Liệu",
    "T35.423.onServiceText": "Ôi, Pet của ngươi đáng yêu quá, tặng cho ta nhá,\nhi hi.",
    "T35.423.name": "Tiệm Pet Amy",
    "T35.424.onServiceText": "Cứ từ từ, ta sẽ giúp ngươi chọn đồ, không phải vội",
    "T35.424.name": "Tiệm Trang Bị Lisa",
    "T35.425.onServiceText": "Muốn thưởng thức đặc sản Tinh Linh Thành không?",
    "T35.425.name": "Trưởng Thương Hội Tinh Linh",
    "T35.426.onServiceText": "Ta là Tộc trưởng Huyền Lâm, khi muốn học kỹ năng\nthì cứ đến tìm ta nhé. Cố gắng lên nào.",
    "T35.426.name": "Tộc Trưởng Huyền Lâm",
    "T35.427.subType": "3-0",
    "T35.427.onServiceText": "Chào mừng ngươi đến với thành trì của sức sống và\nniềm vui - Huyền Lâm Tộc",
    "T35.427.name": "Đạo Sư Huyền Lâm",
    "T35.428.onServiceText": "Nơi đây có bán sách kỹ năng.",
    "T35.428.name": "Kho Sách Huyền Lâm",
    "T35.429.funcInfo": "|9,Đông Huyền Thành,10,2228,1336|30,Quyến Cố\nThành,100,1153,1163|",
    "T35.429.onServiceText": "Ngươi muốn về Đông Huyền Thành ư? ",
    "T35.429.name": "Tinh Linh Dịch Chuyển Huyền Lâm",
    "T35.430.onServiceText": "Hoan nghênh đến với Đông Huyền Thành, xin hãy theo\nta, ta sẽ hướng dẫn các ngươi",
    "T35.430.name": "Sứ Giả Viên",
    "T35.431.onServiceText": "Chú ý quan sát nhất cử nhất động của con thú.",
    "T35.431.name": "Thợ Săn Vương Ngũ",
    "T35.433.onServiceText": "Đừng lo, lúc bị thương hãy đến tìm ta.",
    "T35.433.name": "A Vũ",
    "T35.434.onServiceText": "Các ngươi có cảm nhận thấy Công chúa Tuyết Liên\nhiện diện ở khắp nơi không?",
    "T35.434.name": "Trưởng Lão Vô Ưu Tộc",
    "T35.435.onServiceText": "Xin chào người lữ hành, ở đây mỗi giọt nước sạch\nđều rất quý",
    "T35.435.name": "Thành Chủ Bàng Bối",
    "T35.436.onServiceText": "Hãy quan sát tỷ mỉ sự vật xung quanh, ngươi sẽ\nphát hiện ra điều ngươi muốn biết.",
    "T35.436.name": "Quan Sát Viên",
    "T35.437.onServiceText": "Sống ta làm nhà nghiên cứu, chết ta làm ma nghiên\ncứu, ha ha…",
    "T35.437.name": "Tiến Sĩ Harry",
    "T35.438.onServiceText": "Bị các ngươi dày vò như thế này nữa thì ta khẳng\nđịnh không nuốt nổi bữa cơm",
    "T35.438.name": "Ngư Dân Lão Kim",
    "T35.439.onServiceText": "Ta chỉ đi Bàng Bối để mượn chai xì dầu .",
    "T35.439.name": "Người Qua Đường Ron",
    "T35.440.onServiceText": "(Ánh mắt vô hồn của cô ta nhìn bạn đầy nghi hoặc)",
    "T35.440.name": "Ginny",
    "T35.442.onServiceText": "Ta là Thủ Hoang Nhân.",
    "T35.442.name": "Thủ Hoang Nhân",
    "T35.445.onServiceText": "Tử khí bắt đầu bốc lên.",
    "T35.445.name": "Cương Thi Vương",
    "T35.446.onServiceText": "Ngươi đến để xin gia nhập đội cận vệ? Nhưng ta tin\nchúng ta đã có đủ người rồi.",
    "T35.446.name": "Trưởng Cận Vệ Tiên Lạp",
    "T35.447.onServiceText": "Ta thích cảm giác đi săn trong khu vực tuyết rơi",
    "T35.447.name": "Thợ Săn A Phàm",
    "T35.448.onServiceText": "Độc Nhãn da xanh luôn có ác ý với loài người,\nngươi phải cẩn thận",
    "T35.448.name": "Lão Thợ Săn",
    "T35.449.onServiceText": "Ta cần đá màu đỏ, viên đá màu đỏ",
    "T35.449.name": "Đại Khâu Lăng Sơn Quái",
    "T35.450.onServiceText": "Ta ngày ngày qua lại các thành lớn để truyền đạt\ntình cảm giữa mọi người với nhau.",
    "T35.450.name": "Người Đưa Thư Châu Thần",
    "T35.451.onServiceText": "Ta là người thật thà, chưa từng nói dối, chưa từng\nhại ai",
    "T35.451.name": "Jia Thật Thà",
    "T35.452.onServiceText": "Chỉ cần làm món ăn bằng cả trái tim thì người\nngười đều là thực thần",
    "T35.452.name": "Thực Thần",
    "T35.453.onServiceText": "Xem đây, ai bảo ngư phu không biết làm ruộng",
    "T35.453.name": "Ngư Phu",
    "T35.454.onServiceText": "Lúc đầu nghĩ rằng đến đây làm việc sẽ nhàn hạ,\nkhông ngờ lại bận tối mắt tối mũi",
    "T35.454.name": "Vệ Sĩ",
    "T35.455.subType": "13|1720|1721|1722|1723|1724",
    "T35.455.onServiceText": "Tuy chỉ là vệ sĩ của thôn nhưng trách nhiệm của\nchiến sĩ hay vệ sĩ đều lớn như nhau.",
    "T35.455.name": "Vệ Sĩ Xuất Vân",
    "T35.456.onServiceText": "Ngươi đã dọa các con thú ta định săn chạy hết rồi,\ndi chuyển nhẹ nhàng thôi.",
    "T35.456.name": "Thợ Săn Edward",
    "T35.457.onServiceText": "Phải cho người khác biết rằng hàng hóa của Bàng\nBối Thành có chất lượng tốt nhất",
    "T35.457.name": "Thương Hội Trưởng Bàng Bối",
    "T35.458.onServiceText": "Chào mừng đến với Thiên Lục Châu, ngươi cần về gia\ntộc hay là đi thành Bàng Bối?",
    "T35.458.name": "Hướng Đạo Lục Châu",
    "T35.459.onServiceText": "Ta chỉ là một thương nhân bình thường, không chịu\nđược áp lực như thế này.",
    "T35.459.name": "Phụ Trách Thương Đội",
    "T35.460.onServiceText": "(Con sói khổng lồ ác độc đang nhìn bạn)",
    "T35.460.name": "Thủ Lĩnh Cự Nhân",
    "T35.461.onServiceText": "Khi ngươi nhìn thấy ta thì tất cả các tài sản của\nngươi đã thuộc về ta, ha ha",
    "T35.461.name": "Thủ Lĩnh Sa Tặc",
    "T35.462.onServiceText": "Làm gì thì làm, không được quên những nguy hiểm\nxung quanh luôn rình rập chúng ta.",
    "T35.462.name": "Vệ Sĩ Bàng Bối",
    "T35.463.onServiceText": "Cho xe cộ lưu hành trong thành là bí quyết làm\nphồn vinh cho Tiên Lạp",
    "T35.463.name": "Thương Hội Trưởng Tiên Lạp",
    "T35.464.onServiceText": "Cần phải có lòng tin tưởng với cái cuốc của mình",
    "T35.464.name": "Thợ Mỏ",
    "T35.465.onServiceText": "Ở đây chúng ta có rượu đặc sản được làm từ nguyên\nliệu dâu rừng thơm ngon nhất.",
    "T35.465.name": "Chủ Quán Rượu",
    "T35.466.onServiceText": "Du lịch là sở thích lớn nhất của ta, còn nghệ\nthuật là cuộc sống của ta",
    "T35.466.name": "Nghệ Nhân Lữ Hành",
    "T35.467.onServiceText": "Chào mừng đến với thành Tiên Lạp, ta là chủ tiệm\nvũ khí",
    "T35.467.name": "Chủ Tiệm Vũ Khí",
    "T35.468.onServiceText": "Vùng này dạo gần đây không yên ổn, đi lại phải cẩn\nthận",
    "T35.468.name": "Quan Tuần Tra Lê Dương",
    "T35.469.onServiceText": "(Đang suy nghĩ….)",
    "T35.469.name": "Dược Sĩ",
    "T35.470.onServiceText": "Cừu của chúng ta không phải là cừu thông thường",
    "T35.470.name": "Người Chăn Cừu",
    "T35.471.onServiceText": "Nếu như mỗi ngày ngươi đi tuần 300 vòng ở đây thì\nngươi sẽ biết ta đang nghĩ gì",
    "T35.471.name": "Lính Tuần Tra",
    "T35.473.onServiceText": "Đừng nghĩ rằng nấm thì dễ bắt nạt ",
    "T35.473.name": "Nấm Vương",
    "T35.475.subType": "50|5418|5419",
    "T35.475.onServiceText": "Ta không muốn nói ra, nhưng thực chất ta là một\ncon phượng hoàng, cục tác…",
    "T35.475.name": "Kê Vương",
    "T35.476.onServiceText": "Mỗi sinh mạng của đại lục Vô Ưu đều liên quan chặt\nchẽ đến Tuyết Liên. Tên người nghĩa là hoa sen nở\ntrong tuyết băng giá, công chúa xứng với tên\nđó.Người như nữ thần kiên nghị đối diện với mọi\ntai họa. Linh lực của người đã mang đến cho chúng\nta tự do.",
    "T35.476.name": "Bia Kỉ Niệm",
    "T35.477.onServiceText": "#%#$%$^%!@@#$#@!$#0",
    "T35.477.name": "Thủ Lĩnh Độc Nhãn",
    "T35.478.onServiceText": "Đây là địa bàn của ta",
    "T35.478.name": "Alumo",
    "T35.480.funcInfo": "|17,Lê Dương Đảo,20,2774,209|",
    "T35.480.onServiceText": "Muốn đi thuyền ra đảo ư? Gần đây trên hồ rất nguy\nhiểm, nếu tiền công không cao thì ta sẽ không chở\nđâu.",
    "T35.480.name": "Người Lái Đò Hồ Đại",
    "T35.481.onServiceText": "Chào mừng đến với thành Bàng Bối, ta là chủ tiệm\nthuốc",
    "T35.481.name": "Tiệm Thuốc Kelly",
    "T35.482.onServiceText": "Loài người chả tốt lành gì",
    "T35.482.name": "Đội Trưởng Độc Nhãn Xanh",
    "T35.483.onServiceText": "Loài người thật sự chả tốt lành gì",
    "T35.483.name": "Thủ Lĩnh Độc Nhãn Xanh",
    "T35.484.onServiceText": "Do re mi fa sol la si… Ngươi thấy thế nào?",
    "T35.484.name": "Hổ Bì Dương Thích Hát",
    "T35.485.onServiceText": "Một mảnh da thú không rõ của con gì",
    "T35.485.name": "Mảnh Da Thú",
    "T35.486.onServiceText": "Dã nhân thì cũng phải sinh sống.",
    "T35.486.name": "Độc Nhãn Đào Quặng",
    "T35.487.onServiceText": "Ta đang điều tra chất lượng nước, đừng có làm\nphiền ta",
    "T35.487.name": "Aluca",
    "T35.488.onServiceText": "Ta muốn ăn cá",
    "T35.488.name": "Ốc Vương Ngàn Năm",
    "T35.489.subType": "3-0",
    "T35.489.onServiceText": "Chào mừng đến với Thiên Khung Tộc, nơi sẽ đào tạo\nngươi thành Xạ thủ tài ba.",
    "T35.489.name": "Đạo Sư Thiên Khung",
    "T35.490.onServiceText": "Ta là Tộc Trưởng Thiên Khung, muốn học kỹ năng gia\ntộc thì cứ đến tìm ta.",
    "T35.490.name": "Tộc Trưởng Thiên Khung",
    "T35.491.onServiceText": "Nơi đây có bán sách kỹ năng.",
    "T35.491.name": "Kho Sách Thiên Khung",
    "T35.492.funcInfo": "|9,Đông Huyền Thành,10,2228,1336|30,Quyến Cố\nThành,100,1153,1163|",
    "T35.492.onServiceText": "Ngươi muốn về Đông Huyền Thành ư? ",
    "T35.492.name": "Tinh Linh Dịch Chuyển Thiên Khung",
    "T35.493.name": "Vải",
    "T35.494.funcInfo": "|15,Lê Dương Bắc,20,387,1543|8,Tháp Khắc\nNguyên,30,2681,1591|",
    "T35.494.onServiceText": "Hồ Lê Dương quá nguy hiểm, nếu không có việc gì\ncần thiết thì đừng đi ra đó",
    "T35.494.name": "Người Lái Đò Lộ Cốc",
    "T35.497.funcInfo": "|17,Lê Dương Đảo,20,2774,209|",
    "T35.497.onServiceText": "Muốn đi đâu? ",
    "T35.497.name": "Người Lái Đò Vương Đại",
    "T35.498.onServiceText": "Chữa bệnh cứu người là thiên chức của ta, ngươi\ncảm thấy không khỏe ư?",
    "T35.498.name": "Bác Sĩ Đắc Kỷ",
    "T35.500.onServiceText": "Chào mừng đến với thành Bàng Bối, ta là chủ tiệm\ntrang bị",
    "T35.500.name": "Tiệm Trang Bị Ran",
    "T35.501.onServiceText": "Chào mừng đến với thành Bàng Bối, ta là chủ tiệm\nvũ khí",
    "T35.501.name": "Chủ Tiệm Vũ Khí",
    "T35.503.onServiceText": "Chào mừng đến với thành Bàng Bối, ta là chủ tiệm\ntrang sức",
    "T35.503.name": "Tiệm Trang Sức Saiba",
    "T35.504.onServiceText": "Ta là chủ tiệm tạp hóa Bàng Bối, những vật phẩm ta\nbán sẽ giúp ích rất nhiều",
    "T35.504.name": "Tiểu Nhị Tạp Hóa",
    "T35.505.name": "Thùng Thư Bàng Bối",
    "T35.506.onServiceText": "Ta có thể giúp ngươi giữ vật phẩm chưa cần thiết,\nkhi cần có thể tìm ta để lấy",
    "T35.506.name": "Thủ Kho",
    "T35.507.name": "Quản Lý Đấu Giá",
    "T35.508.funcInfo": "|1,Xuất Vân Thôn,10,1000,1000|10,Tinh Linh\nThành,100,2000,1000|9,Đông Huyền\nThành,100,2057,1309|31,Tiên Lạp\nThành,100,3000,1800|30,Quyến Cố\nThành,100,1153,1163|",
    "T35.508.onServiceText": "Chúc ngươi một chuyến đi vui vẻ.",
    "T35.508.name": "Điểm Dịch Chuyển Trương Chân Nhân",
    "T35.509.onServiceText": "Ta chữa trị một cách nhanh chóng, bất kể là người\nhay là quái vật… Ha ha",
    "T35.509.name": "A Vượng",
    "T35.510.onServiceText": "Ta là chủ tiệm tạp hóa Tiên Lạp, những vật phẩm ta\nbán sẽ giúp ích rất nhiều",
    "T35.510.name": "Chủ Tiệm Tạp Hóa",
    "T35.512.subType": "1101|1782",
    "T35.512.onServiceText": "Đừng thấy rằng ta là nữ nhi mà nghĩ là dễ bắt nạt\nnhé !!",
    "T35.512.name": "Nữ Vương Hoa Yêu",
    "T35.514.onServiceText": "Chào mừng đến với thành Tiên Lạp, ta là chủ tiệm\ntrang bị.",
    "T35.514.name": "Chủ Tiệm Trang Bị",
    "T35.515.onServiceText": "Chào mừng đến với thành Tiên Lạp, ta là chủ tiệm\nthuốc.",
    "T35.515.name": "Chủ Tiệm Thuốc",
    "T35.517.onServiceText": "Ta có thể giúp ngươi lưu giữ những vật phẩm chưa\ncần thiết.",
    "T35.517.name": "Thủ Kho",
    "T35.519.onServiceText": "Hoan nghênh đến Tiên Lạp Thành xinh đẹp.",
    "T35.519.name": "Chủ Tiệm Trang Sức",
    "T35.523.onServiceText": "Chào mừng đến với tiệm pet Tiên Lạp, quý khách cần\nmua gì nào?",
    "T35.523.name": "Chủ Tiệm Pet",
    "T35.524.name": "Quản Lý Đấu Giá",
    "T35.525.name": "Thùng Thư Tiên Lạp",
    "T35.531.funcInfo": "|1,Xuất Vân Thôn,10,1000,1000|38,Bàng Bối\nThành,100,1153,1163|9,Đông Huyền\nThành,100,2057,1309|10,Tinh Linh\nThành,100,2000,1000|30,Quyến Cố\nThành,100,1153,1163|",
    "T35.531.onServiceText": "Chúc ngươi một chuyến đi vui vẻ.",
    "T35.531.name": "Điểm Dịch Chuyển Long Long",
    "T35.537.onServiceText": "Ở đây nguy hiểm lắm, nếu không có việc gì thì\nngươi hãy mau đi đi!",
    "T35.537.name": "Trị Liệu Sư",
    "T35.539.onServiceText": "Tiệm tạp hóa Tinh Linh Thành của ta có bán rất\nnhiều vật phẩm.",
    "T35.539.name": "Chủ Tiệm Tạp Hóa",
    "T35.541.onServiceText": "Xin chào du khách đến Tiên Lạp Thành xinh đẹp.",
    "T35.541.name": "Thành Chủ Tiên Lạp",
    "T35.547.onServiceText": "Sư phụ cần phải hướng dẫn cho đệ tử mọi điều kể cả\nnhỏ nhặt nhất.",
    "T35.547.name": "Sát Hạch Viên Sư",
    "T35.561.onServiceText": "Xin chào, ta là Hoàng Tiểu Nha, qua được kiểm tra\ncủa ta thì sẽ nhận được rất nhiều kinh nghiệm",
    "T35.561.name": "Hoàng Tiểu Nha",
    "T35.566.funcInfo": "|27,Trầm Thụy Lâm,100,200,300|1,Xuất Vân\nThôn,10,1000,1000|10,Tinh Linh\nThành,100,2000,1000|38,Bàng Bối\nThành,100,1153,1163|31,Tiên Lạp\nThành,100,3300,1800|30,Quyến Cố\nThành,100,1153,1163|57,Nông Trường Số\n1,100,696,1574|58,Nông Trường Số 2,100,696,",
    "T35.566.onServiceText": "Chúc bạn may mắn!",
    "T35.566.name": "Chuyển Dịch Mark",
    "T35.567.funcInfo": "|1,Xuất Vân Thôn,10,1000,1000|38,Bàng Bối\nThành,100,1153,1163|9,Đông Huyền\nThành,100,2057,1309|31,Tiên Lạp\nThành,100,3000,1800|30,Quyến Cố\nThành,100,1153,1163|",
    "T35.567.onServiceText": "Chúc ngươi một chuyến đi vui vẻ.",
    "T35.567.name": "Tinh Linh Dịch Chuyển",
    "T35.568.name": "Nhận Nhiệm Vụ Treo Thưởng",
    "T35.569.name": "Nhận Nhiệm Vụ Treo Thưởng",
    "T35.572.onServiceText": "Nhìn cái gì mà nhìn, chưa nhìn thấy lưu manh bao\ngiờ à ?",
    "T35.572.name": "Bang Chủ Răng Cửa",
    "T35.573.onServiceText": "Hoa hoa ở một mình nơi đây thiệt là sợ quá đi >.<",
    "T35.573.name": "Tiểu Hoa",
    "T35.576.name": "Khoáng Thạch",
    "T35.578.name": "Khoáng Ngọc",
    "T35.579.name": "Khoáng Thạch",
    "T35.580.name": "Lông Thú",
    "T35.581.name": "Lông Thú",
    "T35.582.name": "Khoáng Thạch",
    "T35.583.name": "Khoáng Thạch",
    "T35.584.name": "Vải",
    "T35.585.name": "Gỗ",
    "T35.586.name": "Gỗ",
    "T35.587.name": "Gỗ",
    "T35.588.name": "Vải",
    "T35.589.name": "Khoáng Thạch",
    "T35.590.name": "Khoáng Ngọc",
    "T35.591.name": "Khoáng Ngọc",
    "T35.592.onServiceText": "Ngươi biết không? Hoa đào rơi với tốc độ 5mm/giây\nđó nhé.",
    "T35.592.name": "Đồng Đồng",
    "T35.593.onServiceText": "Ta lại nhớ rượu ngon ở Tinh Linh Thành rồi, nhưng\nở đây tuần sơn cũng đáng…",
    "T35.593.name": "Thợ Săn Airy",
    "T35.595.onServiceText": "Nếu ngươi không cẩn thận làm mất vật phẩm nhiệm vụ\nthì có thể đến tìm ta!",
    "T35.595.name": "Tiệm Vật Phẩm Nhiệm Vụ",
    "T35.596.onServiceText": "Khi nào ngươi đủ sức thì hãy tìm ta. Giờ thì đi\nđi.",
    "T35.596.name": "Khảo Quan Trung Cấp",
    "T35.597.onServiceText": "Alo… Ola… Bla… Bla... (Hình như có âm thanh nhưng\nnghe không rõ)",
    "T35.597.name": "Máy Giả Giọng Nói",
    "T35.598.onServiceText": "Đường này do ta mở, muốn qua đường này thì mau nộp\ntiền mãi lộ! Hừ!",
    "T35.598.name": "Tiểu Sơn Tặc",
    "T35.599.onServiceText": "Ngươi tuổi gì mà đòi chắn đường ta, mau tránh ra\nchỗ khác! Thằng bờm!",
    "T35.599.name": "Rota",
    "T35.600.onServiceText": "Khi đạt đến 1 trình độ nhất định phải đến gặp Khảo\nQuan để tự thăng cấp nghề nghiệp và nâng cao năng\nlực. Và dĩ nhiên phải đạt đủ các yêu cầu quy định\nmới có thể thăng cấp.",
    "T35.600.name": " Khảo Quan Trung Cấp",
    "T35.601.onServiceText": "Không gì có thể sánh với tình huynh đệ !",
    "T35.601.name": "Cận Vệ Của Rink",
    "T35.602.onServiceText": "Không ai có thể đối đầu với kẻ báo thù! Người anh\nem mau đi về đi",
    "T35.602.name": "Rink",
    "T35.603.onServiceText": "Xin chào! Ta là nhà thám hiểm phụ tránh nghiên cứu\nvấn đề sa mạc hóa.",
    "T35.603.name": "Nhà Thám Hiểm",
    "T35.604.onServiceText": "Ngươi hãy quan sát kỹ, trong mỗi tinh thể đều hàm\nchứa sự thâm thúy.",
    "T35.604.name": "Tinh Thể Học Giả",
    "T35.605.onServiceText": "Ta trồng hoa chưa thấy núi tuyết nào có thể trồng\nđược hoa Anh Đào cả",
    "T35.605.name": "Thợ Trồng Hoa",
    "T35.608.onServiceText": "Tiên cảnh hoa đào nhảy múa đẹp làm sao! Ha ha ha…",
    "T35.608.name": "Tiểu Ba",
    "T35.609.onServiceText": "Ta ở lại đây, vừa có thể cung cấp thông tin lại\nvừa có thể canh giữ linh hồn Aka",
    "T35.609.name": "Rom",
    "T35.610.onServiceText": "Ta đã không có được thì kẻ khác đừng nghĩ có được,\nta thà huỷ hoại còn hơn",
    "T35.610.name": "Tiêu Khắc",
    "T35.613.onServiceText": "Đừng hỏi tại sao ta lại cầm cuốc sắt, cấp trên ta\nbảo thế đó",
    "T35.613.name": "Thợ Đốn Gỗ",
    "T35.614.onServiceText": "Ta là vua gấu trúc, ta là thần phù thủy, ta…, ta… ",
    "T35.614.name": "Gấu Trúc Vương",
    "T35.615.onServiceText": "Nếu cả gan khai thác trên địa bàn của ta, ta cho\nvề thành miễn phí đó",
    "T35.615.name": "Dũng Sĩ Sói",
    "T35.616.onServiceText": "Xem chừng đã chết rất lâu rồi, nhưng cũng đủ biết\nđó là xác một người phụ nữ",
    "T35.616.name": "Tử Thi",
    "T35.617.onServiceText": "Y thủy chi bàng, lộ anh chi lâm.",
    "T35.617.name": "Y Lộ",
    "T35.619.onServiceText": "Tấm bia đá nghe nói có liên quan đến sự hình thành\ncủa Trầm Thụy Lâm.",
    "T35.619.name": "Bia Mộ Orca",
    "T35.622.onServiceText": "Dạo này em nghe trong phòng có âm thanh kỳ lạ, em\nsợ lắm… anh chị ở lại với em được không???",
    "T35.622.name": "Lan Lan",
    "T35.623.onServiceText": "Không phải ta…. ta không làm gì cả… không biết… ta\nkhông biết gì cả…",
    "T35.623.name": "Cook",
    "T35.629.onServiceText": "Trong địa bàn của ta thì hãy nghe ta! Muốn ăn thì\năn, khi ăn thì phải vui vẻ! A ha ha….",
    "T35.629.name": "Thảo Nguyên Gấu Vương",
    "T35.631.onServiceText": "Nhìn cái gì mà nhìn? Còn nhìn bà ăn thịt ngươi\nluôn.",
    "T35.631.name": "Sói Mẹ Hung Ác",
    "T35.632.onServiceText": "Dùng dao kết thúc mạng sống thật là tuyệt!",
    "T35.632.name": "Misalu",
    "T35.633.onServiceText": "Làm phận nữ nhi, ngươi tưởng dễ lắm sao. Sa mạc\nthì lớn thế kia…",
    "T35.633.name": "Quỷ Điệp Phu Nhân",
    "T35.634.onServiceText": "Cái đầu to đến vậy, liệu có thể ẩn chứa bí mật gì\nnhỉ?",
    "T35.634.name": "Đầu Lâu Khổng Lồ",
    "T35.636.onServiceText": "Gấu đói rồi, gấu muốn ăn. ",
    "T35.636.name": "Gấu Bảo Thạch",
    "T35.637.onServiceText": "Ngươi thích khiêu chiến hả? Có dám nhận lời thách\nđấu không?",
    "T35.637.name": "Nhà Mạo Hiểm",
    "T35.638.onServiceText": "Cây cột này sặc mùi tà khí hôi thối",
    "T35.638.name": "Cột Totem Sói",
    "T35.639.subType": "3-0",
    "T35.639.onServiceText": "Trên để trừ ác đế, dưới để trừ tà yêu, tâm cũng là\nnghĩa, thiên hạ là chí.",
    "T35.639.name": "Đạo Sư Lưu Hỏa",
    "T35.640.onServiceText": "Ta là Tộc Trưởng Lưu Hỏa, muốn học kỹ năng gia tộc\nthì cứ đến tìm ta.",
    "T35.640.name": "Tộc Trưởng Lưu Hỏa",
    "T35.641.onServiceText": "Nơi đây có bán sách kỹ năng gia tộc, nếu ngươi cần\nthì có thể mua.",
    "T35.641.name": "Kho Sách Lưu Hỏa",
    "T35.643.onServiceText": "Bị thương rồi ư? Đừng lo, để ta trị thương cho\nngươi.",
    "T35.643.name": "Lão Ngư Phu",
    "T35.644.onServiceText": "Chớ có làm những việc thừa thãi. Hừ...",
    "T35.644.name": "Thủ Lĩnh Hồ Tặc",
    "T35.645.onServiceText": "Chúng ta sống đời đời kiếp kiếp ở trong sa mạc",
    "T35.645.name": "Thủ Lĩnh Khổng Lồ Sa Mạc",
    "T35.646.funcInfo": "|9,Đông Huyền Thành,10, 1550,1207|30,Quyến Cố\nThành,100,1153,1163|",
    "T35.646.onServiceText": "Ngươi muốn về Đông Huyền Thành ư? ",
    "T35.646.name": "Tinh Linh Dịch Chuyển Lưu Hỏa",
    "T35.647.subType": "1288|1293",
    "T35.647.onServiceText": "Kế thừa trí tuệ ngàn năm nhưng vẫn không đoán được\ntương lai của nhân loại…",
    "T35.647.name": "Thiên Niên Thụ",
    "T35.648.name": "Tinh Linh Vương",
    "T35.650.onServiceText": "Ta rất thích phong cảnh trên đỉnh núi, cảnh mặt\ntrời mọc ở đây là đẹp nhất",
    "T35.650.name": "Thợ Làm Trúc",
    "T35.658.onServiceText": "Sự tình ngày càng phức tạp, không ngờ Hắc Lĩnh Cân\nlại một lần nữa xuất hiện",
    "T35.658.name": "Võ Sĩ",
    "T35.659.onServiceText": "Bức tượng đá trông sinh động như thật",
    "T35.659.name": "Tượng Đá",
    "T35.660.onServiceText": "Các tiền nhân đã hiến sinh mạng quý báu của mình\nđể bảo vệ thành Bàng Bối.",
    "T35.660.name": "Thủ Cốc Nhân",
    "T35.661.onServiceText": "Ta cảm thấy rất phấn khởi về sự phồn thịnh của\nBàng Bối Thành hiện nay.",
    "T35.661.name": "Anh Linh",
    "T35.662.onServiceText": "Ong ta nuôi có thể cho ra mật ong thượng hạng, có\ntiền chưa chắc mua được",
    "T35.662.name": "A Linh",
    "T35.663.onServiceText": "Nếu có cơ hội ta muốn leo lên đỉnh núi cao nhất\ncủa đại lục Vô Ưu này",
    "T35.663.name": "Thành Viên Leo Núi",
    "T35.664.onServiceText": "Ta là vua cánh đồng tuyết, bất kể ai cũng phải quỳ\ndưới chân ta.",
    "T35.664.name": "Nộ Viêm Lam Đế",
    "T35.665.onServiceText": "Chào các anh chị, đã chuẩn bị chết ở đây chưa??",
    "T35.665.name": "Băng Đồng Yêu Vương",
    "T35.667.onServiceText": "Ta đến từ nơi sâu thẳm của Lê Dương, biệt hiệu Lê\nDương Nhất Bá.",
    "T35.667.name": "Ốc Đại Đội Trưởng",
    "T35.668.subType": "1329|2486",
    "T35.668.onServiceText": "Ong mật chúng ta là loài cần cù nhất",
    "T35.668.name": "Ong Mật Nữ Vương",
    "T35.669.onServiceText": "Ta thích phong cảnh trên đỉnh núi, mặt trời mọc ở\nđó đẹp nhất.",
    "T35.669.name": "Lão Âu",
    "T35.670.onServiceText": "Có muốn chết thử 1 lần không?",
    "T35.670.name": "Hắc Thủ Tà Tâm",
    "T35.671.name": "Gấm Vóc",
    "T35.673.name": "Gấm Vóc",
    "T35.674.name": "Kim Loại Hiếm",
    "T35.675.name": "Kim Loại Hiếm",
    "T35.676.name": "Gỗ Tốt",
    "T35.677.name": "Gỗ Tốt",
    "T35.678.name": "Da Thú",
    "T35.679.name": "Da Thú",
    "T35.680.name": "Pha Lê",
    "T35.681.name": "Pha Lê",
    "T35.684.funcInfo": "Array",
    "T35.684.subType": "all",
    "T35.684.onServiceText": "Cỗ quan tài đá thật kỳ dị, bên trong có luồng sáng\nbí ẩn.",
    "T35.684.name": "Bất Hủ Vương",
    "T35.685.funcInfo": "Array",
