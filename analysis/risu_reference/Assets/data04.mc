    "T18.345911.flag": "{sublimeElement:1,sublimeAdd:0,sublimeId:50}",
    "T18.345911.maker": "★ɦαℛ¡α₷α★",
    "T18.345911.flag2": "{0:{t:58,v:0.154,max:1.5},1:{t:61,v:0.395,max:1.5},2:{t:14,v:0.934,max:1.5}}",
    "T19.2.name": "Thanh Đồng Khôi",
    "T19.2.reqClass": "|1|",
    "T19.2.description": "Mũ dễ làm, rẻ tiền được làm từ thanh đồng, là lựa\nchọn tốt nhất dành cho tân thủ\n",
    "T19.3.name": "Năng Lượng Hộ Uyển",
    "T19.3.reqClass": "|4|",
    "T19.3.description": "Vòng bảo vệ cổ tay chỉ dùng được sau khi nạp đủ\nnăng lượng, nếu có tiền thì nên đổi cái khác nhé\n",
    "T19.4.reqClassId": "|2|3|4|",
    "T19.4.name": "Ngân Tiêu Giới Chỉ",
    "T19.4.reqClass": "|1|2|3|4|6|5|",
    "T19.4.description": "Chiếc nhẫn có tên bắt nguồn từ những bài thơ của\nthi nhân Đông Huyền Đại Lục\n",
    "T19.6.name": "Thanh Đồng Khố",
    "T19.6.reqClass": "|1|",
    "T19.6.description": "Trang phục dễ làm, rẻ tiền được làm từ thanh đồng,\nlà lựa chọn tốt nhất dành cho tân thủ\n",
    "T19.7.name": "Thanh Đồng Giáp",
    "T19.7.reqClass": "|1|",
    "T19.7.description": "Giáp bảo vệ dễ làm, rẻ tiền được làm từ thanh\nđồng, là lựa chọn tốt nhất dành cho tân thủ\n",
    "T19.8.name": "Viên Thuẫn",
    "T19.8.reqClass": "|1|",
    "T19.8.description": "Tấm khiên nhỏ giúp bảo vệ cánh tay, được làm bằng\nthép sáng lấp lánh\n",
    "T19.9.reqClassId": "|2|3|4|",
    "T19.9.name": "Linh Long Hạng Liên",
    "T19.9.reqClass": "|1|2|3|4|6|5|",
    "T19.9.description": "Dây chuyền có đính kim cương Linh Longsáng lấp\nlánh\n",
    "T19.10.name": "Tinh Cương Chủy Thủ",
    "T19.10.reqClass": "|6|",
    "T19.10.description": "Loại vũ khí phòng thân có thể giấu vào tay áo\n",
    "T19.12.reqClassId": "|2|3|4|",
    "T19.12.name": "Tố Ngọc Hoàn",
    "T19.12.reqClass": "|1|2|3|4|6|5|",
    "T19.12.description": "Vòng ngọc trắng thanh nhã, là món quà tặng bạn bè\nmà người dân Đông Huyền Đại Lục thích dùng\n",
    "T19.14.name": "Thạch Đầu Bổng",
    "T19.14.reqClass": "|5|",
    "T19.14.description": "Đừng nghi ngờ việc đầu của bạn có nổi u không khi\nnó đánh vào, tuy rất mộc mạc nhưng có ý nghĩa kỷ\nniệm lắm\n",
    "T19.15.name": "Kinh Cúc Bổng",
    "T19.15.reqClass": "|5|",
    "T19.15.description": "Được làm từ loại cây gai ở phía nam Vô Ưu Đại Lục,\nrất bền, tuy nhiên bạn phải chịu chấp nhận hình\ndạng xấu xí của nó\n",
    "T19.29.name": "Bát Lãng Trống",
    "T19.29.reqClass": "|1|",
    "T19.29.description": "Trống này có thể làm vũ khí, khi chiến đấu phát ra\ntiếng \"tùng tùng\", uy hiếp kẻ địch\n",
    "T19.30.name": "Đại Mộc Chuỳ",
    "T19.30.reqClass": "|1|",
    "T19.30.description": "Chùy làm bằng gỗ của rừng già ngủ quên, chất liệu\ncứng, đánh trăm nghìn lần vẫn không hao mòn tí nào\n",
    "T19.31.name": "Tây Qua Chuỳ",
    "T19.31.reqClass": "|1|",
    "T19.31.description": "Chùy có hình quả dưa hấu, xem đầu ngươi cứng hay\ndưa hấu của ta cứng\n",
    "T19.32.name": "Phá Băng Chuỳ",
    "T19.32.reqClass": "|1|",
    "T19.32.description": "Chùy nổi tiếng về độ cứng, tương truyền có thể phá\nvỡ tường băng trên cánh đồng băng, khi lâm trận có\nkhí thế như tiếng băng nứt đá vỡ.\n",
    "T19.33.name": "Luyện Thiết Chuỳ",
    "T19.33.reqClass": "|1|",
    "T19.33.description": "Người lùn dựa theo hình dạng cây búa của Thần Sét\nđể tạo ra cây chùy bằng sắt có độ bền cực cao này.\n",
    "T19.34.name": "Long Cốt Chuỳ",
    "T19.34.reqClass": "|1|",
    "T19.34.description": "Chùy đúc bằng xương của loài rồng, tương truyền\ngiúp kẻ dùng nó có sức mạnh vô cùng\n",
    "T19.35.name": "Bảo Thạch Trượng",
    "T19.35.reqClass": "|3|",
    "T19.35.description": "Pháp trượng khảm Bảo Thạch màu xanh dưới đáy hồ Lê\nDương và trúc xanh của rừng già ngủ quên\n",
    "T19.36.name": "Thất Sắc Trượng",
    "T19.36.reqClass": "|3|",
    "T19.36.description": "Pháp trượng được làm từ gỗ ma pháp của rừng già\nngủ quên, do phát ra ánh sáng bảy màu nên gọi là\ntrượng thất sắc\n",
    "T19.37.name": "Linh Cầu Pháp Trượng",
    "T19.37.reqClass": "|3|",
    "T19.37.description": "Pháp trượng khảm viên đá ma thuật đầy uy lực mà ai\ncũng khao khát có nó\n",
    "T19.38.name": "Phong Vân Điện Trượng",
    "T19.38.reqClass": "|3|",
    "T19.38.description": "Nghe nói trượng này có thể khống chế ba loại sức\nmạnh của gió, mây và sét\n",
    "T19.39.name": "Đồ Đằng Trượng",
    "T19.39.reqClass": "|3|",
    "T19.39.description": "Pháp trượng thần bí có khắc biểu tượng cổ xưa,\ntương truyền biểu tượng này ẩn chứa sức mạnh của\nVô Ưu Tộc thời viễn cổ\n",
    "T19.40.name": "Điêu Long Trượng",
    "T19.40.reqClass": "|3|",
    "T19.40.description": "Pháp trượng trang trí bởi xương của loài rồng,\ntiềm tàng sức mạnh thần bí của rồng, trên thân\ntrượng có đường vân ẩn hiện tựa như lịch sử Vô Ưu\n",
    "T19.41.name": "Đơn Quản Cổ Hỏa Súng",
    "T19.41.reqClass": "|4|",
    "T19.41.description": "Súng tương đối cũ, là đồ cổ, cẩn thận bắt lửa :D\n",
    "T19.42.name": "Song Quản Hỏa Súng",
    "T19.42.reqClass": "|4|",
    "T19.42.description": "Giống với súng hai nòng của thợ săn, lực tấn công\nrất tuyệt\n",
    "T19.44.name": "Lôi Xạ Cự Súng",
    "T19.44.reqClass": "|4|",
    "T19.44.description": "Tên gọi khá uy phong, dựa vào cái tên thì uy lực\nquả là không tồi, dùng thì biết\n",
    "T19.46.name": "Hỏa Long Kích Quang Súng",
    "T19.46.reqClass": "|4|",
    "T19.46.description": "Pháo phát sáng mạnh có thể trực tiếp làm bị thương\nmục tiêu, ưu điểm là tốc độ tấn công nhanh, chuyển\nhướng linh hoạt, chính xác, không bị nhiễm điện từ\n",
    "T19.47.name": "Tụ Năng Lôi Xạ Súng",
    "T19.47.reqClass": "|4|",
    "T19.47.description": "Bắt nguồn từ súng phá giáp, hiệu ứng hấp thu năng\nlượng đảm bảo uy lực của súng, dễ dàng bắn vỡ lớp\nvỏ giáp, một cây súng mà giá cả tính năng đều rất\ntuyệt\n",
    "T19.48.name": "Phụ Ly Tử Súng",
    "T19.48.reqClass": "|4|",
    "T19.48.description": "Thành quả nghiên cứu mới nhất của phòng nghiên cứu\nĐông Huyền tộc, uy lực cực lớn, đọc kỹ hướng dẫn\nsử dụng trước khi dùng\n",
    "T19.49.name": "Thanh Phong Kiếm",
    "T19.49.reqClass": "|6|",
    "T19.49.description": "Lưỡi kiếm vô cùng sắc bén, dùng rất thuận tay\n",
    "T19.50.name": "Ngạnh Mộc Thuẫn",
    "T19.50.reqClass": "|1|",
    "T19.50.description": "Khiên gỗ cứng làm từ gỗ của rừng già ngủ quên\n",
    "T19.51.name": "Cường Kích Thuẫn",
    "T19.51.reqClass": "|1|",
    "T19.51.description": "Khiên có thể làm vũ khí tấn công, vô cùng cứng\ncáp, tương truyền có tinh thạch thần bí nằm bên\ntrong\n",
    "T19.52.name": "Kỵ Sĩ Thuẫn",
    "T19.52.reqClass": "|1|",
    "T19.52.description": "Khiên kỵ sĩ dùng trên chiến trường, bề ngoài đơn\ngiản, sức mạnh lớn, được thêm vào sức mạnh thần bí\n",
    "T19.53.name": "Hoàng Thất Tháp Thuẫn",
    "T19.53.reqClass": "|1|",
    "T19.53.description": "Khiên lưu truyền từ hoàng triều cũ tộc Vô Ưu, trên\nmặt khiên khắc dòng chữ \"Dũng cảm vĩnh sinh\"\n",
    "T19.54.name": "Dũng Sĩ Thuẫn",
    "T19.54.reqClass": "|1|",
    "T19.54.description": "Khiên phòng hộ cao quý màu vàng, tương truyền\nngười dũng cảm nhất vùng Đông Huyền đã từng dùng\n",
    "T19.55.name": "Kỳ Đảo Y Thư",
    "T19.55.reqClass": "|3|",
    "T19.55.description": "Cầu nguyện cho sinh linh bách tính, đúng như tiêu\nchuẩn chiêu sinh của Liêu Vân: quan tâm bách tính\n",
    "T19.56.name": "Học Giả Y Thư",
    "T19.56.reqClass": "|3|",
    "T19.56.description": "Ghi chép tâm huyết của học giả nổi tiếng lịch sử\n",
    "T19.63.name": "Tri Thức Y Thư",
    "T19.63.reqClass": "|3|",
    "T19.63.description": "Tác phẩm y học nổi tiếng của Liêu Vân, cũng là tâm\nđức hành nghề y của học trò ở Liêu Vân\n",
    "T19.64.name": "Linh Vũ Y Kinh",
    "T19.64.reqClass": "|3|",
    "T19.64.description": "Ghi chép kinh nghiệm của các học giả y thuật, chỉ\nđạo phương hướng đúng đắn trong cuộc sống\n",
    "T19.65.name": "Giới Luật Y Thư",
    "T19.65.reqClass": "|3|",
    "T19.65.description": "Quy định của gia tộc, quy phạm cuộc sống, tiêu\nchuẩn làm người\n",
    "T19.66.name": "Tín Ngưỡng Y Thư",
    "T19.66.reqClass": "|3|",
    "T19.66.description": "Tương truyền từng là trang bị của một nhà sư khi\nlàm ra bước vào thế giới thần thánh\n",
    "T19.67.name": "Điện Từ Hộ Uyển",
    "T19.67.reqClass": "|4|",
    "T19.67.description": "Vòng bảo vệ cổ tay vừa tấn công vừa có thể hoá\ngiải tê liệt do sóng điện từ, cẩn thận vì sẽ bị\ntàn phế, tránh sát thương nhầm\n",
    "T19.68.name": "Phù Ma Hộ Uyển",
    "T19.68.reqClass": "|4|",
    "T19.68.description": "Vòng bảo vệ cổ tay ma thuật sơ cấp, có thể tấn\ncông ma thuật trong thời gian nhất định\n",
    "T19.69.name": "Võ Sĩ Hộ Uyển",
    "T19.69.reqClass": "|4|",
    "T19.69.description": "Vòng bảo vệ cổ tay võ sĩ cao cấp, lính dự bị\nthường dùng; tinh tế và có hiệu quả phòng ngự rất\ntuyệt\n",
    "T19.70.name": "Phụ Ly Tử Hộ Uyển",
    "T19.70.reqClass": "|4|",
    "T19.70.description": "Thành quả nghiên cứu mới nhất của phòng nghiên cứu\nvùng đất\nĐông Huyền, hiệu quả phòng ngự tuyệt vời\n",
    "T19.71.name": "Thất Tinh Hộ Uyển",
    "T19.71.reqClass": "|4|",
    "T19.71.description": "Trang bị chứa năng lượng của thất tinh bắc đẩu với\nsức mạnh tự nhiên rất lớn\n",
    "T19.72.name": "Tinh Thiết Khôi",
    "T19.72.reqClass": "|1|",
    "T19.72.description": "Mũ đội đầu luyện từ thép, năng lực phòng vệ và\nhình dạng có khá hơn mũ bằng thanh đồng\n",
    "T19.73.name": "Hợp Kim Khôi",
    "T19.73.reqClass": "|1|",
    "T19.73.description": "Chế từ các kim loại thượng đẳng, hơn hẳn mũ thông\nthường về mọi mặt\n",
    "T19.74.name": "Dũng Sĩ Khôi",
    "T19.74.reqClass": "|1|",
    "T19.74.description": "Mũ tộc người Vô Ưu thường đội khi săn bắn, chiến\nđấu, làm giảm nhẹ thương tích\n",
    "T19.76.name": "Hoàng Kim Khôi",
    "T19.76.reqClass": "|1|",
    "T19.76.description": "Mũ đúc bằng vàng, dũng sĩ hoặc tướng quân chiến\ncông lừng lẫy mới có tư cách đội, chất liệu cao\nquý tượng trưng cho chiến công siêu phàm của người\nđội nó\n",
    "T19.77.name": "Tướng Quân Khôi",
    "T19.77.reqClass": "|1|",
    "T19.77.description": "Mũ tướng quân đội khi xuất chinh, khả năng bảo vệ\ncao, uy phong lẫm liệt\n",
    "T19.78.name": "Tinh Thiết Giáp",
    "T19.78.reqClass": "|1|",
    "T19.78.description": "Áo giáp luyện từ thép, năng lực phòng vệ và hình\ndạng có khá hơn mũ bằng thanh đồng\n",
    "T19.80.name": "Hợp Kim Giáp",
    "T19.80.reqClass": "|1|",
    "T19.80.description": "Chế từ các kim loại thượng đẳng, hơn hẳn áo giáp\nthông thường về mọi mặt\n",
    "T19.81.name": "Dũng Sĩ Giáp",
    "T19.81.reqClass": "|1|",
    "T19.81.description": "Áo giáp tộc người Vô Ưu thường mặc khi săn bắn,\nchiến đấu, công dụng giảm tối đa thương thích\n",
    "T19.82.name": "Tướng Quân Giáp",
    "T19.82.reqClass": "|1|",
    "T19.82.description": "Áo giáp tướng quân mặc khi xuất chinh, khả năng\nbảo vệ cao, uy phong lẫm liệt\n",
    "T19.83.name": "Hoàng Kim Giáp",
    "T19.83.reqClass": "|1|",
    "T19.83.description": "Áo giáp đúc bằng vàng, dũng sĩ hoặc tướng quân\nchiến công lừng lẫy mới có tư cách mặc, chất liệu\ncao quý tượng trưng cho chiến công siêu phàm của\nngười mặc nó\n",
    "T19.91.name": "Tinh Thiết Khố",
    "T19.91.reqClass": "|1|",
    "T19.91.description": "Giáp chân luyện từ thép tinh chất, khả năng phòng\nhộ và hình dáng có nâng cao đáng kể so với đồ bằng\nthanh đồng\n",
    "T19.92.name": "Hợp Kim Khố",
    "T19.92.reqClass": "|1|",
    "T19.92.description": "Chế từ các kim loại thượng đẳng, hơn hẳn giáp\nthông thường về mọi mặt\n",
    "T19.93.name": "Dũng Sĩ Khố",
    "T19.93.reqClass": "|1|",
    "T19.93.description": "Giáp chân tộc người Vô Ưu thường mặc khi săn bắn,\nchiến đấu, làm giảm nhẹ thương tích\n",
    "T19.94.name": "Tướng Quân Khố",
    "T19.94.reqClass": "|1|",
    "T19.94.description": "Giáp chân tướng quân mặc khi xuất chinh, khả năng\nbảo vệ cao, uy phong lẫm liệt\n",
    "T19.95.name": "Hoàng Kim Khố",
    "T19.95.reqClass": "|1|",
    "T19.95.description": "Giáp chân đúc bằng vàng, dũng sĩ hoặc tướng quân\ncó chiến công lừng lẫy mới có tư cách mặc, chất\nliệu cao quý tượng trưng cho chiến công siêu phàm\ncủa người mặc nó\n",
    "T19.110.reqClassId": "|2|3|4|",
    "T19.110.name": "Lam Nha Hạng Liên",
    "T19.110.reqClass": "|1|2|3|4|6|5|",
    "T19.110.description": "Dây chuyền làm bằng răng của rồng cánh xanh trong\nmê cung của Rừng Già Ngủ Quên\n",
    "T19.111.reqClassId": "|2|3|4|",
    "T19.111.name": "Linh Uy Hạng Liên",
    "T19.111.reqClass": "|1|2|3|4|6|5|",
    "T19.111.description": "Dây chuyền đá mã não, tượng trưng cho sự may mắn,\nlà chất liệu trang sức rất được yêu thích\n",
    "T19.112.reqClassId": "|2|3|4|",
    "T19.112.name": "Dạ Linh Hạng Liên",
    "T19.112.reqClass": "|1|2|3|4|6|5|",
    "T19.112.description": "Dây chuyền xâu từ trân châu, đẹp mê hồn, mỗi hạt\ntrân châu đều được lấy từ đáy hồ Lê Dương\n",
    "T19.113.reqClassId": "|2|3|4|",
    "T19.113.name": "Phong Nguyệt Hạng Liên",
    "T19.113.reqClass": "|1|2|3|4|6|5|",
    "T19.113.description": "Băng tinh lam sắc thần bí, tựa như thiên thạch\nngoài vũ trụ\n",
    "T19.116.reqClassId": "|2|3|4|",
    "T19.116.name": "Tử Nguyệt Giới Chỉ",
    "T19.116.reqClass": "|1|2|3|4|6|5|",
    "T19.116.description": "Nhẫn đá ánh trăng màu tím, loại đá vô cùng hiếm\nthấy, tương truyền mặt trăng màu tím xuất hiện thì\nhạnh phúc sắp tới\n",
    "T19.117.reqClassId": "|2|3|4|",
    "T19.117.name": "Đan Tâm Giới Chỉ",
    "T19.117.reqClass": "|1|2|3|4|6|5|",
    "T19.117.description": "Bảo ThạchĐan Tâm tượng trưng trung thành, chuyển\ngiao sống chết thường truyền tặng nhẫn này, tượng\ntrưng vinh nhục cùng hưởng\n",
    "T19.118.reqClassId": "|2|3|4|",
    "T19.118.name": "Ngưng Bích Giới Chỉ",
    "T19.118.reqClass": "|1|2|3|4|6|5|",
    "T19.118.description": "Nhẫn phỉ thuý xanh ngọc bích trong suốt, có thể\nhấp thu sức mạnh tự nhiên\n",
    "T19.119.reqClassId": "|2|3|4|",
    "T19.119.name": "Ma Kim Giới Chỉ",
    "T19.119.reqClass": "|1|2|3|4|6|5|",
    "T19.119.description": "Nhẫn vàng có ma lực, tượng trưng phú quý\n",
    "T19.120.reqClassId": "|2|3|4|",
    "T19.120.name": "Thiên Cực Giới Chỉ",
    "T19.120.reqClass": "|1|2|3|4|6|5|",
    "T19.120.description": "Viên kim cương không tì vết của bắc cực trái đất,\ntổ tiên xưa đã rất vất vả khi tìm kiếm được viên\nkim cương làm ra nhẫn này\n",
    "T19.122.reqClassId": "|2|3|4|",
    "T19.122.name": "Bàn Long Trụy",
    "T19.122.reqClass": "|1|2|3|4|6|5|",
    "T19.122.description": "Trang sức có khắc hoa văn rồng ẩn chứa pháp lực\n",
    "T19.123.reqClassId": "|2|3|4|",
    "T19.123.name": "Bích Ngọc Linh",
    "T19.123.reqClass": "|1|2|3|4|6|5|",
    "T19.123.description": "Chuông làm bằng bích ngọc, âm thanh thánh thót tựa\nnhư chim sơn ca đang hót\n",
    "T19.124.reqClassId": "|2|3|4|",
    "T19.124.name": "Diệm Hỏa",
    "T19.124.reqClass": "|1|2|3|4|6|5|",
    "T19.124.description": "Màu đỏ tựa như ngọn lửa nhảy múa, là viên Bảo\nThạchđầy năng lượng được tìm thấy ở núi lửa sa mạc\n",
    "T19.125.reqClassId": "|2|3|4|",
    "T19.125.name": "Thất Bảo Tinh Thạch",
    "T19.125.reqClass": "|1|2|3|4|6|5|",
    "T19.125.description": "Dây chuyền được làm từ thất bảo, phật giáo có thất\nbảo:\nvàng, bạc, lưu li, mã não, hổ phách, san hô, sò\nđiệp\n",
    "T19.126.reqClassId": "|2|3|4|",
    "T19.126.name": "Bích Huyết Đan Tâm",
    "T19.126.reqClass": "|1|2|3|4|6|5|",
    "T19.126.description": "Bích huyết châu tâm chiếu gan thanh, là đá thần do\nmáu anh hùng tụ thành trong truyền thuyết\n",
    "T19.128.reqClassId": "|2|3|4|",
    "T19.128.name": "Si Tâm Thạch",
    "T19.128.reqClass": "|1|2|3|4|6|5|",
    "T19.128.description": "Tương truyền do nước mắt người con gái si mê tụ\nthành\n",
    "T19.130.reqClassId": "|2|3|4|",
    "T19.130.name": "Hoàng Ngọc Toản",
    "T19.130.reqClass": "|1|2|3|4|6|5|",
    "T19.130.description": "Hoàng cực mỹ bảo, là mỹ bảo so sánh với độ cứng\ncủa kim cương\n",
    "T19.131.reqClassId": "|2|3|4|",
    "T19.131.name": "Ma Âm Linh",
    "T19.131.reqClass": "|1|2|3|4|6|5|",
    "T19.131.description": "Chuông thần kỳ màu đỏ tươi, phát ra âm thanh huyết\nngọc có thể nhiếp hồn người\n",
    "T19.134.name": "Trường Đao",
    "T19.134.reqClass": "|6|",
    "T19.134.description": "Vũ khí thường dùng khi cướp bóc nhà dân của thổ\nphỉ, coi như kiếm sắc\n",
    "T19.135.name": "Trảm Yêu Kiếm",
    "T19.135.reqClass": "|6|",
    "T19.135.description": "Kiếm sắc trên thân có đúc hoa văn nổi, nghe nói có\nthể chế ngự ma pháp của yêu quái\n",
    "T19.136.name": "Thị Huyết Đao",
    "T19.136.reqClass": "|6|",
    "T19.136.description": "Thân đao có màu đỏ máu, tựa như ác ma khát máu,\nmột khi khai đao là phải có máu rơi\n",
    "T19.137.name": "Phi Ngư Kiếm",
    "T19.137.reqClass": "|6|",
    "T19.137.description": "Bảo kiếm tạo thành có thân hình giống cá kiếm, tạo\nhình đặc biệt khiến kiếm rút ra rất nhanh, vô cùng\nsắc bén\n",
    "T19.138.name": "Bách Luyện Đao",
    "T19.138.reqClass": "|6|",
    "T19.138.description": "Tinh luyện từ nhiều loại thép, tuy thân đao nặng,\nnhưng xuất chiêu rất nhẹ nhàng, một vũ khí nên có\n",
    "T19.139.name": "Lang Nha Bổng",
    "T19.139.reqClass": "|5|",
    "T19.139.description": "Thân gậy nặng, lưỡi dao bén, dính cái này lên cổ\nthì chẳng ai thích tý nào\n",
    "T19.140.name": "Tượng Nha Bổng",
    "T19.140.reqClass": "|5|",
    "T19.140.description": "Làm từ ngà voi ma mút quý hiếm, người sưu tầm nó\nnhiều hơn người dùng nó làm vũ khí\n",
    "T19.141.name": "Vẫn Thiết Bổng",
    "T19.141.reqClass": "|5|",
    "T19.141.description": "Luyện từ thiên thạch, nặng cứng không dễ phá hỏng,\nlực tấn công thì gậy thông thường không thể so\nsánh\n",
    "T19.142.name": "Hợp Kim Chiến Bổng",
    "T19.142.reqClass": "|5|",
    "T19.142.description": "Chất liệu đặc biệt + công nghệ kỹ thuật gần như\nhoàn mỹ = ? Khi dùng nó bạn sẽ cảm nhận được thôi\n",
    "T19.143.name": "Thực Mộc Cầm",
    "T19.143.reqClass": "|2|",
    "T19.143.description": "Đàn là nhạc cụ gia tộc Liêu Vân thường dùng khi\nluyện tập, tạo hình đơn giản\n",
    "T19.144.name": "D Âm Cầm",
    "T19.144.reqClass": "|2|",
    "T19.144.description": "Đàn chuyên dùng để biểu diễn âm D, chất liệu độc\nđáo và kỹ nghệ tinh tế, năng lực biểu hiện âm D\nxuất sắc, có ấn tượng sâu sắc\n",
    "T19.145.name": "Giả Âm Cầm",
    "T19.145.reqClass": "|2|",
    "T19.145.description": "Đàn có thể mô phỏng rất nhiều âm thanh, năng lực\nmô phỏng ưu tú, phá vỡ nhiều quy định cũ, trở\nthành đi đầu trong rất nhiều trường hợp\n",
    "T19.146.name": "Cổ Phong Cầm",
    "T19.146.reqClass": "|2|",
    "T19.146.description": "Đàn làm từ gỗ cổ phong, gỗ cổ phong thể hiện vị\ntrí và thực lực của kẻ sở hữu nó\n",
    "T19.147.name": "Cát Phổ Tái Cầm",
    "T19.147.reqClass": "|2|",
    "T19.147.description": "Đàn của Cát Phổ Hàn Nhân, là nhạc cụ luôn theo bên\nngười của những kẻ yêu âm nhạc\n",
    "T19.148.name": "Tử Tinh Cầm",
    "T19.148.reqClass": "|2|",
    "T19.148.description": "Đàn làm từ thuỷ tinh tím và công nghệ tinh xảo, âm\nthanh rung động lòng người, tất cả thể hiện sự hoa\nlệ điển nhã\n",
    "T19.149.name": "Tam Lăng Chùy",
    "T19.149.reqClass": "|6|",
    "T19.149.description": "Vũ khí phòng thân trên chiến trường, tạo hình ba\ngóc đặc biệt\n",
    "T19.150.name": "Mai Hoa Chủy Thủ",
    "T19.150.reqClass": "|6|",
    "T19.150.description": "Làm từ thép tinh, toàn thân điểm xuyết hoa mai,\nvừa đẹp vừa sắc\n",
    "T19.151.name": "Liễu Diệp Chủy Thủ",
    "T19.151.reqClass": "|6|",
    "T19.151.description": "Phần thân rộng phẳng, trên thân có điểm ánh sáng\ntrắng, khiến người khác không lạnh mà vẫn run\n",
    "T19.152.name": "Truy Mệnh Chủy Thủ",
    "T19.152.reqClass": "|6|",
    "T19.152.description": "Uy lực bất phàm, vô cùng sắc nhọn\n",
    "T19.153.name": "Dịch Cốt Chủy Thủ",
    "T19.153.reqClass": "|6|",
    "T19.153.description": "Nhìn rất bình thường nhưng vô cùng sắc, làm kẻ\nđịch trọng thương bằng cách trực tiếp cắt đứt\nxương\n",
    "T19.154.name": "Ni Cầm Cung",
    "T19.154.reqClass": "|2|",
    "T19.154.description": "Dây đàn bằng nylon, đơn giản, không hoa lệ nhưng\nrất thực dụng\n",
    "T19.155.name": "Mã Vĩ Cầm Cung",
    "T19.155.reqClass": "|2|",
    "T19.155.description": "Đuôi ngựa là chất liệu làm dây đàn tiêu chuẩn, âm\nsắc tuyệt vời\n",
    "T19.156.name": "Loan Mộc Cầm Cung",
    "T19.156.reqClass": "|2|",
    "T19.156.description": "Dùng gỗ dẻo bẻ cong làm dây đàn, nghe nói chất\nliệu này chỉ có ở ngọn núi phía sau gia tộc Liêu\nVân\n",
    "T19.157.name": "Sức Ngân Cầm Cung",
    "T19.157.reqClass": "|2|",
    "T19.157.description": "Dây đàn gỗ có đính trang sức bạc, khi kéo đàn ánh\nbạc phản chiếu lên mặt người, đẹp mê hồn\n",
    "T19.158.name": "Tự Nhiên Cầm Cung",
    "T19.158.reqClass": "|2|",
    "T19.158.description": "Dây đàn làm theo công thức từ thời xa xưa, theo\nđuổi khí chất tự nhiên thuần tuý, hình dạng cổ\nquái, âm thanh trong trẻo tươi mới\n",
    "T19.159.name": "Thủy Tinh Cầm Cung",
    "T19.159.reqClass": "|2|",
    "T19.159.description": "Dây đàn làm từ thuỷ tinh, tương truyền có chứa\ntinh thạch của trái đất, có sức mạnh thần kỳ\n",
    "T19.160.name": "Phân Chỉ Thủ",
    "T19.160.reqClass": "|5|",
    "T19.160.description": "Găng tay thông thường, trên đường phố lúc nào cũng\nnhìn thấy\n",
    "T19.161.name": "Động Năng Thủ",
    "T19.161.reqClass": "|5|",
    "T19.161.description": "Găng tay to dày nặng, tương tự như găng bóng chày\n",
    "T19.162.name": "Thiểm Linh Thủ",
    "T19.162.reqClass": "|5|",
    "T19.162.description": "Găng tay thường dùng của chiến sỹ, chống ma sát,\ntăng cường lực phòng thủ\n",
    "T19.163.name": "Lục Lân Thủ",
    "T19.163.reqClass": "|5|",
    "T19.163.description": "Găng tay dệt từ mảnh vảy kỳ lân, đeo vào vừa tay,\nbảo vệ tay\n",
    "T19.164.name": "Phục Ma Thủ",
    "T19.164.reqClass": "|5|",
    "T19.164.description": "Làm từ da linh thú, đeo vào làm giảm tính ác quái\nthú\n",
    "T19.165.name": "Du Hiệp Thủ",
    "T19.165.reqClass": "|5|",
    "T19.165.description": "Găng tay tinh tế tu luyện nhiều nơi trên trái đất,\nlực phòng ngự xuất sắc có thể ứng biến các tình\nhuống đột phát\n",
    "T19.170.name": "Tiểu Mộc Chùy",
    "T19.170.reqClass": "|1|",
    "T19.170.description": "Vũ khí nhập môn của đệ tử Đông Huyền\n",
    "T19.179.name": "Tân Thủ Thư",
    "T19.179.reqClass": "|3|",
    "T19.179.description": "Trang bị nhập môn của đệ tử Đông Huyền\n",
    "T19.189.name": "Thái Khang Kiếm",
    "T19.189.reqClass": "|6|",
    "T19.189.description": "Tác phẩm của thợ nổi tiếng Đông Huyền, đương thời\nlà một cao thủ dùng kiếm, dốc nửa cuộc đời để đúc\nra.\n",
    "T19.197.name": "Huyền Thạch Kiếm",
    "T19.197.reqClass": "|6|",
    "T19.197.description": "Kiếm nặng hơn trăm cân, khí thế khi múa võ làm\nngười thất kinh, có khả năng phá núi\n",
    "T19.198.name": "Hạt Ma Kiếm",
    "T19.198.reqClass": "|6|",
    "T19.198.description": "Truyền thuyết kiếm này phong ấn sức mạnh cực lớn\ncủa ma quỷ ngàn đời, kiếm mang lời nguyền\n",
    "T19.199.name": "Hỏa Tinh Kiếm",
    "T19.199.reqClass": "|6|",
    "T19.199.description": "Chất liệu quý hiếm, tạo hình dị thường, năng lực\nkhó đoán\n",
    "T19.201.name": "Tân Nhân Trượng",
    "T19.201.reqClass": "|3|",
    "T19.201.description": "Vũ khí nhập môn của đệ tử Đông Huyền\n",
    "T19.202.name": "Tiểu Đề Cầm",
    "T19.202.reqClass": "|2|",
    "T19.202.description": "Vũ khí nhập môn của đệ tử Đông Huyền\n",
    "T19.203.name": "Tiểu Mộc Bổng",
    "T19.203.reqClass": "|5|",
    "T19.203.description": "Vũ khí nhập môn của đệ tử Đông Huyền, vật phải có\nkhi giặt quần áo, đánh nhau, chơi bóng chày\n",
    "T19.204.name": "Tân Thủ Súng",
    "T19.204.reqClass": "|4|",
    "T19.204.description": "Vũ khí nhập môn của đệ tử Đông Huyền, chống rung\nđộng cao, kêu to doạ người dùng\n",
    "T19.208.name": "Thiết Kiếm",
    "T19.208.reqClass": "|6|",
    "T19.208.description": "Vũ khí nhập môn của đệ tử Đông Huyền, đừng để bị\nrỉ nhé\n",
    "T19.209.name": "Tân Thủ Thuẫn",
    "T19.209.reqClass": "|1|",
    "T19.209.description": "Vũ khí vào cửa luyện tập của Đông Huyền đời mới\n",
    "T19.210.name": "Tân Thủ Cầm Cung",
    "T19.210.reqClass": "|2|",
    "T19.210.description": "Vũ khí nhập môn của đệ tử Đông Huyền\n",
    "T19.232.name": "Phá Sơn Phủ",
    "T19.232.reqClass": "|1|",
    "T19.232.description": "Rìu này nổi tiếng với chiêu \"nhất phủ khai sơn\",\nsức mạnh của người sử dụng ảnh hưởng đến tính năng\ncủa rìu\n",
    "T19.236.name": "Cực Quang Chùy",
    "T19.236.reqClass": "|1|",
    "T19.236.description": "Làm kẻ địch bị thương trong nháy mắt, tốc độ\nnhanh, khả năng tấn công không thể xem thường\n",
    "T19.244.name": "Ngũ Tinh Chùy",
    "T19.244.reqClass": "|1|",
    "T19.244.description": "Luyện từ hắc kim, uy lực lớn ẩn dưới vỏ ngoài đẹp\nmắt\n",
    "T19.263.name": "Phong Thần Trượng",
    "T19.263.reqClass": "|3|",
    "T19.263.description": "Thần trượng thao túng gió, do một vị đại sư sử\ndụng phong thần vĩ đại nhất lịch sử liêu vân\n",
    "T19.268.name": "Thánh Linh Trượng",
    "T19.268.reqClass": "|3|",
    "T19.268.description": "Trong truyền thuyết người tài trí mới dùng được\ncây trượng này, uy lực vô biên, nhưng có sức mạnh\nlời nguyền\n",
    "T19.273.name": "Tự Nhiên Trượng",
    "T19.273.reqClass": "|3|",
    "T19.273.description": "Cây trượng tinh thạch hình thành từ tự nhiên\n",
    "T19.294.name": "Xuân Lôi Cầm",
    "T19.294.reqClass": "|2|",
    "T19.294.description": "Tiếng đàn tựa như sấm dậy mùa xuân, âm đàn tuy\nkhông cao nhưng khả năng xuyên thấu mạnh, là một\ncây đàn quý hiếm\n",
    "T19.299.name": "Phiêu Diêu Cầm",
    "T19.299.reqClass": "|2|",
    "T19.299.description": "Âm thanh nhẹ nhàng phiêu dật, không chỉ rõ ràng mà\ncòn khiến người ngất ngây\n",
    "T19.304.name": "Xích Tinh Thánh Cầm",
    "T19.304.reqClass": "|2|",
    "T19.304.description": "Danh đàn nổi tiếng, được làm từ Xích tinh, âm đàn\ntrầm bổng, khiến người mê loạn\n",
    "T19.322.name": "Long Thần Tháp Thuẫn",
    "T19.322.reqClass": "|1|",
    "T19.322.description": "Khiên phong ấn sức mạnh của Rồng. Mỗi lần bị công\nkích đều phản xạ một phần thương tích cho kẻ địch.\nĐây là vũ khí sát nhân tiềm ẩn.\n",
    "T19.327.name": "Vương Giả Thuẫn",
    "T19.327.reqClass": "|1|",
    "T19.327.description": "Được người đầu tiên tại đại lục Vô Ưu được tôn anh\nhùng sử dụng qua. Khiên có thể ban cho người sử\ndụng dũng khí lớn\n",
    "T19.330.name": "Thánh Chiến Thuẫn",
    "T19.330.reqClass": "|1|",
    "T19.330.description": "Một trong những tiêu chí hiển vinh nhất của thánh\nchiến giả. Đây là tấm khiên phòng hộ lý tưởng\nnhất, chỉ có những chiến binh có chiến tích lẫy\nlừng mới có thể sở hữu\n",
    "T19.515.reqClassId": "|1|5|6|",
    "T19.515.name": "Thiết Quyền Hạng Liên",
    "T19.515.reqClass": "|1|2|3|4|6|5|",
    "T19.515.description": "Kim cương trên hạng liên có hình nắm tay nắm chặt,\nsức mạnh thập toàn kỳ mỹ\n",
    "T19.516.reqClassId": "|1|5|6|",
    "T19.516.name": "Nguyệt Chiến Hạng Liên",
    "T19.516.reqClass": "|1|2|3|4|6|5|",
    "T19.516.description": "Nguyệt Chiến Bảo Thạch làm mặt dây chuyền. Truyền\nthuyết, dây chuyền do Đông Huyền - Tích Thiên trảm\nnguyệt đoạt được\n",
    "T19.517.reqClassId": "|1|5|6|",
    "T19.517.name": "Ngưng Huyết Hạng Liên",
    "T19.517.reqClass": "|1|2|3|4|6|5|",
    "T19.517.description": "Theo tin đồn, người đầu tiên đeo dây chuyền này,\nmỗi lần giết chết kẻ địch đều dùng máu tươi để\nnhuộm vào dây. Dần dần, dây chuyền mới có hình\ndạng như ngày nay\n",
    "T19.518.reqClassId": "|1|5|6|",
    "T19.518.name": "Quang Mang Hạng Liên",
    "T19.518.reqClass": "|1|2|3|4|6|5|",
    "T19.518.description": "Quang mang lóng lánh, huyền ảo của Dạ Minh Châu\ntỏa sáng dưới tinh không\n",
    "T19.519.reqClassId": "|1|5|6|",
    "T19.519.name": "Hàn Sương Hạng Liên",
    "T19.519.reqClass": "|1|2|3|4|6|5|",
    "T19.519.description": "Thuỷ tinh lam sắc thần bí, nghe nói có sức mạnh\nđóng băng toàn thế giới\n",
    "T19.520.reqClassId": "|1|5|6|",
    "T19.520.name": "Kỳ Lân Hạng Liên",
    "T19.520.reqClass": "|1|2|3|4|6|5|",
    "T19.520.description": "Dây chuyền làm từ vẩy kỳ lân, một trong năm thần\nthú cổ đại, có sức mạnh không thể ngờ tới\n",
    "T19.521.reqClassId": "|1|5|6|",
    "T19.521.name": "Minh Thiền Giới Chỉ",
    "T19.521.reqClass": "|1|2|3|4|6|5|",
    "T19.521.description": "Mỗi lần vung lên đều phát ra âm thanh như tiếng ve\nkêu rả rích\n",
    "T19.522.reqClassId": "|1|5|6|",
    "T19.522.name": "Long Huyết Giới Chỉ",
    "T19.522.reqClass": "|1|2|3|4|6|5|",
    "T19.522.description": "Dung nhập Long Huyết trong quá trình tu luyện cuối\ncùng có thể sở hữu ma lực\n",
    "T19.523.reqClassId": "|1|5|6|",
    "T19.523.name": "Tử Tinh Giới Chỉ",
    "T19.523.reqClass": "|1|2|3|4|6|5|",
    "T19.523.description": "Nhẫn đá mặt trăng màu tím, loại đá vô cùng hiếm\nthấy, nghe đồn mặt trăng màu tím xuất hiện thì\nhạnh phúc sắp tới\n",
    "T19.524.reqClassId": "|1|5|6|",
    "T19.524.name": "Lục Phong Giới Chỉ",
    "T19.524.reqClass": "|1|2|3|4|6|5|",
    "T19.524.description": "Nhẫn phỉ thuý xanh ngọc bích, là phỉ thuý trong\nsuốt, có thể hấp thu sức mạnh tự nhiên\n",
    "T19.525.reqClassId": "|1|5|6|",
    "T19.525.name": "Tinh Vũ Giới Chỉ",
    "T19.525.reqClass": "|1|2|3|4|6|5|",
    "T19.525.description": "Tinh Vũ là tinh thần võ sĩ được truyền lưu hàng\ntrăm năm, thân là võ sĩ phải lấy tinh thần Tinh Vũ\nlàm tôn chỉ\n",
    "T19.526.reqClassId": "|1|5|6|",
    "T19.526.name": "Vũ Tôn Giới Chỉ",
    "T19.526.reqClass": "|1|2|3|4|6|5|",
    "T19.526.description": "Vũ Tôn là cảnh giới cao nhất của võ sĩ, chỉ có\nngười đạt đến loại cảnh giới này mới đủ tư cách\nđeo giới chỉ này\n",
    "T19.527.reqClassId": "|1|5|6|",
    "T19.527.name": "Kim Cương Khuyên",
    "T19.527.reqClass": "|1|2|3|4|6|5|",
    "T19.527.description": "Bảo vật của Thái Thượng Lão Quân, có thể to nhỏ\ntùy ý, theo truyền thuyết có năng lực bắt giữ tiên\nnhân\n",
    "T19.528.reqClassId": "|1|5|6|",
    "T19.528.name": "Long Ngân",
    "T19.528.reqClass": "|1|2|3|4|6|5|",
    "T19.528.description": "Bảo thạch điêu khắc hình rồng, bên trong có ẩn\nchứa long lực\n",
    "T19.529.reqClassId": "|1|5|6|",
    "T19.529.name": "Lãnh Thúy Linh",
    "T19.529.reqClass": "|1|2|3|4|6|5|",
    "T19.529.description": "Chiếc chuông được chạm trổ từ Thúy Sắc Lãnh Ngọc\nlấy từ hồ băng ngàn năm. Thanh âm có thể hoán tỉnh\nlinh hồn\n",
    "T19.530.reqClassId": "|1|5|6|",
    "T19.530.name": "Hỏa Vũ",
    "T19.530.reqClass": "|1|2|3|4|6|5|",
    "T19.530.description": "Hỏa nguyên tố nhảy múa phảng phất như vật sống\n",
    "T19.531.reqClassId": "|1|5|6|",
    "T19.531.name": "Phúc Tinh Bảo Thạch",
    "T19.531.reqClass": "|1|2|3|4|6|5|",
    "T19.531.description": "Đây là một khối phúc tinh thạch hiếm có trên thế\ngian, sức mạnh tiềm ẩn trong nó có thể giúp võ sĩ\nnhanh chóng tăng tốc độ luyện tập võ công\n",
    "T19.532.reqClassId": "|1|5|6|",
    "T19.532.name": "Thiên Tâm Vô Cực",
    "T19.532.reqClass": "|1|2|3|4|6|5|",
    "T19.532.description": "Theo truyền thuyết chỉ có người có duyên mới có\nthể thu được vật này và đạt được vô tận năng lực\n",
    "T19.533.reqClassId": "|1|5|6|",
    "T19.533.name": "Long Mang",
    "T19.533.reqClass": "|1|2|3|4|6|5|",
    "T19.533.description": "Đồ trang sức vân rồng, ẩn chứa long lực\n",
    "T19.535.reqClassId": "|2|3|4|",
    "T19.535.name": "Long Nha Tỏa",
    "T19.535.reqClass": "|1|2|3|4|6|5|",
    "T19.535.description": "Khoá chế tạo từ răng rồng, từ khi chế tạo thành\nvẫn không có chìa khóa để mở. Nghe nói chỉ có\nngười đại trí tuệ mới có thể mở khóa này\n",
    "T19.536.reqClassId": "|1|5|6|",
    "T19.536.name": "Võ Sĩ Tâm",
    "T19.536.reqClass": "|1|2|3|4|6|5|",
    "T19.536.description": "Tượng trưng cho lòng quyết tâm theo đuổi đến cùng\ncủa võ sĩ\n",
    "T19.537.reqClassId": "|1|5|6|",
    "T19.537.name": "Ngưng Lam Quyết",
    "T19.537.reqClass": "|1|2|3|4|6|5|",
    "T19.537.description": "Lam ngọc thiên nhiên, mặt trên theo năm tháng được\ntự nhiên khắc họa thành hình Âm dương thái cực\n",
    "T19.539.reqClassId": "|2|3|4|",
    "T19.539.name": "Bích Thủy Thái Cực",
    "T19.539.reqClass": "|1|2|3|4|6|5|",
    "T19.539.description": "Thủy tinh xanh biếc được tự nhiên tạo thành, có\nhình Thái Cực\n",
    "T19.540.reqClassId": "|1|5|6|",
    "T19.540.name": "Thuẫn Hình Toản",
    "T19.540.reqClass": "|1|2|3|4|6|5|",
    "T19.540.description": "Khiên hình viên ngọc được chế từ Hoàng cực ngọc\nthạch, độ cứng có thể so với kim cương\n",
    "T19.541.reqClassId": "|1|5|6|",
    "T19.541.name": "Phúc Tinh Tỏa",
    "T19.541.reqClass": "|1|2|3|4|6|5|",
    "T19.541.description": "Ổ khoá vàng tràn đầy phúc khí, là vật năm xưa võ\nsĩ Phúc Tinh thường đeo\n",
    "T19.542.reqClassId": "|2|3|4|",
    "T19.542.name": "Phúc Nguyên Kim Tỏa",
    "T19.542.reqClass": "|1|2|3|4|6|5|",
    "T19.542.description": "Phúc nguyên thâm hậu, kim tỏa là vật truyền thừa\ncủa cổ gia tộc truyền lại tượng trưng cho phúc khí\n",
    "T19.543.reqClassId": "|1|5|6|",
    "T19.543.name": "Vô Tận Huyết Sắc",
    "T19.543.reqClass": "|1|2|3|4|6|5|",
    "T19.543.description": "Chiếc chuông huyết sắc, theo truyền thuyết có thể\nkhiến võ sĩ tẩu hoả nhập ma. Nếu có thể vượt qua\nma chú này thì sẽ trở thành chí tôn\n",
    "T19.545.name": "Khinh Bì Mão",
    "T19.545.reqClass": "|2|",
    "T19.545.description": "Được chế tạo từ da động vật, không những nhẹ nhàng\ntiện dụng mà còn thể chống được phong hàn\n",
    "T19.546.name": "Nhạn Linh Mão",
    "T19.546.reqClass": "|2|",
    "T19.546.description": "Được làm từ lông vũ của chim nhạn, vì thế hết sức\nmềm mại, nhẹ nhàng và sở hữu khả năng phòng ngự\nđáng kể\n",
    "T19.547.name": "Tinh Linh Mão",
    "T19.547.reqClass": "|2|",
    "T19.547.description": "Các thương nhân vì muốn kiếm lời nên đã mô phỏng\nchế tạo theo trang bị chiến đấu của Tinh Linh Tộc,\ntất nhiên chất lượng không thể tốt bằng\n",
    "T19.548.name": "Quý Tộc Mão",
    "T19.548.reqClass": "|2|",
    "T19.548.description": "Trang phục của quý tộc, hoa lệ và cá tính, phô\ntrương sự vô tận về tài phú cùng quyền lực\n",
    "T19.549.name": "Linh Động Mão",
    "T19.549.reqClass": "|2|",
    "T19.549.description": "Được dệt từ một loại gấm vô danh, nhẹ nhàng phiêu\ndật, bề ngoài nhìn có vẻ mỏng manh nhưng rất bền\n",
    "T19.550.name": "Tước Sĩ Mão",
    "T19.550.reqClass": "|2|",
    "T19.550.description": "Tầng lớp quý tộc thượng lưu thường sử dụng, màu\nsắc đẹp và sáng, khả năng phòng hộ tốt\n",
    "T19.551.name": "Miên Bố Mão",
    "T19.551.reqClass": "|3|",
    "T19.551.description": "Được dệt từ vải bông mà đa số người dân thường\ndùng\n",
    "T19.552.name": "Dương Bì Mão",
    "T19.552.reqClass": "|3|",
    "T19.552.description": "Được làm từ lông cừu, ấm áp thực dụng nhưng khả\nnăng phòng ngự rất bình thường\n",
    "T19.553.name": "Kim Ty Mão",
    "T19.553.reqClass": "|3|",
    "T19.553.description": "Được dệt từ tơ vàng, giá thành cao, hiệu quả phòng\nngự rất tốt\n",
    "T19.554.name": "Chúc Phúc Mão",
    "T19.554.reqClass": "|3|",
    "T19.554.description": "Vốn là trang bị làm từ chất liệu thông thường\nnhưng sau khi được pháp sư chúc phúc thì hiệu quả\nhoàn toàn khác\n",
    "T19.555.name": "Nhân Từ Mão",
    "T19.555.reqClass": "|3|",
