    "T35.2444.name": "Sứ Giả Tiếp Đón",
    "T35.2445.onServiceText": "Nơi này là Cánh cổng chân lý, có 4 con quái thú,\nnhưng chỉ có 1 con nói thật. Hãy dựa vào trí thông\nminh của mình để tìm ra con đường đúng mà rời khỏi\nđây nhé.",
    "T35.2445.name": "Huyền Nội Lão Nhân",
    "T35.2447.name": "Trói Buộc",
    "T35.2448.name": "Cảm Ân",
    "T35.2449.name": "Tuế Nguyệt",
    "T35.2450.name": "Chân Lý",
    "T35.2451.onServiceText": "Bất kỳ ai đều có thể rời khỏi đây, chỉ cần trong\nlòng có Hy Vọng thì sẽ nhận được Quang Minh",
    "T35.2451.name": "Nấm Kỳ Quái",
    "T35.2452.onServiceText": "Hãy tự tin, cứ quẹo phải, đừng quay đầu là ngươi\ncó thể rời khỏi đây.",
    "T35.2452.name": "Bánh Mật Kỳ Quái",
    "T35.2453.onServiceText": "Trên đường đi sẽ có nhiều quái thú nhắc nhở ngươi\nnhưng cũng có thể gạt ngươi, đừng tin vào chúng.",
    "T35.2453.name": "Pyocomon Kỳ Quái",
    "T35.2454.onServiceText": "Ở đây có 1 mê cung kỳ quái, cơ bản sẽ không có\ncổng chuyển dịch rời khỏi đây vì nó đã được giấu\nđi. Ngươi phải phá được cơ quan thì mới mở được",
    "T35.2454.name": "Tiểu Hổ Kỳ Quái",
    "T35.2455.name": "Nấm Vương Thánh Linh (lv155)",
    "T35.2456.name": "Rồng Xanh Gian Ác (lv155)",
    "T35.2457.name": "Chuột Tinh Linh (lv160)",
    "T35.2458.name": "Huyết Tộc Vương (lv160)",
    "T35.2459.scriptOff": "if(fromBF){\tvar script_npc_level = 145;\tvar\nspript_loot = rand3(1, 100);\tvar\nscript_midObj = {1:1,2:12}; \tif(spript_loot <\n5)\t{\t\tif( c )\t\t{\t\t\tif(c.inGroup())\n\t\t\t{\t\t\t\tscript_node =\nc.memberList.head;\t\t\t}\t\t\telse \t\t\t{\t\t\t\tscript_node\n= {};\t\t\t\tscript_node.obj =\nc.data.id;\t\t\t}\t\t\twhile(script_node !=\nnull)\t\t\t{\t\t\t\tvar spt_player = getCharactor(\nscript_node.obj );\t\t\t\tvar spt_index = rand3(1,2);\n\t\t\t\t\tif(minus(spt_player.level,script_npc_level) >\n10 ||spt_player.level<80)\t\t\t\t\t\t{\t\t\t\t\t\trequire =\ntrue;\t\t\t\t\t}\t\t\t\t\telse\t\t\t\t\t{\t\t\t\t\t\t_addMedalInBag(script_node.obj,\nscript_midObj[spt_index], true);\t\t\t\t\tif\n(inRate(2))\t\t\t\t\t{\t\t\t\t\t\tvar num\n=100;\t\t\t\t\t\taddStoneSealPointDirectly(script_node.obj,\nnum);\t\t\t\t\t}\t\t\t\t\t}\t\t\t\tscript_node =\nscript_node.next;\t\t\t}\t\t}\t}\tif(inRate(10))\t{\t\tif( c\n)\t\t{\t\t\tif(c.inGroup()) \t\t\t{\t\t\t\tscript_node =\nc.memberList.head;\t\t\t}\t\t\telse \t\t\t{\t\t\t\tscript_node\n= {};\t\t\t\tscript_node.obj =\nc.data.id;\t\t\t}\t\t\twhile(script_node !=\nnull)\t\t\t{\t\t\t\tif\n(inRate(50))\t\t\t\t{\t\t\t\t\taddItem(script_node.obj, 29,\n5565, 1 , 0, 0, \"\", null);\t\t\t\t}\t\t\t\tscript_node =\nscript_node.next;\t\t\t}\t\t}\t}}",
    "T35.2459.subType": "all",
    "T35.2459.name": "Nấm Vương Thánh Linh (lv155)",
