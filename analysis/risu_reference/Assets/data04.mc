    "T129.1.name": "Điểm đầu",
    "T129.2.name": "Điểm cuối",
    "T129.3.name": "Điểm giữa",
    "T129.4.name": "Bảo rương nhỏ",
    "T129.4.tip": "Bảo vật ẩn chứa trong Bí Cảnh, người may mắn mới\nmở được.\nNgẫu nhiên mở được: 100 Kết Tinh Thần Dụ, nguyên\nliệu cấp 4.",
    "T129.5.name": "Bảo rương trung",
    "T129.5.tip": "Bảo vật ẩn chứa trong Bí Cảnh, người may mắn mới\nmở được.\nNgẫu nhiên mở được: 100 Kết Tinh Thần Dụ, nguyên\nliệu cấp 5, Tinh Hồn Linh Giáp.",
    "T129.6.name": "Bảo rương lớn",
    "T129.6.tip": "Bảo vật lớn ẩn chứa trong Bí Cảnh, phải người kiên\ntrì mới mở được.\nNgẫu nhiên mở được: lượng lớn Kết Tinh Thần Dụ,\nbảo thạch thượng hạng, Tẩy Tủy Đan cao cấp",
    "T129.7.name": "Ô đấu",
    "T129.7.tip": "Đây là vùng đất trong Bí Cảnh bị những kẻ lang\nthang chiếm đóng, ai bước vào không có mạng trở\nra.",
    "T129.8.name": "Ô Đại Thánh",
    "T129.8.tip": "Đây vật độc thường thấy trong Bí Cảnh, đối với\nnhững kẻ ngoại lai nó đều tỏ vẻ không lương thiện.",
    "T129.9.name": "Ô Đại Thánh",
    "T129.9.tip": "Sở hữu sức mạnh thần kỳ, làm mê hoặc lòng người",
    "T129.10.name": "Ô Đại Thánh",
    "T129.10.tip": "Sự tồn tại thần bí trong Bí Cảnh, tốt nhất là tìm\nđường khác mà đi.",
    "T129.11.name": "Chuyển trận",
    "T129.11.tip": "Lực không gian không ổn định, bất cứ vật nào tiếp\ncận đều sẽ bị đẩy đi 1 nơi khác.",
    "T129.12.name": "Ô bạc",
    "T129.12.tip": "Ngẫu nhiên nhận 1 lượng ngân phiếu",
    "T129.13.name": "Minigame",
    "T129.13.tip": "Chức năng chưa mở!",
    "T129.14.name": "Ô Exp",
    "T129.14.tip": "Ngẫu nhiên nhận 1 lượng exp",
    "T129.15.name": "Ô lò xo",
    "T129.15.tip": "Đưa về điểm xuất phát",
    "T129.16.name": "Bẫy 1 - Kẹp",
    "T129.16.tip": "Kẹp bắt heo, đạp trúng bất động 1 khoảng thời gian",
    "T129.17.name": "Bẫy 1 - Bẫy",
    "T129.17.tip": "Giếng sâu, rớt vào sẽ không thể di chuyển",
    "T129.18.name": "Bẫy 3 - Trói Cương Thi",
    "T129.18.tip": "Khi bước chân vào 1 nơi xa lạ, không biết chân\nngười sẽ ra sao",
    "T129.19.name": "Bẫy 4 - Bắt Alien",
    "T129.19.tip": "Với kinh nghiệm nghiên cứu sinh vật ngàn năm qua,\nloại ngươi vừa bắt rất thích hợp làm đối tượng\nnghiên cứu",
