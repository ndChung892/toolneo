    "T45.5432.name": "Vong Linh Thuẫn",
    "T45.5432.aScriptText": "Ngẫu nhiên nhận được 2 nguyên liệu trang bị và 1\nLệnh bài treo thưởng, phẩm chất nhiệm vụ càng cao\n(trắng<lục<xanh<tím) thì xác suất nhận được nguyên\nliệu cấp cao càng cao",
    "T45.5433.info": "Tiêu diệt 1 Tử Vong Trảo, sau đó quay về tìm Vệ Sĩ\nTinh LinhThành",
    "T45.5433.reqClass": "all",
    "T45.5433.subType": "9-15",
    "T45.5433.startText": "Tử Vong Trảo ở Cổ Thành thường xuyên quấy nhiễu cư\ndân, hãy mau tiêu diệt chúng",
    "T45.5433.completeText": "Đã an toàn, cảm ơn ngươi!",
    "T45.5433.name": "Tử Vong Trảo",
    "T45.5433.aScriptText": "Ngẫu nhiên nhận được 2 nguyên liệu trang bị và 1\nLệnh bài treo thưởng, phẩm chất nhiệm vụ càng cao\n(trắng<lục<xanh<tím) thì xác suất nhận được nguyên\nliệu cấp cao càng cao",
    "T45.5434.info": "Tiêu diệt 30 Nhện Độc Đỏ, sau đó quay về tìm Vệ Sĩ\nTinh LinhThành",
    "T45.5434.reqClass": "all",
    "T45.5434.subType": "9-15",
    "T45.5434.startText": "Vệ Sĩ cho biết ở Đăng Vân Địa, các ma quỷ đang\nhoành hành. Mọi người phải cố gắng đánh đuổi chúng\nđi!",
    "T45.5434.completeText": "Cảm ơn ngươi!",
    "T45.5434.name": "Nhện Độc Đỏ",
    "T45.5434.aScriptText": "Ngẫu nhiên nhận được 2 nguyên liệu trang bị và 1\nLệnh bài treo thưởng, phẩm chất nhiệm vụ càng cao\n(trắng<lục<xanh<tím) thì xác suất nhận được nguyên\nliệu cấp cao càng cao",
    "T45.5435.info": "Tiêu diệt 30 Hỏa Cơ Giáp, sau đó quay về tìm Vệ Sĩ\nTinh LinhThành",
    "T45.5435.reqClass": "all",
    "T45.5435.subType": "9-15",
    "T45.5435.startText": "Vệ Sĩ cho biết ở Đăng Vân Địa, các ma quỷ đang\nhoành hành. Mọi người phải cố gắng đánh đuổi chúng\nđi!",
    "T45.5435.completeText": "Cảm ơn ngươi!",
    "T45.5435.name": "Hỏa Cơ Giáp",
    "T45.5435.aScriptText": "Ngẫu nhiên nhận được 2 nguyên liệu trang bị và 1\nLệnh bài treo thưởng, phẩm chất nhiệm vụ càng cao\n(trắng<lục<xanh<tím) thì xác suất nhận được nguyên\nliệu cấp cao càng cao",
    "T45.5452.info": "Giúp Thợ Săn Muỗi giáo huấn Quân Đoàn Muỗi",
    "T45.5452.reqClass": "all",
    "T45.5452.startText": "Thời khắc sinh tử đã đến, lần này hãy để cho bọn\nQuân Đoàn Muỗi thấy được lợi hại của cư dân Đại\nLục Vô Ưu chúng ta.",
    "T45.5452.completeText": "Người chính là Thần Cứu Sinh của Đại Lục Vô Ưu!",
    "T45.5452.name": "Thích Sát Muỗi Đại Vương",
    "T45.5452.aScriptText": "Phần thưởng kinh nghiệm và ngân phiếu",
    "T45.5453.info": "Tiến về Vĩnh Dạ Cảng, tìm gặp Thợ Săn Muỗi, mở\nnhiệm vụ phụ bản Quỷ Hút Máu",
    "T45.5453.reqClass": "all",
    "T45.5453.startText": "Thợ Săn Muỗi đưa cho ta Thư Cầu Cứu, nghe đâu\ntrước đó đã phát hiện ra 1 nơi gọi là sào huyệt\ncủa Quỷ Hút Máu. Hãy đến xem giúp ông ấy!",
    "T45.5453.completeText": "Các ngươi có thể đến tìm Thợ Săn Muỗi ở Vĩnh Dạ\nCảng để vào phụ bản",
    "T45.5453.name": "Mở Nhiệm Vụ Quỷ Hút Máu",
    "T45.5454.info": "Huy chương vinh danh những cư dân gắn bó với Vua\nPháp Thuật, nhận tại Sứ Giả Sinh Nhận.",
    "T45.5454.reqClass": "all",
    "T45.5454.startText": "Mỗi ngày có thể đến đây để nhận BUFF, tuy không có\nhiệu ứng đặc biệt nhưng có sẽ được huy chương vinh\ndanh",
    "T45.5454.completeText": "Đây là phần thưởng của ngươi!",
    "T45.5454.name": "Nhận Huy Chương Kỷ Niệm Thành Lập",
    "T45.5455.info": "Chỉ cần đem đến Gà Tây May Mắn đến cho ta phóng\nsinh là có thể nhận Huy Chương Đôi Cánh Gà Tây!",
    "T45.5455.reqClass": "all",
    "T45.5455.startText": "Cho ngươi!",
    "T45.5455.name": "Đổi Huy Chương Đôi Cánh Gà Tây",
    "T45.5456.info": "Gần đây khi quái vật hoành hành khắp nơi thì vai\ntrò đồng hành của pet lại quan trọng hơn bao giờ\nhết. Ta quyết định thu thập 1 số trang bị dành\nviệc nâng cao sức mạnh của pet.",
    "T45.5456.reqClass": "all",
    "T45.5456.startText": "Đây là phần thưởng cảm tạ ngươi!",
    "T45.5456.completeText": "Kinh nghiệm Pet, có cơ hội nhận được Thuốc Tăng\nTrưởng Pet",
    "T45.5456.name": "Thu Thập Trang Bị Thùy Vân",
    "T45.5456.aScriptText": "Phần thưởng kinh nghiệm pet \n có xác suất nhận Thuốc Tăng Trưởng Pet",
    "T45.5441.info": "Bắt 1 con Tung Thạch Giả",
    "T45.5441.reqClass": "all",
    "T45.5441.subType": "9-15",
    "T45.5441.startText": "Tiệm pet gần đây nhận được vô số đơn đặt hàng, hãy\nmau giúp bắt các loại pet đang hot nào!",
    "T45.5441.completeText": "Loại tốt thế này ắt hắn nhiều người thích lắm. Ha\nha cảm ơn ngươi nhé!",
    "T45.5441.name": "Tung Thạch Giả Quý",
    "T45.5441.aScriptText": "Ngẫu nhiên nhận được 2 nguyên liệu trang bị và 1\nLệnh bài treo thưởng, phẩm chất nhiệm vụ càng cao\n(trắng<lục<xanh<tím) thì xác suất nhận được nguyên\nliệu cấp cao càng cao",
    "T45.5442.info": "Bắt 1 con Vong Linh Thuẫn",
    "T45.5442.reqClass": "all",
    "T45.5442.subType": "9-15",
    "T45.5442.startText": "Tiệm pet gần đây nhận được vô số đơn đặt hàng, hãy\nmau giúp bắt các loại pet đang hot nào!",
    "T45.5442.completeText": "Loại tốt thế này ắt hắn nhiều người thích lắm. Ha\nha cảm ơn ngươi nhé!",
    "T45.5442.name": "Vong Linh Thuẫn Quý",
    "T45.5442.aScriptText": "Ngẫu nhiên nhận được 2 nguyên liệu trang bị và 1\nLệnh bài treo thưởng, phẩm chất nhiệm vụ càng cao\n(trắng<lục<xanh<tím) thì xác suất nhận được nguyên\nliệu cấp cao càng cao",
    "T45.5443.info": "Bắt 1 con Nhện Độc Đỏ",
    "T45.5443.reqClass": "all",
    "T45.5443.subType": "9-15",
    "T45.5443.startText": "Tiệm pet gần đây nhận được vô số đơn đặt hàng, hãy\nmau giúp bắt các loại pet đang hot nào!",
    "T45.5443.completeText": "Loại tốt thế này ắt hắn nhiều người thích lắm. Ha\nha cảm ơn ngươi nhé!",
    "T45.5443.name": "Nhện Độc Đỏ Quý",
    "T45.5443.aScriptText": "Ngẫu nhiên nhận được 2 nguyên liệu trang bị và 1\nLệnh bài treo thưởng, phẩm chất nhiệm vụ càng cao\n(trắng<lục<xanh<tím) thì xác suất nhận được nguyên\nliệu cấp cao càng cao",
    "T45.5444.info": "Bắt 1 con Hỏa Cơ Giáp",
    "T45.5444.reqClass": "all",
    "T45.5444.subType": "9-15",
    "T45.5444.startText": "Tiệm pet gần đây nhận được vô số đơn đặt hàng, hãy\nmau giúp bắt các loại pet đang hot nào!",
    "T45.5444.completeText": "Loại tốt thế này ắt hắn nhiều người thích lắm. Ha\nha cảm ơn ngươi nhé!",
    "T45.5444.name": "Hỏa Cơ Giáp Quý",
    "T45.5444.aScriptText": "Ngẫu nhiên nhận được 2 nguyên liệu trang bị và 1\nLệnh bài treo thưởng, phẩm chất nhiệm vụ càng cao\n(trắng<lục<xanh<tím) thì xác suất nhận được nguyên\nliệu cấp cao càng cao",
    "T45.5445.info": "Bắt 1 con Không Hồn Sư",
    "T45.5445.reqClass": "all",
    "T45.5445.subType": "9-15",
    "T45.5445.startText": "Tiệm pet gần đây nhận được vô số đơn đặt hàng, hãy\nmau giúp bắt các loại pet đang hot nào!",
    "T45.5445.completeText": "Loại tốt thế này ắt hắn nhiều người thích lắm. Ha\nha cảm ơn ngươi nhé!",
    "T45.5445.name": "Khống Hồn Sư Quý",
    "T45.5445.aScriptText": "Ngẫu nhiên nhận được 2 nguyên liệu trang bị và 1\nLệnh bài treo thưởng, phẩm chất nhiệm vụ càng cao\n(trắng<lục<xanh<tím) thì xác suất nhận được nguyên\nliệu cấp cao càng cao",
    "T45.5446.info": "Bắt 1 con Ma Thạch Tượng",
    "T45.5446.reqClass": "all",
    "T45.5446.subType": "9-15",
    "T45.5446.startText": "Tiệm pet gần đây nhận được vô số đơn đặt hàng, hãy\nmau giúp bắt các loại pet đang hot nào!",
    "T45.5446.completeText": "Loại tốt thế này ắt hắn nhiều người thích lắm. Ha\nha cảm ơn ngươi nhé!",
    "T45.5446.name": "Ma Thạch Tượng Quý",
    "T45.5446.aScriptText": "Ngẫu nhiên nhận được 2 nguyên liệu trang bị và 1\nLệnh bài treo thưởng, phẩm chất nhiệm vụ càng cao\n(trắng<lục<xanh<tím) thì xác suất nhận được nguyên\nliệu cấp cao càng cao",
    "T45.5463.info": "Để đền bù tổn thất cho các cư dân, đây là 1 món\nnhỏ dành tặng các cư dân Vua Pháp Thuật",
    "T45.5463.reqClass": "all",
    "T45.5463.startText": "Gửi tặng các cư dân món quà nhỏ",
    "T45.5463.completeText": "Đây là phần thưởng của ngươi",
    "T45.5463.name": "Nhận Kim Phiếu",
    "T45.5431.info": "Tiêu diệt 30 Tung Thạch Giả, sau đó quay về tìm Vệ\nSĩ Tinh LinhThành",
    "T45.5431.reqClass": "all",
    "T45.5431.subType": "9-15",
    "T45.5431.startText": "Vệ Sĩ cho biết ở Đăng Vân Địa, các ma quỷ đang\nhoành hành. Mọi người phải cố gắng đánh đuổi chúng\nđi!",
    "T45.5431.completeText": "Cảm ơn ngươi!",
    "T45.5431.name": "Tung Thạch Giả",
    "T45.5431.aScriptText": "Ngẫu nhiên nhận được 2 nguyên liệu trang bị và 1\nLệnh bài treo thưởng, phẩm chất nhiệm vụ càng cao\n(trắng<lục<xanh<tím) thì xác suất nhận được nguyên\nliệu cấp cao càng cao",
    "T45.5449.info": "Giúp Thợ Săn Muỗi giáo huấn Muỗi Tướng Quân và hóa\ngiải phong ấn cho Vợt Muỗi",
    "T45.5449.reqClass": "all",
    "T45.5449.startText": "Muỗi Tướng Quân đang canh giữ Thần Khí Vợt Muỗi,\nhãy đuổi hắn đi và hóa giải phong ấn cho Thần Khí!",
    "T45.5449.completeText": "Ngươi làm rất tốt! Hãy mau đi giải phong ấn cho\nthần khí khác đi!",
    "T45.5449.name": "Thần Khí Hủy Diệt? Vợt Muỗi!",
    "T45.5449.aScriptText": "Phần thưởng kinh nghiệm và ngân phiếu",
    "T45.5450.info": "Giúp Thợ Săn Muỗi giáo huấn Muỗi Quân Sư và hóa\ngiải phong ấn cho Nhang Muỗi",
    "T45.5450.reqClass": "all",
    "T45.5450.startText": "Muỗi Quân Sư đang canh giữ Thần Khí Nhang Muỗi,\nhãy đuổi hắn đi và hóa giải phong ấn cho Thần Khí!",
    "T45.5450.completeText": "Phong ấn đã được hóa giải. Lúc này Muỗi Đại Vương\ncũng nhận được bài học",
    "T45.5450.name": "Thần Khí Hủy Diệt? Nhang Muỗi!",
    "T45.5450.aScriptText": "Phần thưởng kinh nghiệm và ngân phiếu",
    "T45.5451.info": "Giúp Thợ Săn Muỗi giáo huấn Muỗi Đại Vương",
    "T45.5451.reqClass": "all",
    "T45.5451.startText": "2 Thần Khí đã được hóa giải, trước mắt hãy còn 1\nQuân Đoàn Muỗi và Muỗi Đại Vương. Hắn cực kỳ xảo\nquyệt! Hãy cẩn thận!",
    "T45.5451.completeText": "Đáng ghét! Lại để hắn chạy thoát! Mau bắt hắn lại\nmau!",
    "T45.5451.name": "Tóm Gọn Thủ Lĩnh",
    "T45.5451.aScriptText": "Phần thưởng kinh nghiệm và ngân phiếu",
    "T45.5468.info": "Mang Giấy Chiêu Mộ Binh Đoàn Cương Thi đến gặp Kẻ\nGác Cổng Địa Ngục vào Sào Huyệt Cương Thi nhận\nnhiệm vụ",
    "T45.5468.reqClass": "all",
    "T45.5468.startText": "Bọn Tiểu Cương Thi ta rất là trầm lặng, nhưng nhận\nđược giấy chiêu mộ thì cũng có chút hứng thú!",
    "T45.5468.completeText": "Có giấy chiêu mộ, ta sẽ đưa ngươi đến Sào Huyệt\nCương Thi!",
    "T45.5468.name": "Nhiệm Vụ Binh Đoàn Cương Thi",
    "T45.5469.info": "Cổ Đồnng còn thừa trong sự kiện có thể đem đổi lấy\nkinh nghiệm ở Kẻ Gác Cổng Địa Ngục",
    "T45.5469.reqClass": "all",
    "T45.5469.startText": "Cổ Đồnng còn thừa trong sự kiện có thể đem đổi lấy\nkinh nghiệm ở Kẻ Gác Cổng Địa Ngục",
    "T45.5469.completeText": "Đây là phần thưởng của ngươi!",
    "T45.5469.name": "Cổ Đồng đổi exp nhân vật",
    "T45.5469.aScriptText": "Đổi lấy 1 lượng exp nhân vật",
    "T45.5485.info": "Giúp Tôn Mỹ Mỹ đánh đuổi Nấm Vương phá phách",
    "T45.5485.reqClass": "all",
    "T45.5485.startText": "Mấy ngày nay, Nấm Vương cứ chạy đến đây để phá\nphách. Hãy giúp ta đuổi nó đi đi!",
    "T45.5485.completeText": "Làm tốt lắm! Tiếp theo hãy đến thăm hỏi Tiệm Vũ\nKhí A Nhĩ (51,136) đi!",
    "T45.5485.name": "Tiệm Pet Mỹ Mỹ",
    "T45.5485.aScriptText": "Phần thưởng chưa biết",
    "T45.5471.info": "Cổ Đồng nhận được có thể dùng để triệu tập Vua\nCương Thi ở tầng 3 tại Tiểu Cương Thi",
    "T45.5471.reqClass": "all",
    "T45.5471.startText": "Thu thập đủ 12 Cổ Đồng là có thể triệu tập Vua\nCương Thi!",
    "T45.5471.completeText": "Đại Vương đã xuất hiện!",
    "T45.5471.name": "Triệu Tập Vua Cương Thi",
    "T45.5471.aScriptText": "Các dũng sĩ, hãy dũng cảm lên!",
    "T45.5472.info": "Cổ Đồnng còn thừa trong sự kiện có thể đem đổi lấy\nkinh nghiệm pet ở Kẻ Gác Cổng Địa Ngục",
    "T45.5472.reqClass": "all",
    "T45.5472.startText": "Cổ Đồnng còn thừa trong sự kiện có thể đem đổi lấy\nkinh nghiệm pet ở Kẻ Gác Cổng Địa Ngục",
    "T45.5472.completeText": "Đây là phần thưởng của ngươi!",
    "T45.5472.name": "Cổ Đồng đổi exp pet",
    "T45.5472.aScriptText": "Đổi lấy 1 lượng exp pet",
    "T45.5457.info": "Gần đây khi quái vật hoành hành khắp nơi thì vai\ntrò đồng hành của pet lại quan trọng hơn bao giờ\nhết. Ta quyết định thu thập 1 số trang bị dành\nviệc nâng cao sức mạnh của pet.",
    "T45.5457.reqClass": "all",
    "T45.5457.startText": "Đây là phần thưởng cảm tạ ngươi!",
    "T45.5457.completeText": "Kinh nghiệm Pet, có cơ hội nhận được Thuốc Tăng\nTrưởng Pet",
    "T45.5457.name": "Thu Thập Trang Bị Tử Điện",
    "T45.5457.aScriptText": "Phần thưởng kinh nghiệm pet \n có xác suất nhận Thuốc Tăng Trưởng Pet",
    "T45.5458.info": "Gần đây khi quái vật hoành hành khắp nơi thì vai\ntrò đồng hành của pet lại quan trọng hơn bao giờ\nhết. Ta quyết định thu thập 1 số trang bị dành\nviệc nâng cao sức mạnh của pet.",
    "T45.5458.reqClass": "all",
    "T45.5458.startText": "Đây là phần thưởng cảm tạ ngươi!",
    "T45.5458.completeText": "Kinh nghiệm Pet, có cơ hội nhận được Thuốc Tăng\nTrưởng Pet",
    "T45.5458.name": "Thu Thập Trang Bị Xích Nguyệt",
    "T45.5458.aScriptText": "Phần thưởng kinh nghiệm pet \n có xác suất nhận Thuốc Tăng Trưởng Pet",
    "T45.5459.info": "Lần theo tin tức, hãy tìm Thỏ Tinh Nghịch",
    "T45.5459.reqClass": "all",
    "T45.5459.startText": "Chiếc búa thần kỳ ta vốn định rèn ra đã bị đám thỏ\ntrộm mất rồi, nếu ngươi có thể tìm lại được, ta sẽ\ntặng lại chiếc búa ấy cho ngươi",
    "T45.5459.completeText": "Thế nào, trên tay cầm búa đặc biệt có cảm giác\nkhác khác đúng không?",
    "T45.5459.name": "Tìm Búa",
    "T45.5459.aScriptText": "Nhận lượng lớn exp, ngân phiếu, búa thần kỳ",
    "T45.5460.info": "Đến đây chúc phúc để nhận Huy Chương Nhã An Gia Du",
    "T45.5460.reqClass": "all",
    "T45.5460.startText": "Trong khu hoang dã sẽ nhận được Nến Chúc Phúc dùng\nđể đổi danh hiệu!",
    "T45.5460.completeText": "Đây là phần thưởng của ngươi",
    "T45.5460.name": "Nhận Huy Chương Nhã An Gia Du",
    "T45.5461.scriptGiveUp": "CharLogic.restoreRes(player);",
    "T45.5461.info": "Trong thời gian sự kiện Tết, tại Lê Dương Bắc, Vân\nĐài, Quang Bình Nguyên, Đông Xuất Vân, Thiên Lục\nChâu để thu nhặt Mèo Bông Bảo Bảo và Hổ Bông Bối\nBối để nhận phần thưởng",
    "T45.5461.reqClass": "all",
    "T45.5461.startText": "Ta đang ở Lê Dương Bắc, Vân Đài, Quang Bình\nNguyên, Đông Xuất Vân chờ phát quà cho các bé\nngoan, ngươi đã tìm thấy chưa?",
    "T45.5461.completeText": "Ngày lễ an vui!",
    "T45.5461.name": "Thu Nhặt Thú Bông (5 Cái)",
    "T45.5461.aScriptText": "Phần thưởng là lượng lớn exp, ngân phiếu và vật\nphẩm thần bí",
    "T45.5462.scriptGiveUp": "CharLogic.restoreRes(player);",
    "T45.5462.info": "Trong thời gian sự kiện Tết, tại Lê Dương Bắc, Vân\nĐài, Quang Bình Nguyên, Đông Xuất Vân, Thiên Lục\nChâu để thu nhặt Mèo Bông Bảo Bảo và Hổ Bông Bối\nBối để nhận phần thưởng",
    "T45.5462.reqClass": "all",
    "T45.5462.startText": "Ta đang ở Lê Dương Bắc, Vân Đài, Quang Bình\nNguyên, Đông Xuất Vân chờ phát quà cho các bé\nngoan, ngươi đã tìm thấy chưa?",
    "T45.5462.completeText": "Ngày lễ an vui",
    "T45.5462.name": "Thu Hồi Hổ Bông Bối Bối (20 Cái)",
    "T45.5479.info": "Đánh bại Chỉ Huy Quân Địch",
    "T45.5479.reqClass": "all",
    "T45.5479.startText": "Thời khắc đã đến, Chỉ Huy Quân Địch đã xuất hiện,\nhãy chiến đấu với bọn chúng!",
    "T45.5479.completeText": "Thật đáng ngưỡng mộ!",
    "T45.5479.name": "Tấn Công Vĩnh Dạ",
    "T45.5479.aScriptText": "Phần thưởng chưa biết",
    "T45.5464.info": "Nhận Hạt Giống Dưa Hấu của Lão Nông Dân và đem\ntrồng",
    "T45.5464.reqClass": "all",
    "T45.5464.startText": "Haizz, già rồi, lực bất tòng tâm. Anh bạn trẻ, có\nthể giúp ta trồng mớ dưa hấu này không?",
    "T45.5464.completeText": "Ây da, cảm ơn anh bạn trẻ.",
    "T45.5464.name": "Nhận Hạt Giống Dưa Hấu",
    "T45.5448.info": "Giúp Thợ Săn Muỗi giáo huấn bọn Muỗi Tiểu Binh\nGiáp, Ất, Bính, Đinh",
    "T45.5448.reqClass": "all",
    "T45.5448.startText": "Có 1 đám Muỗi Tiểu Binh thường xuyên quấy phá làm\nta không thể tiếp cận Thần Khí Phong Ấn, hãy giúp\nta đánh đuổi chúng đi!",
    "T45.5448.completeText": "Đaã giải quyết xong bọn tạp binh, hãy mau đi giải\nphong ấn thần khí!",
    "T45.5448.name": "Tiểu Binh Phiền Phức",
    "T45.5448.aScriptText": "Phần thưởng kinh nghiệm và ngân phiếu",
    "T45.5466.info": "Để đền bù tổn thất cho các cư dân, đây là 1 món\nnhỏ dành tặng các cư dân Vua Pháp Thuật. Người\nchơi cấp 20 sẽ nhận được 300 kim phiếu, người chơi\ncấp 100 sẽ nhận được 500 kim phiếu",
    "T45.5466.reqClass": "all",
    "T45.5466.startText": "Gửi tặng các cư dân món quà nhỏ",
    "T45.5466.completeText": "Đây là phần thưởng của ngươi",
    "T45.5466.name": "Nhận Kim Phiếu",
    "T45.5467.info": "Thu thập 3 Lông Vũ Thất Sắc và 1 Song Thất Thủy",
    "T45.5467.reqClass": "all",
    "T45.5467.startText": "Để cứu lấy Chim Khách bị thương cần phải có Lông\nVũ Trị Thương. Ta biết ở Thất Sắc Kê tại Vân Đài,\nTinh Linh Nước tại Lê Dương Bắc sẽ nhận được\nnguyên liệu chế tạo Lông Vũ Trị Thương.",
    "T45.5467.completeText": "Lông Vũ Trị Thương đã được chế tạo xong, hãy mau\nđến Anh Vũ Cảnh để cứu Chim Khách",
    "T45.5467.name": "Bắt Cầu Ô Thước",
    "T45.5467.aScriptText": "Kinh nghiệm, ngân phiếu, vật phẩm, điểm thưởng sự\nkiện",
    "T45.5484.info": "Thông qua khảo nghiệm của Nhân Viên Bảo Vệ Vật\nPhẩm",
    "T45.5484.reqClass": "all",
    "T45.5484.startText": "Haha, còn nhớ đại thúc à? Để ta thử xem con đã lớn\nkhôn thế nào!",
    "T45.5484.completeText": "Quả thật lợi hại!",
    "T45.5484.name": "Nhân Viên Bảo Quản Vật Phẩm",
    "T45.5484.aScriptText": "Phần thưởng chưa biết",
    "T45.5500.info": "Nhận 100 Kẹo Đồng từ Sứ Giả Halloween",
    "T45.5500.reqClass": "all",
    "T45.5500.startText": "Phải có Kẹo Đồng mới sát thương được Kỵ Sĩ Tử Vong",
    "T45.5500.completeText": "Đây là Kẹo Đồng dành cho ngươi, hãy mau đem đi\nđánh bại Kỵ Sĩ Tử Vong",
    "T45.5500.name": "Kẹo Đồng",
    "T45.5486.info": "Giúp Tiệm Vũ Khí A Nhĩ mang Găng Tay Hái Thuốc\ngiao cho Tiệm Thuốc Ông Vương",
    "T45.5486.reqClass": "all",
    "T45.5486.startText": "Tất cả đều là anh chị em của nhau, ta cũng không\nmuốn làm khó mọi người, hãy giúp ta đưa Găng Tay\nHái Thuốc cho Tiệm Thuốc Ông Vương.",
    "T45.5486.completeText": "Đa tạ!",
    "T45.5486.name": "Tiệm Vũ Khí A Nhĩ",
    "T45.5486.aScriptText": "Phần thưởng chưa biết",
    "T45.5487.info": "Giúp Tiệm Thuốc Ông Vương hái 5 đóa Hoa Mộng Mơ",
    "T45.5487.reqClass": "all",
    "T45.5487.startText": "Đến thật đúng lúc. Hoa Mộng Mơ đã nở rồi. Hãy giúp\nta hái về 5 đóa hoa này!",
    "T45.5487.completeText": "Làm tốt lắm! Hãy giúp chúng ta thăm hỏ thôn\ntrưởng!",
    "T45.5487.name": "Tiệm Thuốc Ông Vương ",
    "T45.5487.aScriptText": "Phần thưởng chưa biết",
    "T45.5488.info": "Thông qua khảo nghiệm của trưởng thôn, trả lời\nđúng 10 câu hỏi",
    "T45.5488.reqClass": "all",
    "T45.5488.startText": "Nhanh vậy đã trở về rồi à? Ta cũng muốn thử ngươi,\nnếu có trả lời đúng 10 câu hỏi thì xem như thông\nqua!",
    "T45.5488.completeText": "Rất tốt! Tân Nhân MM đã gửi lời chúc phúc đến\nngươi!",
    "T45.5488.name": " Trưởng Thôn Stoff",
    "T45.5488.aScriptText": "Phần thưởng chưa biết",
    "T45.5489.info": "Tìm đánh Kê Vương thật",
    "T45.5489.reqClass": "all",
    "T45.5489.startText": "Huhu~~~Không đánh lại Kê Vương rồi╭(╯^╰)╮có ai\ngiúp hông?",
    "T45.5489.completeText": "Cảm ơn! Mọi người đã vất vả rồi!",
    "T45.5489.name": "Đại Chiến Kê Vương",
    "T45.5489.aScriptText": "Phần thưởng chưa biết",
    "T45.5490.info": "Đến gặp Sứ Giả Sinh Nhật đổi danh hiệu \"Trở Về\nXuất Vân\"",
    "T45.5490.reqClass": "all",
    "T45.5490.startText": "Trong thời gian sự kiện Sinh Nhật, dùng 2 Xuất Vân\nChi Tinh đổi lấy danh hiệu \"Trở Về Xuất Vân\" (thời\nhạn 15 ngày)",
    "T45.5490.completeText": "Đây mãi là nhà của chúng tôi!",
    "T45.5490.name": "Đổi danh hiệu Trở Về Xuất Vân",
    "T45.5490.aScriptText": "Danh hiệu \"Trở Về Xuất Vân\"",
    "T45.5491.info": "Đến gặp Sứ Giả Sinh Nhật đổi danh hiệu \"Cao Tài\nSinh\"",
    "T45.5491.reqClass": "all",
    "T45.5491.startText": "Trong thời gian sự kiện Sinh Nhật, dùng 3 Xuất Vân\nChi Tinh đổi lấy danh hiệu \"Cao Tài Sinh\"",
    "T45.5491.completeText": "Đây mãi là nhà của chúng tôi!",
    "T45.5491.name": "Đổi danh hiệu Cao Tài Sinh",
    "T45.5491.aScriptText": "Danh hiệu \"Cao Tài Sinh\"",
    "T45.5492.info": "Chúc Phúc của Tân Nhân MM có thể đổi lấy kinh\nnghiệm pet",
    "T45.5492.reqClass": "all",
    "T45.5492.startText": "Trong thời gian sự kiện Sinh Nhật, chúc phúc của\nTân Nhân MM có thể đổi lấy kinh nghiệm pet",
    "T45.5492.completeText": "Đây là phần thưởng của ngươi!",
    "T45.5492.name": "Đổi Chúc Phúc Tân Nhân MM",
    "T45.5492.aScriptText": "Đổi lấy phần thưởng exp pet",
    "T45.5477.info": "Tiêu diệt Đội Tấn Công Tả, Đội Tấn Công Hữu, Đội\nTấn Công Chính, Đội Tấn Công Chủ Lực giải cứu Binh\nSĩ Bị Nạn",
    "T45.5477.reqClass": "all",
    "T45.5477.startText": "Hãy cứu lấy các Binh Sĩ Bị Nạn",
    "T45.5477.completeText": "Làm tốt lắm!",
    "T45.5477.name": "Cứu Viện Vĩnh Dạ",
    "T45.5477.aScriptText": "Phần thưởng chưa biết",
    "T45.5478.info": "Tìm vật tư và chuyển đến cho Binh Sĩ Tiền Tuyến\n(nhấp đôi vào Định Vị Phù để hiển thị địa điểm của\nvật tư)",
    "T45.5478.reqClass": "all",
    "T45.5478.startText": "Ở đây còn ẩn giấu rất nhiều vật tư. Định Vị Phù sẽ\ngiúp tìm ra vị trí của chúng. Hãy dựa vào các chỉ\nthị trên đây tìm vật tư",
    "T45.5478.completeText": "Đúng là thần dũng! Tin rằng nhiệm vụ sau mọi người\ncũng sẽ hoàn thành tốt!",
    "T45.5478.name": "Vận Chuyển Vĩnh Dạ",
    "T45.5478.aScriptText": "Phần thưởng chưa biết",
    "T45.5495.info": "Halloween đã đến, hãy mau gặp Đạo Sư của các gia\ntộc để đòi kẹo nào!",
    "T45.5495.reqClass": "all",
    "T45.5495.startText": "Trong thời gian sự kiện Halloween, mỗi ngày có thể\nđến gặp Đạo Sư của các gia tộc để nhận 1 Túi Kẹo",
    "T45.5495.completeText": "Này, Túi Kẹo cho các ngươi, nhớ cẩn thận khi mở\nnhé!!",
    "T45.5495.name": "Cho kẹo hay bị ghẹo",
    "T45.5480.info": "Mở hệ thống phòng ngự (mang Thẻ Bài Khẩu Lệnh đến\nBù Nhìn ma Pháp để mở bảng giao diện nhập mật mã,\nlấy Chìa Khóa Thạch Anh)",
    "T45.5480.reqClass": "all",
    "T45.5480.startText": "Pháp Sư của chúng ta đã thành công khống chế được\nBù Nhìn. Nhiệm vụ của mọi người là tìm ra mật mã\nchính xác để mở hệ thống phòng ngự",
    "T45.5480.completeText": "Vất cả cho mọi người rồi!",
    "T45.5480.name": "Phòng Ngự Vĩnh Dạ",
    "T45.5480.aScriptText": "Phần thưởng chưa biết",
    "T45.5481.info": "Giúp Pháp Sư bố trí Bảo Thạch Năng Lượng và yểm\ntrợ cho ông ấy an toàn rời khỏi chiến trường (nhấp\nđôi vào Bảo Thạch Năng Lượng để hiển thị địa điểm\nvà chuyển đến đó)",
    "T45.5481.reqClass": "all",
    "T45.5481.startText": "Hệ thống phòng ngự đã mở, bây giờ chỉ cần đặt Năng\nLượng Bảo Thạch đúng vị trí nữa là được. Chỉ cần\nnhấp chọn sử dụng, sẽ hiển thị vị trí này",
    "T45.5481.completeText": "Rất tốt!",
    "T45.5481.name": "Rút Binh Vĩnh Dạ",
    "T45.5481.aScriptText": "Phần thưởng chưa biết",
    "T45.5482.info": "Mang Mộng Cảnh Thạch giao cho Sứ Giả Sinh Nhật để\nnhận nhiệm vụ Trở Về Xuất Vân",
    "T45.5482.reqClass": "all",
    "T45.5482.startText": "Trong thời gian Quốc Khánh, ta sẽ đưa ngươi trở về\nXuất Vân Thôn năm nào.",
    "T45.5482.completeText": "Đã có Mộng Cảnh Thạch, ta sẽ đưa người Trở Về Xuất\nVân!",
    "T45.5482.name": "Trở Về Xuất Vân",
    "T45.5483.info": "Thăm hỏi Nhân Viên Quản Lý Vật Phẩm",
    "T45.5483.reqClass": "all",
    "T45.5483.startText": "Lâu rồi không đến, ngươi còn nhớ Xuất Vân Thôn năm\nxưa không? Hãy đi xung quanh xem thử xem!",
    "T45.5483.completeText": "Thật đáng quý, hãy để đại thúc xem kỹ con xem !",
    "T45.5483.name": "Quay Về Chốn Cũ",
    "T45.5483.aScriptText": "Phần thưởng chưa biết",
    "T45.5515.info": "Giúp Tiến Sĩ Uttra giải mã",
    "T45.5515.reqClass": "all",
    "T45.5515.startText": "Đấy, ngươi thấy chưa, chỉ cần đem loại lông mao\nnào vào máy phân tích thì không lâu sau sẽ có\nthông tin. Nhưng có điều, ta không biết mật mã mở\nmáy ==\" Giúp ta với nhé!",
    "T45.5515.completeText": "Nhóc làm tốt lắm",
    "T45.5515.name": "Giải Mã",
    "T45.5501.info": "Dùng 50 Kẹo Halloween để đổi lấy danh hiệu Ác Ma\nQuấy Phá",
    "T45.5501.reqClass": "all",
    "T45.5501.startText": "Dùng 50 Kẹo Halloween để đổi lấy danh hiệu Ác Ma\nQuấy Phá",
    "T45.5501.completeText": "Huy Chương danh hiệu của ngươi đây!",
    "T45.5501.name": "Đổi Danh Hiệu Halloween",
    "T45.5502.info": "Món quà đền bù của ta dành cho mọi người",
    "T45.5502.reqClass": "all",
    "T45.5502.startText": "Món quà đền bù của ta dành cho mọi người",
    "T45.5502.completeText": "Món quà đền bù của ta dành cho ngươi!",
    "T45.5502.name": "Nhận Kim Phiếu",
    "T45.5503.info": "Thu thập 4 Thẻ Bài Tinh Linh để đổi lấy 1 Tinh\nLinh",
    "T45.5503.reqClass": "all",
    "T45.5503.startText": "Thu thập 4 Thẻ Bài Tinh Linh sẽ đổi được 1 Tinh\nLinh",
    "T45.5503.completeText": "Đây là tinh linh của ngươi!",
    "T45.5503.name": "Đổi Tinh Linh Halloween",
    "T45.5504.info": "Mang Trưng Binh Lệnh đến Chỉ Huy Trưng Binh mở\nnhiệm vụ Trưởng Lão Ma Thuật",
    "T45.5504.reqClass": "all",
    "T45.5504.startText": "Toàn Cổ Thành đã được phong ấn mới, cần mang chìa\nkhóa thần bí đến để giải ấn!",
    "T45.5504.completeText": "Có Trưng Binh Lệnh rồi ta sẽ đưa ngươi đến khe núi\nCổ Thành",
    "T45.5504.name": "Mở Nhiệm Vụ Trưởng Lão Ma Thuật",
    "T45.5505.info": "Chìa Khóa Truyền Thuyết cần phải tập hợp đủ 4 chìa\nkhóa mới có thể tìm thấy",
    "T45.5505.reqClass": "all",
    "T45.5505.startText": "Năm xưa, vì để bảo đảm an toàn cho chiếc chìa khóa\nđó, các trưởng lão đã chia công thức chế tạo chìa\nkhóa ra làm nhiều phần, giao cho những người họ\ntin tưởng để bảo quản. Trước tiên, ngươi đến chỗ\ntiệm vũ khí đòi Công Thức Chìa Khóa thứ 1 đi.",
    "T45.5505.completeText": "Phong ấn lỏng lẻo đến vậy sao?",
    "T45.5505.name": "Chìa Khóa Bí Mật",
    "T45.5473.scriptGiveUp": "delItemByColor(cid, 29, 3909, 1, 0, null)",
    "T45.5473.info": "Dùng La Bàn Nguyệt Ảnh để tìm Ánh Trăng",
    "T45.5473.reqClass": "all",
    "T45.5473.startText": "Gần đây ta nhặt được 1 vật rất lạ, gọi là La Bàn\nNguyệt Ảnh, nghe nói có thể dùng thể truy tìm ánh\ntrăng. Ngươi có đồng ý giúp ta tìm không?",
    "T45.5473.completeText": "Tốt quá! Vậy là mọi người đều có thể ngắm trăng\nrồi. Đây, đây là phần thưởng của ngươi.",
    "T45.5473.name": "Truy Tìm Ánh Trăng",
    "T45.5473.aScriptText": "Kinh nghiệm, ngân phiếu, vật phẩm",
    "T45.5474.info": "Cần 3 Lúa mạch và 3 Đậu Nành<font\ncolor=\"#FF0000\">(Túi cần ít nhất 1 ô trống)</font>",
    "T45.5474.reqClass": "all",
    "T45.5474.startText": "Trung Thu thì phải có bánh trung thu. Hãy thu thập\ncác nguyên liệu, ta sẽ giúp ngươi nấu bánh.",
    "T45.5474.completeText": "Hãy thưởng thức hương vị bánh trung thu tuyệt hảo\ncủa Đại Lục Vô Ưu",
    "T45.5474.name": "Làm Bánh Trung Thu",
    "T45.5474.aScriptText": "Kinh nghiệm, ngân phiếu, phần thưởng, thức ăn,\ndanh hiệu",
    "T45.5475.info": "Mang Thủ Lệnh Tiếp Viện đến Sứ Giả Quốc Khánh nhận\nnhiệm vụ Kích Chiến Vĩnh Dạ Cảng",
    "T45.5475.reqClass": "all",
    "T45.5475.startText": "Trong thời gian sự kiện Quốc Khánh, có thể tham\ngia sự kiện Kích Chiến Vĩnh Dạ Cảng",
    "T45.5475.completeText": "Có Thủ Lệnh Tiếp Viện, ta sẽ đưa ngươi đến Chiến\nTrường Vĩnh Dạ Cảng",
    "T45.5475.name": "Kích Chiến Vĩnh Dạ Cảng",
    "T45.5476.info": "Tiêu diệt tất cả Tiểu Binh Quân Địch xung quanh cứ\nđiểm của ta",
    "T45.5476.reqClass": "all",
    "T45.5476.startText": "Các dũng sĩ, mọi người đến thật đúng lúc. Chắc mọi\nngười cũng đã biết tình hình nghiêm trọng thế nào.\nHãy mau giúp ta tiêu diệt tất cả Tiểu Binh Quân\nĐịch xung quanh cứ điểm của chúng ta!",
    "T45.5476.completeText": "Làm tốt lắm! Ta còn có 1 nhiệm vụ khác giao cho\nmọi người!",
    "T45.5476.name": "Cứ Điểm Vĩnh Dạ",
    "T45.5476.aScriptText": "Phần thưởng chưa biết",
    "T45.5494.info": "Halloween đã đến, hãy mau gặp Đạo Sư của các gia\ntộc để đòi kẹo nào!",
    "T45.5494.reqClass": "all",
    "T45.5494.startText": "Trong thời gian sự kiện Halloween, mỗi ngày có thể\nđến gặp Đạo Sư của các gia tộc để nhận 1 Túi Kẹo",
    "T45.5494.completeText": "Này, Túi Kẹo cho các ngươi, nhớ cẩn thận khi mở\nnhé!!",
    "T45.5494.name": "Cho kẹo hay bị ghẹo",
    "T45.5511.info": "Đến gặp Chỉ Huy Trưng Binh đổi danh hiệu Trưởng\nLão Ma Thuật",
    "T45.5511.reqClass": "all",
    "T45.5511.startText": "Trong thời gian sự kiện, dùng 2 Huy Chương Trưởng\nLão để đổi lấy danh hiệu Trưởng Lão Ma Thuật (15\nNgày)",
    "T45.5511.completeText": "Gừng càng già càng cay mà!",
    "T45.5511.name": "Đổi Danh Hiệu Trưởng Lão Ma Thuật",
    "T45.5511.aScriptText": "Danh hiệu \"Trưởng Lão Ma Thuật\"",
    "T45.5496.info": "Halloween đã đến, hãy mau gặp Đạo Sư của các gia\ntộc để đòi kẹo nào!",
    "T45.5496.reqClass": "all",
    "T45.5496.startText": "Trong thời gian sự kiện Halloween, mỗi ngày có thể\nđến gặp Đạo Sư của các gia tộc để nhận 1 Túi Kẹo",
    "T45.5496.completeText": "Này, Túi Kẹo cho các ngươi, nhớ cẩn thận khi mở\nnhé!!",
    "T45.5496.name": "Cho kẹo hay bị ghẹo",
    "T45.5497.info": "Halloween đã đến, hãy mau gặp Đạo Sư của các gia\ntộc để đòi kẹo nào!",
    "T45.5497.reqClass": "all",
    "T45.5497.startText": "Trong thời gian sự kiện Halloween, mỗi ngày có thể\nđến gặp Đạo Sư của các gia tộc để nhận 1 Túi Kẹo",
    "T45.5497.completeText": "Này, Túi Kẹo cho các ngươi, nhớ cẩn thận khi mở\nnhé!!",
    "T45.5497.name": "Cho kẹo hay bị ghẹo",
    "T45.5498.info": "Halloween đã đến, hãy mau gặp Đạo Sư của các gia\ntộc để đòi kẹo nào!",
    "T45.5498.reqClass": "all",
    "T45.5498.startText": "Trong thời gian sự kiện Halloween, mỗi ngày có thể\nđến gặp Đạo Sư của các gia tộc để nhận 1 Túi Kẹo",
    "T45.5498.completeText": "Này, Túi Kẹo cho các ngươi, nhớ cẩn thận khi mở\nnhé!!",
    "T45.5498.name": "Cho kẹo hay bị ghẹo",
    "T45.5499.info": "Dùng 10 Kẹo Halloween để đổi lấy 1 Gậy Pháp Thuật",
    "T45.5499.reqClass": "all",
    "T45.5499.startText": "Dùng 10 Kẹo Halloween để đổi lấy 1 Gậy Pháp Thuật",
    "T45.5499.completeText": "Gậy Pháp Thuật của ngươi đây!",
    "T45.5499.name": "Đổi Gậy Pháp Thuật",
    "T45.5516.info": "Giết Hoa Yêu Mê Ảo nhận Phấn Hoa Mê Ảo",
    "T45.5516.reqClass": "all",
    "T45.5516.startText": "Theo phân tích thì tên này là một loài quái vật\nmới xuất hiện. Không biết thực hư năng lực thế nào\nnhưng gây rối cỡ này thì chắc cũng không phải dạng\nvừa đâu. Ta đang nghiên cứu nguyên liệu mới để chế\ntạo Liều Thuốc Mê Ảo, ngươi hãy giúp ta thu phục\ntên quái kia để ta nghiên cứu nào!",
    "T45.5516.completeText": "Làm tốt lắm, đây là Sổ Tay Nghiên Cứu của ngươi",
    "T45.5516.name": "Liều Thuốc Mê Ảo",
    "T45.5517.info": "Mang Gà Tây May Mắn đổi Huy Chương “Hội Gà Tây”",
    "T45.5517.reqClass": "all",
    "T45.5517.startText": "Chỉ cần mang Gà Tây May Mắn đến đây, ta sẽ trao\ntặng danh hiệu cho ngươi!",
    "T45.5517.completeText": "Cho ngươi đấy!",
    "T45.5517.name": "Đổi Huy Chương \"Hội Gà Tây\"",
    "T45.5518.info": "Bắt 1 con Hỏa Kê cam đến giao cho Sứ Giải Giáng\nSinh",
    "T45.5518.reqClass": "all",
    "T45.5518.startText": "Giáng Sinh đã đến! Hãy giúp ta bắt 1 con Hỏa Kê\ncam, ta sẽ trao tặng ngươi phần thưởng thần bí.",
    "T45.5518.completeText": "Công trạng này là của ngươi",
    "T45.5518.name": "Sát Thủ Gà Tây",
    "T45.5519.info": "Nhận Người Tuyết Giả Mạo",
    "T45.5519.reqClass": "all",
    "T45.5519.startText": "Ta nghĩ chắc ngươi cũng đã nghe nói gần đây xuất\nhiện 1 đám người tuyết làm loạn. Chúng là thuộc hạ\ncủa Vua Người Tuyết được phái đến làm loạn Đại Lục\nVô Ưu. Nếu ngươi có thể thu phục được bọn chúng,\nta và người dân Vô Ưu rất cảm kích.",
    "T45.5519.completeText": "Cảm ơn ngươi rất nhiều. Đây là phần thưởng dành\ncho ngươi",
    "T45.5519.name": "Đánh Bại Vua Người Tuyết",
    "T45.5520.info": "Mang Thiệp Năm Mới đổi Huy Chương Bậc Thầy Bảo\nRương",
    "T45.5520.reqClass": "all",
    "T45.5520.startText": "Đem Giấy, Khung, Phông Nền, Trang Trí để đổi Thiệp\nNăm Mới, nhận công trạng",
    "T45.5520.completeText": "Cho ngươi đấy!",
    "T45.5520.name": "Đổi Huy Chương \"Bậc Thầy Bảo Rương\"",
    "T45.5521.info": "Đem Giấy, Khung, Phông Nền, Trang Trí để đổi Thiệp\nNăm Mới",
    "T45.5521.reqClass": "all",
    "T45.5521.startText": "Đem Giấy, Khung, Phông Nền, Trang Trí để đổi Thiệp\nNăm Mới",
    "T45.5521.completeText": "Đây là phần thưởng của ngươi!",
    "T45.5521.name": "Đổi Thiệp Năm Mới",
    "T45.5506.info": "Nữ Vương Hoa Yêu đã xuất hiện, hãy đến ngăn chặn..",
    "T45.5506.reqClass": "all",
    "T45.5506.startText": "Chìa khóa thứ nhất đang nằm trong tay của Nữ Vương\nHoa Yêu!",
    "T45.5506.completeText": "Ngươi thật lợi hại!",
    "T45.5506.name": "Công Thức Chìa Khóa 1",
    "T45.5507.info": "Chủ Tiệm Pet cần bạn đến đám Cỏ Ba Lá (49,172) tìm\nCỏ May Mắn để nhận chìa khóa thứ 2",
    "T45.5507.reqClass": "all",
    "T45.5507.startText": "Chìa khóa thứ hai đang ở chủ tiệm thuốc, hãy tìm\nông ấy!",
    "T45.5507.completeText": "Thượng lộ bình an!",
    "T45.5507.name": "Công Thức Chìa Khóa 2",
    "T45.5508.scriptGiveUp": "var script_mid =\nplayer.data.posMapId;if(!d[33][script_mid].cehua){\td[33][script_mid].cehua={};}if(!d[33][script_mid].cehua.arr){\td[33][script_mid].cehua.arr={};}for(i=0;i<4;i++){\tsetNpcOffline(d[33][script_mid].cehua.arr[i],player.line);}d[33][script_mid].cehua.questId=null;d[33][player.data.posMapId].script_true=null;",
    "T45.5508.info": "Vượt thủ thách của chủ tiệm pet nhận lấy 1 chìa\nkhóa",
    "T45.5508.reqClass": "all",
    "T45.5508.startText": "Tìm Chủ Tiệm Pet để lấy chìa khóa!",
    "T45.5508.completeText": "Để ta suy nghĩ xem có nên giao công thức cho ngươi\nkhông.",
    "T45.5508.name": "Công Thức Chìa Khóa 3",
