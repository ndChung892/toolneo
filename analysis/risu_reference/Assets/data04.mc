    "T29.1797.name": "Thuốc Diệt Trùng",
    "T29.1797.description": "Thuốc Diệt Trùng trong truyền thuyết\n",
    "T29.1798.name": "Thượng Cổ Tà Cổ",
    "T29.1798.description": "Nguồn gốc tội ác của Cổ Độc\n",
    "T29.1799.name": "Đắc Kỷ Dược",
    "T29.1799.description": "Thuốc do danh y đại lục Đắc Kỷ bào chế\n",
    "T29.1800.name": "Y Tiên Dược",
    "T29.1800.description": "Thuốc do Y tiên bào chế\n",
    "T29.1801.name": "Thái Dương Thần Kính",
    "T29.1801.description": "Tương truyền đây là chiếc gương thần có thể khiền\nyêu quái hiện nguyên hình\n",
    "T29.1802.name": "Kim Sáng Dược",
    "T29.1802.description": "Nghe nói Thần Thú rất thích dùng\n",
    "T29.1803.name": "Quái Thạch",
    "T29.1803.description": "Viên đá kỳ quái\n",
