    "T19.634.reqClass": "|5|",
    "T19.634.description": "Được làm từ vỏ cây nhưng sức phòng ngự còn cao hơn\ncả sắt thép\n",
    "T19.635.name": "Phá Hy Khố",
    "T19.635.reqClass": "|5|",
    "T19.635.description": "Làm bằng da gấu bền chắc, lại được gia công tỷ mỉ\nnên rất tốt\n",
    "T19.637.name": "Quý Tộc Đai",
    "T19.637.reqClass": "|2|",
    "T19.637.description": "Trang phục của quý tộc, hoa lệ và cá tính, phô\ntrương sự vô tận về tài phú cùng quyền lực\n",
    "T19.638.name": "Tinh Linh Đai",
    "T19.638.reqClass": "|2|",
    "T19.638.description": "Các thương nhân vì muốn kiếm lời nên đã mô phỏng\nchế tạo theo trang bị chiến đấu của Tinh Linh Tộc,\ntất nhiên chất lượng không thể tốt bằng\n",
    "T19.639.name": "Nhạn Linh Đai",
    "T19.639.reqClass": "|2|",
    "T19.639.description": "Được làm từ lông vũ của chim nhạn, vì thế hết sức\nmềm mại, nhẹ nhàng và sở hữu khả năng phòng ngự\nđáng kể\n",
    "T19.640.name": "Khinh Bì Đai",
    "T19.640.reqClass": "|2|",
    "T19.640.description": "Được chế tạo từ da động vật, không những nhẹ nhàng\ntiện dụng mà còn thể chống được phong hàn\n",
    "T19.641.name": "Tướng Quân Đai",
    "T19.641.reqClass": "|1|",
    "T19.641.description": "Thắt lưng tướng quân thường đeo khi xuất chinh,\nnăng lực phòng ngự cực mạnh, uy phong lẫm liệt\n",
    "T19.642.name": "Hoàng Kim Đai",
    "T19.642.reqClass": "|1|",
    "T19.642.description": "Đai tạo từ hoàng kim, chỉ những tướng quân, dũng\nsĩ chiến tích lẫy lừng mới có tư cách mặc, chất\nlượng cao quý tượng trưng cho chiến tích bất phàm\ncủa người mặc nó\n",
    "T19.643.name": "Dũng Sĩ Đai",
    "T19.643.reqClass": "|1|",
    "T19.643.description": "Đai lưng được Vô Ưu tộc nhân thường mặc khi săn\nbắn, chiến đấu, có năng lực giảm nhẹ thương tổn\n",
    "T19.644.name": "Hợp Kim Đai",
    "T19.644.reqClass": "|1|",
    "T19.644.description": "Được chế tạo từ thượng phẩm kim chúc, năng lực hơn\nhẳn các đai lưng thông thường về mọi mặt\n",
    "T19.645.name": "Tinh Thiết Đai",
    "T19.645.reqClass": "|1|",
    "T19.645.description": "Đai lưng được luyện chế từ tinh thiết, so với\ntrang bị thanh đồng thì hình dạng, lực phòng ngự\ntăng lên không ít\n",
    "T19.646.name": "Thanh Đồng Đai",
    "T19.646.reqClass": "|1|",
    "T19.646.description": "Đai dễ làm, rẻ tiền được làm từ thanh đồng, là lựa\nchọn tốt nhất dành cho tân thủ\n",
    "T19.647.name": "Linh Động Đai",
    "T19.647.reqClass": "|2|",
    "T19.647.description": "Được dệt từ một loại gấm vô danh, nhẹ nhàng phiêu\ndật, bề ngoài nhìn có vẻ mỏng manh nhưng rất bền\n",
    "T19.648.name": "Tước Sĩ Đai",
    "T19.648.reqClass": "|2|",
    "T19.648.description": "Tầng lớp quý tộc thượng lưu thường sử dụng, màu\nsắc đẹp và sáng, khả năng phòng hộ tốt\n",
    "T19.649.name": "Sa Nhung Đai",
