    "T19.1410.reqClassId": "|2|3|4|",
    "T19.1410.name": "Huyễn Quang Hạng Liên",
    "T19.1410.reqClass": "|1|2|3|4|5|6|",
    "T19.1410.description": "Dây chuyền tỏa ra ánh sáng ma pháp mạnh mẽ,\ntăng cao pháp thuật của người đeo\n",
    "T19.1411.reqClassId": "|1|5|6|",
    "T19.1411.name": "Tàn Nhẫn Liên",
    "T19.1411.reqClass": "|1|2|3|4|5|6|",
    "T19.1411.description": "Dây chuyền làm từ máu tà thần, tỏa ra sức mạnh\ncuồng bạo, khiến cho người sử dụng trở nên\nlạnh lùng tàn nhẫn.\n",
    "T19.1412.reqClassId": "|2|3|4|",
    "T19.1412.name": "Huyễn Quang Giới Chỉ",
    "T19.1412.reqClass": "|1|2|3|4|5|6|",
    "T19.1412.description": "Nhẫn tỏa ra ánh sáng ma pháp mạnh mẽ,\ntăng cao pháp thuật của người đeo\n",
    "T19.1413.reqClassId": "|1|5|6|",
    "T19.1413.name": "Tàn Nhẫn Luân",
    "T19.1413.reqClass": "|1|2|3|4|5|6|",
    "T19.1413.description": "Vòng làm từ máu tà thần, tỏa ra sức mạnh\ncuồng bạo, khiến cho người sử dụng trở nên\nlạnh lùng tàn nhẫn.\n",
    "T19.1414.reqClassId": "|2|3|4|",
    "T19.1414.name": "Thất Sắc Hải Tinh",
    "T19.1414.reqClass": "|1|2|3|4|5|6|",
    "T19.1414.description": "Vật báu từ đáy biển, tương truyền Thất Sắc Hải\nTinh\ncó liên kết mạnh mẽ với sức mạnh nguyên tố\n",
    "T19.1415.reqClassId": "|1|5|6|",
    "T19.1415.name": "Dã Man Biểu Tượng",
    "T19.1415.reqClass": "|1|2|3|4|5|6|",
    "T19.1415.description": "Vật dụng thờ cúng tổ tiên của các bộ tộc hoang dã,\ncó hình dạng kỳ dị, có khả năng kích phát sự độc\nác\n",
    "T19.1416.reqClassId": "|2|3|4|",
    "T19.1416.name": "Hỏa Diệm Hạch",
    "T19.1416.reqClass": "|1|2|3|4|5|6|",
    "T19.1416.description": "Hạt nhân nham thạch hình thành trong miệng núi\nlửa,\nchứa sức mạnh hỏa diệm\n",
    "T19.1417.reqClassId": "|1|5|6|",
    "T19.1417.name": "Phụng Vũ",
    "T19.1417.reqClass": "|1|2|3|4|5|6|",
    "T19.1417.description": "Phượng hoàng là loài chim bất tử trong truyền\nthuyết, chỉ cần có 1 cọng lông của nó trên mình\nlà sẽ có ý chí chiến đấu bất tử\n",
    "T19.1418.name": "Bàn Thạch Ấn Chương",
    "T19.1418.reqClass": "|1|2|3|4|5|6|",
    "T19.1418.description": "Thánh vật của tộc khổng lồ, có thể tạo ra kết giới\nmạnh nhất thế gian, vững như bàn thạch\n",
    "T19.1418.artifactSkill": "7-11",
    "T19.1421.name": "Hành Giả Tượng",
    "T19.1421.reqClass": "|1|2|3|4|5|6|",
    "T19.1421.description": "Di vật của các hiền triết cổ đại, đem đến lòng tin\ncho mọi người trên bước đường tu luyện\n",
    "T19.1421.artifactSkill": "7-20",
    "T19.1422.name": "Mê Thất Kính",
    "T19.1422.reqClass": "|1|2|3|4|5|6|",
    "T19.1422.description": "Ma kính của thần hắc ám Hodur, không những\ncó thể khiến lòng tin bị thuyên giảm mà còn ngăn\nchặn được sức mạnh nguyên tố\n",
    "T19.1422.artifactSkill": "7-17",
    "T19.1423.name": "Thủy Tinh La Bàn",
    "T19.1423.reqClass": "|1|2|3|4|5|6|",
    "T19.1423.description": "La bàn ẩn chứa ma lực, luôn có thể chỉ hướng\nmọi lúc mọi nơi\n",
    "T19.1423.artifactSkill": "7-14",
    "T19.1424.name": "Vô Tượng La Bàn",
    "T19.1424.reqClass": "|1|2|3|4|5|6|",
    "T19.1424.description": "La bàn ẩn chứa ma lực, luôn có thể chỉ hướng\nmọi lúc mọi nơi\n",
    "T19.1424.artifactSkill": "7-15",
