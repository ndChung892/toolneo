    "T45.50465.startText": "Hì Hì, Ha Ha, chúng ta là những chú hề thông minh",
    "T45.50465.completeText": "Cá Tháng Tư Vui Vẻ！",
    "T45.50465.name": "Từ Bỏ Nhiệm Vụ",
    "T45.50465.aScriptText": "Phần thưởng bí mật",
    "T45.50466.info": "Chú hề lấy Máy Định Vị của bạn mang đi chơi đùa\nrồi sẽ trả lại, chài, có vẻ bị hỏng rồi!",
