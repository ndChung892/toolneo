    "T35.1844.onServiceText": "Đây chính là thủ hộ bảo vệ công chúa Tuyết Liên",
    "T35.1844.name": "Công Chúa Tuyết Liên",
    "T35.1847.onServiceText": "Hừ hừ, ngươi nghĩ ác ma là cái gì chứ? Ngươi có\nthể khống chế cơ thể ta, nhưng không thể nào điều\nkhiển được linh hồn ta, Chu Ma Vương vĩ đại vạn\ntuế!",
    "T35.1847.name": "Thủ Lĩnh Ác Ma",
    "T35.1848.funcInfo": "|9,Đông Huyền Thành,100,2228,1336|525,Thành Phố\nChìm,100,660,550|56,Mị Hoặc Lâm,100,450,181",
    "T35.1848.onServiceText": "Dũng sĩ, cảm tạ sự tương trợ của ngườ, ta sẽ đưa\nngười đến Thánh Đường",
    "T35.1848.name": "Chuyển Dịch Thánh Đường",
    "T35.1849.onServiceText": "Bảo vệ Vô Ưu, bảo vệ công chúa Tuyết Liên là sứ\nmệnh cả đời ta",
    "T35.1849.name": "Thống Lĩnh Chiến Sĩ Thánh Đường",
    "T35.1850.onServiceText": "Để bảo vệ Đại Lục Vô Ưu, không chỉ có sức mạnh mà\ncòn phải vận dụng trí tuệ",
    "T35.1850.name": "Thuật Sĩ Thánh Đường",
    "T35.1851.onServiceText": "Hãy cho ta chút bình yên, đừng làm phiền đến cuộc\nsống của ta",
    "T35.1851.name": "Gia Tộc Mê Muội",
    "T35.1852.onServiceText": "…… Trước sau gì ta cũng là bá chủ của cái hải\ndương này.",
    "T35.1852.name": "Hải Yêu",
    "T35.1854.at": "0-23|0-6|1-31|0-11|hunter",
    "T35.1854.name": "Thợ Săn Đoạt Bảo",
    "T35.1855.at": "0-23|0-6|1-31|0-11|hunterboss",
    "T35.1855.name": "Thủ Lĩnh Đoạt Bảo",
    "T35.1856.scriptOff": "var script_index = 0; var script_node = null;var\nexpNumScp = 1.5;var monNumScp = 0.3;if(npc.nid &&\nfromBF){if( c ){\tif(c.inGroup()) \t{\t\tscript_node =\nc.memberList.head;\t}\telse \t{\t\tscript_node =\n{};\t\tscript_node.obj =\nc.data.id;\t}\twhile(script_node != null)\t{\n\t\tvar spt_player = getCharactor( script_node.obj\n);\t\taddChaExp(script_node.obj,\nBASIC_GET_EXP[spt_player.level]*expNumScp);\t\taddMoney(script_node.obj\n,\"moneyBind\",\nBASIC_GET_MONEY[spt_player.level]*monNumScp);\t\tif(inRate(30))\n{\nvar spt_itemId1 = 3742;\t\naddItem(script_node.obj, 29, spt_itemId1, 1 , 0,\n1, \"\", -1);\t\t\n}\t\tif(inRate(40))\n{\n\t\nvar spt_itemId2 = 3741;\t\t\nvar spt_itemId3 = 3745;\t\naddItem(script_node.obj, 29, spt_itemId2, 1 , 0,\n1, \"\", -1);\naddItem(script_node.obj, 29, spt_itemId3, 1 , 0,\n1, \"\", -1);\t\t\n}\n\tscript_index ++;\t\tscript_node =\nscript_node.next;\t}}}",
    "T35.1856.at": "0-23|0-6|1-31|0-11|chengzhangfannao",
    "T35.1856.onServiceText": "Ta là ác mộng của lũ trẻ～Dù là 1 tuổi thơ trong\nsáng đến đâu thì sớm muộn gì cũng gặp ta thôi,\nmuahahahaha",
    "T35.1856.name": "Phiền Não Cuộc Sống",
    "T35.1857.at": "0-23|0-6|1-31|0-11|wanoushouji",
    "T35.1857.onServiceText": "@(^_^)@ Ngươi là ai chứ? Ta chỉ tiếp các bé ngoan\nthôi～",
    "T35.1857.name": "Mèo Bông Bảo Bảo",
    "T35.1858.at": "0-23|0-6|1-31|0-11|wanoushouji",
    "T35.1858.onServiceText": "@(^_^)@ Ngươi là ai chứ? Ta chỉ tiếp các bé ngoan\nthôi～",
    "T35.1858.name": "Hổ Bông Bối Bối",
    "T35.1859.at": "new|2025/6/1/12/0/0-2025/6/3/23/59/0",
    "T35.1859.onServiceText": "@(T_T)@ Ngươi là ai? Sao lại đáng sợ thế này, mau\nđi chỗ khác chơi～",
    "T35.1859.name": "Bảo Bảo Lạc Đường",
    "T35.1860.onServiceText": "Nơi này đã từng là 1 chiến trường khốc liệt, chỉ\ncó những dũng sĩ tài năng mới trở thành truyền\nnhân chân chính",
    "T35.1860.name": "Long Bối Tế Tự",
    "T35.1861.at": "0-23|0-6|31-31|1-1",
    "T35.1861.onServiceText": "Chủ đề của sự kiện Ngày Môi Trường năm nay là:\nđoàn kết, tạo dựng 1 thế giới Vua Pháp Thuật hoàn\nmỹ!",
    "T35.1861.name": "Sứ Giả Môi Trường",
    "T35.1862.scriptOff": "var script_index = 0; var script_node = null;var\nexpNumScp = 1.5;var monNumScp = 0.5;if( c\n){\tif(c.inGroup()) \t{\t\tscript_node =\nc.memberList.head;\t}\telse \t{\t\tscript_node =\n{};\t\tscript_node.obj =\nc.data.id;\t}\twhile(script_node != null)\t{\t\tvar\nspt_player = getCharactor( script_node.obj\n);\t\taddChaExp(script_node.obj,\nBASIC_GET_EXP[spt_player.level]*expNumScp);\t\taddMoney(script_node.obj\n,\"moneyBind\",\nBASIC_GET_MONEY[spt_player.level]*monNumScp);\t\tif(inRate(20))\t\t{\t\t\tvar\nscript_obj =\ngetPlanByRate(\"3-1214\");\t\t\tif(script_obj)\t\t\t{\t\t\t\t\taddItemByPlan(script_node.obj,\nscript_obj, 1);\t\t\t}\t\t\tsystemSay(script_node.obj,\nLang.NPC_Script818);\t\t}\t\tscript_index\n++;\t\tscript_node = script_node.next;\t}}",
    "T35.1862.subType": "all",
    "T35.1862.name": "Tinh Linh Rừng",
