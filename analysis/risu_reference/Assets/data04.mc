    "T29.441.name": "Bùa Trấn Yêu",
    "T29.441.reqClass": "|1|2|3|4|6|5|",
    "T29.441.description": "Một tờ giấy ố vàng nhàu nát, không biết đã dán\nđược bao nhiêu năm, nhưng nó luôn trấn áp Cương\nThi, như vậy có thể thấy nó ẩn chứa sức mạnh lớn\nnhư thế nào\n",
    "T29.507.name": "Ốc Tiểu Binh",
    "T29.507.description": "Ốc tiểu binh mới bị bắt giữ, vẫn đang phản kháng\n",
    "T29.508.name": "Túi Quà Thẻ Tân Thủ",
    "T29.508.info": "Nhấp đôi mở túi quà",
    "T29.508.reqClass": "|1|2|3|4|6|5|",
    "T29.508.description": "Cần dùng Thẻ Tân Thủ thì mới nhận được túi này",
    "T29.509.name": "Túi Quà Thẻ Pha Lê",
    "T29.509.info": "Nhấp đôi mở túi quà",
    "T29.509.reqClass": "|1|2|3|4|6|5|",
    "T29.509.description": "Cần dùng Thẻ Pha Lê thì mới nhận được túi này",
    "T29.510.name": "Túi Quà Thẻ Kim Cương",
    "T29.510.info": "Nhấp đôi mở túi quà",
    "T29.510.reqClass": "|1|2|3|4|6|5|",
    "T29.510.description": "Cần dùng Thẻ Kim Cương thì mới nhận được túi này",
    "T29.512.name": "Thịt Thất Vị Kê",
    "T29.512.reqClass": "|1|2|3|4|5|6|",
    "T29.512.description": "Thịt Thất Vị Kê có bảy vị, thịt non, dễ nấu, được\nxếp thứ sáu trong bảy món ăn ngon đại lục\n",
    "T29.514.name": "Rau Dại Xanh",
    "T29.514.reqClass": "|1|2|3|4|5|6|",
    "T29.514.description": "Rau dại màu xanh mọc ở Đông Xuất Vân, thơm ngon\ntuyệt vời\n",
    "T29.515.name": "Mẫu Thức Ăn Của Vệ Sĩ",
    "T29.515.reqClass": "|1|2|3|4|5|6|",
    "T29.515.description": "Thức ăn của vệ sĩ, tỏa mùi rất thơm\n",
    "T29.516.name": "Cành Cây Khiết Tịnh",
    "T29.516.reqClass": "|1|2|3|4|5|6|",
    "T29.516.description": "Cành cây non sạch, nghe nói nấu canh có thể thanh\nlọc cơ thể, không lo bị nóng.\n",
    "T29.517.name": "Canh Giải Độc",
    "T29.517.reqClass": "|1|2|3|4|5|6|",
    "T29.517.description": "Thuốc giải độc đặc chế của ông chủ tiệm thuốc Xuất\nVân, chuyên trị ngộ độc thức ăn, người uống phải\nuống hết trong một lần\n",
    "T29.523.name": "Thư Của Trưởng Lão",
    "T29.523.reqClass": "|1|2|3|4|6|5|",
    "T29.523.description": "Thư của trưởng lão ở Vô Ưu gửi trưởng thương hội\nĐông Huyền, nội dung là giúp đỡ điều tra việc sơn\nquái đột nhiên xuất hiện\n",
    "T29.524.name": "Tiêu Bản Đất",
    "T29.524.reqClass": "|1|2|3|4|6|5|",
    "T29.524.description": "Đất đã bị sa hóa trầm trọng, hoàn toàn không cảm\nthấy một tẹo sức sống nào.\n",
    "T29.525.name": "Thư Trưởng Thương Hội Bàng Bối",
    "T29.525.reqClass": "|1|2|3|4|6|5|",
    "T29.525.description": "Thư của Trưởng Thương Hội Đông Huyền, nội dung là\nđiều tra sự bỏ chạy của Tiểu Sơn Quái.\n",
    "T29.527.name": "Báo Cáo Phân Tích",
    "T29.527.reqClass": "|1|2|3|4|6|5|",
    "T29.527.description": "Tờ báo cáo chi tiết miêu tả sự thay đổi bất thường\ncủa quan hệ các loài trên Quang Bình Nguyên\n",
    "T29.528.name": "Sơ Đồ Dẫn Đường",
    "T29.528.reqClass": "|1|2|3|4|6|5|",
    "T29.528.description": "Đây là bản đồ của Vô Ưu đại lục được vẽ bằng máy,\ntrên đó chỉ vẽ duy nhất một đường ngang.\n",
    "T29.529.name": "Thư Cầu Viện",
    "T29.529.reqClass": "|1|2|3|4|6|5|",
    "T29.529.description": "Một bức thư cầu viện khẩn cấp\n",
    "T29.531.name": "Giấy Ủy Quyền Điều Tra",
    "T29.531.reqClass": "|1|2|3|4|6|5|",
    "T29.531.description": "Giấy ủy quyền của Vệ Sĩ Bàng Bối, tất cả những\nngười bị điều tra phải phối hợp vô điều kiện với\nbên điều tra\n",
    "T29.532.name": "Lục Lạc",
    "T29.532.reqClass": "|1|2|3|4|5|6|",
    "T29.532.description": "Lục lạc kỳ lạ, âm thanh trong trẻo nghe rất rõ\ntrong gió\n",
    "T29.533.name": "Mảnh Da Dê Kho Báu",
    "T29.533.reqClass": "|1|2|3|4|5|6|",
    "T29.533.description": "Ở vị trí Thiên Lục Châu (21,6) có chôn rất nhiều\nbáu vật. Sư thay đổi địa chất đã làm lộ ra các cơ\nquan bí mật ra ngoài mặt đất. Chắc chắn đã có\nchuyện đã xảy ra!\n",
    "T29.535.name": "Báo Cáo Của Thương Hội",
    "T29.535.reqClass": "|1|2|3|4|6|5|",
    "T29.535.description": "Báo cáo ghi chép quá trình chiến đấu dũng cảm của\nPhụ Trách Thương Đội với Thủ Lĩnh Sa Tặc\n",
    "T29.536.name": "Đơn Đặt Hàng Trang Bị",
    "T29.536.reqClass": "|1|2|3|4|6|5|",
    "T29.536.description": "Giáp nhẹ 50 bộ, thương hội Đông Huyền mua.\n",
    "T29.537.name": "Mật Thuật Kiếm",
    "T29.537.reqClass": "|1|2|3|4|5|6|",
    "T29.537.description": "Kiếm khắc rất nhiều hoa văn phức tạp, dường như\nchứa một năng lượng rất lớn, không thể nào trang\nbị và sử dụng\n",
    "T29.538.name": "Thư Giới Thiệu Của Thương Hội Đông Huyền",
    "T29.538.reqClass": "|1|2|3|4|6|5|",
    "T29.538.description": "Giấy chứng minh tư cách đại biểu do trưởng thương\nhội Đông Huyền cấp, chứng minh tư cách của người\nmang nó.\n",
    "T29.540.name": "Túi Quà Kim Cương",
    "T29.540.info": "Nhấp đôi mở túi quà",
    "T29.540.reqClass": "|1|2|3|4|5|6|",
    "T29.540.description": "Túi quà với vô số món quà hậu hĩnh",
    "T29.541.name": "Mật Ong",
    "T29.541.reqClass": "|1|2|3|4|5|6|",
    "T29.541.description": "Mật ong thơm ngào ngạt, ngọt lịm khiến loài người\nvà loài gấu đều thích ăn\n",
    "T29.542.name": "Chương Nhạc Thứ Nhất",
    "T29.542.reqClass": "|1|2|3|4|5|6|",
    "T29.542.description": "Chương nhạc miêu tả cảnh đẹp khi mặt trời mọc ở Lê\nDương\n",
    "T29.543.name": "Chương Nhạc Thứ Hai",
    "T29.543.reqClass": "|1|2|3|4|5|6|",
    "T29.543.description": "Chương nhạc miêu tả cảnh đẹp kỳ vĩ trên đại địa\n",
    "T29.544.name": "Chương Nhạc Thứ Ba",
    "T29.544.reqClass": "|1|2|3|4|5|6|",
    "T29.544.description": "Chương nhạc miêu tả sóng biển rì rào\n",
    "T29.545.name": "Chương Nhạc Thứ Tư",
    "T29.545.reqClass": "|1|2|3|4|5|6|",
    "T29.545.description": "Chương nhạc miêu tả buổi sáng thức giấc của người\nVô Ưu\n",
    "T29.546.name": "Chương Nhạc Thứ Năm",
    "T29.546.reqClass": "|1|2|3|4|5|6|",
    "T29.546.description": "Chương nhạc miêu tả buổi lao động cần cù của người\nVô Ưu\n",
    "T29.547.name": "Chương Nhạc Thứ Sáu",
    "T29.547.reqClass": "|1|2|3|4|5|6|",
    "T29.547.description": "Chương nhạc miêu tả người Vô Ưu chia sẻ thành quả\n",
    "T29.548.name": "Chương Nhạc Cuối Cùng",
    "T29.548.reqClass": "|1|2|3|4|5|6|",
    "T29.548.description": "Chương nhạc miêu tả cảnh đêm, tự do, tĩnh mịch\n",
    "T29.549.name": "Rương Của Thợ Mỏ",
    "T29.549.reqClass": "|1|2|3|4|5|6|",
    "T29.549.description": "Rương công cụ mòn nghiêm trọng, cầm lên so sánh đã\nnhẹ hơn rất nhiều\n",
    "T29.550.name": "Rương Rỗng",
    "T29.550.reqClass": "|1|2|3|4|5|6|",
    "T29.550.description": "Rương rỗng không một vật dụng bên trong, thể tích\ntương đối lớn, cản thận kẻo làm làm hỏng\n",
    "T29.551.name": "Rương Nặng",
    "T29.551.reqClass": "|1|2|3|4|5|6|",
    "T29.551.description": "Rương rất nặng của thợ mỏ đựng đầy dụng cụ, muốn\nmang đi phải cần có sức khỏe tốt\n",
    "T29.552.name": "Vuốt Của Gấu Tuyết",
    "T29.552.reqClass": "|1|2|3|4|5|6|",
    "T29.552.description": "Móng vuốt cứng có thể đào đất, ở vùng tuyết băng\ngiá, gấu tuyết dựa vào khả năng đào bới, bắt mồi\nvà chiến đấu của nó để sinh tồn\n",
    "T29.553.name": "Công Cụ Mòn",
    "T29.553.reqClass": "|1|2|3|4|5|6|",
    "T29.553.description": "Công cụ của thợ mỏ vì dùng linh tinh nên bị mòn\nnghiêm trọng\n(có thể nhận từ Độc Nhãn Đào Quặng)",
    "T29.555.name": "Nước Hôi Thối",
    "T29.555.reqClass": "|1|2|3|4|5|6|",
    "T29.555.description": "Dung dịch vừa đen vừa thối, đây thực sự lấy từ hồ\nLê Dương lên đây ư ?\n",
    "T29.556.name": "Dịch Của Phỉ Thúy Tinh",
    "T29.556.reqClass": "|1|2|3|4|5|6|",
    "T29.556.description": "Dịch trên người Phỉ Thúy Tinh ở Lê Dương Đảo,\ntrông thật gớm ghiếc",
    "T29.557.name": "Thần Bí Dược",
    "T29.557.reqClass": "|1|2|3|4|5|6|",
    "T29.557.description": "Dịch màu vàng tươi, ngửi rất có tính kích thích\n",
    "T29.558.name": "Nước Bọt Của Lang Bì Dương",
    "T29.558.reqClass": "|1|2|3|4|5|6|",
    "T29.558.description": "Nước bọt của Lang Bì Dương bị điên thật thối quá,\ntại sao chúng nó không đánh răng nhỉ?\n",
    "T29.559.name": "Vỏ Cây Lá Khô",
    "T29.559.reqClass": "|1|2|3|4|5|6|",
    "T29.559.description": "Lá cây khô rất dễ bị cháy\n",
    "T29.560.name": "Gốc Cây Lá Khô",
    "T29.560.reqClass": "|1|2|3|4|5|6|",
    "T29.560.description": "Cây khô, thật khó tưởng tượng vật này có thể sinh\ntrưởng ở đây!\n",
    "T29.561.name": "Vỏ Cây Lão Cổ Thụ",
    "T29.561.reqClass": "|1|2|3|4|5|6|",
    "T29.561.description": "Vỏ cây rất dày, có thể dày như độ dày của giáp\nsắt, có trên người của Lão Cổ Thụ ở Quang Bình\nNguyên\n",
    "T29.562.name": "Rễ Cây Lão Cổ Thụ",
    "T29.562.reqClass": "|1|2|3|4|5|6|",
    "T29.562.description": "Rễ cây rất to, lấy từ cây vô cùng lớn, có trên\nngười của Lão Cổ Thụ ở Quang Bình Nguyên\n",
    "T29.564.name": "Mật Gấu Tuyết",
    "T29.564.reqClass": "|1|2|3|4|5|6|",
    "T29.564.description": "Mật gấu tuyết là nguyên liệu quan trọng bổ trợ\nthánh dược nên nổi tiếng cả đại lục\n",
    "T29.565.name": "Thuốc Giải Đặc Chế",
    "T29.565.reqClass": "|1|2|3|4|5|6|",
    "T29.565.description": "Đây là loại đặc chế rất mạnh, nhớ lắc đều trước\nkhi sử dụng\n",
    "T29.566.name": "Hộp Kim Loại Kỳ Dị",
    "T29.566.reqClass": "|1|2|3|4|5|6|",
    "T29.566.description": "Hộp kim loại rất nhỏ, Ôc vệ sĩ gác biển đã giấu nó\ntrong hộp ốc rồi\n",
    "T29.567.name": "Tinh Thể Cát",
    "T29.567.reqClass": "|1|2|3|4|5|6|",
    "T29.567.description": "Hạt tinh thể rất nhỏ, dưới ánh trăng thường hiện\nlên màu tím mờ ảo thần bí\n",
    "T29.568.name": "Đá Sức Mạnh",
    "T29.568.reqClass": "|1|2|3|4|5|6|",
    "T29.568.description": "Hòn đá chứa sức mạnh to lớn\n",
    "T29.569.name": "Ánh Sáng Của Tuyết Liên",
    "T29.569.reqClass": "|1|2|3|4|5|6|",
    "T29.569.description": "Ánh sáng phát ra lung linh huyền ảo\n",
    "T29.572.name": "Túi Bưu Kiện",
    "T29.572.description": "Túi bưu kiện trống rỗng\n",
    "T29.573.name": "Vũ Khí Của A Vũ",
    "T29.573.reqClass": "|1|2|3|4|5|6|",
    "T29.573.description": "Chùy sắt đặc biệt, là vũ khí do thợ rèn đo thân\nthể của A Vũ mà rèn ra\n",
    "T29.574.name": "Mẩu Giấy Viết Mật Ngữ",
    "T29.574.reqClass": "|1|2|3|4|6|5|",
    "T29.574.description": "Bên trên viết một câu: Chúc mừng chiếc răng cửa\nđẹp mà dũng mãnh\n",
    "T29.575.name": "Thư Của Bối Tư",
    "T29.575.reqClass": "|1|2|3|4|6|5|",
    "T29.575.description": "Giấy ủy quyền của vệ sĩ Bàng Bối, tất cả những\nngười bị điều tra phải phối hợp vô điều kiện với\nbên điều tra\n",
    "T29.576.name": "Tiểu Mộc Chùy",
    "T29.576.reqClass": "|1|",
    "T29.576.description": "Vũ khí nhập môn của Đông Huyền, sử dụng để tập\nluyện\n",
    "T29.577.name": "Răng Khổng Lồ",
    "T29.577.reqClass": "|1|2|3|4|5|6|",
    "T29.577.description": "Răng của người này rất to, mùi hôi nồng nặc\n",
    "T29.578.name": "Mật Hải Tinh",
    "T29.578.reqClass": "|1|2|3|4|5|6|",
    "T29.578.description": "Gan của Tiểu Hải Tinh ở hồ Lê Dương có tác dụng\ntrừ yêu rất lớn\n",
    "T29.579.name": "Thuốc Thử Nghiệm Yêu Lực",
    "T29.579.reqClass": "|1|2|3|4|5|6|",
    "T29.579.description": "Ngửi có cảm giác ngột ngạt\n",
    "T29.580.name": "Cá Tươi",
    "T29.580.reqClass": "|1|2|3|4|5|6|",
    "T29.580.description": "Cá mới bắt từ khơi xa\n",
    "T29.581.name": "Chìa Khóa Gãy",
    "T29.581.info": "Nhấp đôi để sử dụng chìa khóa",
    "T29.581.reqClass": "|1|2|3|4|5|6|",
    "T29.581.description": "Một chiếc chìa khóa cổ, có vẻ ẩn chứa một bí mật\nnào đó. (Nhấp đôi để mở nhiệm vụ)",
    "T29.582.name": "Hòm Đồng",
    "T29.582.reqClass": "|1|2|3|4|6|5|",
    "T29.582.description": "Hàng hóa mà thương hội bị cướp\n",
    "T29.583.name": "《Sách Kỹ Năng Rèn》",
    "T29.583.reqClass": "|1|2|3|4|6|5|",
    "T29.583.description": "Một quyển sách ghi lại kiến thức rèn\n",
    "T29.585.name": "Thánh Thạch",
    "T29.585.reqClass": "|1|2|3|4|6|5|",
    "T29.585.description": "Tinh thể màu xanh do băng kết tinh và nước thánh\ntạo nên, tương đối đẹp\n",
    "T29.587.name": "Bưu Kiện 1",
    "T29.587.reqClass": "|1|2|3|4|6|5|",
    "T29.587.description": "Người nhận là Amy ở tiệm Pet\n",
    "T29.588.name": "Bưu Kiện 2",
    "T29.588.reqClass": "|1|2|3|4|6|5|",
    "T29.588.description": "Người nhận là Văn Văn ở tiệm trang sức\n",
    "T29.589.name": "Bưu Kiện 3",
    "T29.589.reqClass": "|1|2|3|4|6|5|",
    "T29.589.description": "Người nhận là Madoff ở tiệm vũ khí\n",
    "T29.590.name": "Bưu Kiện 4",
    "T29.590.reqClass": "|1|2|3|4|6|5|",
    "T29.590.description": "Người nhận là Tiên Tử Trị Thương\n",
    "T29.591.name": "Bưu Kiện 5",
    "T29.591.reqClass": "|1|2|3|4|6|5|",
    "T29.591.description": "Một bức thư khả nghi, chỉ ghi người nhận là trưởng\nthương hội Tinh Linh Thành, không nói rõ người gửi\n",
    "T29.592.name": "Thùng Hàng",
    "T29.592.reqClass": "|1|2|3|4|6|5|",
    "T29.592.description": "Hòm có đựng hàng hóa\n",
    "T29.593.name": "Gỗ Lợp Mái",
    "T29.593.reqClass": "|1|2|3|4|6|5|",
    "T29.593.description": "Gỗ tốt dùng để làm mái nhà\n",
    "T29.594.name": "Rượu Mật Ong",
