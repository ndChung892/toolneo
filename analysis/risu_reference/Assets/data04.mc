    "T29.7241.description": "Túi quà dành VIP",
    "T29.7242.name": "Túi Cặp Ma Thuật",
    "T29.7242.info": "Nhấp đôi để mở",
    "T29.7242.reqClass": "|1|2|3|4|6|5|",
    "T29.7242.description": "Chứa 1 tiểu tinh linh Cặp Pháp Thuật \n(Cấp độ mang theo là 80)",
    "T29.7243.name": "Huy Chương Pháp Thuật",
    "T29.7243.info": "Nhấp đôi sử dụng",
    "T29.7243.reqClass": "|1|2|3|4|6|5|",
    "T29.7243.description": "Danh hiệu Kỷ niệm cho ngày sinh nhật Vua Pháp\nThuật",
    "T29.7244.name": "Túi Thần Thú Kỷ Niệm XVII",
    "T29.7244.info": "Nhấp đôi để mở",
    "T29.7244.reqClass": "|1|2|3|4|6|5|",
    "T29.7244.description": "Chứa 3 Jery và 3 Lôi Lân Ảnh phẩm chất xanh dương",
    "T29.7245.name": "Huy Chương “Theo Đuổi Ánh Sáng”",
    "T29.7245.info": "Nhấp đôi sử dụng",
    "T29.7245.reqClass": "|1|2|3|4|6|5|",
    "T29.7245.description": "Nhận danh hiệu Theo Đuổi Ánh Sáng",
    "T29.7246.name": "Thời trang Thệ Ước Lam Ảo (30 Ngày)",
    "T29.7246.info": "Nhấp đôi để mở",
    "T29.7246.reqClass": "|1|2|5|3|6|4|",
    "T29.7246.description": "Mở nhận 1 Thời trang Thệ Ước Lam Ảo (30 Ngày)",
    "T29.7247.name": "Hộp Quà Quả Tinh Linh",
    "T29.7247.info": "Nhấp đôi để mở",
    "T29.7247.reqClass": "|1|2|5|3|6|4|",
    "T29.7247.description": "Mở có xác suất 20% nhận 3 Quả Tinh Linh (Lớn), \n30% nhận 3 Quả Tinh Linh (Vừa), \n50% nhận 3 Quả Tinh Linh Nhỏ",
    "T33.512.name": "Tầng 3 Lang Huyệt Động",
    "T33.1.name": "Xuất Vân Thôn",
    "T33.1.info": "Thôn nhỏ yên tĩnh nằm giữa đồi núi và đồng bằng\nphía tây đại lục, tương truyền là nơi khởi nguồn\nvăn minh Đại Lục Vô Ưu.",
    "T33.2.name": "Đông Xuất Vân",
    "T33.2.info": "Vùng ngoại ô Xuất Vân dẫn đến Đông Huyền, là nơi\nsăn bắn và luyện tập thích hợp cho cấp 6 - 10.",
    "T33.3.name": "Vân Đài",
    "T33.3.info": "Nơi bắt đầu học tập, nhận sự trợ giúp từ tự nhiên.\nThích hợp cho cấp độ từ 1 - 5.",
    "T33.4.name": "Thiện Tĩnh Địa",
    "T33.4.info": "Vùng đất sơ khai, nơi có kiến thức nghìn năm lưu\ntruyền lại. Thích hợp cho cấp độ từ 11 - 15.",
    "T33.5.name": "Lê Dương Thôn",
    "T33.5.info": "Thôn nhỏ ven hồ Lê Dương có phong cảnh hữu tình mê\nhoặc người lữ khách. Thích hợp cho cấp độ từ 51 -\n55.",
    "T33.6.name": "Lê Dương Nam",
    "T33.6.info": "Vùng đất nguy hiểm nhất của Lê Dương, rất ít người\nqua lại. Thích hợp cho cấp độ từ 61 - 65.",
    "T33.7.name": "Quân Cổ Đạo",
    "T33.7.info": "Nơi ở của thánh hiền quân tử, giúp rèn luyện tính\nkhiêm tốn học hỏi, kiên cường bất khuất. Thích hợp\ncho cấp độ từ 81- 85.",
    "T33.8.name": "Tháp Khắc Nguyên",
    "T33.8.info": "Rừng cây rộng lớn nằm giữa Lê Dương và Hư Không\nMạc, là nơi ở của bầy sói. Thích hợp cho cấp độ từ\n46 - 50.",
    "T33.9.name": "Đông Huyền Thành",
    "T33.9.info": "Thành phố nằm ngay giữa đại lục, là trung tâm hành\nchính, văn hóa, giao thông của đại lục.",
    "T33.10.name": "Tinh Linh Thành",
    "T33.10.info": "Thành phố xanh tươi nằm ven rừng, nổi tiếng với\ntruyền thuyết tinh linh, mang đầy sức sống thiên\nnhiên.",
    "T33.11.name": "Linh Vũ Tộc",
    "T33.11.info": "Tộc Linh Vũ nằm ở phía nam đại lục, là nơi đào tạo\nra những danh y tài ba và thông hiểu lễ nghĩa.",
    "T33.12.name": "Bàn Địa Tộc",
    "T33.12.info": "Nằm phía đông nam Quang Bình Nguyên, đào tạo ra\nnhững chiến binh nổi danh với tên gọi \"Lá chắn của\nđại lục\".",
    "T33.13.name": "Liêu Vân Tộc",
    "T33.13.info": "Nằm trên đỉnh núi tuyết phía tây, là cái nôi ươm\ntạo nghệ thuật gia âm nhạc.",
    "T33.14.name": "Hư Không Mạc",
    "T33.14.info": "Nơi có nhiều vật quý, nhưng là vùng đất chết, vô\nsố sinh linh đã bị chôn vùi. Thích hợp cho cấp độ\ntừ 56 - 60.",
    "T33.15.name": "Lê Dương Bắc",
    "T33.15.info": "Phía bắc hồ Lê Dương là nguồn nước của Đông Huyền,\ntuy phong cảnh hữu tình nhưng khá nguy hiểm. Thích\nhợp cho cấp độ từ 16 - 20",
    "T33.16.name": "Ngọc Phong Lâm",
    "T33.16.info": "Chim hót véo von, bướm ong bay lượn, trăm hoa đua\nnở, tựa chốn thiên đường. Thích hợp cho cấp độ từ\n71 - 75.",
    "T33.17.name": "Lê Dương Đảo",
    "T33.17.info": "Hòn đảo bé nhỏ như con thuyền đậu trên mặt hồ, là\nnơi đi dễ khó về. Thích hợp cho cấp độ từ 21 - 30.",
    "T33.18.name": "Kỳ Thạch Địa",
    "T33.18.info": "Vùng đất từng là nơi cư ngụ của một nền văn minh\nviễn cổ. Thích hợp cho cấp độ từ 86 - 90.",
    "T33.19.name": "Linh Lan",
    "T33.19.info": "Đường mòn trong núi trải đầy cánh lan, khung cảnh\nđẹp nhưng tiềm tàng mối nguy hiểm. Thích hợp cho\ncấp độ từ 91 - 95.",
    "T33.20.name": "Thánh Ước Địa",
    "T33.20.info": "Nơi hẹn ước của công chúa và hoàng tử, giờ đây trở\nthành nơi hẹn ước của các đôi yêu nhau. Thích hợp\ncho cấp độ từ 116 - 120.",
    "T33.21.name": "Chỉ Phong Cốc",
    "T33.21.info": "Vùng đất khô cằn chết chóc. Thích hợp cho cấp độ\ntừ 91 - 95.",
    "T33.22.name": "Tuyết Lâm",
    "T33.22.info": "Vùng đất tuyết phủ nhưng không kém phần tươi đẹp\nnhờ vào rừng hoa đỏ tươi rực rỡ. Thích hợp cho cấp\nđộ từ 81 - 85.",
    "T33.23.name": "Phục Ma Cốc",
    "T33.23.info": "Hang động tối tăm vô cùng đáng sợ. Yêu cầu cấp độ\n96 - 100.",
    "T33.24.name": "Hộ Chi Địa",
    "T33.24.info": "Việc bảo hộ là mãi mãi, nhưng anh hùng lại không\nthể bất tử. Thích hợp cho cấp độ từ 101 - 110.",
    "T33.25.name": "Lưu Hỏa Tộc",
    "T33.25.info": "Tộc Lưu Hỏa nằm ở phía bắc đại lục, được thừa kế\ndi sản về võ thuật do cổ nhân lưu truyền.",
    "T33.26.name": "Quang Bình Nguyên",
    "T33.26.info": "Vùng đất nằm ở hướng mặt trời mọc, nơi sinh sống\ncủa các tinh linh. Thích hợp cho cấp độ từ 26 -\n30.",
    "T33.27.name": "Trầm Thụy Lâm",
    "T33.27.info": "Vùng rừng cây rậm rạp, mặt trời không chiếu tới,\nsương mù dày đặc. Thích hợp cho cấp độ từ 41 - 45.",
    "T33.28.name": "Vân Lộc Sơn",
    "T33.28.info": "Ban ngày có mây trắng bao phủ, nhưng đêm xuống lại\ncó thể nhìn rõ bầu trời sao sáng rực. Thích hợp\ncho cấp độ từ 76 - 80.",
    "T33.29.name": "Mê Quang Tự",
    "T33.29.info": "Không ai có thể sống sót rời khỏi nơi đây để kể về\nvùng đất này. Thích hợp cho cấp độ từ 106 - 110.",
    "T33.30.name": "Quyến Cố Thành",
    "T33.30.info": "Nhờ được thiên thần bảo hộ mà người dân nơi đây\nluôn được sống thanh bình.",
    "T33.31.name": "Tiên Lạp Thành",
    "T33.31.info": "Thành phố xinh đẹp nằm ở đông đảo băng, nổi danh\nvới tên gọi Thành phố của nghệ thuật.",
    "T33.32.name": "Thiên Khung Tộc",
    "T33.32.info": "Nằm phía đông bắc đảo băng, là nơi lưu trú của các\nxạ thủ tinh anh, vững về kỹ thuật máy và năng\nlượng học",
    "T33.33.name": "Lạp Tuyết Địa",
    "T33.33.info": "Vùng đất bên ngoài thành Tiên Lạp, băng tuyết phủ\nđầy trên mặt đất. Thích hợp cho cấp độ từ 21 - 25.",
    "T33.34.name": "Anh Vũ Cảnh",
    "T33.34.info": "Vùng đất trên đỉnh núi tuyết, đầy vẻ mê hoặc nhưng\ncũng nguy hiểm khó lường. Thích hợp cho cấp độ từ\n36 - 40.",
    "T33.35.name": "Băng Tuyết Nguyên",
    "T33.35.info": "Mùa đông trường kỳ nơi đây khiến cho chim chóc\nkhông bay tới, hoa cỏ khó sinh sôi. Thích hợp cho\ncấp độ từ 71 - 75.",
    "T33.36.name": "Thần Di Cảnh",
    "T33.36.info": "Vùng đất bị lãng quên và trở thành nơi bắt nguồn\ncủa ác ma. Thích hợp cho cấp độ từ 111 - 115.",
    "T33.37.name": "Cổ Thành",
    "T33.37.info": "Cổ Thành chứa đựng những năng lực tà ác và thần bí\ntừ tàn tích chiến tranh năm xưa.Thích hợp cho cấp\nđộ từ 146 - 150.",
    "T33.38.name": "Bàng Bối Thành",
    "T33.38.info": "Thành cổ sừng sững tại tây nam đại lục, được ca\ntụng là thành trì của anh hùng.",
    "T33.39.name": "Huyền Lâm Tộc",
    "T33.39.info": "Tộc Huyền Lâm nằm ở bờ tây đại lục, nổi tiếng với\nnhững thợ săn dày dạn kinh nghiệm và kỹ năng thuần\nphục Pet.",
    "T33.40.name": "Thiên Lục Châu",
    "T33.40.info": "Nơi dừng chân của khách lữ hành, thương nhân ra\nvào tấp nập. Thích hợp cho cấp độ từ 16 - 20.",
    "T33.41.name": "Kỵ Bình Nguyên",
    "T33.41.info": "Con đường huyết mạch dẫn đến Bàng Bối, có cuồng\nnhân ẩn cư và còn lại vết tích của người xưa.\nThích hợp cho cấp độ từ 31- 35.",
    "T33.42.name": "Cổ Đạo",
    "T33.42.info": "Ba nghìn chiến binh đã vùi thân tại đây, ý chí bất\ndiệt, hồn thiêng động trời. Thích hợp cho cấp độ\ntừ 66 - 70.",
    "T33.43.name": "Đoạn Cốc",
    "T33.43.info": "Vùng đất lạnh giá nhất nhưng có cảnh đẹp mê người,\ntuy nhiên cũng không phải không nguy hiểm. Thích\nhợp cho cấp độ từ 120 - 130.",
    "T33.44.name": "Đăng Vân Địa",
    "T33.44.info": "Ẩn sâu trong những đám mây trắng là một nguồn sức\nmạnh tà ác. Thích hợp cho cấp độ từ 141 - 145.",
    "T33.45.name": "Tử Mộng Cảnh",
    "T33.46.name": "Kiếm Hồn Cảnh",
    "T33.47.name": "Không Gian Ma Chiến",
    "T33.48.name": "Trấn Ma Tháp",
    "T33.49.name": "Bang Hội",
    "T33.50.name": "Khoáng Động",
    "T33.51.name": "Bảo Tàng Mật Thất",
    "T33.52.name": "Tầng 50 Trấn Ma Tháp",
    "T33.53.name": "Tân Tuyết Địa",
    "T33.54.name": "Chiến Trường Bang Hội",
    "T33.55.name": "Điêu Linh Thôn",
    "T33.55.info": "Nơi ở của Thiên Binh khi xưa, nay đã bị quái vật\nbay chiếm lĩnh, trở nên hoang tàn. Thích hợp cho\ncấp độ từ 131 - 135.",
    "T33.56.name": "Mị Hoặc Lâm",
    "T33.56.info": "Rừng rậm đầy yêu ma mê hoặc, rất dễ lạc lối. Thích\nhợp cho cấp độ từ 136 - 140.",
    "T33.519.name": "Tầng 3 Liệt Diễm Thâm Uyên",
    "T33.520.name": "Tầng 4 Liệt Diễm Thâm Uyên",
    "T33.59.name": "Giác Đấu Đông Huyền",
    "T33.60.name": "Chiến Trường Achilles",
    "T33.61.name": "Tử Tức Đảo",
    "T33.61.info": "Hòn đảo sương mù vây quanh, chỉ nhìn thấy ánh sáng\ntừ các tảng đá khổng lồ bí ẩn. Thích hợp cho cấp\nđộ 100-105.",
    "T33.62.name": "Bản đồ mới ++2",
    "T33.63.name": "Lễ Đường Hôn Lễ Cao Cấp",
    "T33.513.name": "Tầng 3 Lang Huyệt Động",
    "T33.514.name": "Tầng 4 Lang Huyệt Động",
    "T33.515.name": "Ảo Ma Tháp",
    "T33.516.name": "Tầng 1 Không Gian Đa Chiều",
    "T33.517.name": "Tầng 1 Liệt Diễm Thâm Uyên",
    "T33.518.name": "Tầng 2 Liệt Diễm Thâm Uyên",
    "T33.70.name": "Mã Thạch Tuyết",
    "T33.70.info": "Hoang mạc lạnh giá, quái vật ở đây còn lạnh lùng\nhơn khí hậu. Thích hợp cho cấp độ 110 - 115.",
    "T33.71.name": "Thiên Đường Thần Thánh",
    "T33.71.info": "Nơi sinh linh đồ thán, vong hồn tứ tán, bay lượn\nngợp trời. Thích hợp cho cấp độ từ 56-60.",
    "T33.72.name": "Đấu Trường Bánh Kem",
    "T33.65.name": "Lễ Đường Hôn Lễ Quý Giá",
    "T33.66.name": "Khu Hoang Mạc",
    "T33.66.info": "Không ai muốn biết nơi thần bí này. Đây là nơi tận\ncùng của không gian và thời gian, là nơi an nghỉ\ncủa những thủ hộ Vô Ưu. Thích hợp cho cấp độ từ\n120-125.",
    "T33.58.name": "Nông Trường Số 2",
    "T33.68.name": "Phong Bạo Cốc",
    "T33.68.info": "Thung lùng quanh năm bị bão táp tàn phá chỉ còn\nlại tàn tích. Thích hợp cho cấp độ từ 115 - 120.",
    "T33.69.name": "Phụ Bản Quỷ Hút Máu",
    "T33.69.info": "Nơi hoang sơ cuối đường chân trời đỏ thẳm, hoang\nvu, chỉ còn tiếng gió rít hàng đêm. Nơi này hầu\nnhư đã bị chìm vào dĩ vãng của lịch sử. Thích hợp\ncho cấp độ từ 110 - 115.",
    "T33.527.name": "Học Viện Đông Huyền",
    "T33.528.name": "Đảo Thần Bí",
    "T33.528.info": "Hòn đảo kỳ bí nhất Vô Ưu, thoắt ẩn thoắt hiện!",
    "T33.554.name": "Ào Cảnh Tầng 17",
    "T33.554.info": "Đây là nơi quái vật tứ phương đều tụ tập về. Cấp\nđộ đề nghị 105 - 110",
    "T33.64.name": "Lễ Đường Hôn Lễ Thông Thường",
    "T33.531.name": "Tầng 5 Thế Giới Hải Dương",
    "T33.75.name": "Đấu Trường Tranh Bá",
    "T33.57.name": "Nông Trường Số 1",
    "T33.534.name": "Sào Huyệt Vua Người Tuyết",
    "T33.521.name": "Tầng 1 Thế Giới Hải Dương",
    "T33.522.name": "Tầng 2 Thế Giới Hải Dương",
    "T33.523.name": "Tầng 3 Thế Giới Hải Dương",
    "T33.524.name": "Tầng 4 Thế Giới Hải Dương",
    "T33.525.name": "Thành Phố Chìm",
    "T33.525.info": "Một di tích văn minh được chôn giấu dưới tầng biển\nsâu và 1 bí mật động trời.",
    "T33.526.name": "Quỷ Môn Quan",
    "T33.526.info": "Quỷ Môn dần dần khai mở, hàng trăm yêu ma hoành\nhành.",
    "T33.541.name": "Ào Cảnh Tầng 4",
    "T33.541.info": "Đây từng là trung tâm văn hóa, chính trị, giao\nthông của toàn Đại Lục Vô Ưu rộng lớn này.",
    "T33.555.name": "Ào Cảnh Tầng 18",
    "T33.555.info": "Một nơi thần bí chưa ai tìm hiểu được. Nơi đây\nđược xem là tận cùng của không gian và thời gian,\ncũng là nơi bắt đầu hồi sinh của vạn vật. Cấp độ\nđề nghị 120 - 125",
    "T33.67.name": "Vĩnh Dạ Cảng",
    "T33.67.info": "Hải cảng thần bí ẩn hiện dưới ánh trăng mờ ảo.\nThích hợp cấp độ 105 - 110.",
    "T33.530.name": "Tây Võ Đài Đông Huyền",
    "T33.545.name": "Ào Cảnh Tầng 8",
    "T33.545.info": "Khu rừng bám đầy rong rêu nằm tận trong rừng già\nsâu thẳm",
    "T33.532.name": "Hội Trường Phân Chia",
    "T33.533.name": "Ký Ức Tinh Linh Thành",
    "T33.533.info": "Khu rừng bám đầy rong rêu nằm tận trong rừng già\nsâu thẳm",
    "T33.548.name": "Ào Cảnh Tầng 11",
    "T33.548.info": "Bên ngoài thành Tiên Lạp, băng tuyết phủ đầy nhưng\nvô số sinh vật sinh sôi nảy nở. Cấp độ đề nghị 21\n- 25",
    "T33.73.name": "Chiến Trường Dũng Sĩ",
    "T33.101.name": "Đấu Trường Đoạt Bảo",
    "T33.102.name": "Nơi Thi Câu Cá",
    "T33.552.name": "Ào Cảnh Tầng 15",
    "T33.552.info": "Nơi đây có địa hình và văn mình gần như thành phố\nchìm, ẩn chứa nhiều bí mật của Đại Lục Vô Ưu",
    "T33.553.name": "Ào Cảnh Tầng 16",
    "T33.553.info": "Đây là nơi anh hùng tứ xứ tề tụ luận đàm về các bí\nkíp thuật học",
    "T33.540.name": "Ào Cảnh Tầng 3",
    "T33.540.info": "Cấp độ đề nghị 21 -30",
    "T33.568.name": "Tầng 7 Không Gian Mê Đồ",
    "T33.556.name": "Ào Cảnh Tầng 19",
    "T33.556.info": "Nơi lạnh nhất trên thế giới nhưng phong cảnh nơi\nnày cũng thuộc dạng tuyệt mỹ. Cấp độ đề nghị 120 -\n130",
    "T33.557.name": "Ào Cảnh Tầng 20",
    "T33.557.info": "Thành phố được lập ở phía đông Băng Đảo. Nơi đây\nđược mệnh danh là thành đô của nghệ thuật",
    "T33.529.name": "Đông Võ Đài Đông Huyền",
    "T33.572.name": "Tầng 11 Không Gian Mê Đồ",
    "T33.546.name": "Ào Cảnh Tầng 9",
    "T33.546.info": "Nơi được bảo hộ vĩnh hằng. Cấp độ đề nghị 101 -\n110",
    "T33.547.name": "Ào Cảnh Tầng 10",
    "T33.547.info": "Nơi tiềm tàng năng lượng của của Đại Lục Vô Ưu.\nCấp độ đề nghị 26 -30",
    "T33.575.name": "Tầng 14 Không Gian Mê Đồ",
    "T33.549.name": "Ào Cảnh Tầng 12",
    "T33.549.info": "Dưới sự bảo hộ của các thiên thần, nơi này chưa\ntừng bị xâm lược, vì vậy đây được xem là lạc viên\nmà ai cũng muốn đến",
    "T33.550.name": "Ào Cảnh Tầng 13",
    "T33.550.info": "Nơi này bị bỏ hoang nhiều năm, trở thành nơi trú\nngụ của các cô hồn dạ quỷ. Cấp độ đề nghị 111 -\n115",
    "T33.551.name": "Ào Cảnh Tầng 14",
    "T33.551.info": "Chiến trường ma thần thời viễn cổ, mang năng lượng\ncủa thần tiên lẫn cả ác ma. Cấp độ đề nghị 146 -\n150",
    "T33.537.name": "Phòng Chờ 3",
    "T33.538.name": "Ào Cảnh Tầng 1",
    "T33.538.info": "Nơi nhận năng lượng tự nhiên, tìm kiếm mục tiêu\ncho chính mình. Cấp độ đề nghị 1 - 5",
    "T33.539.name": "Ào Cảnh Tầng 2",
    "T33.539.info": "Lê Dương Hồ Nhạn,sầu sầu hồ thủy, đông huyền chi\nnguyên, nguy cơ man viên. Cấp độ đề nghị 16 - 20",
    "T33.569.name": "Tầng 8 Không Gian Mê Đồ",
    "T33.570.name": "Tầng 9 Không Gian Mê Đồ",
    "T33.542.name": "Ào Cảnh Tầng 5",
    "T33.542.info": "Nhân chi thánh triết, trúc chi quân tử. Cấp độ đề\nnghị 81 - 85",
    "T33.543.name": "Ào Cảnh Tầng 6",
    "T33.543.info": "Nơi yên tĩnh bên ngoài thành, cấp độ đề nghị 91 -\n95",
    "T33.544.name": "Ào Cảnh Tầng 7",
    "T33.544.info": "Đây từng là nơi ước định giữa công chúa và hoàng\ntử năm xưa. Sau đó bị ác ma xâm lược, hoành hành.\nCấp độ đề nghị 116 - 120",
    "T33.574.name": "Tầng 13 Không Gian Mê Đồ",
    "T33.76.name": "Quảng Trường Kỳ Thạch",
    "T33.77.name": "Phòng Trò Chuyện",
    "T33.563.name": "Tầng 2 Không Gian Mê Đồ",
    "T33.564.name": "Tầng 3 Không Gian Mê Đồ",
    "T33.565.name": "Tầng 4 Không Gian Mê Đồ",
    "T33.535.name": "Phòng Chờ 1",
    "T33.536.name": "Phòng Chờ 2",
    "T33.83.name": "Hành Lang Vô Tận\n- Đoạn Không",
    "T33.84.name": "Hành Lang Vô Tận\n- Địa Ngục",
    "T33.85.name": "Hành Lang Vô Tận\n- Thâm Uyên",
    "T33.571.name": "Tầng 10 Không Gian Mê Đồ",
    "T33.110.name": "Huyết Sắc Cổ Bích",
    "T33.573.name": "Tầng 12 Không Gian Mê Đồ",
    "T33.559.name": "Không Gian Tín Niệm",
    "T33.559.info": "Nơi lạnh nhất trên thế giới, ẩn sau là phong cảnh\ntuyệt mỹ. Cấp độ đề nghị 120 - 130",
    "T33.560.name": "Không Gian Vận Mệnh",
    "T33.576.name": "Tầng 15 Không Gian Mê Đồ",
    "T33.562.name": "Tầng 1 Không Gian Mê Đồ",
    "T33.80.name": "Hành Lang Vô Tận\n- Hỏa Diệm",
    "T33.81.name": "Hành Lang Vô Tận\n- Băng Lửa",
    "T33.82.name": "Hành Lang Vô Tận\n- Quyết Định",
    "T33.566.name": "Tầng 5 Không Gian Mê Đồ",
    "T33.567.name": "Tầng 6 Không Gian Mê Đồ",
    "T33.583.name": "Không Gian Bí Mật",
    "T33.86.name": "Hành Lang Vô Tận\n- Luân Hồi",
    "T33.87.name": "Ảo Địa Tiêu Trừ",
    "T33.88.name": "Thiên Không Thành",
    "T33.88.info": "Truyền thuyết khai mở, chấn động trời đất. Nơi này\nđược xem là điểm tận cùng của tuổi tác và thời\nđại. Một thành trì trên không tĩnh lặng giữa chốn\nĐại Lục Vô Ưu. Cấp độ đề nghị : 150 - 160.",
    "T33.587.name": "Không Gian Tĩnh Mịch",
    "T33.588.name": "Thủ Vệ Viễn Cổ",
    "T33.558.name": "Không Gian Luân Hồi",
    "T33.78.name": "Chiến Trường Tula",
    "T33.79.name": "Hành Lang Vô Tận\n- Khởi Trình",
    "T33.561.name": "Không Gian Dũng Khí",
    "T33.578.name": "Rừng Rậm Số",
    "T33.579.name": "Thế Giới Chân Lý",
    "T33.580.name": "Ác Ma Đảo",
    "T33.581.name": "Hàng Lang Nguyên Tố",
    "T33.582.name": "Vùng Đất Cạm Bẫy",
    "T33.584.name": "Hành Lang Nguy Hiểm",
    "T33.584.info": "Một sơn cốc hẹp dài vô tạn giữa những ngọn núi\ncao, con người cây cỏ nơi này đều chìm trong bóng\ntối. Cấp độ đề nghị: 115 - 120.",
    "T33.585.name": "Tiểu Đảo Cô Lập",
    "T33.586.name": "Tháp Trí Tuệ",
    "T33.602.name": "Tầng 3 Sự kiện Kho Báu Đại Mạc",
    "T33.603.name": "Tầng 4 Sự kiện Kho Báu Đại Mạc",
    "T33.604.name": "Tầng 5 Sự kiện Kho Báu Đại Mạc",
    "T33.150004.name": "Hộp Quà Bí Ẩn",
    "T33.150005.name": "Bắn Tỉa Chuẩn Xác",
    "T33.150006.name": "Kiểm Tra Chiến Lực",
    "T33.577.name": "Tầng 2 Không Gian Đa Chiều",
    "T33.600.name": "Tầng 1 Sự kiện Kho Báu Đại Mạc",
    "T33.601.name": "Tầng 2 Sự kiện Kho Báu Đại Mạc",
    "T33.140104.name": "Mật Đạo 3",
    "T33.140105.name": "Mật Đạo 2",
    "T33.140106.name": "Mật Đạo 1",
    "T33.2000.name": "Cạnh Kỹ Trường",
