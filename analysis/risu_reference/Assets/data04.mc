    "T35.1523.name": "Dịch Chuyển Chiến Trường",
    "T35.1524.onServiceText": "Ngoài việc có thể học kỹ năng bang hội, các thành\nviên còn nhận được nhiều phúc lợi khác!",
    "T35.1524.name": "Quản Lý Phúc Lợi Bang Hội",
