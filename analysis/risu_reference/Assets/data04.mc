    "T29.1516.name": "Lễ Hộp Bánh Ú",
    "T29.1516.info": "Nhấp đôi mở túi quà",
    "T29.1516.reqClass": "|1|2|3|4|6|5|",
    "T29.1516.description": "Bên trong chứa bánh bao rất ngon\n",
    "T29.1517.name": "Rương Đồ Chơi",
    "T29.1517.info": "Nhấp đôi mở túi quà",
    "T29.1517.reqClass": "|1|2|3|4|6|5|",
    "T29.1517.description": "Quà mừng ngày Quốc tế thiếu nhi 1/6, mọi người\ncùng đến chơi nào!\n",
    "T29.1518.name": "Túi Quà Tết Đoan Ngọ",
    "T29.1518.info": "Nhấp đôi mở túi quà",
    "T29.1518.reqClass": "|1|2|3|4|6|5|",
    "T29.1518.description": "Túi quà mừng Đoan Ngọ, bên trong có bánh rất ngon\nvà các vật phẩm khác\n",
    "T29.1519.name": "Bánh Ú Xuất Vân",
    "T29.1519.info": "Tăng 600 điểm giới hạn HP trong 15 phút, dùng khi\nkhông chiến đấu",
    "T29.1519.reqClass": "|1|2|3|4|5|6|",
    "T29.1519.description": "Bánh nhân thịt gà cực ngon, đặc sản của Xuất Vân\nThôn, mang đến cho bạn sức sống tràn trề\n",
    "T29.1520.name": "Bánh Ú Bàng Bối",
    "T29.1520.info": "Tăng 300 điểm tấn công trong 15 phút, dùng khi\nkhông chiến đấu",
    "T29.1520.reqClass": "|1|2|3|4|5|6|",
    "T29.1520.description": "Bánh nhân đậu đỏ cực ngon, đặc sản của Bàng Bối,\ngiúp bạn tăng thêm lòng dũng cảm\n",
    "T29.1521.name": "Bánh Ú Tiên Lạp",
    "T29.1521.info": "Tăng 500 điểm phòng ngự trong 15 phút, dùng khi\nkhông chiến đấu",
    "T29.1521.reqClass": "|1|2|3|4|5|6|",
    "T29.1521.description": "Bánh sữa thơm ngon, đặc sản của Tiên Lạp, giúp bạn\nđao thương bất nhập\n",
    "T29.1522.name": "Bánh Ú Tinh Linh",
    "T29.1522.info": "Tăng 60% tốc độ tấn công trong 15 \n phút, dùng khi không chiến đấu",
    "T29.1522.reqClass": "|1|2|3|4|5|6|",
    "T29.1522.description": "Bánh nhân nấm, tinh hoa của rừng sâu \n Tinh Linh, giúp thân thể bạn trở nên nhanh nhẹn",
    "T29.1523.name": "Bánh Ú Đông Huyền",
    "T29.1523.info": "Tăng 15% tỷ lệ bạo kích trong 15 phút, dùng khi\nkhông chiến đấu",
    "T29.1523.reqClass": "|1|2|3|4|5|6|",
    "T29.1523.description": "Bánh nhân hải sản sử dụng những hải sản tươi ngon\ncủa Đông Huyền, giúp bạn có thêm lòng tin\n",
    "T29.1524.name": "Thẻ Tiểu Cương Thi (1 tháng)",
    "T29.1524.info": "Thời gian biến thân duy trì trong 1 giờ",
