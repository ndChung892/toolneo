    "T35.1493.onServiceText": "Các ngươi đúng là trời sinh 1 cặp, hôm nay được ở\nbên nhau, ngày sau phải biết trân trọng, chúc các\nngươi hạnh phúc",
    "T35.1493.name": "Tộc Trưởng Bối Tư",
    "T35.1494.name": "Dâu Phụ",
    "T35.1495.name": "Rể Phụ",
    "T35.1496.name": "Dâu Phụ",
    "T35.1497.name": "Rể Phụ",
    "T35.1498.name": "Dâu Phụ",
    "T35.1499.name": "Rể Phụ",
    "T35.1500.name": "Dâu Phụ",
    "T35.1501.name": "Rể Phụ",
    "T35.1502.onServiceText": "Nếu có Thất Sắc Hoa và Cỏ Cầu Vồng thì có thể đến\nchỗ ta để nhuôm màu cho bản thân hoặc pet",
    "T35.1502.name": "Thợ Nhuộm",
    "T35.1503.name": "Thạch Long",
    "T35.1504.onServiceText": "Cây bé nhỏ vừa được trồng",
    "T35.1504.name": "Cây Xanh Tết Trồng Cây",
    "T35.1505.subType": "all",
    "T35.1505.onServiceText": "Đừng có cản ta! Đừng có cản ta! Ở đây chỗ nào cũng\nlà kho báu!!!",
    "T35.1505.name": "Tộc Navi Điên Loạn",
    "T35.1506.onServiceText": "Nếu ta biết được cách điều khiển long tộc thì ta\nsẽ chinh phục được cả thế giới! Ha ha ha!",
    "T35.1506.name": "Thuật Sĩ Đào Mỏ",
    "T35.1507.scriptOff": "var script_index = 0; var script_node = null;var\nexpNumScp = 2.5;var monNumScp = 0.7;if( c\n){\tif(c.inGroup()) \t{\t\tscript_node =\nc.memberList.head;\t}\telse \t{\t\tscript_node =\n{};\t\tscript_node.obj =\nc.data.id;\t}\twhile(script_node != null)\t{\nvar spt_player = getCharactor( script_node.obj\n);\t\taddChaExp(script_node.obj,\nBASIC_GET_EXP[spt_player.level]*expNumScp);\t\taddMoney(script_node.obj\n,\"moneyBind\",\nBASIC_GET_MONEY[spt_player.level]*monNumScp);\t\tvar\nscript_obj =\ngetPlanByRate(\"3-1135\");\t\tif(script_obj)\t\t{\t\t\taddItemByPlan(script_node.obj,\nscript_obj, 1);\t\t}\t\tscript_index ++;\t\tscript_node\n= script_node.next;\t}}",
