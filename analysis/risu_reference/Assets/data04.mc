    "T35.1863.subType": "all",
    "T35.1863.name": "Tinh Linh Nước",
    "T35.1864.scriptOff": "var script_index = 0; var script_node = null;var\nexpNumScp = 1.5;var monNumScp = 0.5;if( c\n){\tif(c.inGroup()) \t{\t\tscript_node =\nc.memberList.head;\t}\telse \t{\t\tscript_node =\n{};\t\tscript_node.obj =\nc.data.id;\t}\twhile(script_node != null)\t{\t\tvar\nspt_player = getCharactor( script_node.obj\n);\t\taddChaExp(script_node.obj,\nBASIC_GET_EXP[spt_player.level]*expNumScp);\t\taddMoney(script_node.obj\n,\"moneyBind\",\nBASIC_GET_MONEY[spt_player.level]*monNumScp);\t\tif(inRate(20))\t\t{\t\t\tvar\nscript_obj =\ngetPlanByRate(\"3-1216\");\t\t\tif(script_obj)\t\t\t{\t\t\t\t\taddItemByPlan(script_node.obj,\nscript_obj, 1);\t\t\t}\t\t\tsystemSay(script_node.obj,\nLang.NPC_Script818);\t\t}\t\tscript_index\n++;\t\tscript_node = script_node.next;\t}}",
    "T35.1864.subType": "all",
    "T35.1864.name": "Tinh Linh Hoa",
    "T35.1865.subType": "all",
    "T35.1865.name": "Sâm Linh",
    "T35.1866.subType": "all",
    "T35.1866.name": "Thủy Linh",
    "T35.1867.subType": "all",
    "T35.1867.name": "Hoa Linh",
    "T35.1868.name": "Bảo Rương Mỹ Hóa",
    "T35.1869.at": "0-23|0-6|31-31|1-1",
    "T35.1869.onServiceText": "Để đền bù cho tổn thất của các cư dân, Vua Pháp\nThuật Team gửi 1 món quà nhỏ (200 kim phiếu) đến\nngười chơi cấp độ 30 trở lên!",
    "T35.1869.name": "Sứ Giả Sự Kiện",
    "T35.1871.onServiceText": "Hừ hừ, ngươi nghĩ ác ma là cái gì chứ? Ngươi có\nthể khống chế cơ thể ta, nhưng không thể nào điều\nkhiển được linh hồn ta, Chu Ma Vương vĩ đại vạn\ntuế!",
    "T35.1871.name": "Nguyên Soái Ác Ma",
    "T35.1872.onServiceText": "(Vũ khí nếu như đã bay vào không trung, dù có mạnh\nđến đâu, cũng chỉ còn là ảo ảnh mà thôi)",
    "T35.1872.name": "Chu Ma Vương",
    "T35.1873.onServiceText": "Đây chắc là nhân vật trong truyền thuyết rồi.",
    "T35.1873.name": "Tượng Người Thủ Hộ",
    "T35.1874.onServiceText": "Kết cục pháp trận này là tượng trưng cho cái gì?",
    "T35.1874.name": "Pháp Trận Thủ Hộ",
    "T35.1875.onServiceText": "Đây là bia đá bị phá vỡ",
    "T35.1875.name": "Thạch Bia Đổ Nát",
    "T35.1876.onServiceText": "Một ảo ảnh kỳ bí, dù có đứng dưới ánh sáng mặt\ntrời cũng không sao thấy rõ",
    "T35.1876.name": "Ảo Ảnh Đen Tối",
    "T35.1877.name": "Sinh Vật Hải Dương",
    "T35.1886.name": "Ma Binh",
    "T35.1887.name": "Ma Binh Cao Cấp",
    "T35.1889.at": "new|2013/7/18/0/0/0-2013/9/5/23/59/0",
    "T35.1889.name": "Đại Vị Vương",
    "T35.1890.at": "new|2013/7/18/0/0/0-2013/9/5/23/59/0",
    "T35.1890.name": "Đại Vị Vương",
    "T35.1891.at": "new|2013/7/18/0/0/0-2013/9/5/23/59/0",
    "T35.1891.onServiceText": "Sử dụng Dược Thủy Dụ Dỗ để bắt đom đóm~",
    "T35.1891.name": "Đại Thụ Nông Trường",
    "T35.1892.scriptOff": "var script_index = 0; var script_node = null;var\nscript_totalNum = 3;var expNumScp = 1;var\nmonNumScp = 0.2;if(npc.nid && fromBF){\t\tvar\nspt_playername = encode(TBL_CHARACTOR, c.data.id,\nc.data.name);\tif( c )\t{\t\tif(c.inGroup())\n\t\t{\t\t\tscript_node = c.memberList.head;\t\t}\t\telse\n\t\t{\t\t\tscript_node = {};\t\t\tscript_node.obj =\nc.data.id;\t\t}\t\twhile(script_node != null)\t\t{\t\t\tvar\nscript_allNum = getGlobalData(\"xueguainum\",\nscript_node.obj, \"allNum\");\t\t\tif( !script_allNum\n)\t\t\t{\t\t\t\tscript_allNum =\n0;\t\t\t}\t\t\ttrace(\"script_allNum = \"\n+script_allNum);\t\t\tvar spt_date =\ngetGlobalData(\"xueguainum\", script_node.obj,\n\"date\");\t\t\tif( !spt_date || spt_date !=\ngetDateFormatStr().substr(0,8))\t\t\t{\t\t\t\tsetGlobalData(\n\"xueguainum\", script_node.obj, \"date\",\ngetDateFormatStr().substr(0,8) );\n\t\t\t\tsetGlobalData( \"xueguainum\", script_node.obj,\n\"allNum\", 0 );\t\t\t\tscript_allNum = 0;\t\t\t\tspt_date =\ngetGlobalData(\"xueguainum\", script_node.obj,\n\"date\");\t\t\t}\t\t\tif( spt_date ==\ngetDateFormatStr().substr(0,8)\n)\t\t\t{\t\t\t\tvar script_allNum =\ngetGlobalData(\"xueguainum\", script_node.obj,\n\"allNum\");\t\t\t\tvar spt_player = getCharactor(\nscript_node.obj );\t\t\t\taddChaExp(script_node.obj,\nBASIC_GET_EXP[spt_player.level]*expNumScp);\t\t\t\taddMoney(script_node.obj\n,\"moneyBind\",\nBASIC_GET_MONEY[spt_player.level]*monNumScp);\t\t\t\tvar\nscript_obj =\ngetPlanByRate(\"4-48\");\t\t\t\tif(script_obj)\t\t\t\t{\t\t\t\t\taddItemByPlan(script_node.obj,\nscript_obj, 1);\t\t\t\t}\t\t\t\tsetGlobalData(\n\"xueguainum\", script_node.obj, \"allNum\",\nadd(script_allNum, 1)\n);\t\t\t\tif(Number(script_allNum)< 3)\t\t\t\t{\n\t\t\t\t\tvar spt_itemId1 =\n3821;\t\t\t\t\taddItem(script_node.obj, 29,\nspt_itemId1, 5 , 0, 1, \"\",\n-1);\t\t\t\t}\t\t\t\telse\t\t\t\t{\t\t\t\t\tsystemSay(script_node.obj,\nLang.NPC_Script1582);\t\t\t\t}\t\t\t\tscript_index\n++;\t\t\t\tscript_node = script_node.next;\t\t\t}\t\t}\t\t\t}}",
    "T35.1892.subType": "all",
    "T35.1892.name": "Quái Tuyết",
    "T35.1893.onServiceText": "Từ lúc thành lập Quân Đoàn đến nay, bọn ác ma đã\nkhông ngừng hủy hoại đến thành tựu cống hiến của\nchúng ta. Sau khi chuyển sinh, phải gia nhậm Quân\nĐoàn đấy!",
    "T35.1893.name": "Quân Đoàn Trưởng Đông Huyền",
