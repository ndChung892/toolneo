    "T35.819.name": "Cổng Đến Tầng 5",
    "T35.820.name": "Linh Hồn Người Thợ",
    "T35.821.onServiceText": "Đừng làm phiền ta!",
    "T35.821.name": "Hồ Tặc",
    "T35.822.scriptOff": "if(fromBF){\tvar script_npc_level = 55;\tvar\nspript_loot = rand3(1, 100);\tif(spript_loot <\n5)\t{\t\tif( c )\t\t{\t\t\tif(c.inGroup())\n\t\t\t{\t\t\t\tscript_node =\nc.memberList.head;\t\t\t}\t\t\telse \t\t\t{\t\t\t\tscript_node\n= {};\t\t\t\tscript_node.obj =\nc.data.id;\t\t\t}\t\t\twhile(script_node !=\nnull)\t\t\t{\t\t\t\tvar spt_player = getCharactor(\nscript_node.obj\n);\t\t\t\t\tif(minus(spt_player.level,script_npc_level)\n> 10 ||spt_player.level<50)\t\t\t\t\t\t{\t\t\t\t\t\trequire =\ntrue;\t\t\t\t\t}\t\t\t\t\telse\t\t\t\t\t{\t\t\t\t\tif\n(inRate(2))\t\t\t\t\t{\t\t\t\t\t\tvar num\n=100;\t\t\t\t\t\taddStoneSealPointDirectly(script_node.obj,\nnum);\t\t\t\t\t}\t\t\t\t\t}\t\t\t\tscript_node =\nscript_node.next;\t\t\t}\t\t}\t}\tif(inRate(10))\t{\t\tif( c\n)\t\t{\t\t\tif(c.inGroup()) \t\t\t{\t\t\t\tscript_node =\nc.memberList.head;\t\t\t}\t\t\telse \t\t\t{\t\t\t\tscript_node\n= {};\t\t\t\tscript_node.obj =\nc.data.id;\t\t\t}\t\t\twhile(script_node !=\nnull)\t\t\t{\t\t\t\tif\n(inRate(50))\t\t\t\t{\t\t\t\t\taddItem(script_node.obj, 29,\n5536, 1 , 0, 0, \"\", null);\t\t\t\t}\t\t\t\tscript_node =\nscript_node.next;\t\t\t}\t\t}\t}}",
    "T35.822.subType": "all",
    "T35.822.name": "Thủy Tinh Bào (lv56)",
    "T35.823.scriptOff": "if(fromBF){\tvar script_npc_level = 60;\tvar\nspript_loot = rand3(1, 100);\tif(spript_loot <\n5)\t{\t\tif( c )\t\t{\t\t\tif(c.inGroup())\n\t\t\t{\t\t\t\tscript_node =\nc.memberList.head;\t\t\t}\t\t\telse \t\t\t{\t\t\t\tscript_node\n= {};\t\t\t\tscript_node.obj =\nc.data.id;\t\t\t}\t\t\twhile(script_node !=\nnull)\t\t\t{\t\t\t\tvar spt_player = getCharactor(\nscript_node.obj\n);\t\t\t\t\tif(minus(spt_player.level,script_npc_level)\n> 10 ||spt_player.level<50)\t\t\t\t\t\t{\t\t\t\t\t\trequire =\ntrue;\t\t\t\t\t}\t\t\t\t\telse\t\t\t\t\t{\t\t\t\t\tif\n(inRate(2))\t\t\t\t\t{\t\t\t\t\t\tvar num\n=100;\t\t\t\t\t\taddStoneSealPointDirectly(script_node.obj,\nnum);\t\t\t\t\t}\t\t\t\t\t}\t\t\t\tscript_node =\nscript_node.next;\t\t\t}\t\t}\t}\tif(inRate(10))\t{\t\tif( c\n)\t\t{\t\t\tif(c.inGroup()) \t\t\t{\t\t\t\tscript_node =\nc.memberList.head;\t\t\t}\t\t\telse \t\t\t{\t\t\t\tscript_node\n= {};\t\t\t\tscript_node.obj =\nc.data.id;\t\t\t}\t\t\twhile(script_node !=\nnull)\t\t\t{\t\t\t\tif\n(inRate(50))\t\t\t\t{\t\t\t\t\taddItem(script_node.obj, 29,\n5402, 1 , 0, 0, \"\", null);\t\t\t\t}\t\t\t\tscript_node =\nscript_node.next;\t\t\t}\t\t}\t}}",
