    "T29.880.reqClass": "|5|",
    "T29.880.description": "Có xác suất học kỹ năng cao cấp Hệ Ác Ma: Hắc Dạ\nMa Ảnh Cao Cấp,\nKhúc Ca Diệt Vong Cao Cấp, Ma Nhẫn Trảm Kích Cao\nCấp, Hắc Huyết\nXâm Nhiễm Cao Cấp, Phục Thù Lợi Nhẫn Cao Cấp, Vô\nBiên Thê Dạ Cao Cấp",
    "T29.881.name": "Yếu Quyết Hệ BOSS Cao Cấp",
    "T29.881.info": "Dùng trong phần Luyện pet - Kỹ năng",
    "T29.881.reqClass": "|7|",
    "T29.881.description": "Có xác suất học kỹ năng cao cấp Hệ BOSS",
    "T29.882.name": "Con Mắt Chân Thật",
    "T29.882.description": "Con mắt sáng ngời, có hồn, nhìn nhiều sẽ tự giác\nnói ra sự thật, phải cẩn thận, ha ha\n",
    "T29.883.name": "Tinh Hoa Dương Khí",
    "T29.883.description": "Vật phẩm siêu bổ, được làm từ nguyên liệu chế dược\ncực phẩm\n",
    "T29.884.name": "Thuốc Giải Độc Anh",
    "T29.884.description": "Thuốc tốt chữa choáng váng, ác tâm, mê hoặc\n",
    "T29.885.name": "Cánh Hoa Quỷ Dị",
    "T29.885.description": "Cánh hoa quái dị, không phải cánh hoa mà thực vật\nnên có.\n",
    "T29.886.name": "Phấn Hoa Mê Hồn",
    "T29.886.description": "Phấn hoa ngửi thì rất thơm nhưng sẽ làm người hôn\nmê\n",
    "T29.887.name": "Sợi Tơ Pháp Lực",
    "T29.887.description": "Tất cả vũ khí trên người Diệp hồn yêu hoa\n",
    "T29.888.name": "Nhiếp Hồn Pháp Châu",
    "T29.888.description": "Pháp châu này chỉ có Mèo Kính Đen đạo hạnh cao\nthâm mới có\n",
    "T29.889.name": "Yếu Quyết Ma Thú Đặc Cấp Hệ Long",
    "T29.889.info": "Dùng trong phần Luyện pet - Kỹ năng",
    "T29.889.reqClass": "|6|",
    "T29.889.description": "Có xác suất học cho pet học được 1 trong 2 kỹ\nnăng: Cuồng Phong Nộ và Phong Nhận\n",
    "T29.890.name": "Đầu Tiêu Khắc",
    "T29.890.description": "Máu chảy đầm đìa, nhìn thật khủng khiếp\n",
    "T29.891.name": "Đá Trạm Lam",
    "T29.891.description": "Hình dạng trong suốt, lấp lánh, là cực phẩm thủy\ntinh dùng làm trang sức\n",
    "T29.892.name": "Sách Của Người Thợ",
    "T29.892.description": "Quyển sách ghi lại các tinh hoa của những người\nthợ từ viễn cổ\n",
    "T29.893.name": "Một Chiếc Nhẫn",
    "T29.893.description": "Mặt trên có khắc \"Roma mãi yêu\"\n",
    "T29.894.name": "Cô Hoàng Thảo",
    "T29.894.description": "Một loại thảo dược dùng chế tạo độc dược\n",
    "T29.895.name": "Thuốc Xua Đuổi",
    "T29.895.description": "Tỏa ra một thứ mùi khiến người ngạt thở\n",
    "T29.896.name": "Thủy Tinh Tình Yêu",
    "T29.896.description": "Tỏa ra tình cảm thương nhớ và ái tình sâu đậm\n",
    "T29.897.name": "Một Bảo Rương",
    "T29.897.reqClass": "|1|2|3|4|5|6|",
    "T29.897.description": "Nam mộc bảo rương được đào ra từ nơi khai thác đá\nthời viễn cổ\n",
    "T29.898.name": "Tinh Hoa Nấm Đỏ Độc",
    "T29.898.description": "Tinh hoa từ nấm, làm thuốc rất tốt\n",
    "T29.899.name": "Hải Tinh Thạch",
    "T29.899.reqClass": "|1|2|3|4|6|5|",
    "T29.899.description": "Khoáng sản năng lượng được hình thành dưới đáy\nbiển, ký sinh trên thân Bá vương hải tinh\n",
    "T29.900.name": "Phấn Hoa Nữ Vương Hoa Yêu",
    "T29.900.reqClass": "|1|2|3|4|6|5|",
    "T29.900.description": "Phấn hoa rơi ra từ Nữ vương hoa yêu, có khả năng\nkhiến người rơi vào ác mộng\n",
    "T29.901.name": "Mãnh Vỡ Tinh Thể Màu Đen",
    "T29.901.reqClass": "|1|2|3|4|6|5|",
    "T29.901.description": "Mảnh vỡ tinh thể màu đen hình nắm tay to nhỏ, có\nnên đưa cho tộc trưởng?\n",
    "T29.902.name": "Thuốc Giải Ác Mộng Đặc Chế",
    "T29.902.description": "Thuốc bột có hiệu quả giải ác mộng do phấn hoa,\nhít để giải trừ\n",
    "T29.903.name": "Băng Tinh Tinh Thể",
    "T29.903.description": "Tinh thể trong suốt kỳ lạ, có lúc hiện lên những\nmàu sắc khác nhau theo từng tầng\n",
    "T29.904.name": "Thuốc Phun Đặc Hiệu",
    "T29.904.description": "Thuốc phun tụ băng có thể làm giảm hiệu quả của\ndược vật và độc vật\n",
    "T29.905.name": "Lưu Tinh Trảo",
    "T29.905.description": "Lưu tinh trảo, được làm từ hợp kim bí ẩn, có 2\nnăng lực chiến đấu gần và xa\n",
    "T29.906.name": "Phấn Đỏ Độc",
    "T29.906.description": "Khuẩn phấn từ nấm đỏ độc, có tính ăn mòn cực cao,\nnếu lấy tay sờ, tự chịu hậu quả\n",
    "T29.907.name": "Băng Tuyết Kết Tinh",
    "T29.907.description": "Theo truyền thuyết, tinh thể do linh khí băng\ntuyết ngưng kết mà thành, bình thường rất hiếm gặp\n",
    "T29.908.name": "Thuốc Tụ Băng Cực Mạnh",
    "T29.908.description": "Dịch đóng băng mạnh mẽ, nhiệt độ cực thấp. Nhược\nđiểm duy nhất là: dễ bay hơi, khó bảo quản\n",
    "T29.909.name": "Thuốc Phun Tụ Huyết",
    "T29.909.description": "Thuốc phun có thể hóa giải các chất ăn mòn thành\nchất vô hại\n",
    "T29.910.name": "Hòm Gỗ Tròn",
    "T29.910.description": "Hòm xếp đầy gỗ tròn, cầm lên rất nặng, không tin\nđược trên đời này có vật nặng đến thế\n",
    "T29.911.name": "Phấn Mê Hoặc",
    "T29.911.description": "Bột phấn làm con người sinh ra ảo giác\n",
    "T29.912.name": "Nước Mắt Của Lão Cổ Thụ",
    "T29.912.description": "Nước mắt của Lão cổ thụ rơi xuống trước khi chết,\nthứ nhỏ bé này là khắc tinh của các vật xấu trên\nđời\n",
    "T29.913.name": "Phấn Nguyền Rủa",
    "T29.913.description": "Bột đất do Gấu Trúc sử dụng làm phép, dùng dược\nthảo bí ẩn nghiền ra mà thành.\n",
    "T29.914.name": "Thuốc Giải Trừ Ám ảnh",
    "T29.914.description": "Thuốc do Đại thánh hiền Fetocci điều chế, có thể\nnhanh chóng giải trừ ám ảnh giấc mơ\n",
    "T29.915.name": "Huyết Hùng Sôi Sục",
    "T29.915.description": "Huyết hùng tươi có thể bỏng tay là nguyên liệu tốt\nnhất để làm vật làm phép.\n",
    "T29.916.name": "Tinh Hoa Huyết Hùng",
    "T29.916.description": "Dược phấn thần kỳ có thể tự hấp thu thuốc trong\nkhí trời, hiệu quả khá tốt\n",
    "T29.917.name": "Gỗ Tròn Chân Chính",
    "T29.917.description": "Gỗ được buộc thành bó, rất nặng, thật lo không\nbiết dây thừng có bị đứt không\n",
    "T29.918.name": "Da Khiết Bạch",
    "T29.918.reqClass": "|1|2|3|4|6|5|",
    "T29.918.description": "Một chiến lợi phẩm không tồi, có lẽ nên đưa cho\nthần xạ thủ ở Tháp Khắc Nguyên xem sao\n",
    "T29.919.name": "Cương Đao Lợi Trảo",
    "T29.919.reqClass": "|1|2|3|4|6|5|",
    "T29.919.description": "Một chiến lợi phẩm không tồi, có lẽ nên đưa cho\nthần xạ thủ ở Tháp Khắc Nguyên xem sao\n",
    "T29.920.name": "Yến Hồng Thạch",
    "T29.920.reqClass": "|1|2|3|4|6|5|",
    "T29.920.description": "Một chiến lợi phẩm không tồi, có lẽ nên đưa cho\nthần xạ thủ ở Tháp Khắc Nguyên xem sao\n",
    "T29.921.name": "Tơ Quỷ Hồn Khuẩn",
    "T29.921.reqClass": "|1|2|3|4|6|5|",
    "T29.921.description": "Một chiến lợi phẩm không tồi, có lẽ nên đưa cho\nthần xạ thủ ở Tháp Khắc Nguyên xem sao\n",
    "T29.922.name": "Ấn Chương Vua Thợ Săn",
    "T29.922.reqClass": "|1|2|3|4|6|5|",
    "T29.922.description": "Ấn chương của thần xạ thủ giao cho, tích lũy đủ số\nlượng nhất định sẽ tìm được ông ta.\n",
    "T29.923.name": "Ấn Thưởng Vua Thợ Săn",
    "T29.923.reqClass": "|1|2|3|4|6|5|",
    "T29.923.description": "Huy chương được thần xạ thủ cấp, ông ấy đã nhận\nthức được năng lực của bạn, trong tương lai hãy\ntạo thành tích để ông ấy thấy.\n",
    "T29.924.name": "Vật Phá Ma",
    "T29.924.reqClass": "|1|2|3|4|6|5|",
    "T29.924.description": "Dược phẩm dùng để trừ ma\n",
    "T29.925.name": "Hồn Phách Hà Hồng",
    "T29.925.reqClass": "|1|2|3|4|6|5|",
    "T29.925.description": "Bình thủy tinh chứa hồn phách Hà Hồng\n",
    "T29.926.name": "Dịch Bọt Phỉ Thúy Tinh",
    "T29.926.reqClass": "|1|2|3|4|6|5|",
    "T29.926.description": "Chai đựng dịch thể dính dính.\n",
    "T29.927.name": "Lệ Vô Tận Tư Niệm",
    "T29.927.reqClass": "|1|2|3|4|6|5|",
    "T29.927.description": "Một trong những vật phẩm tạo thành nhẫn kết hôn.\n",
    "T29.928.name": "Xương Chi Sau Của Thỏ Hoang",
    "T29.928.description": "Xương rất cứng, có thể chịu tất cả các lực hoạt\nđộng của thỏ\n",
    "T29.929.name": "Vuốt Của Chiến Sĩ Sói",
    "T29.929.description": "Vuốt trước cực kỳ sắc bén của Chiến Sĩ Sói dùng để\ntấn công.\n",
    "T29.930.name": "Móng Của Mèo Kinh Đen",
    "T29.930.description": "Móng tay trong suốt như thủy tinh, vô cùng sắc\nbén.\n",
    "T29.931.name": "《Bu Loong Ngược》",
    "T29.931.reqClass": "|1|2|3|4|6|5|",
    "T29.931.description": "Một tạp chí khoa học, trong có ghi nhiều quan điểm\nkỳ quái của các nhà khoa học\n",
    "T29.932.name": "Đá Pháp Thuật",
    "T29.932.reqClass": "|1|2|3|4|6|5|",
    "T29.932.description": "Hòn đá Gấu Trúc dùng để thực hiện pháp thuật, có\ncông dụng nhất định\n",
    "T29.933.name": "Tim Đập",
    "T29.933.reqClass": "|1|2|3|4|6|5|",
    "T29.933.description": "Tim của bạn hay tim của hắn? Đằng nào thì nó cũng\nđang đập thình thịch\n",
    "T29.934.name": "Người Máy Tê Liệt",
    "T29.934.reqClass": "|1|2|3|4|6|5|",
    "T29.934.description": "Nhìn giống một bé gái, nhưng khi bế lên thấy rất\nnặng và cứng\n",
    "T29.935.name": "Máu Của Nấm Đông Cô",
    "T29.935.reqClass": "|1|2|3|4|6|5|",
    "T29.935.description": "Dịch lỏng màu xanh lặng lẽ chảy trong chai\n",
    "T29.936.name": "Vỏ Ngoài Của Thủy Lam Bọt",
    "T29.936.reqClass": "|1|2|3|4|6|5|",
    "T29.936.description": "Vỏ ngoài màu xanh, rất mỏng và dẻo dai\n",
    "T29.937.name": "Cơ Bắp Của Độc Nhãn Da Xanh",
    "T29.937.reqClass": "|1|2|3|4|6|5|",
    "T29.937.description": "Cơ bắp phân bố rất có quy luật, thảo nào chúng\nmạnh như thế\n",
    "T29.938.name": "Tim Nằm Yên",
    "T29.938.reqClass": "|1|2|3|4|6|5|",
    "T29.938.description": "Trái tim bình lặng\n",
    "T29.939.name": "Nhu Yếu Phẩm Sinh Hoạt",
    "T29.939.description": "Hòm chất đầy vật phẩm hàng ngày\n",
    "T29.940.name": "《Ảo Ảnh Sa Mạc》",
    "T29.940.description": "Sách này ghi chép lại những ảo ảnh xuất hiện trên\nsa mạc\n",
    "T29.941.name": "Dịch Nấm Cực Độc",
    "T29.941.description": "Chất lỏng xanh thẫm, có tính năng ăn mòn cực\nmạnh,nếu sờ thử hậu quả tự chịu\n",
    "T29.942.name": "Tay Phải Gấu Mật",
    "T29.942.description": "Tay gấu bên trên dính đầy mật ong\n",
    "T29.943.name": "Tuyến Độc Của Hấp Huyết Hải Tinh",
    "T29.943.description": "Tuyến độc tiết ra chất có ma lực mạnh mẽ khiến\nngười tê liệt\n",
    "T29.944.name": "Tay Trái Gấu Mật",
    "T29.944.description": "Tay gấu bên trên dính đầy sáp ong\n",
    "T29.945.name": "Mật Của Thất Hồn Yêu Hoa",
    "T29.945.description": "Hạt châu màu xám, khi cầm trên tay cảm giác mình\nlà sinh vật nhỏ bé nhất thế giới\n",
    "T29.946.name": "Mật Của Diệp Hồn Yêu Hoa",
    "T29.946.description": "Hạt châu màu xanh, khiến ta cảm giác như đang ở\ntrong lòng mẹ thiên nhiên.\n",
    "T29.947.name": "Tim Sói Mẹ",
    "T29.947.description": "Trái tim dù rời khỏi thân thể vẫn không ngừng đập,\nliên tục xuất ra chất dịch màu đen.\n",
    "T29.948.name": "Mật Mị Yêu Hoa",
    "T29.948.description": "Hạt châu màu đỏ.\n",
    "T29.949.name": "Bụi Thủy Tinh Thần Bí",
    "T29.949.reqClass": "|1|2|3|4|5|6|",
    "T29.949.description": "Tinh thể trong suốt ta chưa bao giờ nhìn thấy\n",
    "T29.950.name": "Trí Thạch Tinh Thể",
    "T29.950.description": "Tinh thể trên tay phát ra ánh sáng đỏ tươi, đập\nnhư trái tim, khiến người cảm thấy bất an. Hãy mau\ngiao nộp cho chủ thành Tinh Linh đi.\n",
    "T29.951.name": "Bột Phấn Thần Bí",
    "T29.951.description": "Bột phấn có màu sắc kỳ quái\n",
    "T29.952.name": "Gói Đồ",
    "T29.952.description": "Túi đồ chứa những vật phẩm không thích hợp cho lắm\n",
    "T29.953.name": "Truyện Cổ Grimm",
    "T29.953.description": "Sách cổ tích, mọi người cho rằng các câu chuyện\ntrong sách sẽ mang lại giấc mơ đẹp cho trẻ em\n",
    "T29.954.name": "Ma Văn Phù",
    "T29.954.description": "Một loại phù văn phép thuật, có khả năng xua tan\nvà dụ dỗ\n",
    "T29.955.name": "Ma Tinh Bình",
    "T29.955.description": "Một loại dược phẩm quý, theo truyền thuyết được\nchế tạo từ thủy tinh pháp thuật.\n",
    "T29.956.name": "Huyết Tinh",
    "T29.956.description": "Thuốc tăng cường năng lực của Pet, cực kỳ hiếm,\nchỉ có yêu quái tu luyện đắc đạo mới có.\n",
    "T29.957.name": "Chuông Ma",
    "T29.957.description": "Đạo cụ pháp thuật dùng để dẫn dụ Pet theo mình.\n",
    "T29.959.name": "Huy Chương Tân Thủ Vô Địch",
    "T29.959.info": "Nhấp đôi nhận được danh hiệu",
    "T29.959.reqClass": "|4|6|5|3|2|1|",
    "T29.959.description": "Vật phẩm pháp thuật, nhấp đôi để sử dụng\n",
    "T29.960.name": "Huy Chương Thú Liệp Chi Vương",
    "T29.960.info": "Nhấp đôi để sử dụng ",
    "T29.960.reqClass": "|4|6|5|3|2|1|",
    "T29.960.description": "Huy chương quý giá giúp bạn có được \n danh hiệu Thú Liệp Chi Vương.",
    "T29.961.name": "Thuốc Tăng Trưởng Pet Loại A",
    "T29.961.info": "Tăng kinh nghiệm cho pet là 30000 điểm",
    "T29.961.reqClass": "|1|2|3|4|6|5|",
    "T29.961.description": "Tăng kinh nghiệm cho pet nhanh chóng",
    "T29.962.name": "Thuốc Tăng Trưởng Pet Loại B",
    "T29.962.info": "Tăng kinh nghiệm cho pet là 150000 điểm",
    "T29.962.reqClass": "|1|2|3|4|6|5|",
    "T29.962.description": "Tăng kinh nghiệm cho pet nhanh chóng",
    "T29.963.name": "Báo Cáo Phân Tích Vật Phẩm",
    "T29.963.description": "Báo cáo được đội trưởng cảnh vệ Tiên Lạp đưa sau\nkhi phân tích vật khả nghi.\n",
    "T29.964.name": "Thuốc Tăng Trưởng Pet Loại C",
    "T29.964.info": "Tăng kinh nghiệm cho pet là 300000 điểm",
    "T29.964.reqClass": "|1|2|3|4|6|5|",
    "T29.964.description": "Tăng kinh nghiệm cho pet nhanh chóng",
    "T29.965.name": "Bản Totem Của Tộc Sói",
    "T29.965.description": "Totem hình bán nguyệt màu xám, không rõ có phải\nlàm từ kim loại hay không, nhưng cầm lên thấy rất\nnặng\n",
    "T29.966.name": "Bản Totem Cổ",
    "T29.966.description": "Totem hình sừng trâu màu xám, không rõ có phải làm\ntừ kim loại hay không, nhưng trông có vẻ cũ nát.\n",
    "T29.967.name": "Băng Tinh Trấn Tĩnh",
    "T29.967.description": "Ngậm trong miệng cảm thấy toàn thân mát lạnh, trấn\ntĩnh được tinh thần\n",
    "T29.968.name": "Lệ Hồi Ức",
    "T29.968.description": "Giọt lệ chân tình, rất hiếm thấy\n",
    "T29.969.name": "Thuốc Ái Tình",
    "T29.969.description": "Dược thủy thần kỳ, nghe nói uống vào có thể tận\nhưởng hương vị đẹp nhất của tình yêu.\n",
    "T29.970.name": "Phấn Thức Tỉnh",
    "T29.970.description": "Rất khó ngửi, có hiệu quả nâng cao tinh thần, thức\ntỉnh u mê\n",
    "T29.971.name": "Khối Thịt Kỳ Quái",
    "T29.971.description": "Do gấu nôn ra, mùi cực kỳ thối\n",
    "T29.972.name": "Dịch Nấm Ăn Thịt",
    "T29.972.description": "Chất dịch từ miệng Nấm ăn thịt, có khả năng tiêu\nhoá thức ăn rất tốt\n",
    "T29.973.name": "Dụng Cụ Khắc Bản",
    "T29.973.description": "Dụng cụ để viết của các tân thủ Đông Huyền\n",
    "T29.974.name": "Dịch Ốc",
    "T29.974.description": "Chất dịch màu xanh, có mùi cực kì hôi thối\n",
    "T29.975.name": "Mảnh Vỡ Cột Totem",
    "T29.975.description": "Mãnh rơi ra từ totem thần bí, không rõ chất liệu\ngì\n",
    "T29.976.name": "Thuốc Xịt Đặc Chế",
    "T29.976.description": "Nghiên cứu gia XX đặc chế, thuốc chuyên dùng đặc\nhiệu 3000.\n",
    "T29.977.name": "Bản Totem Khổng Lồ",
    "T29.977.description": "Tượng trưng cho dũng sĩ tộc người khổng lồ, khắc\nhình mãnh hổ\n",
    "T29.978.name": "Máu Mã Não Tinh",
    "T29.978.description": "Mã Não tuy to tròn nhưng muốn lấy máu ra quả không\ndễ\n",
    "T29.979.name": "Cành Cây Cứng Đầu",
    "T29.979.description": "Cành cây đặc biệt, có thể xuyên vào linh hồn ác\nquỷ khống chế chúng\n",
    "T29.980.name": "Bình Thuốc U Lam",
    "T29.980.description": "Bình nhỏ nửa trong nửa đục màu lam nhạt\n",
    "T29.981.name": "Tín Vật Tinh Linh",
    "T29.981.description": "Áo giáp Chủ thành Tinh Linh tặng, thể hiện sự chấp\nnhận của Tinh Linh\n",
    "T29.982.name": "Cỏ Bốn Lá",
    "T29.982.description": "Biến thể của cỏ 3 lá, nghe nói mang đến vận may\n",
    "T29.983.name": "Quyển Sách Khắc Chữ",
    "T29.983.reqClass": "|1|2|3|4|6|5|",
    "T29.983.description": "Dùng cổ ngữ viết thành, do chưa đủ trình độ nên\nhiểu được chút ít\n",
    "T29.984.name": "Dong Hủ Vị Dịch",
    "T29.984.description": "Được mệnh danh là dịch tiêu hoá tự nhiên mạnh nhất\n",
    "T29.985.name": "Hải Tảo Hấp Phụ",
    "T29.985.description": "Tảo biển hình bọt biển, lực hấp thụ thần kỳ\n",
    "T29.986.name": "Khế Ước Giới Chỉ",
    "T29.986.description": "Nhẫn được mài từ ngọc xanh biếc\n",
    "T29.987.name": "Thuốc Tĩnh Hoá",
    "T29.987.description": "Chỉ cần 1 lọ nhỏ cũng có thể làm toàn bộ cá hồ Lê\nDương bất động\n",
    "T29.988.name": "Hắc Lĩnh Cân Hộ Kiên",
    "T29.988.description": "Biểu tượng thân phận Hắc lĩnh cân thần bí, ít\nngười trông thấy\n",
    "T29.989.name": "Nước Suối Sự Sống",
    "T29.989.description": "Nước thần có thể hồi sinh trong truyền thuyết, vật\nbáu của chủ thành Tinh Linh\n",
    "T29.990.name": "Tán Của Nấm Cực Độc",
    "T29.990.description": "Mặc dù mọc trên thân nấm cực độc nhưng không có\nđộc tính gì\n",
    "T29.991.name": "Lưu Hỏa Sơ Cấp Chứng Nhận",
    "T29.991.info": "Chứng nhận phổ cập",
    "T29.991.reqClass": "|6|",
    "T29.991.description": "Chứng nhận thăng cấp của Lưu Hỏa Tộc, chứng minh\nbạn đủ tư cách thăng cấp Hiệp sĩ trung cấp.\n",
    "T29.992.name": "Lưu Hỏa Trung Cấp Chứng Nhận",
    "T29.992.info": "Chứng nhận phổ cập",
    "T29.992.reqClass": "|6|",
    "T29.992.description": "Chứng nhận thăng cấp của Lưu Hỏa Tộc, chứng minh\nbạn đủ tư cách thăng cấp Hiệp sĩ sơ cấp.\n",
    "T29.993.name": "Băng Hoa Lộ Thủy",
    "T29.993.description": "Do hoa tuyết tinh khiết tan ra mà thành, có hương\nthơm nhè nhẹ\n",
    "T29.994.name": "Đám Bùn Sống",
    "T29.994.description": "Hinh như có rất nhiều vi sinh vật\n",
    "T29.995.name": "Quy Nguyên Châu",
    "T29.995.info": "Không hạn chế cấp độ sử dụng",
    "T29.995.reqClass": "|1|2|3|4|6|5|",
    "T29.995.description": "Vật phẩm thần kỳ có thể tái thiết lập tất cả thuộc\ntính nhân vật.\n",
    "T29.996.name": "Túi Quà Vũ Khí Trác Việt",
    "T29.996.info": "Nhấp đôi để mở nhận vũ khí",
    "T29.996.reqClass": "|1|2|3|5|6|4|",
    "T29.996.description": "Túi quà bên trong có vũ khí trác việt quý giá",
    "T29.997.name": "Túi Quà Vật Phẩm Thăng Cấp Nhanh",
    "T29.997.info": "Nhấp đôi để mở nhận vật phẩm",
    "T29.997.reqClass": "|1|2|3|5|6|4|",
    "T29.997.description": "Túi quà bên trong có các vật phẩm giúp thăng cấp\nnhanh chóng",
    "T29.998.name": "Túi Quà Tăng Trưởng Pet",
    "T29.998.info": "Nhấp đôi để mở nhận vật phẩm",
    "T29.998.reqClass": "|1|2|3|5|6|4|",
    "T29.998.description": "Túi quà bên trong có các vật phẩm có lợi cho pet",
    "T29.999.name": "Lưu Hỏa Hồi Phù",
    "T29.999.info": "Giúp di chuyển đến Lưu Hỏa Tộc",
    "T29.999.reqClass": "|6|",
    "T29.999.description": "Giúp di chuyển đến Lưu Hỏa Tộc",
    "T29.1000.name": "Phiếu Đổi Túi Quà Thức Tỉnh Chiến Binh",
    "T29.1000.info": "Có thể đến chỗ Tân Thủ Sứ để chọn 1 món quà",
    "T29.1000.reqClass": "|1|2|5|3|6|4|",
    "T29.1001.name": "Dịch Ếch Xanh",
    "T29.1001.description": "Chất lỏng dính dính màu tím, có mùi lạ rất nặng\n",
    "T29.1002.name": "Miếng Cắt Thạch Tượng",
    "T29.1002.description": "Do quần áo hóa đá tạo thành, rất giòn\n",
    "T29.1003.name": "Ốc Hóa Thạch",
    "T29.1003.description": "Vỏ ốc hóa thạch tự nhiên, rất bất thường\n",
    "T29.1004.name": "Anh Linh Kiếm",
    "T29.1004.description": "Làm theo công nghệ cổ, là vật tráng sĩ thời viễn\ncổ thường dùng\n",
    "T29.1005.name": "Chất Tẩy Rửa",
    "T29.1005.description": "Chất tẩy rửa thường gặp\n",
    "T29.1006.name": "Anh Linh Hoa",
    "T29.1006.description": "Hoa thần bí nở trong hang sâu, nghe nói nó kế thừa\ný chí của Anh Linh, là vật thần tưởng nhớ Anh Linh\n",
    "T29.1007.name": "Trứng Ong Chúa",
    "T29.1007.description": "Trứng ong chúa khổng lồ, trong một đống chỉ có một\ntrứng nở thành ong chúa\n",
    "T29.1008.name": "Tương Nữ Vương Ong Mật",
    "T29.1008.description": "Đồ siêu bổ, không ăn quả lãng phí, hương thơm\nthanh mát\n",
    "T29.1009.name": "Chất Thanh Tẩy XX Đặc Chế",
    "T29.1009.description": "Do nghiên cứu viên XX đặc chế, nếu dùng thích hợp\ncó thể làm tan chảy tất cả\n",
    "T29.1010.name": "Mảnh Vỡ Totem",
    "T29.1010.description": "Totem đáng thương lại bị vỡ một mảnh\n",
    "T29.1011.name": "Băng Kết Tinh Khối",
    "T29.1011.description": "Toàn thân trong suốt, sáng lấp lánh, có khí lạnh\nbao trùm\n",
    "T29.1012.name": "Băng Xuyên Thiên Thư",
    "T29.1012.reqClass": "|1|2|3|4|6|5|",
    "T29.1012.description": "Ghi chép cách dùng miếng thủy tinh băng kết và\nlịch sử Băng Yêu tộc\n",
    "T29.1013.name": "Vòng Xà Yêu",
    "T29.1013.reqClass": "|1|2|3|4|6|5|",
    "T29.1013.description": "Do kim loại thần bí tạo thành, cứng và tỏa sáng\n",
    "T29.1014.name": "Lệnh Bài Tinh Linh",
    "T29.1014.reqClass": "|1|2|3|4|6|5|",
    "T29.1014.description": "Lệnh bài thần bí, tượng trưng cho thân phận\n",
