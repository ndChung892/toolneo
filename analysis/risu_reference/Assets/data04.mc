    "T45.50523.completeText": "Cá Tháng Tư Vui Vẻ！",
    "T45.50523.name": "Từ Bỏ Nhiệm Vụ",
    "T45.50523.aScriptText": "Phần thưởng bí mật",
    "T45.50547.info": "Quét sạch hồ tặc ở Lê Dương Thôn",
    "T45.50547.reqClass": "all",
    "T45.50547.startText": "Hồ tặc đột nhiên đột kích, hãy đánh lùi chúng rồi\nhẵng tính tiếp chuyện khác",
    "T45.50547.completeText": "Cuối cùng cũng hít thở thoải mái",
    "T45.50547.name": "Mưa Gió Sắp Đến 4",
    "T45.50450.info": "Đến gặp Sứ Giả Quốc Khánh đổi danh hiệu \"Cao Tài\nSinh\"",
    "T45.50450.reqClass": "all",
    "T45.50450.startText": "Trong thời gian sự kiện, dùng 3 Xuất Vân Chi Tinh\nđổi lấy danh hiệu \"Cao Tài Sinh\"",
    "T45.50450.completeText": "Đây mãi là nhà của chúng tôi!",
    "T45.50450.name": "Đổi danh hiệu Cao Tài Sinh",
    "T45.50450.aScriptText": "Danh hiệu \"Cao Tài Sinh\"",
    "T45.50526.info": "Chú hề lấy Máy Định Vị của bạn mang đi chơi đùa\nrồi sẽ trả lại, chài, có vẻ bị hỏng rồi!",
    "T45.50526.reqClass": "all",
    "T45.50526.startText": "Hì Hì, Ha Ha, người tìm nhầm người rồi",
    "T45.50526.completeText": "Hì Hì",
    "T45.50526.name": "Ủy Thác Kỳ Lạ 5",
    "T45.50527.info": "Chú ý! Một khi đã chọn hoàn thành nhiệm vụ này thì\nkhông thể nhận nhiệm vụ khác! Hãy kiểm tra ô trống\ntrong túi!",
    "T45.50527.reqClass": "all",
    "T45.50527.startText": "Hì Hì, Ha Ha, chúng ta là những chú hề thông minh",
    "T45.50527.completeText": "Cá Tháng Tư Vui Vẻ！",
    "T45.50527.name": "Từ Bỏ Nhiệm Vụ",
    "T45.50527.aScriptText": "Phần thưởng bí mật",
    "T45.50453.info": "Sử dụng Thiệp Chúc Mừng Năm Mới đổi Huy Chương\n“Bậc Thầy Bảo Rương”",
    "T45.50453.reqClass": "all",
    "T45.50453.startText": "Thu thập đủ giấy, khung, phông nền, đồ trang trí\nđể làm thiệp năm mới",
    "T45.50453.completeText": "Tặng ngươi nè!",
    "T45.50453.name": "Đổi Danh Hiệu \"Bậc Thầy Bảo Rương\"",
    "T45.50529.info": "Cần đạt được tán thành của Nhân Viên Gương Mẫu\ntại Lê Dương Bắc, Quang Binh Nguyên, Lạp Tuyết\nĐịa, Thiên Lục Châu mới có thể trở thành nhiên\nviên gương mẫu mới ~",
    "T45.50529.reqClass": "all",
    "T45.50529.startText": "Mấy ngày nay ta đang bình chọn chiến sĩ thi đua",
    "T45.50529.completeText": "Chúc mừng!",
    "T45.50529.name": "Hình Mẫu Lao Động Mới",
    "T45.50455.info": "2 Bó Hoa Hồng To có thể đổi lấy Túi Lễ Tình Nhân!\nSố lượng có hạn.",
    "T45.50455.reqClass": "all",
    "T45.50455.startText": "Ta biết ngươi muốn nói gì.Gửi hoa mà không đến thì\nchắc chắn là lỗi ở định mệnh!",
    "T45.50455.completeText": "Tốt lắm, đây là phần thưởng của ngươi!",
    "T45.50455.name": "Đổi Túi Lễ Tình Nhân",
    "T45.50531.info": "Hoàn thành đánh giá xếp loại nghề",
    "T45.50531.reqClass": "|1|2|3|5|6|4|",
    "T45.50531.startText": "Đem Giấy Chứng Nhận Trung Cấp Khảo Hạch cho ta, ta\nsẽ đưa phần thưởng ngay",
    "T45.50531.completeText": "Chúc mừng!",
    "T45.50531.name": "Đánh Giá Xếp Loại Nghề Trung Cấp",
    "T45.50531.aScriptText": "Thăng cấp cấp độ thành thạo",
    "T45.50532.info": "Hoàn thành đánh giá xếp loại nghề",
    "T45.50532.reqClass": "|1|2|3|5|6|4|",
    "T45.50532.startText": "Đem Giấy Chứng Nhận Cao Cấp Khảo Hạch cho ta, ta\nsẽ đưa phần thưởng ngay",
    "T45.50532.completeText": "Chúc mừng!",
    "T45.50532.name": "Đánh Giá Xếp Loại Nghề Cao Cấp",
    "T45.50532.aScriptText": "Thăng cấp cấp độ siêu phàm",
    "T45.50533.info": "Cấp 30 trở lên, đến gặp Tộc Trưởng Bối Tư để chứng\nminh mình là học viên có thực lực.",
    "T45.50533.reqClass": "all",
    "T45.50533.startText": "Lễ Quốc Khánh sắp đến, ta cần một số học sinh có\nnăng lực hỗ trợ giữ gìn trị an.",
    "T45.50533.completeText": "Ân, Không tệ, Chính là ngươi!",
    "T45.50533.name": "Lễ Quốc Khánh",
    "T45.50510.info": "Thu thập 4 Thẻ Bài Tinh Linh để đổi lấy 1 Tinh\nLinh",
    "T45.50510.reqClass": "all",
    "T45.50510.startText": "Thu thập 4 Thẻ Bài Tinh Linh sẽ đổi được 1 Tinh\nLinh",
    "T45.50510.completeText": "Đây là tinh linh của ngươi!",
    "T45.50510.name": "Đổi Tinh Linh Halloween",
    "T45.50511.info": "Dùng Gà Tây May Mắn đổi lấy Huy Chương \"Bằng Hữu\nGà Tây\"",
    "T45.50511.reqClass": "all",
    "T45.50511.startText": "Chỉ cần phù hợp với điều kiện của ta, danh hiệu\nnày là dành cho ngươi!",
    "T45.50511.completeText": "Tặng ngươi nè!",
    "T45.50511.name": "Đổi Huy Chương \"Bằng Hữu Gà Tây\"",
    "T45.50461.info": "Chú ý! Một khi đã chọn hoàn thành nhiệm vụ này thì\nkhông thể nhận nhiệm vụ khác! Hãy kiểm tra ô trống\ntrong túi!",
    "T45.50461.reqClass": "all",
    "T45.50461.startText": "Hì Hì, Ha Ha, chúng ta là những chú hề thông minh",
    "T45.50461.completeText": "Cá Tháng Tư Vui Vẻ！",
    "T45.50461.name": "Từ Bỏ Nhiệm Vụ",
    "T45.50461.aScriptText": "Phần thưởng bí mật",
    "T45.50462.info": "Chú hề lấy Máy Định Vị của bạn mang đi chơi đùa\nrồi sẽ trả lại, Emmm, giống như trở nên hơi kỳ\nquái…..",
    "T45.50462.reqClass": "all",
    "T45.50462.startText": "Hì Hì, Ha Ha, người tìm nhầm người rồi",
    "T45.50462.completeText": "Hì Hì",
    "T45.50462.name": "Ủy Thác Kỳ Lạ 3",
    "T45.50463.info": "Chú ý! Một khi đã chọn hoàn thành nhiệm vụ này thì\nkhông thể nhận nhiệm vụ khác! Hãy kiểm tra ô trống\ntrong túi!",
    "T45.50463.reqClass": "all",
    "T45.50463.startText": "Hì Hì, Ha Ha, chúng ta là những chú hề thông minh",
    "T45.50463.completeText": "Cá Tháng Tư Vui Vẻ！",
    "T45.50463.name": "Từ Bỏ Nhiệm Vụ",
    "T45.50463.aScriptText": "Phần thưởng bí mật",
    "T45.50437.info": "Tuy là không biết lý do gì nhưng hình như hắn muốn\nđưa cho ngươi....",
    "T45.50437.reqClass": "all",
    "T45.50437.startText": "×&￥#@！&……！",
    "T45.50437.completeText": "￥×%",
