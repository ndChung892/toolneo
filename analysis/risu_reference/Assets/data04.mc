    "T35.931.onServiceText": "Quyến Cố Thành được các thần linh phù hộ nên ngày\ncàng phát đạt!",
    "T35.931.name": "Thương Hội Trưởng Quyến Cố",
    "T35.932.onServiceText": "Chào mừng ngươi đến với tiệm thuốc Quyến Cố Thành.",
    "T35.932.name": "Tiệm Thuốc Raul",
    "T35.933.funcInfo": "|1,Xuất Vân Thôn,10,1000,1000|9,Đông Huyền\nThành,100,2057,1309|10,Tinh Linh\nThành,100,2000,1000|38,Bàng Bối\nThành,100,1153,1163||31,Tiên Lạp\nThành,100,3000,1800",
    "T35.933.onServiceText": "Chúc ngươi một chuyến đi vui vẻ.",
    "T35.933.name": "Tinh Linh Dịch Chuyển Quyến Cố",
    "T35.934.onServiceText": "Đây là tiệm tạp hóa Quyến Cố Thành, chuyên bán các\nmón tạp phẩm.",
    "T35.934.name": "Tiệm Tạp Hóa Leni",
    "T35.935.onServiceText": "Món ăn ta nấu rất ngon, ngươi có muốn nếm thử\nkhông?",
    "T35.935.name": "Tiệm Thực Phẩm",
    "T35.936.onServiceText": "Vì hòa bình của Quyến Cố Thành ta nhất định phải\nchú tâm canh gác",
    "T35.936.name": "Vệ Sĩ Quyến Cố",
    "T35.937.onServiceText": "Nghe nói làm cận vệ ở Quyến Cố Thành được trả\nlương rất khá.",
    "T35.937.name": "Dần - Cận Vệ Quyến Cố",
    "T35.938.onServiceText": "Nghe nói làm cận vệ ở Quyến Cố Thành được trả\nlương rất khá.",
    "T35.938.name": "Mẹo - Cận Vệ Quyến Cố",
    "T35.939.onServiceText": "Chào mừng đến với tiệm pet Quyến Cố Thành, ta có\nthể giúp gì cho ngươi nào?",
    "T35.939.name": "Tiệm Pet Phiêu Phiêu",
    "T35.940.onServiceText": "Chào mừng đến với tiệm vũ khí Quyến Cố Thành.",
    "T35.940.name": "Tiệm Vũ Khí Lang Mộc",
    "T35.941.onServiceText": "Chờ đợi sự hồi sinh của Ma Vương…!",
    "T35.941.name": "Lãnh Chúa Phệ Nhật",
    "T35.942.onServiceText": "Bé dơi của ta đi đâu rồi?",
    "T35.942.name": "Người Nuôi Dơi",
    "T35.943.onServiceText": "Ta muốn nuốt chửng tất cả sinh vật!",
    "T35.943.name": "Lửa Tà Ma",
    "T35.944.onServiceText": "Ta là Học giả tà ma, người nô bộc trung thành nhất\ncủa Ma Vương đại nhân!",
    "T35.944.name": "Học Giả Tà Ma Budle",
    "T35.945.onServiceText": "Ngươi là ai?",
    "T35.945.name": "Hoar",
    "T35.946.onServiceText": "Đây là lãnh địa của ta!",
    "T35.946.name": "Quang Dực Vương",
    "T35.947.onServiceText": "Ta là Hắc Long Vương!",
    "T35.947.name": "Hắc Long Vương",
    "T35.948.onServiceText": "Ta là Thổ Long, ngươi đừng nói cho kẻ khác biết\nnhé!",
    "T35.948.name": "Thổ Long",
    "T35.949.onServiceText": "Ta là Quản lý Chuyển Dịch Bang Hội",
    "T35.949.name": "Quản lý Chuyển Dịch Bang Hội",
    "T35.950.scriptOff": "if( c ){\tvar\nscript_line = Number(LINE_SERVER_ID)+1;\tvar\ns_map = MAP_DEFENCER_TABLE[npc.id].mapId;\tvar\ns_level = MAP_DEFENCER_TABLE[npc.id].level;\tvar\ns_exp = 1 +\n(s_level-1)*MAP_DEFENCER_TABLE[npc.id].addExp;\tvar\nnameStr =\nencode(TBL_CHARACTOR,c.data.id,c.data.name);\tsystemMidMsgBroadcast(Msg.replace(Lang.NPC_ScriptOff8,\n{ \"name\" : nameStr , \"line\" : script_line ,\n\"place\" : getMapNameByIndex(s_map) , \"place2\" :\ngetMapNameByIndex(s_map) , \"times\" :\nNumber(s_exp).toFixed(2) } ));}",
    "T35.950.subType": "all",
    "T35.950.name": "Yêu Thú",
    "T35.951.at": "0-23|0-6|31-31|1-1",
    "T35.951.onServiceText": "Học tập là một chặng đường tuy dài nhưng lại tràn\nngập niềm vui… Mỗi một tân thủ khi đến đây đều\nmang theo ước mơ và hi vọng của mình, mong mỏi sẽ\ncó ngày thành tài!",
    "T35.951.name": "Người Tiến Cử",
    "T35.952.onServiceText": "Vân Lộc Sơn là một ngọn núi tuyệt vời, không những\nphong cảnh hùng vĩ mà còn có khu rừng xanh mát,\nsản vật phong phú. Người dân quanh núi đời đời nhờ\nvào nghề đốn củi, hái thuốc, săn bắn mà có cuộc\nsống an lành, no ấm…",
    "T35.952.name": "Tiểu Tinh Linh Nghịch Ngợm",
    "T35.953.at": "0-23|0-6|30-30|1-1",
    "T35.953.name": "Chuyên Gia Dò Tìm Khoáng Sản",
