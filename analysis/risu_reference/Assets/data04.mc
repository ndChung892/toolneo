    "T12.2071.name": "Chiến Dương",
    "T12.2072.name": "Chiến Dương【Tiến Hóa】",
    "T12.2073.name": "Thiên Ma Chiến Tướng ",
    "T12.2074.name": "Ma Nh?n",
    "T12.2075.name": "Thái Cổ Cự Nhân",
    "T12.2076.name": "Mãng Xà Thượng Cổ",
    "T12.2078.name": "Celica",
    "T12.2078.msg": "Đã dám bước chân vào Thánh Vực, ta sẽ cho các\nngươi thấy sức mạnh của Thần! Đừng nghĩ chỉ có\nngươi mới điều khiển được nguyên tố! Vẫn còn non\nlắm!",
    "T12.2079.name": "Thần Sát Hộ Vệ",
    "T12.2079.msg": "Có sự bảo hộ của ta, các ngươi đừng mơ tưởng gặp\nđược Thần! Á! Á! Khắc chế nguyên tố à? Ta cũng\nbiết!",
    "T12.2080.name": "Thần Sát Hộ Vệ II",
    "T12.2080.msg": "Các ngươi cứ từ từ mà nếm trải cái chết!",
    "T12.2081.name": "Đội Trưởng Vệ Nữ Thần",
    "T12.2081.msg": "Nghe hiệu lệnh của ta, xem cờ lệnh của ta mà tấn\ncông!",
    "T12.2082.name": "Chiến Nữ Thần",
    "T12.2082.msg": "Chú ý bảo vệ đội trưởng!",
    "T12.2083.name": "Sethia",
    "T12.2083.msg": "Đã dám bước chân vào Thánh Vực, ta sẽ cho các\nngươi thấy sức mạnh của Thần! Đừng nghĩ chỉ có\nngươi mới điều khiển được nguyên tố! Vẫn còn non\nlắm!",
    "T12.2084.name": "Faya",
    "T12.2084.msg": "Có sự bảo hộ của ta, các ngươi đừng mơ tưởng gặp\nđược Thần! Á! Á! Khắc chế nguyên tố à? Ta cũng\nbiết!",
    "T12.2085.name": "Rena",
    "T12.2085.msg": "Các ngươi cứ từ từ mà nếm trải cái chết!",
    "T12.2086.name": "Võ Quan Thần Điện",
    "T12.2086.msg": "Nghe hiệu lệnh của ta, xem cờ lệnh của ta mà tấn\ncông!",
    "T12.2087.name": "Anh Linh Thần Điện",
    "T12.2087.msg": "Chú ý bảo vệ đội trưởng!",
    "T12.2088.name": "Brunswald",
    "T12.2088.msg": "Nguyên tố tự nhiên đã bị ta khống chế! Các ngươi\nkhông thể nào đánh bại được ta đâu! Hê hê!",
    "T12.2089.name": "Gia Cát Lỗ Na",
    "T12.2089.msg": "Ta chính là Tung Giả tự nhiên!",
    "T12.2090.name": "Rosemary",
    "T12.2090.msg": "Ta chính là Tung Giả tự nhiên!",
    "T12.2091.name": "Grace",
    "T12.2091.msg": "Ta chính là Tung Giả tự nhiên!",
    "T12.2092.name": "Hervor",
    "T12.2092.msg": "Ta chính là Tung Giả tự nhiên!",
    "T12.2093.name": "Chiến Cơ",
    "T12.2093.msg": "Chúng tôi là nữ thần bổ sung ý chí chiến đấu",
    "T12.2094.name": "Alvit",
    "T12.2094.msg": "Đến được đây xem ra ngươi cũng có chút năng lực!\nHãy xem sức mạnh khiên nguyên tố của ta đây!",
    "T12.2095.name": "Geironul",
    "T12.2095.msg": "Hãy tấn công ta đi!",
    "T12.2096.name": "Hellock",
    "T12.2096.msg": "Hãy tấn công ta đi!",
    "T12.2097.name": "Slade",
    "T12.2097.msg": "Hãy tấn công ta đi!",
    "T12.2098.name": "Aurora",
    "T12.2098.msg": "Hãy tấn công ta đi!",
    "T12.2099.name": "Fuluen",
    "T12.2099.msg": "Muốn vượt qua thử thách của ta à? Không phải dễ ăn\nđâu nhá!",
    "T12.2100.name": "Reginleif",
    "T12.2100.msg": "Hãy thử đánh ta đi!",
    "T12.2101.name": "Hermway",
    "T12.2101.msg": "Hãy thử đánh ta đi!",
    "T12.2102.name": "Nolan",
    "T12.2102.msg": "Hãy thử đánh ta đi!",
    "T12.2103.name": "Frya",
    "T12.2103.msg": "Hãy thử đánh ta đi!",
    "T12.2104.name": "Bar",
    "T12.2104.msg": "Nếu đã không gia nhập hàng ngũ của ta thì hãy chịu\nchết đi!",
    "T12.2105.name": "Agres",
    "T12.2105.msg": "Hừ hừ, đợi đấy! Ta sẽ tiêu diệt các ngươi!",
    "T12.2106.name": "Walsak",
    "T12.2106.msg": "Đột phá năng lượng!",
    "T12.2107.name": "Amen",
    "T12.2107.msg": "Tập hợp năng lượng!",
    "T12.2108.name": "Sami Kina",
    "T12.2108.msg": "Dự trữ năng lượng!",
    "T12.2109.name": "Babatos",
    "T12.2109.msg": "(Lặng lẽ tích lực)",
    "T12.2110.name": "Marble",
    "T12.2110.msg": "Hãy đợi thêm tí nữa!",
    "T12.2111.name": "Par",
