    "T35.965.name": "Nam Chiến Binh [Tượng Điêu Khắc]",
    "T35.966.onServiceText": "Sau khi hoàn thành 1 nhiệm vụ thì ngươi có thể đi\ntìm đường xuống tầng tiếp theo.",
    "T35.966.name": "Phù Thủy Phương Bắc",
    "T35.967.onServiceText": "Tiếp theo sẽ rất nguy hiểm, ngươi cần phải chú ý!",
    "T35.967.name": "Phù Thủy Phương Đông",
    "T35.968.onServiceText": "Nếu ngươi đã hoàn thành nhiệm vụ thì ta sẽ đưa\nngươi xuống tầng tiếp theo",
    "T35.968.name": "Cổng Đến Tầng 2",
    "T35.969.onServiceText": "Tiên Cảnh trong truyền thuyết ẩn chứa rất nhiều\nbáu vật, ngươi đã chuẩn bị sẵn sàng cho việc truy\ntìm kho báu chưa? Nhớ lưu ý là ngươi chỉ có 2\ntiếng đồng hồ thôi đấy!",
    "T35.969.name": "Sứ Giả Dịch Chuyển Tiên Cảnh",
    "T35.970.name": "Cổng Đến Tầng 3",
    "T35.971.onServiceText": "Nếu ngươi dùng đúng chìa khóa cùng màu với cánh\ncổng để mở thì sẽ có thể đến được tầng 3. Tuy\nnhiên đáng tiếc là ngươi lại không thể nhìn thấy\nmàu sắc của cánh cổng. Ta không thể chỉ cho ngươi\ncánh cổng chính xác, nhưng ta có thể đảm bảo với\nngươi trong s",
    "T35.971.name": "Người Dẫn Đường Gian Xảo",
    "T35.972.name": "Cổng Đến Tầng 3",
    "T35.973.name": "Khảo Quan Tiên Cảnh",
    "T35.974.name": "Tiểu Binh Dịch Chuyển",
    "T35.975.at": "0-23|0-6|1-31|0-11|FbNpc",
    "T35.975.onServiceText": "Ha ha, ta ở đây chính là để chờ những người như\nngươi đấy.",
    "T35.975.name": "Khảo Quan Gian Lận",
    "T35.976.item": "5-11",
    "T35.976.onServiceText": "Khóm hoa nằm lặng lẽ, tỏa ra hương thơm ngát",
    "T35.976.name": "Khóm Hoa Tiên Cảnh",
    "T35.977.onServiceText": "Sau khi hoàn thành nhiệm vụ ở tầng này thì có thể\ntìm lối xuống tầng tiếp theo.",
    "T35.977.name": "Cây Trí Tuệ",
