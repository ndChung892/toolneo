    "T45.5321.name": "Nhện Độc Đỏ Quý",
    "T45.5321.aScriptText": "Ngẫu nhiên nhận được 2 nguyên liệu trang bị và 1\nLệnh bài treo thưởng, phẩm chất nhiệm vụ càng cao\n(trắng<lục<xanh<tím) thì xác suất nhận được nguyên\nliệu cấp cao càng cao",
    "T45.5322.info": "Bắt 1 con Vong Linh Thuẫn",
    "T45.5322.reqClass": "all",
    "T45.5322.subType": "9-14",
    "T45.5322.startText": "Tiệm pet gần đây nhận được vô số đơn đặt hàng, hãy\nmau giúp bắt các loại pet đang hot nào!",
    "T45.5322.completeText": "Những thứ quý giá thế này nhất định sẽ rất được ưa\nchuộng. Cảm ơn ngươi nhé!",
    "T45.5322.name": "Vong Linh Thuẫn Quý",
    "T45.5322.aScriptText": "Ngẫu nhiên nhận được 2 nguyên liệu trang bị và 1\nLệnh bài treo thưởng, phẩm chất nhiệm vụ càng cao\n(trắng<lục<xanh<tím) thì xác suất nhận được nguyên\nliệu cấp cao càng cao",
