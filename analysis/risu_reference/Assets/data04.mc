    "T29.1025.name": "Nội Dung Tấm Đá",
    "T29.1025.description": "Nội dung tấm đá mà tộc trưởng Bối Tư dịch, hình\nnhư là truyền thuyết cổ nào đó\n",
    "T29.1026.name": "Mảnh Vỡ Tấm Đá",
    "T29.1026.description": "Tấm đá không đầy đủ, trên có ký hiệu lạ thường\n",
    "T29.1027.name": "Tấm Đá Cổ Xưa",
    "T29.1027.description": "Tấm đá viết bằng chữ không đọc được, giống với\nHình văn cổ tự\n",
    "T29.1028.name": "Răng Kịch Độc",
