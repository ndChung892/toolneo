    "T29.1986.info": "Đạo cụ phụ bản",
    "T29.2090.name": "(Xuân)",
    "T29.2090.description": "Thu thập một trong các tổ hợp “Ma Lực”, “Ma Lực Học Đường”, “Ma Lực Học Đường Tết”, “Ma Lực Học Đường Chúc Mừng Năm Mới”, có thể đổi thưởng tại Sứ Giả Sự Kiện Tết ở Đông Huyền Thành",
    "T29.2091.name": "(Tết)",
    "T29.2091.description": "Thu thập một trong các tổ hợp “Ma Lực”, “Ma Lực Học Đường”, “Ma Lực Học Đường Tết”, “Ma Lực Học Đường Chúc Mừng Năm Mới”, có thể đổi thưởng tại Sứ Giả Sự Kiện Tết ở Đông Huyền Thành",
    "T29.2557.info": "Nhấp đúp để sử dụng",
    "T29.2558.info": "Nhấp đúp để sử dụng",
    "T29.2559.info": "Nhấp đúp để sử dụng",
    "T29.2572.name": "Bộ Quà Tân Học Kỳ",
    "T29.2572.info": "Nhấp đúp để mở",
    "T29.2572.description": "Bộ quà chúc mừng năm học mới",
    "T29.2573.name": "Bộ Quà Ngày Biển",
    "T29.2573.info": "Nhấp đúp để mở",
    "T29.2573.description": "Bộ quà chúc mừng mùa hè",
    "T29.2924.description": "Loại dược thảo thần kỳ trong truyền thuyết chỉ được nuôi dưỡng bằng sương sớm, xanh biếc tươi tốt khiến người nhìn thấy cảm thấy thư thái.",
    "T29.2925.description": "Gai nhọn sau nhiều năm biến dị trở nên nóng bỏng vô cùng, tương truyền có thể xua tan giá lạnh.",
    "T29.2926.description": "Loại cỏ truyền thuyết mọc tại vùng đất vong linh, được cho là hóa thân từ linh hồn người đã khuất.",
    "T29.2927.description": "Hình dạng kỳ lạ, ăn vào sẽ mê mất bản thân, là một loại độc thảo cực kỳ hiếm gặp.",
    "T29.2928.description": "Loại cỏ hình trái tim rất đẹp, tương truyền có tác dụng kỳ diệu giúp con người lập tức bình tâm.",
    "T29.2929.description": "Rễ cây quanh năm phát ra ánh sáng xanh, nghe nói có thể khiến người chết sống lại.",
    "T29.2930.description": "Rất ít người tìm thấy được, quanh hoa luôn có một lớp sương mỏng như thể mọc giữa tầng mây.",
    "T29.2931.description": "Dây leo có hình dáng như cây khô héo, ngay cả lá mọc trên đó cũng giống lá úa.",
    "T29.2932.description": "Loài hoa nở từ một loại thực vật trong truyền thuyết, nghe nói ban ngày màu đen, ban đêm phát ra ánh sáng trắng nhạt.",
    "T29.2933.description": "Một loại dây leo màu tím, tương truyền có khả năng tạo ảo ảnh khiến người khác không thể tìm thấy.",
    "T29.3197.description": "Từng chinh chiến sa trường, từng trải qua tình sâu nghĩa nặng, khi trở về xin dâng tặng bạn gói quà tôn quý nhất.",
    "T29.3198.description": "Từng chinh chiến sa trường, từng trải qua tình sâu nghĩa nặng, khi trở về xin dâng tặng bạn gói quà tôn quý nhất.",
    "T29.3199.description": "Từng chinh chiến sa trường, từng trải qua tình sâu nghĩa nặng, khi trở về xin dâng tặng bạn gói quà tôn quý nhất.",
    "T29.3243.name": "Bộ Quà Bồi Thường Bang Hội",
