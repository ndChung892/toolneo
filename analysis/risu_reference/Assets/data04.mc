    "T29.1034.name": "Truy Hồn Phù",
    "T29.1034.info": "Nhấp đôi điền nơi muốn đến",
    "T29.1034.reqClass": "|1|2|5|3|6|4|",
    "T29.1034.description": "Phù chú phương Đông thần bí, có thể di chuyển đến\nngay lập tức đến cạnh một người trong cùng kênh\n",
    "T29.1035.name": "Mông Diện Cân",
