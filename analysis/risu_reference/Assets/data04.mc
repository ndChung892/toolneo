    "T35.2351.name": "Sứ Giả Bí Cảnh",
    "T35.2352.scriptOff": "if(npc.nid && fromBF)\n{\taddBloodyNpcAfterNpcOff(npc.posX,npc.posY);\tBLOODYBATTLE_FIR_NEED_KILL_NUM--;\taddBloodyBattleScore(c,10);\tvar\nisKillAll;\tif(BLOODYBATTLE_FIR_NEED_KILL_NUM == 0)\n{\t\tisKillAll = true;\t} else {\t\tisKillAll =\nfalse;\t}\tif(isKillAll)\n{\t\t\tdispatchEvent(BLOODYBATTLE_KILL_ALL);\t}\tif(c.inGroup())\n\t{\t\tnode = c.memberList.head;\t}\telse \t{\t\tnode =\n{};\t\tnode.obj = c.data.id;\t}\twhile(node)\t{\t\tvar\nscript_obj1 =\ngetPlanByRate(\"3-4422\");\t\taddItemByPlan(node.obj,\nscript_obj1, 1);\t\t\tnode = node.next;\t}}",
    "T35.2352.subType": "all",
