    "T33.506.name": "Tầng 2 Lục Tiên Cảnh",
    "T33.507.name": "Tầng 3 Lục Tiên Cảnh",
    "T33.508.name": "Tầng 4 Lục Tiên Cảnh",
    "T33.509.name": "Tầng 5 Lục Tiên Cảnh",
    "T33.510.name": "Tầng 1 Lang Huyệt Động",
    "T33.511.name": "Tầng 2 Lang Huyệt Động",
    "T35.1.onServiceText": "Trên sa mạc rộng lớn mênh mông cần phải cẩn thận.",
    "T35.1.name": "A Thổ",
    "T35.2.onServiceText": "Ta cho ngươi sống thêm 3 phút thì ngươi chẳng thể\nsống đến 5 phút!",
    "T35.2.name": "Thần Chết",
    "T35.3.onServiceText": "Ở đây ta có một lượng lớn vật tư quân nhu, nếu\nngươi cần thì có thể dùng Lệnh Bài Treo Thưởng để\nđổi ở chỗ ta.",
    "T35.3.name": "Quan Quân Nhu",
    "T35.4.onServiceText": "Ta đang điều tra tìm nguyên nhân thiếu nước",
    "T35.4.name": "Người Tìm Nước",
    "T35.5.onServiceText": "Ngươi đã xem Silent Hill bao giờ chưa?",
    "T35.5.name": "Quỷ Diện",
    "T35.6.onServiceText": "Địa bàn của ta thì ta làm chủ!",
    "T35.6.name": "Xà Yêu Lãnh Chúa",
    "T35.7.onServiceText": "Nơi này rất thích hợp để nuôi ong",
    "T35.7.name": "Người Bắt Ong",
    "T35.8.name": "Gấm Vóc",
    "T35.9.name": "Kim Loại Hiếm",
    "T35.10.name": "Da Thú",
    "T35.11.name": "Lông Thú",
    "T35.12.at": "new|2017/2/3/0/0/0-2017/2/16/10/0/0",
    "T35.12.onServiceText": "Thu thập đủ 7 viên ngọc rồng thì có thể đến chỗ ta\nđể đổi lấy 1 túi quà thần bí O(∩_∩)O",
    "T35.12.name": "Sứ Giả Long Tộc",
    "T35.15.onServiceText": "Ngươi tin vào tình yêu chứ? Ngươi có muốn tìm tình\nyêu của cuộc đời mình không? Ngươi có thể hy sinh\ntất cả vì tình yêu không?",
    "T35.15.name": "Ái Thần",
    "T35.16.at": "0-23|0-6|1-31|0-11|MushroomFruit",
    "T35.16.onServiceText": "Nấm to quá (Nghe nói nhà hàng Âu Dương Đông Huyền\nThành đang thu mua)!",
    "T35.16.name": "Nấm Tươi",
    "T35.17.at": "0-23|0-6|1-31|0-11|MushroomFruit",
    "T35.17.onServiceText": "Nấm to quá (Nghe nói nhà hàng Âu Dương Đông Huyền\nThành đang thu mua)!",
    "T35.17.name": "Nấm Tươi",
