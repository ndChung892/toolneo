    "T29.1724.description": "Chủ động - Tự phục hồi, dùng điểm ma pháp để tạo\nđiểm sinh mệnh, hồi phục tiếp tục trong các hiệp\ntiếp theo\n",
    "T29.1725.name": "Cân Bằng Chi Thược",
    "T29.1725.info": "Dùng trong phần Luyện pet - Kỹ năng",
    "T29.1725.reqClass": "|3|",
    "T29.1725.description": "Kỹ năng pet hệ thực vật cao cấp. Bị động - Điều\ntiết sự cân bằng giữa Trí lực và Tinh thần để tăng\nuy lực ma pháp lên tối đa\n",
    "T29.1726.name": "Lệnh Truy Nã",
    "T29.1726.reqClass": "|1|2|3|4|5|6|",
    "T29.1726.description": "Ghi lại vị trí ẩn nấp của kẻ bị truy nã(nhấp đôi\nđể xem)",
    "T29.1727.name": "Sách Kỹ Năng - Sống Chết Có Nhau",
