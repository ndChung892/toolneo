    "T29.29.name": "Tinh Linh Cầu Siêu Cấp",
    "T29.29.info": "Khi chiến đấu có thể gia tăng 3điểm năng lực săn\nbắt cho nhân vật, hiệu quả duy trì trong 10 lượt!",
    "T29.29.reqClass": "|1|2|5|3|6|4|",
    "T29.29.description": "Quả cầu tinh linh thần kỳ khi tung ra sẽ bắt được\nquái vật dễ dàng và\nnhanh chóng thuần phục chúng",
    "T29.30.name": "Lông Vũ Của Thất Vị Kê",
    "T29.30.reqClass": "|1|2|3|4|6|5|",
    "T29.30.description": "Lông cứng nhất trên mình Thất Vị Kê ở Vân Đài, chỉ\ncần gà còn sống thì sợi lông không bao giờ bị đứt.\n",
    "T29.31.name": "Tâm Ý Của Sư Tỷ",
    "T29.31.description": "Bức thư trả lời tình tứ của sư tỷ, đừng có đọc\ntrộm đấy.",
    "T29.32.name": "Bó Hoa Hồng To",
    "T29.32.info": "Tặng cho người khác giới có thể tăng thêm 660 điểm\nthân mật",
    "T29.32.reqClass": "|1|2|3|4|5|6|",
    "T29.32.description": "Bó hoa to kết từ 11 đoá hồng nhỏ, thể hiện hạnh\nphúc ngọt ngào, rất được các cô gái yêu thích.\n",
    "T29.33.name": "Sừng Tiểu Sơn Quái",
    "T29.33.reqClass": "|1|2|3|4|6|5|",
    "T29.33.description": "Sừng nhọn trên đầu tiểu sơn quái, nghe nói bột mài\nra từ sừng này là thuốc cầm máu tốt nhất\n",
    "T29.34.name": "Thư Tình Kiên Cường",
    "T29.34.description": "Chữ viết trong thư cũng như người viết đều toát ra\ndũng khí kiên cường.\n",
    "T29.35.name": "Thư Tình Sức Sống",
    "T29.35.description": "Bức thư tràn đầy sức sống làm cho người đọc và\nngười viết luôn lạc quan, yêu đời\n",
    "T29.36.name": "Thư Tình Lãng Mạn",
    "T29.36.description": "Bất kể chữ viết hay câu từ trong thư đều rất\ntuyệt, nhưng cũng gây cảm giác nổi da gà cho người\nxem.\n",
    "T29.37.name": "Thư Tình Cứng Nhắc",
    "T29.37.description": "Thư không tạo nên được không khí lãng mạn, vui vẻ\nmà lại mang khí lạnh nặng nề\n",
    "T29.38.name": "Thư Tình Chất Phác",
    "T29.38.description": "Chữ viết trong thư muôn phần đẹp đẽ, không dung\ntục, có thể nhận thấy tình cảm nghiêm túc, chân\nchất của người viết\n",
    "T29.39.name": "Huy Chương [Thú Liệp Chi Vương]",
    "T29.39.info": "Nhấp đôi nhận được danh hiệu",
    "T29.39.reqClass": "|1|2|3|4|6|5|",
    "T29.39.description": "Huy chương do xạ thủ thần trao tặng, đeo vào có\nđược sức mạnh không ngờ\n",
