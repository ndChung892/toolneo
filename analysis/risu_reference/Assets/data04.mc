    "T29.795.reqClass": "|1|2|3|5|6|4|",
    "T29.795.description": "Bạn được tặng danh hiệu \"Xuất Vân Chi Hồng\"\n",
    "T29.796.name": "Huy Chương Đông Huyền Chi Diệu",
    "T29.796.info": "Nhấp đôi nhận được danh hiệu",
    "T29.796.reqClass": "|1|2|3|5|6|4|",
    "T29.796.description": "Bạn sẽ được tặng danh hiệu \"Đông Huyền Chi Diệu\"\n",
    "T29.797.name": "Huy Chương Bàng Bối Chi Tuyền",
    "T29.797.info": "Nhấp đôi nhận được danh hiệu",
    "T29.797.reqClass": "|1|2|3|5|6|4|",
    "T29.797.description": "Bạn sẽ được tăng danh hiệu \"Bàng Bối Chi Tuyền\"\n",
    "T29.798.name": "Huy Chương Tinh Linh Chi Mạch",
    "T29.798.info": "Nhấp đôi nhận được danh hiệu",
    "T29.798.reqClass": "|1|2|3|5|6|4|",
    "T29.798.description": "Bạn được tặng danh hiệu \"Tinh Linh Chi Mạch\"\n",
    "T29.799.name": "Huy Chương Tiên Lạp Chi Quang",
    "T29.799.info": "Nhấp đôi nhận được danh hiệu",
    "T29.799.reqClass": "|1|2|3|5|6|4|",
    "T29.799.description": "Bạn được tặng danh hiệu \"Tiên Lạp Chi Quang\"\n",
    "T29.800.name": "Biên Lai Báo Nhận",
    "T29.800.reqClass": "|1|2|3|4|6|5|",
    "T29.800.description": "Biên lai ký nhận của người nhận thư, hãy giao cho\nChu Thần.\n",
    "T29.801.name": "Vòi Bạch Tuộc",
    "T29.801.description": "Thực phẩm cực ngon nhưng lại được làm từ động vật\ncực độc.\n",
    "T29.802.name": "Yếu Quyết Hệ Thực Vật Sơ Cấp",
    "T29.802.info": "Dùng trong phần Luyện pet - Kỹ năng",
    "T29.802.reqClass": "|3|",
    "T29.802.description": "Có xác suất học được kỹ năng sơ cấp Hệ Thực Vật:\nẢo Hoa Kỳ Hương",
    "T29.803.name": "Yếu Quyết Hệ BOSS Sơ Cấp",
    "T29.803.info": "Dùng trong phần Luyện pet - Kỹ năng",
    "T29.803.reqClass": "|7|",
    "T29.803.description": "Có xác suất học được kỹ năng sơ cấp Hệ BOSS",
    "T29.804.name": "Yếu Quyết Hệ Ác Ma Sơ Cấp",
    "T29.804.info": "Dùng trong phần Luyện pet - Kỹ năng",
    "T29.804.reqClass": "|5|",
    "T29.804.description": "Có xác suất học được kỹ năng sơ cấp Hệ Ác Ma: Vô\nBiên Thê Dạ,\nKhúc Ca Diệt Vong, Phục Thù Lợi Nhận, Hắc Huyết\nXâm Nhiễm,\nKích Trạng Loạn Tâm, Thạc Hóa Chi Xúc, Vẻ Ngoài\nYếu Ớt,\nPhản Ứng Trì Độn, Hắc Dạ Ma Ảnh",
    "T29.805.name": "Kẹp Bắt Thú Siêu Cấp",
    "T29.805.info": "Tăng 2 điểm bắt pet, dùng khi chiến đấu",
    "T29.805.reqClass": "|1|2|5|3|6|4|",
    "T29.805.description": "Dụng cụ săn bắt cao cấp có thể gia tăng năng lực\nsăn bắt. Duy trì liên tục trong 10 lượt đánh\n",
    "T29.806.name": "Răng Cửa To",
    "T29.806.description": "Răng cửa thật lớn, có thể dùng làm mẫu\n",
    "T29.807.name": "Răng Nanh Độc Nhãn Khổng Lồ",
    "T29.807.description": "Lớn hơn nhiều lần so với răng năng độc nhãn bình\nthường.\n",
    "T29.808.name": "Đầu Dã Nhân",
    "T29.808.description": "Đầu dã nhân tượng trưng cho phần thưởng cao quý\n",
    "T29.809.name": "Lệnh Bài Hắc Thủ",
    "T29.809.description": "Một bức thư chứa nhiều bí mật, có quan hệ lớn với\ncác sự việc kỳ lạ phát sinh gần đây.\n",
    "T29.811.name": "Mẫu Máu",
    "T29.811.description": "Một loại mẫu máu dùng làm thí nghiệm, không có tác\ndụng đặc biệt.\n",
    "T29.812.name": "Da Gấu Tuyết",
    "T29.812.description": "Một trong những loại da giữ ấm tốt nhất tại vùng\nnúi tuyết. Dù không quá quý hiếm nhưng cũng đáng\ncất giữ.\n",
    "T29.813.name": "Bình Thủy Tinh",
    "T29.813.description": "Một loại bình thủy tinh dùng trong thí nghiệm,\ntrông có vẻ khá quý.\n",
    "T29.814.name": "Trái Tim Đại Dương",
    "T29.814.description": "Theo truyền thuyết, trong đây có chứa thánh thủy,\ncó thể phục hồi sức mạnh cho sinh vật.\n",
    "T29.815.name": "Thuốc Trọng Sinh Đại Địa",
    "T29.815.description": "Một loại thuốc thần kỳ, nghe nói có thể chữa vết\nthương nặng\n",
    "T29.816.name": "Thư Của Rink",
    "T29.816.description": "Một phong thư bình thường, nhưng là manh mối để\ntìm kiếm Rink\n",
    "T29.817.name": "Mảnh Thiên Lý Truyền Âm",
    "T29.817.description": "Mảnh \"Thiên lý truyền âm\" nhỏ, ánh sáng lấp lánh.\n",
    "T29.818.name": "Máu Yêu Hoa Vương",
    "T29.818.description": "Vật phẩm vô cùng quý, vừa có thể làm thuốc, vừa là\nnguyên liệu tốt nhất để chế tạo.\n",
    "T29.819.name": "Túi Quà Lễ Độc Thân",
    "T29.819.info": "Nhấp đôi để mở",
    "T29.819.reqClass": "|1|2|5|3|6|4|",
    "T29.819.description": "Tết độc thân vui vẻ, quà này chắc ít người muốn\nnhận ==\n",
    "T29.821.name": "Thịt Mèo",
    "T29.821.description": "Nhìn cũng được, đáng tiếc không ai dám ăn.\n",
    "T29.822.name": "Sách Thiên Lý Truyền Âm",
    "T29.822.reqClass": "|1|2|3|4|6|5|",
    "T29.822.description": "Quyển sách quan trọng dùng để tìm kiếm tung tích\nkẻ địch\n",
    "T29.823.name": "Gói Thức Ăn",
    "T29.823.description": "Có mùi hôi thối, không rõ bên trong là gì.\n",
    "T29.824.name": "Máy Dò Tìm",
    "T29.824.description": "Máy thăm dò bão cát, tương đối đắt tiền\n",
    "T29.825.name": "Máy Dò Tìm Bị Hỏng",
    "T29.825.description": "Máy đã bị đốt, máy dò chính xác như thế sao lại bị\nthiêu hủy?\n",
    "T29.826.name": "Tinh Hoa Vương",
    "T29.826.description": "Bộ phận tinh hoa nhất của Hoa yêu, nguyên liệu cần\nthiết để làm trang bị động lực.\n",
    "T29.827.name": "Máy Dò Tìm Đã Sửa",
    "T29.827.description": "Máy dò tìm đã sửa xong, nhìn giống hệt máy mới,\ntuy nhiên tạp âm vẫn còn khá lớn!\n",
    "T29.828.name": "Báo Cáo Kiểm Tra",
    "T29.828.description": "Bản báo cáo liên quan đến vấn đề sa mạc hóa và\nhiện tượng bão cát.\n",
    "T29.829.name": "Bột Phấn Lưu Lại",
    "T29.829.reqClass": "|1|2|3|4|6|5|",
    "T29.829.description": "Bột phấn kỳ quái lưu lại trên khóe miệng của Thỏ\nHoang Điên Loạn, mùi hương rất kỳ lạ\n",
    "T29.830.name": "Dây Leo Bền Chắc",
    "T29.830.reqClass": "|1|2|3|4|6|5|",
    "T29.830.description": "Dây leo thiên nhiên, vừa chắc chắn lại rất đàn\nhồi, là nguyên liệu lý tưởng để chế tạo hộ thân\nphù.\n",
    "T29.831.name": "Nanh Sói Sắc Nhọn",
    "T29.831.description": "Nanh sói tượng trưng cho dũng khí, phải mài nhọn\nđầu trước khi dùng làm hộ thân phù.\n",
    "T29.832.name": "Dũng Khí Hộ Thân Phù",
    "T29.832.description": "Hộ thân phù được làm từ nanh sói, trên có khắc văn\ntự cổ tượng trưng cho dũng khí.\n",
    "T29.833.name": "Súng Tân Thủ",
    "T29.833.description": "Vũ khí của Lính tuần tra, dù sao cũng dùng không\nđược, hãy trả lại cho hắn đi.\n",
    "T29.834.name": "Túi Bột Kỳ Quái",
    "T29.834.description": "Túi chứa bột kỳ quái, mùi rất quen, dường như đã\ntừng ngửi thấy ở đâu đó\n",
    "T29.835.name": "Dịch Của Lão Cổ Thụ",
    "T29.835.description": "Dịch trên thân Lão cổ thụ, nghe nói có hiệu quả\nkiềm chế hưng phấn.\n",
    "T29.836.name": "Tinh Thể Nước",
    "T29.836.description": "Nghe nói có hiệu quả hạ thấp huyết khí.\n",
    "T29.837.name": "Thuốc Ngưng Băng",
    "T29.837.description": "Thuốc đông kết cực mạnh, trong nháy mắt đông kết\ntoàn bộ nước trong không khí.\n",
    "T29.838.name": "Phấn Hoa Thất Hồn",
    "T29.838.description": "Phấn hoa rơi ra từ Thất Hồn Yêu Hoa, có khả năng\ntạo ra ảo giác\n",
    "T29.839.name": "Thuộc Giải Phấn Thất Hồn",
    "T29.839.description": "Thuốc giải trừ hiệu quả của phấn hoa thất hồn, hít\nvào để giải trừ\n",
    "T29.840.name": "Phấn Hoa Diệp Hồn",
    "T29.840.description": "Phấn hoa rơi ra từ Diệp Hồn Hoa Yêu, có khả năng\ntạo ra ảo giác hưng phấn, kích thích\n",
    "T29.841.name": "Thuốc Giải Phấn Diệp Hồn",
    "T29.841.description": "Thuốc giải trừ hiệu quả của phấn hoa Diệp Hồn, hít\nvào để giải trừ\n",
    "T29.842.name": "Thuốc Giải Phấn Mị Hoặc",
    "T29.842.description": "Thuốc giải trừ hiệu quả của phấn Mị Hoặc, hít vào\nđể giải trừ\n",
    "T29.843.name": "Hộp Kim Loại Bí Ẩn",
    "T29.843.reqClass": "|1|2|3|4|5|6|",
    "T29.843.description": "Hộp kim loại rất nhỏ, tựa như đã thấy qua ở đâu\n",
    "T29.844.name": "Phấn Hoa Mê Hoặc",
    "T29.844.description": "Phấn hoa rơi ra từ Mị\nHoặc hoa yêu, có khả năng tạo ra ảo giác kích\nthích hưng phấn\n",
    "T29.845.name": "Túi Quà Học Bổng",
    "T29.845.info": "Nhấp đôi mở túi quà",
    "T29.845.reqClass": "|1|2|5|3|6|4|",
    "T29.845.description": "Học bổng với thật nhiều kim phiếu",
    "T29.846.name": "Túi Quà Ma Thú Yếu Quyết",
    "T29.846.info": "Nhấp đôi mở túi quà",
    "T29.846.reqClass": "|1|2|5|3|6|4|",
    "T29.846.description": "Chứa ngẫu nhiên các loại Ma thú yếu quyết",
    "T29.847.name": "Túi Quà Bảo Vật Thần Kỳ",
    "T29.847.info": "Nhấp đôi mở túi quà",
    "T29.847.reqClass": "|1|2|3|5|6|4|",
    "T29.847.description": "Bên trong chứa rất nhiều bảo vật thần kỳ",
    "T29.848.name": "Phiếu Đổi Túi Quà Lễ Tạ Ơn",
    "T29.848.info": "Có thể đến chỗ Đông Huyền Sứ để chọn 1 món quà",
    "T29.848.reqClass": "|1|2|5|3|6|4|",
    "T29.848.description": "Phiếu dùng để đổi lấy túi quà",
    "T29.849.name": "Hoàng Kim Lễ (Cực Đại)",
    "T29.849.info": "Nhấp đôi sử dụng để đổi lấy kim phiếu",
    "T29.849.reqClass": "|1|2|3|4|6|5|",
    "T29.849.description": "Cuộn giấy đổi lấy rất nhiều kim phiếu",
    "T29.850.name": "Danh Sách Nguyên Liệu",
    "T29.850.reqClass": "|1|2|3|4|6|5|",
    "T29.850.description": "Dịch Của Lão Cổ Thụ 5 phần, Tinh Thể Nước 5 phần,\nThuốc Ngưng Băng 1 phần\n",
