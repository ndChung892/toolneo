    "T19.1786.reqClass": "|1|2|3|4|5|6|",
    "T19.1786.description": "Như tiếng gầm lớn của thiên long phẫn nộ làm người\nkhác mất đi hết dũng khí. Tuy nhiên để làm chủ\nđược năng lượng này không phải là điều dễ dàng",
    "T19.1787.reqClassId": "|1|5|6|",
    "T19.1787.name": "Cuồng Long Giới Chỉ",
    "T19.1787.reqClass": "|1|2|3|4|5|6|",
    "T19.1787.description": "Như tiếng gầm lớn của thiên long phẫn nộ làm người\nkhác mất đi hết dũng khí. Tuy nhiên để làm chủ\nđược năng lượng này không phải là điều dễ dàng",
    "T19.1788.reqClassId": "|2|3|4|",
    "T19.1788.name": "Hồi Sinh Giới Chỉ",
    "T19.1788.reqClass": "|1|2|3|4|5|6|",
    "T19.1788.description": "Đây là chiếc nhẫn thần bí nhất trong truyền\nthuyết, là sự giao hòa giữa ánh sáng và bóng đêm.\nAi sở hữu nó cũng tức sở hữu được sức mạnh lưỡng\ncực",
    "T19.1789.reqClassId": "|2|3|4|",
    "T19.1789.name": "Hồi Sinh Hạng Liên",
    "T19.1789.reqClass": "|1|2|3|4|5|6|",
    "T19.1789.description": "Đây là chiếc nhẫn thần bí nhất trong truyền\nthuyết, là sự giao hòa giữa ánh sáng và bóng đêm.\nAi sở hữu nó cũng tức sở hữu được sức mạnh lưỡng\ncực",
    "T19.1790.reqClassId": "|2|3|4|",
    "T19.1790.name": "Thời Không Luân",
    "T19.1790.reqClass": "|1|2|3|4|5|6|",
    "T19.1790.description": "Là năng lượng ma pháp lớn, có khả năng điều khiển\ncả guồng quay thời gian",
    "T19.1791.reqClassId": "|2|3|4|",
    "T19.1791.name": "Ảo Thái",
    "T19.1791.reqClass": "|1|2|3|4|5|6|",
    "T19.1791.description": "Là mảnh vỡ pha lê hấp thụ các loại năng lượng\nnguyên tố, có màu sắc cầu vồng lấp lánh làm thất\nhồn những kẻ nhìn thấy nó và sinh ra ảo giá ma\nquái",
    "T19.1792.reqClassId": "|1|5|6|",
    "T19.1792.name": "Hắc Diệu Tinh Thạch",
    "T19.1792.reqClass": "|1|2|3|4|5|6|",
    "T19.1792.description": "Là loại pha lê thần bí nhất Vô Ưu, tìm được trong\ndung nham, nặng tựa ngàn cân, sức mạnh vô biên",
    "T19.1793.reqClassId": "|1|5|6|",
