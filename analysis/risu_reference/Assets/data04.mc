    "T45.1889.info": "Tiêu diệt 20 Búp Bê, sau đó báo cáo với Trưởng Cận\nVê Đông Huyền Thành.",
    "T45.1889.reqClass": "all",
    "T45.1889.subType": "9-8",
    "T45.1889.startText": "Tiêu diệt 20 Búp Bê, sau khi hoàn thành thì quay\nvề báo cáo cho Trưởng Cận Vệ Đông Huyền.",
    "T45.1889.completeText": "Đa tạ dũng sĩ!",
    "T45.1889.name": "Búp Bê Đầu To",
    "T45.1889.aScriptText": "Ngẫu nhiên nhận được 2 nguyên liệu trang bị và 1\nLệnh bài treo thưởng, phẩm chất nhiệm vụ càng cao\n(trắng<lục<xanh<tím) thì xác suất nhận được nguyên\nliệu cấp cao càng cao",
    "T45.1890.info": "Tiêu diệt 20 Trúc Yêu, sau đó báo cáo với Trưởng\nCận Vệ Đông Huyền Thành.",
