    "T35.2318.name": "Shop Dũng Khí",
    "T35.2319.onServiceText": "Hãy sử dụng mệnh lệnh Giao\n Nộp. Trong thời gian sự kiện, mỗi người chỉ \ncó 3 cơ hội",
    "T35.2319.name": "Momo",
    "T35.2320.onServiceText": "Hãy sử dụng mệnh lệnh Giao\n Nộp. Trong thời gian sự kiện, mỗi người chỉ \ncó 3 cơ hội",
    "T35.2320.name": "Loni",
    "T35.2321.onServiceText": "Vị trí bổ sung - sau khi vòng tuần hòan bị\n tiêu trừ sẽ phát sinh liên kích, liên kích\n càng cao, điểm số nhận được càng nhiều !",
    "T35.2321.name": "Nhím Xanh",
    "T35.2322.onServiceText": "Vị trí bổ sung - sau khi vòng tuần hòan bị\n tiêu trừ sẽ phát sinh liên kích, liên kích\n càng cao, điểm số nhận được càng nhiều !",
    "T35.2322.name": "Người Tuyết Sống Động",
    "T35.2323.onServiceText": "Khai hỏa, *2, chỉ khi bị tiêu trừ mới tạo ra tác\ndụng đặc biệt!\nChỉ khi tiêu diệt vật chuyển hướng mới tạo ra tác\ndụng!",
    "T35.2323.name": "Kim Hổ",
    "T35.2324.onServiceText": "Khai hỏa, *2, chỉ khi bị tiêu trừ mới tạo ra tác\ndụng\nđặc biệt! Chỉ khi tiêu diệt vật chuyển hướng mới\ntạo\nra tác dụng!",
    "T35.2324.name": "Nấm Điện",
    "T35.2331.at": "0-23|0-6|1-31|0-11",
    "T35.2331.onServiceText": "Chúc bạn chơi game vui vẻ. Nhớ đến\n gặp ta nhận thưởng sau khi kết thúc sự \nkiện nhé!",
    "T35.2331.name": "Sứ Giả Tiêu Trừ",
