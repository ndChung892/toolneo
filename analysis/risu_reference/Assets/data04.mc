    "T19.1362.name": "Lôi Thần Chiến Chùy",
    "T19.1362.reqClass": "|1|",
    "T19.1362.description": "Búa khổng lồ tương truyền do thần sét Thor rèn\nnên,\nbúa tung đến đâu, sét vang rền đến đó\n",
    "T19.1363.name": "Kỳ Phúc Quyền Trượng",
    "T19.1363.reqClass": "|3|",
    "T19.1363.description": "Chỉ có những hiền triết năng lực cao thâm mới có\nthể\nphát huy hết sức mạnh ban phúc của quyền trượng\nnày\n",
    "T19.1364.name": "Hắc Ám Thần Công",
    "T19.1364.reqClass": "|4|",
    "T19.1364.description": "Súng kỹ thuật cao dùng năng lượng hắc ám làm\nsức đẩy, uy lực hơn hẳn súng thần công thông\nthường\n",
    "T19.1365.name": "Hạo Thiên Cổ Kiếm",
    "T19.1365.reqClass": "|6|",
    "T19.1365.description": "Thanh gươm cổ có nguồn gốc từ 1 vương quốc phương\nĐông, vẻ ngoài đơn giản nhưng chứa sức mạnh bí ẩn\n",
    "T19.1366.name": "Kim Sắc Cầm",
    "T19.1366.reqClass": "|2|",
    "T19.1366.description": "Đàn phát ra ánh vàng rực rỡ, âm thanh vang vọng\ntựa tiếng gọi ngàn xưa\n",
    "T19.1367.name": "Lưu Tinh Chiến Bổng",
    "T19.1367.reqClass": "|5|",
    "T19.1367.description": "Gậy làm từ các hợp kim quý hiếm, tuy nhẹ nhưng khi\nđánh lại có sức mạnh của sao băng\n",
    "T19.1368.name": "Thập Tự Quân Thuẫn",
    "T19.1368.reqClass": "|1|",
    "T19.1368.description": "Tấm khiên được sử dụng bởi kỵ sĩ đứng đầu Thập\nTự Chinh, cứng rắn tựa bàn thạch\n",
    "T19.1369.name": "Đông Huyền Biên Niên Sử",
    "T19.1369.reqClass": "|3|",
    "T19.1369.description": "Ghi chép lại lịch sử và bí mật của Đông Huyền, chỉ\ncó đại hiền triết mới được phép xem\n",
    "T19.1370.name": "Ma Tinh Hộ Uyển",
    "T19.1370.reqClass": "|4|",
    "T19.1370.description": "Ma Tinh có sức mạnh nguyên tố rất lớn, phải có ý\nchí\nmạnh mẽ mới có thể dùng được hộ uyển làm từ Ma\nTinh\n",
    "T19.1371.name": "Vô Ảnh Chủy Thủ",
    "T19.1371.reqClass": "|6|",
    "T19.1371.description": "Lưỡi dao mỏng như tờ giấy, vô cùng sắc bén\n",
    "T19.1372.name": "Kim Ty Cầm Cung",
    "T19.1372.reqClass": "|2|",
    "T19.1372.description": "Cầm cung làm từ tơ vàng và gỗ liễu, vô cùng quý\ngiá,\nkết hợp với Kim Sắc Cầm sẽ vô cùng hoàn hảo\n",
    "T19.1373.name": "Tham Lang Thủ",
    "T19.1373.reqClass": "|5|",
    "T19.1373.description": "Vốn là 1 phần trong bộ binh khí Sát Phá Lang,\nẩn chứa bí mật đến nay chưa có lời giải\n",
    "T19.1374.name": "Lôi Thần Khôi",
    "T19.1374.reqClass": "|1|",
    "T19.1374.description": "Trang bị thần sét Thor từng sử dụng, không những\nkiên cố mà còn có sấm sét bao quanh, kẻ thù chạm\nvào sẽ bị tê liệt\n",
    "T19.1375.name": "Kiền Thành Mão",
    "T19.1375.reqClass": "|3|",
    "T19.1375.description": "Chỉ có kiên định mới luôn được thần linh phù hộ,\nmới nhận được lòng tin và sức mạnh cứu thế\n",
    "T19.1376.name": "Tinh Thần Mão",
    "T19.1376.reqClass": "|5|",
    "T19.1376.description": "Thợ săn giỏi liên kết với tự nhiên nếu mang trang\nbị này trên người còn có thể liên kết với tinh\nvân,\nnhận được sức mạnh thần bí từ vũ trụ.\n",
    "T19.1377.name": "Vô Song Khôi",
    "T19.1377.reqClass": "|6|",
    "T19.1377.description": "Sức phòng ngự cực cao, thiên hạ vô song, nhưng\ncũng rất nặng, hiệp sĩ không đủ năng lực khó có\nthể mặc lên người\n",
    "T19.1378.name": "Linh Phong Khôi",
    "T19.1378.reqClass": "|4|",
    "T19.1378.description": "Xạ thủ có thêm tốc độ của ma phong sẽ như hổ\nmọc thêm cánh, khó ai có thể ung dung trước\nngười mang trang bị ma phong\n",
    "T19.1379.name": "Ma Âm Mão",
    "T19.1379.reqClass": "|2|",
    "T19.1379.description": "Trang bị mang sức mạnh thần bí phương Đông,\nnhạc công mang trang bị này sẽ có sức mạnh\ncâu hồn đoạt phách\n",
    "T19.1380.name": "Lôi Thần Giáp",
    "T19.1380.reqClass": "|1|",
    "T19.1380.description": "Trang bị thần sét Thor từng sử dụng, không những\nkiên cố mà còn có sấm sét bao quanh, kẻ thù chạm\nvào sẽ bị tê liệt\n",
    "T19.1381.name": "Kiền Thành Bào",
    "T19.1381.reqClass": "|3|",
    "T19.1381.description": "Chỉ có kiên định mới luôn được thần linh phù hộ,\nmới nhận được lòng tin và sức mạnh cứu thế\n",
    "T19.1382.name": "Tinh Thần Y",
    "T19.1382.reqClass": "|5|",
    "T19.1382.description": "Thợ săn giỏi liên kết với tự nhiên nếu mang trang\nbị này trên người còn có thể liên kết với tinh\nvân,\nnhận được sức mạnh thần bí từ vũ trụ.\n",
