    "T29.219.name": "Tiêu Bản Gấu Trúc Hồ Lô",
    "T29.219.description": "Tiêu bản Gấu Trúc Hồ Lô dùng để nghiên cứu sự xuất\nhiện của Cổ Trùng.\n",
    "T29.220.name": "Tiêu Bản Kiến Miệng Rộng",
    "T29.220.description": "Tiêu bản Kiến Miệng Rộng dùng để nghiên cứu sự\nxuất hiện của Cổ Trùng\n",
    "T29.221.name": "Tiêu Bản Lan Thảo Tinh",
    "T29.221.description": "Tiêu bản Lam Thảo Tinh dùng để nghiên cứu sự xuất\nhiện của Cổ Trùng\n",
    "T29.222.name": "Lá Lan Thảo Tinh",
    "T29.222.description": "Dược thảo trị độc của Cổ Trùng\n",
    "T29.223.name": "Tiếng Gầm Sư Tử",
    "T29.223.description": "Tiếng gầm giận dữ của Sư Tử\n",
    "T29.224.name": "Rễ Lan Thảo Tinh",
    "T29.224.description": "Rễ Lam Thảo Tinh, trông không có gì đặc biệt\n",
    "T29.225.name": "Lệnh Bài",
    "T29.225.description": "Lệnh bài của tộc trưởng Bối Tư, có được lệnh bài\nnày thì tất cả thành viên Đông Huyền đều sẽ tận\nlực tương trợ cho bạn\n",
    "T29.226.name": "Gỗ Trầm Hương",
    "T29.226.description": "Loại gỗ tỏa ra mùi hương kỳ lạ, có vẻ là một báu\nvật lâu đời\n",
    "T29.227.name": "Đất Ảo Trần",
    "T29.227.description": "Loại đất ngưng tụ sức mạnh cực lớn, có vẻ là một\nbáu vật lâu đời\n",
    "T29.228.name": "Giấy Chứng Nhận Tộc Trưởng Bối Tư",
    "T29.228.description": "Thư của Tộc Trưởng Bối Tư gửi đến thành chủ Bàng\nBối, có thể giúp bạn dễ dàng lấy được Thần Vận\nThủy\n",
    "T29.229.name": "Nước May Mắn",
    "T29.229.description": "Một loại nước cực kỳ quý giá, vẩy lên người sẽ có\nđược ma lực cực lớn\n",
    "T29.230.name": "Đầu Kiến Miệng Rộng",
    "T29.230.description": "Đầu của Kiến Miệng Rộng, thức ăn ngon của quái vật\n",
    "T29.231.name": "Linh Dược Trấn Ma",
    "T29.231.description": "Linh dược dùng để trục xuất ác ma ",
    "T29.232.name": "Công Thức Chìa Khóa 1",
    "T29.232.reqClass": "|1|2|3|4|6|5|",
    "T29.232.description": "Một trong những công thức chế tạo chìa khóa bí\nđiển, bên trong có viết các nguyên liệu chế tạo\nchìa khóa (nhấp đôi để mở)\n",
    "T29.233.name": "Công Thức Chìa Khóa 2",
    "T29.233.reqClass": "|1|2|3|4|6|5|",
    "T29.233.description": "Một trong những công thức chế tạo chìa khóa bí\nđiển, bên trong có viết các nguyên liệu chế tạo\nchìa khóa(nhấp đôi để mở)\n",
    "T29.234.name": "Công Thức Chìa Khóa 3",
    "T29.234.reqClass": "|1|2|3|4|6|5|",
    "T29.234.description": "Một trong những công thức chế tạo chìa khóa bí\nđiển, bên trong có viết các nguyên liệu chế tạo\nchìa khóa(nhấp đôi để mở)\n",
    "T29.235.name": "Công Thức Chìa Khóa 4",
    "T29.235.reqClass": "|1|2|3|4|6|5|",
    "T29.235.description": "Một trong những công thức chế tạo chìa khóa bí\nđiển, bên trong có viết các nguyên liệu chế tạo\nchìa khóa (nhấp đôi để mở)\n",
    "T29.236.name": "Công Thức Chìa Khóa 5",
    "T29.236.reqClass": "|1|2|3|4|6|5|",
    "T29.236.description": "Một trong những công thức chế tạo chìa khóa bí\nđiển, bên trong có viết các nguyên liệu chế tạo\nchìa khóa (nhấp đôi để mở)\n",
    "T29.237.name": "Ma Thạch Hề",
    "T29.237.description": "Nguồn ma lực của Hề Ác Ma, nếu không có viên đá\nnày thì hắn chỉ là một tên hề bình thường",
    "T29.238.name": "Mặt Nạ Thiên Diện Quái",
    "T29.238.description": "Phía sau lớp mặt nạ của Thiên Diện Quái lại là một\ntấm mặt nạ khác\n",
    "T29.239.name": "Phấn Bướm",
    "T29.239.description": "Hồ Điệp nhờ có phấn này nên mớicó được vẻ ngoài\nlộng lẫy như thế\n",
    "T29.240.name": "Mật Tuyết Thú",
    "T29.240.description": "Mật Tuyết Thú quý giá, lớn hơn mật gấu rất nhiều\n",
    "T29.241.name": "Linh Châu Yêu Hồ",
    "T29.241.description": "Mất đi Linh Châu thì Yêu Hồ sẽ không còn là yêu\nquái nữa\n",
    "T29.242.name": "Ma Linh Khí",
    "T29.242.description": "Vật chất thần kỳ giúp duy trì thực thể của Ma\nLinh, tích tụ tinh hoa của trời đất\n",
    "T29.243.name": "Nửa Trang Công Thức",
    "T29.243.description": "Nửa trang công thức chìa khóa bí điển ",
    "T29.244.name": "Tuyết Vực Hoa",
    "T29.244.description": "Đóa hoa nở trong băng tuyết, quái vật ở Tuyết Vực\nnhờ mang theo đóa hoa này trên người mà tránh được\nlạnh giá\n",
    "T29.245.name": "Nham Thạch Kỳ Dị",
    "T29.245.description": "Loại đá khiến người đến gần bị ảo giác, vì thế các\nquái vật ở Kỳ Thạch Địa đều mang theo loại đá này\nđể tránh bị kẻ địch tấn công\n",
    "T29.246.name": "Công Thức Chìa Khóa Khó Hiểu",
    "T29.246.description": "Tuy cũng là một trong những công thức chìa khóa\nnhưng lại viết bằng loại văn tự khó hiểu\n",
    "T29.247.name": "Thuốc Ký Ức",
    "T29.247.description": "Loại thuốc giúp phục hồi ký ức\n",
    "T29.248.name": "Kim Thuộc Tơ",
    "T29.248.description": "Đây là linh kiện quan trọng trên người quái vật hệ\nmáy\n",
    "T29.249.name": "Chìa Khóa Bí Điển",
    "T29.249.description": "Chìa khóa có thể mở bí điển trong truyền thuyết\n",
    "T29.250.name": "Thư Thành Chủ Tinh Linh",
    "T29.250.description": "Thư có liên quan đến nội dung bí điển\n",
    "T29.251.name": "Thương Nghị Thư Tộc Trưởng",
    "T29.251.description": "Thư thương nghị Tộc Trưởng gửi đến mọi người, hỏi\ný kiến về việc hồi sinh công chúa Tuyết Liên\n",
    "T29.252.name": "Hồi Âm",
    "T29.252.description": "Thư mọi người trả lời Tộc Trưởng\n",
    "T29.253.name": "Tuyết Liên Trí Thạch",
    "T29.253.description": "Tinh thể ẩn chứa thần lực của công chúa Tuyết\nLiên, người sở hữu sẽ kích phát tiềm lực tối đa\n",
    "T29.254.name": "Mảnh Vỡ Trí Thạch",
    "T29.254.description": "Mảnh vỡ Trí Thạch, tuy chỉ là mảnh vỡ nhưng cũng\nvẫn chứa năng lượng rất lớn\n",
    "T29.255.name": "Ác Ma Huyết",
