    "T29.1296.description": "Có thể dùng để mở Ma Huyễn Bảo Rương\n",
    "T29.1297.name": "Bánh Trôi Thịt",
    "T29.1297.info": "Tăng 600 điểm giới hạn HP trong 15 phút, dùng khi\nkhông chiến đấu",
    "T29.1297.reqClass": "|1|2|3|4|5|6|",
    "T29.1297.description": "Làm từ thịt gà mỹ vị đặc sản thôn Xuất Vân, tràn\nđầy sức sống\n",
    "T29.1298.name": "Bánh Trôi Đậu Đỏ",
    "T29.1298.info": "Tăng 300 điểm tấn công trong 15 phút, dùng khi\nkhông chiến đấu",
    "T29.1298.reqClass": "|1|2|3|4|5|6|",
    "T29.1298.description": "Làm từ đậu đỏ thơm ngọt đặc sản Bàng Bối, ăn vào\nsẽ dũng cảm chiến đấu\n",
    "T29.1299.name": "Bánh Trôi Sữa",
    "T29.1299.info": "Tăng 500 điểm phòng ngự trong 15 phút, dùng khi\nkhông chiến đấu",
    "T29.1299.reqClass": "|1|2|3|4|5|6|",
    "T29.1299.description": "Làm từ sữa thơm của vùng Tiên Lạp, làm cho đao\nsúng không chạm vào được\n",
    "T29.1300.name": "Bánh Trôi Nấm",
    "T29.1300.info": "Tăng 60% tốc độ tấn công trong 15 phút, dùng khi\nkhông chiến đấu",
    "T29.1300.reqClass": "|1|2|3|4|5|6|",
    "T29.1300.description": "Làm từ tinh hoa nấm của rừng già Tinh Linh, làm\ncho thân thủ nhanh nhẹn\n",
    "T29.1301.name": "Bánh Trôi Hải Sản",
    "T29.1301.info": "Tăng 15% tỷ lệ bạo kích trong 15 phút, dùng khi\nkhông chiến đấu",
    "T29.1301.reqClass": "|1|2|3|4|5|6|",
    "T29.1301.description": "Làm từ hải sản tươi ngon nhất Đông Huyền, tăng\nniềm tin lên bội phần\n",
    "T29.1302.name": "Chocolate",
    "T29.1302.info": "Tặng cho người khác có thể tăng thêm 60 điểm thân\nmật giữa 2 người",
    "T29.1302.reqClass": "|1|2|3|4|5|6|",
    "T29.1302.description": "Chocolate thơm đậm đà tựa như nụ hôn say đắm, món\nquà tốt nhất dành tặng người yêu, nhưng ăn nhiều\nbị béo phì đó nha\n",
    "T29.1303.name": "Hoa Hồng",
    "T29.1303.info": "Tặng cho người khác giới có thể tăng thêm 60 điểm\nthân mật",
    "T29.1303.reqClass": "|1|2|3|4|5|6|",
    "T29.1303.description": "Không có hoa nào thể hiện tình yêu ngoại trừ hoa\nhồng, tượng trưng cho tình cảm đẹp đẽ, là thiên sứ\ntruyền đạt lòng ái mộ của con người\n",
    "T29.1304.name": "Dã Thú Cuồng Vũ",
    "T29.1304.info": "Sử dụng tại phần Luyện - Kỹ năng pet",
    "T29.1304.reqClass": "|2|",
    "T29.1304.description": "Sách kỹ năng hệ dã thú cao cấp, tấn công vật lý\ndạng chủ động, tấn công mục tiêu liên tục\n",
    "T29.1308.name": "Túi Quà Tết Nguyên Tiêu",
    "T29.1308.info": "Nhấp đôi để mở túi quà",
    "T29.1308.reqClass": "|1|2|5|3|6|4|",
    "T29.1308.description": "Bên trong chứa các loại bánh trôi, chìa khóa\nNguyên Tiêu, có thể mở được các loại nguyên liệu\ncấp 4 và bảo thạch, đồng thời có xác suất nhận\nđược sách Kim Ngưu Cuồng Vũ\n",
    "T29.1309.name": "Chìa Khóa Nguyên Tiêu",
    "T29.1309.info": "Nhấp đôi sử dụng chìa khóa",
    "T29.1309.reqClass": "|1|2|5|3|6|4|",
    "T29.1309.description": "Có thể dùng để mở Ma Huyễn Bảo Rương\n",
    "T29.1310.name": "Túi Quà Kim Dương",
    "T29.1310.info": "Nhấp đôi mở túi quà",
    "T29.1310.reqClass": "|1|2|5|3|6|4|",
    "T29.1310.description": "Chứa pet Hổ Bì Dương Bảo Bảo phẩm chất 1.5 (cấp độ\nsử dụng 10)",
    "T29.1311.name": "Hình Ảnh Bất Ly",
    "T29.1311.info": "Nhấp đôi sử dụng",
    "T29.1311.reqClass": "|1|2|3|4|5|6|",
    "T29.1311.description": "Sau khi dùng sẽ lập tức được dịch chuyển đến bên\ncạnh người yêu, hữu hiệu với cả 2 phái\n",
    "T29.1312.name": "Chân Tâm Thạch",
    "T29.1312.reqClass": "|1|2|3|4|6|5|",
    "T29.1312.description": "Tạo hoá sinh ra vật thần kỳ, hình trái tim hồng\ntươi, vì thế còn gọi là xích tâm thạch, có phân\nbiệt giới tính, thành đôi thành cặp\n",
    "T29.1313.name": "Túi Quà Lễ Tình Nhân",
    "T29.1313.info": "Nhấp đôi mở túi quà",
    "T29.1313.reqClass": "|1|2|3|4|5|6|",
    "T29.1313.description": "Túi quà chứa 11 đóa Hoa Hồng, 11 phần Chocolate,\nlà biểu tượng của Lễ tình nhân, tượng trưng tình\nyêu",
    "T29.1314.name": "Nhị Hoa Hạnh Phúc",
    "T29.1314.description": "Nhị hoa tượng trưng cho hạnh phúc",
    "T29.1315.name": "Hộp Chocolate",
    "T29.1315.info": "Tặng cho người khác có thể tăng thêm 660 điểm thân\nmật giữa 2 người",
    "T29.1315.reqClass": "|1|2|3|4|5|6|",
    "T29.1315.description": "Chocolate cao cấp đóng hộp, tặng cho ai cũng\nthích, nhưng khuyên người yêu đừng ăn quá nhiều dễ\nbị béo phì!\n",
    "T29.1316.name": "Sách Kỹ Năng Tình Nhân - Tâm Tâm Tương Ấn",
    "T29.1316.info": "Nhấp đôi vào sách kỹ năng để học",
    "T29.1316.reqClass": "|1|2|3|4|5|6|",
    "T29.1316.description": "Sách dùng để học kỹ năng Tâm Tâm Tương Ấn\n",
    "T29.1317.name": "Sách Kỹ Năng Tình Nhân - Đồng Khí Liên Chi",
    "T29.1317.info": "Nhấp đôi vào sách kỹ năng để học",
