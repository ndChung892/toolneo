    "T29.6267.name": "Rượu Hoa Cúc",
    "T29.6267.info": "Miễn giảm 10% sát thương trong 30 phút, dùng trong\nchiến đấu",
    "T29.6267.reqClass": "|1|2|5|3|6|4|",
    "T29.6267.description": "Rượu trường thọ, vị mát lạnh, \ngiúp mát gan, mắt sáng, kiện não, \nngăn ngừa lão hóa",
    "T29.6268.name": "Thù Du",
    "T29.6268.reqClass": "|1|2|5|3|6|4|",
    "T29.6268.description": "Thù Du là loại thực vật có mùi thơm \nmàu xanh, có thể sát trùng trừ độc, \ntrục hàn trừ phong.",
    "T29.6269.name": "Túi Thù Du",
    "T29.6269.info": "Hiệu quả duy trì trong 30 phút, có thể cộng dồn,\ndùng trong chiến đấu",
    "T29.6269.reqClass": "|1|2|5|3|6|4|",
    "T29.6269.description": "Bên trong có ít Thù Du, khi sử dụng sẽ làm \ngiảm sát thương chịu khi chiến đấu với Ác Linh",
    "T29.6270.name": "Túi Hương Trừ Tà",
    "T29.6270.info": "Dùng trong chiến dấu",
    "T29.6270.reqClass": "|1|2|5|3|6|4|",
    "T29.6270.description": "Chứa lượng lớn vật trừ tà, khi sử dụng sẽ \nkhông bị ác linh phát hiện, nhưng chỉ \nhiệu lực trong thời gian ngắn. Hãy sử dụng \ntrước khi pk với ác linh",
    "T29.6271.name": "Huy Chương Ác Linh Tiêu Tán",
    "T29.6271.info": "Nhấp đôi để dùng",
    "T29.6271.reqClass": "|1|2|5|3|6|4|",
    "T29.6271.description": "Minh chứng đẩy lùi ác linh trong Tết Trùng Dương",
    "T29.6272.name": "Huy Chương Cửu Cửu Quy Nhất",
    "T29.6272.info": "Nhấp đôi để dùng",
    "T29.6272.reqClass": "|1|2|5|3|6|4|",
    "T29.6272.description": "Minh chứng đẩy lùi ác linh trong Tết Trùng Dương",
    "T29.6273.name": "Dược Thủy Tiến Hóa Thú Cưỡi Cao Cấp",
    "T29.6273.reqClass": "|1|2|5|3|6|4|",
    "T29.6273.description": "Khi sử dụng sẽ có xác suất tiến hóa thú cưỡi lên\ncấp cao hơn.\nChỉ có thể dùng tiến hóa thú cưỡi cấp 8 trở lên",
    "T29.6274.name": "Sách Chuyển Dịch Ảo Ma Tháp",
    "T29.6274.info": "Lv70 trở lên + trong túi phải có Lệnh Thông Tháp +\nđủ chiến tích mới được dùng",
    "T29.6274.reqClass": "|1|2|3|4|6|5|",
    "T29.6274.description": "Sau khi sử dụng có thể trực tiếp vào tầng (số tầng\nđã thông quan-10)\nẢo Ma Tháp khiêu chiến, đồng thời giới hạn thời\ngian\nkhiêu chiến giảm xuống 120 phút. Nhân vật đã\nchuyển sinh\nthì sau khi sử dụng, cứ 2 tầng chỉ cần đấu 1 lần, \ngiời hạn thời gian khiêu chiến xuống 60 phút.",
    "T29.6275.name": "Sách Chuyển Dịch Ảo Ma Tháp Cao Cấp",
    "T29.6275.info": "Nhân vật chuyển sinh\n+ trong túi phải có Lệnh Thông Tháp + đủ chiến\ntích mới được dùng",
    "T29.6275.reqClass": "|1|2|3|4|6|5|",
    "T29.6275.description": "Sau khi sử dụng có thể trực tiếp vào tầng (số tầng\nđã thông quan-10)\nẢo Ma Tháp khiêu chiến. Cứ mỗi 10 tầng \nchỉ cần đấu 1 lần, đồng thời giới hạn thời gian \nkhiêu chiến giảm xuống 12 phút",
    "T29.6276.name": "Túi Quà Tiến Hóa Hoàn Mỹ",
    "T29.6276.info": "Nhấp đôi để mở",
    "T29.6276.reqClass": "|1|2|3|4|6|5|",
    "T29.6276.description": "Chứa Túi Quà Lông Vũ Cấp 5*2, Lông Vũ Chúc Phúc\nCao Cấp*2,\nLông Vũ Phượng Hoàng*60, Túi Quà Dược Thủy Tiến\nHóa Thú Cưỡi*5,\nLong Diên Hương (40 Cái)*1, Linh Hồn Thạch Đặc\nCấp*2,\nTinh Hồn Linh Giáp*16, Chìa Khóa Linh Vũ*3, \nTúi Quà Dược Thủy Tiến Hóa Thú Cưỡi Cao Cấp *5. ",
    "T29.6277.name": "Túi Quà Cả Đời Viên Mãn",
    "T29.6277.info": "Nhấp đôi để mở",
    "T29.6277.reqClass": "|1|2|3|4|6|5|",
    "T29.6277.description": "Chứa Quả Linh Tê*2,\nTúi Thiên Phú Thạch Cam Cấp 4*1, \nTúi Quà Dược Thủy Tiến Hóa Thú Cưỡi Cao Cấp *5, \nBảo Rương Phù Văn Hy Hữu Cam*1, \nTúi Quà EXP Mệnh Hồn Cao Cấp*2, \nTúi Quà Tự Chọn Lông Vũ Cấp 4*2, \nTúi Quà Tự Chọn Pet Ảo Hóa Cam*3. ",
    "T29.6278.name": "Túi Quà Dược Thủy Tiến Hóa Thú Cưỡi Cao Cấp ",
    "T29.6278.info": "Nhấp đôi để mở",
